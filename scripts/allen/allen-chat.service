# /etc/systemd/system/allen-chat.service
# System unit with a dedicated system user (no login shell, no sudoers entry).
# Not a --user unit: on this Spark the user manager silently skips mount
# namespacing (AppArmor restricts unprivileged user namespaces), and not
# drakestapleton, whose account has sudo: the sandbox is not the only layer.
[Unit]
Description=allen-chat: public gateway for www.aienos.com/allen/ (tailnet only, no credentials)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=allen-chat
Group=allen-chat
SupplementaryGroups=allen-spool allen-drop allen-relaydrop
EnvironmentFile=-/etc/allen-chat/env
ExecStart=/usr/bin/python3 -I /opt/allen-chat/allen_chat.py \
  --listen 100.64.0.2:18110 \
  --trusted-proxy 100.64.0.3 \
  --upstream 127.0.0.1:18091 \
  --system-prompt /opt/allen-chat/system-prompt.txt \
  --catalog /var/lib/allen-catalog/catalog.txt \
  --areas-file /var/lib/allen-catalog/areas.txt \
  --omc /opt/allen-chat/omc \
  --irwasm /opt/allen-chat/irwasm \
  --spool-in /var/lib/allen-chat/spool-in \
  --spool-status /var/lib/allen-chat/spool-status \
  --contacts-drop /var/lib/allen-chat/contacts-drop \
  --memory-url http://127.0.0.1:18096 \
  --relay-drop /var/lib/allen-chat/relay-drop \
  --console-listen 100.64.0.2:18112 \
  --console-state /var/lib/allen-chat/console
Environment=PATH=/usr/bin:/bin
Restart=on-failure
RestartSec=5
UMask=0027
Nice=5

# What public Allen cannot do (README): no credentials, no home, writes only into the drop dirs
# (spool, contacts, relay) and the console's presence.json. The console listener (18112) is
# tailnet only; nft admits it only from Drake's devices 100.64.0.1/100.64.0.4 and the Spark.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/allen-chat/spool-in /var/lib/allen-chat/contacts-drop /var/lib/allen-chat/relay-drop /var/lib/allen-chat/console
InaccessiblePaths=-/var/lib/allen-contacts -/var/lib/omega-pusher -/var/lib/allen-relay
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK only because bwrap configures the loopback of the compile sandbox's
# empty network namespace over NETLINK_ROUTE; without CAP_NET_ADMIN it can change nothing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.1 100.64.0.1 100.64.0.2 100.64.0.3 100.64.0.4
SystemCallFilter=@system-service @mount unshare setns
SystemCallArchitectures=native
MemoryMax=1G
TasksMax=128
CPUQuota=200%
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
