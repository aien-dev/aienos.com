note Browser glue authored and emitted by seeded Omega, same pattern as Hive #105.
text client "/* Generated by om/alpha-page/client.om. Do not edit. */\n(() => {\n  'use strict';\n  const command = document.getElementById('alpha-command');\n  const copy = document.getElementById('alpha-copy');\n  const status = document.getElementById('alpha-copy-status');\n  if (!command || !copy || !status) return;\n  copy.addEventListener('click', async () => {\n    try {\n      await navigator.clipboard.writeText(command.textContent);\n      status.textContent = 'Copied. Read the script before running it.';\n    } catch (_) {\n      const selection = window.getSelection();\n      const range = document.createRange();\n      range.selectNodeContents(command);\n      selection.removeAllRanges();\n      selection.addRange(range);\n      status.textContent = 'Clipboard unavailable. The command is selected; copy it manually.';\n    }\n  });\n  const button = document.getElementById('alpha-motion');\n  const scene = document.querySelector('.alpha-scene');\n  const reduced = matchMedia('(prefers-reduced-motion: reduce)');\n  let running = false;\n  const sync = () => {\n    const play = running && !reduced.matches && !document.hidden;\n    scene.dataset.motion = play ? 'on' : 'off';\n    button.setAttribute('aria-pressed', String(running && !reduced.matches));\n    button.textContent = reduced.matches ? 'Motion off: reduced motion preference' : running ? 'Pause the event horizon' : 'Play the event horizon';\n    button.disabled = reduced.matches;\n  };\n  button.addEventListener('click', () => { running = !running; sync(); });\n  reduced.addEventListener('change', () => { if (reduced.matches) running = false; sync(); });\n  document.addEventListener('visibilitychange', sync);\n  sync();\n})();\n"
fn main to int
pos = ulong 0
while lt pos len client bound 65536
n = write 1 client pos sub len client pos
if le n 0
ret 1
end
pos = add pos ulong n
end
ret 0
end
