note Allen chat client. ~N~ tokens expand the single definitions in contract.om.
note Each text holds one JS function or one group of declarations; the last binds the page.
note Composed with contract.om and allen.om by check.sh, never compiled on its own.

note JavaScript prelude
text js0 "/* Allen chat client.\n *\n * Generated by om/allen-page/allen-js.om; never hand-edit. The page skeleton is\n * generated by om/allen-page/allen.om. Model and network text only ever reaches\n * textContent, a text node, or the srcdoc of a frame sandboxed to allow-scripts\n * alone: nothing from the network is parsed as markup in this document. The\n * conversation lives in this closure only: no storage, no cookies.\n */\n(() => {\n  'use strict';\n  const root = document.getElementById('~0~');\n  if (!root) return;\n  const byId = id => document.getElementById(id);\n  const log = byId('~1~');\n  const form = byId('~2~');\n  const input = byId('~3~');\n  const sendButton = byId('~4~');\n  const stopButton = byId('~5~');\n  const status = byId('~6~');\n  const newButton = byId('~7~');\n  const examples = byId('~15~');\n  const speed = { model: byId('~8~'), queue: byId('~9~'), ttft: byId('~10~'), first: byId('~11~'), rate: byId('~12~'), tokens: byId('~13~'), server: byId('~14~') };\n  const CHAT = '~16~';\n  const OMEGA = '~17~';\n  const LIMIT = { count: ~18~, each: ~19~, total: ~20~, source: ~21~ };\n  const CSP = \"~22~\";\n  const SANDBOX = '~23~';\n  const CALL_MS = ~25~;\n  const turns = [];\n  const runners = new Set();\n  let active = null;\n  let epoch = 0;\n  let countdown = 0;\n"

note JavaScript el
text js1 "  function el(tag, className, text) {\n    const node = document.createElement(tag);\n    if (className) node.className = className;\n    if (text !== undefined) node.textContent = text;\n    return node;\n  }\n"

note JavaScript setText
text js2 "  function setText(node, value) {\n    if (node && node.textContent !== value) node.textContent = value;\n  }\n"

note JavaScript button
text js3 "  function button(label, handler) {\n    const node = el('button', 'allen-tool', label);\n    node.type = 'button';\n    node.addEventListener('click', handler);\n    return node;\n  }\n"

note JavaScript ms
text js4 "  function ms(value) {\n    return Number.isFinite(value) ? `${Math.round(value)} ms` : '-';\n  }\n  function count(value) {\n    return Number.isSafeInteger(value) && value >= 0 ? String(value) : '?';\n  }\n"

note JavaScript cut
text js5 "  /* Contract limits count characters; never leave half a surrogate pair behind. */\n  function cut(text, max) {\n    if (text.length <= max) return text;\n    const head = text.slice(0, max);\n    return /[\\ud800-\\udbff]$/.test(head) ? head.slice(0, -1) : head;\n  }\n"

note JavaScript fit
text js6 "  /* The newest turns that fit the gateway: at most LIMIT.count messages, each at\n     most LIMIT.each characters, LIMIT.total in all, starting with a user turn. */\n  function fit(list) {\n    const out = list.map(turn => ({ role: turn.role, content: cut(turn.content, LIMIT.each) }));\n    let total = out.reduce((sum, turn) => sum + turn.content.length, 0);\n    while (out.length > 1 && (out.length > LIMIT.count || total > LIMIT.total || out[0].role !== 'user')) {\n      total -= out.shift().content.length;\n    }\n    return out;\n  }\n"

note JavaScript sse
text js7 "  /* Incremental server-sent events: a chunk may end anywhere, even inside a line. */\n  function sse(onEvent) {\n    let carry = '';\n    let name = '';\n    let data = [];\n    function line(text) {\n      if (text === '') {\n        if (data.length) onEvent(name || 'message', data.join('\\n'));\n        name = '';\n        data = [];\n        return;\n      }\n      if (text.startsWith(':')) return;\n      const colon = text.indexOf(':');\n      const field = colon < 0 ? text : text.slice(0, colon);\n      let value = colon < 0 ? '' : text.slice(colon + 1);\n      if (value.startsWith(' ')) value = value.slice(1);\n      if (field === 'event') name = value;\n      else if (field === 'data') data.push(value);\n    }\n    return {\n      feed(chunk) {\n        carry += chunk;\n        let start = 0;\n        for (;;) {\n          const end = carry.indexOf('\\n', start);\n          if (end < 0) break;\n          line(carry.slice(start, end).replace(/\\r$/, ''));\n          start = end + 1;\n        }\n        carry = carry.slice(start);\n      },\n      end() {\n        if (carry) line(carry.replace(/\\r$/, ''));\n        carry = '';\n        line('');\n      },\n    };\n  }\n"

note JavaScript inline
text js8 "  /* Inline code and bold only; every piece becomes a text node. */\n  function inline(parent, text) {\n    let at = 0;\n    for (const match of text.matchAll(/`([^`\\n]+)`|\\*\\*([^*\\n]+)\\*\\*/g)) {\n      if (match.index > at) parent.append(document.createTextNode(text.slice(at, match.index)));\n      parent.append(match[1] !== undefined ? el('code', '', match[1]) : el('strong', '', match[2]));\n      at = match.index + match[0].length;\n    }\n    if (at < text.length) parent.append(document.createTextNode(text.slice(at)));\n  }\n"

note JavaScript renderer
text js9 "  /* Streams a reply into nodes. Each token is appended to the text node of the\n     line being written; a finished line is re-rendered as paragraph text, a\n     heading, or a line of a fenced code block. A line that may still become a\n     fence is held back until it is decided, so fences never flash as text. */\n  function renderer(body) {\n    const st = { block: null, sep: null, tail: null, code: null, codeText: null, lang: '', wrap: null, bar: null, pre: null, line: '', held: false, text: '' };\n    const opening = /^ {0,3}```\\s*([A-Za-z0-9_+.-]*)\\s*$/;\n    const closing = /^ {0,3}```\\s*$/;\n    const maybeOpening = /^ {0,3}`{1,3}[A-Za-z0-9_+.-]*$/;\n    const maybeClosing = /^ {0,3}`{1,3}$/;\n    function closeParagraph() {\n      if (st.block && !st.block.firstChild) st.block.remove();\n      st.block = null;\n    }\n    function tailNode() {\n      if (st.tail) return st.tail;\n      st.tail = document.createTextNode('');\n      if (st.code) {\n        st.code.append(st.tail);\n      } else {\n        if (!st.block) {\n          st.block = el('p', 'allen-p');\n          body.append(st.block);\n        } else if (st.block.firstChild) {\n          st.sep = document.createTextNode('\\n');\n          st.block.append(st.sep);\n        }\n        st.block.append(st.tail);\n      }\n      return st.tail;\n    }\n    function retract(keepSep) {\n      if (st.tail) st.tail.remove();\n      if (st.sep && !keepSep) st.sep.remove();\n      st.tail = null;\n      st.sep = null;\n    }\n    function openCode(lang) {\n      st.wrap = el('div', 'allen-code');\n      st.bar = el('div', 'allen-tools');\n      st.bar.append(el('span', 'allen-lang', lang || 'text'));\n      st.pre = el('pre');\n      st.code = el('code');\n      st.codeText = document.createTextNode('');\n      st.code.append(st.codeText);\n      st.pre.append(st.code);\n      st.wrap.append(st.bar, st.pre);\n      body.append(st.wrap);\n      st.lang = lang;\n    }\n    function closeCode() {\n      retract(false);\n      tools(st.lang, st.codeText.data.replace(/\\n$/, ''), st.wrap, st.bar, st.pre);\n      st.code = null;\n      st.codeText = null;\n    }\n    function commit() {\n      const line = st.line;\n      st.line = '';\n      st.held = false;\n      if (st.code) {\n        retract(false);\n        if (closing.test(line)) closeCode();\n        else st.codeText.appendData(line + '\\n');\n        return;\n      }\n      const open = opening.exec(line);\n      const heading = /^#{1,4}\\s+(.*)$/.exec(line);\n      if (open || heading || !line.trim()) {\n        retract(false);\n        closeParagraph();\n        if (open) {\n          openCode(open[1].toLowerCase());\n        } else if (heading) {\n          const node = el('p', 'allen-h');\n          inline(node, heading[1]);\n          body.append(node);\n        }\n        return;\n      }\n      tailNode();\n      retract(true);\n      inline(st.block, line);\n    }\n    return {\n      push(token) {\n        st.text += token;\n        token.split('\\n').forEach((piece, index) => {\n          if (index > 0) commit();\n          if (!piece) return;\n          st.line += piece;\n          if ((st.code ? maybeClosing : maybeOpening).test(st.line)) {\n            st.held = true;\n          } else if (st.held) {\n            st.held = false;\n            tailNode().data = st.line;\n          } else {\n            tailNode().appendData(piece);\n          }\n        });\n      },\n      finish() {\n        if (st.line) commit();\n        if (st.code) closeCode();\n        retract(false);\n        closeParagraph();\n        return st.text;\n      },\n    };\n  }\n"

note JavaScript tools
text js10 "  /* Buttons under a finished fenced block: html runs in a sandbox, omega\n     compiles to WebAssembly, every block can be copied. */\n  function tools(lang, source, wrap, bar, pre) {\n    const kind = /^html?$/.test(lang) ? 'html' : /^(omega|om)$/.test(lang) ? 'omega' : '';\n    const out = el('div', 'allen-out');\n    let view = null;\n    const showCode = shown => {\n      pre.hidden = !shown;\n      if (view) view.setAttribute('aria-pressed', String(shown));\n    };\n    if (kind === 'html') {\n      bar.append(button('Run', () => {\n        runHtml(source, out);\n        showCode(false);\n      }));\n    }\n    if (kind === 'omega') {\n      bar.append(button('Compile and run', event => compileOmega(source, out, event.currentTarget)));\n    }\n    if (kind) {\n      view = button('Code', () => showCode(pre.hidden));\n      view.setAttribute('aria-pressed', 'true');\n      bar.append(view);\n    }\n    const copy = button('Copy', () => copyText(source, copy));\n    bar.append(copy);\n    wrap.append(out);\n  }\n"

note JavaScript copyText
text js11 "  async function copyText(source, node) {\n    try {\n      await navigator.clipboard.writeText(source);\n      setText(node, 'Copied');\n    } catch (_) {\n      setText(node, 'Copy blocked');\n    }\n    setTimeout(() => setText(node, 'Copy'), 1500);\n  }\n"

note JavaScript sandboxed
text js12 "  /* The policy becomes the first element of the program's head: after an\n     existing head tag that only a doctype, html tag or comments precede, else\n     in a head of its own placed after any doctype and html tag. */\n  function sandboxed(source) {\n    const meta = `<meta http-equiv=\"Content-Security-Policy\" content=\"${CSP}\">`;\n    const head = /^\\s*(?:<!doctype[^>]*>\\s*)?(?:<!--[\\s\\S]*?-->\\s*)*(?:<html(?:\\s[^>]*)?>\\s*)?(?:<!--[\\s\\S]*?-->\\s*)*<head(?:\\s[^>]*)?>/i.exec(source);\n    if (head) return source.slice(0, head[0].length) + meta + source.slice(head[0].length);\n    const lead = /^\\s*(?:<!doctype[^>]*>\\s*)?(?:<html(?:\\s[^>]*)?>)?/i.exec(source)[0];\n    return `${lead}<head>${meta}</head>${source.slice(lead.length)}`;\n  }\n"

note JavaScript runHtml
text js13 "  function runHtml(source, out) {\n    const frame = document.createElement('iframe');\n    frame.setAttribute('sandbox', SANDBOX);\n    frame.setAttribute('referrerpolicy', 'no-referrer');\n    frame.setAttribute('title', 'Program written by Allen, sandboxed');\n    frame.className = 'allen-frame';\n    frame.srcdoc = sandboxed(source);\n    const box = el('div', 'allen-frame-box');\n    box.append(frame);\n    out.replaceChildren(box, el('p', 'allen-note', 'Sandboxed: its scripts run with no access to this page or your cookies, and its content security policy blocks network loads. Drag the corner to resize.'));\n  }\n"

note JavaScript retryAfter
text js14 "  function retryAfter(response, body) {\n    const value = Number(body && body.retry_after !== undefined ? body.retry_after : response.headers.get('Retry-After'));\n    return Number.isFinite(value) && value > 0 ? Math.ceil(value) : 0;\n  }\n"

note JavaScript refusal
text js15 "  function refusal(code, body) {\n    const said = body && typeof body.message === 'string' ? body.message.slice(0, 300) : '';\n    if (code === 429) return 'You are sending faster than Allen takes turns.';\n    if (code === 503) return 'Allen is busy with other visitors right now.';\n    if (code === 413) return 'That is longer than Allen accepts in one go. Shorten it, or start a new conversation.';\n    if (code === 400) return `Allen could not read that request${said ? `: ${said}` : '.'}`;\n    return `Allen is unreachable right now (HTTP ${code}).`;\n  }\n"

note JavaScript notice
text js16 "  /* Status line text, with a live countdown when the gateway says when to retry. */\n  function notice(text, wait) {\n    clearInterval(countdown);\n    if (!wait) {\n      setText(status, text);\n      return;\n    }\n    let left = wait;\n    const show = () => setText(status, left > 0 ? `${text} Try again in ${left} s.` : `${text} You can try again now.`);\n    show();\n    countdown = setInterval(() => {\n      left -= 1;\n      show();\n      if (left <= 0) clearInterval(countdown);\n    }, 1000);\n  }\n"

note JavaScript types
text js17 "  /* Omega scalar types: i32 for the narrow ones (JS Number), i64 for the wide\n     ones (JS BigInt). Inputs are checked against the declared range. */\n  const TYPES = {\n    bool: { wide: false, min: 0n, max: 1n },\n    uchar: { wide: false, min: 0n, max: 255n },\n    ushort: { wide: false, min: 0n, max: 65535n },\n    uint: { wide: false, min: 0n, max: 4294967295n },\n    byte: { wide: false, min: -128n, max: 127n },\n    short: { wide: false, min: -32768n, max: 32767n },\n    int: { wide: false, min: -2147483648n, max: 2147483647n },\n    ulong: { wide: true, min: 0n, max: 18446744073709551615n },\n    long: { wide: true, min: -9223372036854775808n, max: 9223372036854775807n },\n  };\n  const known = type => typeof type === 'string' && Object.hasOwn(TYPES, type);\n"

note JavaScript argument
text js18 "  function argument(type, raw) {\n    const range = TYPES[type];\n    const text = raw.trim();\n    if (type === 'bool' && /^(true|false)$/i.test(text)) return text.toLowerCase() === 'true' ? 1 : 0;\n    if (!/^-?\\d{1,20}$/.test(text)) throw new RangeError('needs a whole number');\n    const value = BigInt(text);\n    if (value < range.min || value > range.max) throw new RangeError(`must be ${range.min} to ${range.max}`);\n    return range.wide ? value : Number(value);\n  }\n"

note JavaScript shown
text js19 "  /* wasm hands back i32 as a signed Number and i64 as a signed BigInt; show\n     each value the way its Omega type reads it. */\n  function shown(type, value) {\n    switch (type) {\n      case 'bool': return value !== 0 ? 'true' : 'false';\n      case 'uchar': return String(value & 255);\n      case 'ushort': return String(value & 65535);\n      case 'uint': return String(value >>> 0);\n      case 'byte': return String((value << 24) >> 24);\n      case 'short': return String((value << 16) >> 16);\n      case 'int': return String(value | 0);\n      case 'ulong': return BigInt.asUintN(64, value).toString();\n      case 'long': return BigInt.asIntN(64, value).toString();\n      default: return value === undefined ? 'done' : String(value);\n    }\n  }\n"

note JavaScript workerMain
text js20 "  /* Runs inside a dedicated worker, so a long loop never freezes this page:\n     the page ends the worker when a call overruns CALL_MS. */\n  function workerMain() {\n    let ready = null;\n    self.onmessage = async event => {\n      const job = event.data;\n      if (job.module) {\n        ready = WebAssembly.instantiate(job.module, {});\n        ready.catch(() => {});\n        return;\n      }\n      try {\n        const instance = await ready;\n        const value = instance.exports[job.name](...job.args);\n        self.postMessage({ id: job.id, ok: true, value });\n      } catch (error) {\n        self.postMessage({ id: job.id, ok: false, trap: error instanceof WebAssembly.RuntimeError, message: String((error && error.message) || error) });\n      }\n    };\n  }\n"

note JavaScript runner
text js21 "  function runner(module) {\n    let worker = null;\n    let next = 0;\n    const pending = new Map();\n    function stop() {\n      if (worker) worker.terminate();\n      worker = null;\n      for (const job of pending.values()) {\n        clearTimeout(job.timer);\n        job.done({ ok: false, message: 'the runner was reset' });\n      }\n      pending.clear();\n    }\n    function start() {\n      const url = URL.createObjectURL(new Blob([`(${workerMain.toString()})();`], { type: 'text/javascript' }));\n      worker = new Worker(url);\n      URL.revokeObjectURL(url);\n      worker.onmessage = event => {\n        const job = pending.get(event.data.id);\n        if (!job) return;\n        pending.delete(event.data.id);\n        clearTimeout(job.timer);\n        job.done(event.data);\n      };\n      worker.onerror = event => {\n        event.preventDefault();\n        stop();\n      };\n      worker.postMessage({ module });\n    }\n    function run(name, args) {\n      if (!worker) start();\n      return new Promise(done => {\n        const id = next;\n        next += 1;\n        const timer = setTimeout(() => {\n          pending.delete(id);\n          stop();\n          done({ ok: false, timeout: true });\n        }, CALL_MS);\n        pending.set(id, { timer, done });\n        worker.postMessage({ id, name, args });\n      });\n    }\n    const handle = { run, stop };\n    runners.add(handle);\n    return handle;\n  }\n"

note JavaScript fnForm
text js22 "  function fnForm(fn, exported, machine) {\n    const name = typeof fn.name === 'string' ? fn.name : '';\n    const params = Array.isArray(fn.params) ? fn.params : [];\n    const ret = typeof fn.ret === 'string' ? fn.ret : 'void';\n    const form = el('form', 'allen-fn');\n    form.noValidate = true;\n    const signature = el('p', 'allen-sig');\n    signature.append(el('code', '', `${name}(${params.map(p => `${p.name}: ${p.type}`).join(', ')}) to ${ret}`));\n    form.append(signature);\n    const fields = params.map(param => {\n      const label = el('label', 'allen-arg');\n      label.append(el('span', '', `${param.name}: ${param.type}`));\n      const field = el('input');\n      field.type = 'text';\n      field.inputMode = 'numeric';\n      field.autocomplete = 'off';\n      field.spellcheck = false;\n      if (known(param.type)) field.placeholder = `${TYPES[param.type].min} to ${TYPES[param.type].max}`;\n      label.append(field);\n      form.append(label);\n      return field;\n    });\n    const call = el('button', 'allen-tool', 'Call');\n    call.type = 'submit';\n    const result = el('output', 'allen-result');\n    form.append(call, result);\n    if (!exported.has(name) || !params.every(p => known(p.type)) || !(ret === 'void' || known(ret))) {\n      call.disabled = true;\n      setText(result, 'This function uses a type this page cannot call.');\n    }\n    form.addEventListener('submit', async event => {\n      event.preventDefault();\n      const args = [];\n      for (let i = 0; i < params.length; i += 1) {\n        try {\n          args.push(argument(params[i].type, fields[i].value));\n        } catch (error) {\n          setText(result, `${params[i].name} ${error.message}`);\n          fields[i].focus();\n          return;\n        }\n      }\n      call.disabled = true;\n      setText(result, 'running');\n      const answer = await machine.run(name, args);\n      call.disabled = false;\n      if (answer.ok) setText(result, `= ${shown(ret, answer.value)}`);\n      else if (answer.timeout) setText(result, `stopped: no answer within ${CALL_MS / 1000} s, so the runner was reset`);\n      else if (answer.trap) setText(result, `trapped: ${answer.message}`);\n      else setText(result, `error: ${answer.message}`);\n    });\n    return form;\n  }\n"

note JavaScript omegaReady
text js23 "  async function omegaReady(reply, out) {\n    const bytes = Uint8Array.from(atob(reply.wasm), c => c.charCodeAt(0));\n    const module = await WebAssembly.compile(bytes);\n    const exported = new Set(WebAssembly.Module.exports(module).filter(item => item.kind === 'function').map(item => item.name));\n    const machine = runner(module);\n    const panel = el('div', 'allen-wasm');\n    const pin = typeof reply.omc_sha256 === 'string' ? reply.omc_sha256.slice(0, 12) : '?';\n    panel.append(el('p', 'allen-note', `Omega compiled to WebAssembly by the pinned seeded compiler on the Spark, running in your browser. Compiled in ${count(reply.compile_ms)} ms to ${bytes.length} bytes of wasm with no imports (omc ${pin}).`));\n    const list = Array.isArray(reply.functions) ? reply.functions : [];\n    for (const fn of list) panel.append(fnForm(fn, exported, machine));\n    if (!list.length) panel.append(el('p', 'allen-note', 'This unit exports no functions.'));\n    out.replaceChildren(panel);\n  }\n"

note JavaScript omegaFailed
text js24 "  function omegaFailed(source, reply, out) {\n    const where = reply.stage === 'irwasm' ? 'The WebAssembly translator refused it' : reply.stage === 'limit' ? 'It is over a size limit' : 'The Omega compiler refused it';\n    const message = typeof reply.message === 'string' ? reply.message.slice(0, 500) : 'no message';\n    const hint = typeof reply.hint === 'string' ? reply.hint.slice(0, 500) : '';\n    const box = el('div', 'allen-fail');\n    box.append(el('p', 'allen-err', `${where}: ${message}`));\n    if (hint) box.append(el('p', 'allen-note', hint));\n    box.append(button('Ask Allen to fix it', () => fixRequest(source, message, hint)));\n    out.replaceChildren(box);\n  }\n"

note JavaScript fixRequest
text js25 "  function fixRequest(source, message, hint) {\n    const head = `This Omega did not compile. The gateway said: ${message}${hint ? `\\nHint: ${hint}` : ''}\\nPlease fix it and show the whole corrected unit.\\n\\n\\`\\`\\`omega\\n`;\n    const room = LIMIT.each - head.length - 4;\n    const body = source.length > room ? `${cut(source, Math.max(0, room - 20))}\\n(source cut to fit)` : source;\n    ask(`${head}${body}\\n\\`\\`\\``);\n  }\n"

note JavaScript compileOmega
text js26 "  async function compileOmega(source, out, trigger) {\n    if (new TextEncoder().encode(source).length > LIMIT.source) {\n      out.replaceChildren(el('p', 'allen-err', `This source is over the ${LIMIT.source} byte limit for compiling.`));\n      return;\n    }\n    trigger.disabled = true;\n    out.replaceChildren(el('p', 'allen-note', 'Compiling on the Spark.'));\n    try {\n      const response = await fetch(OMEGA, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ source }), cache: 'no-store', credentials: 'omit' });\n      const reply = await response.json().catch(() => null);\n      if (!response.ok || !reply || typeof reply !== 'object') {\n        const wait = retryAfter(response, reply);\n        out.replaceChildren(el('p', 'allen-err', `${refusal(response.status, reply)}${wait ? ` Try again in ${wait} s.` : ''}`));\n      } else if (reply.ok === true && typeof reply.wasm === 'string') {\n        await omegaReady(reply, out);\n      } else {\n        omegaFailed(source, reply, out);\n      }\n    } catch (error) {\n      out.replaceChildren(el('p', 'allen-err', `Could not compile and load it: ${error.message}`));\n    } finally {\n      trigger.disabled = false;\n    }\n  }\n"

note JavaScript message
text js27 "  function message(role, label) {\n    const item = el('li', `allen-msg allen-msg-${role}`);\n    item.append(el('p', 'allen-who', label));\n    const body = el('div', 'allen-body');\n    item.append(body);\n    log.append(item);\n    return { item, body };\n  }\n"

note JavaScript speedReset
text js28 "  function speedReset() {\n    for (const key of ['queue', 'ttft', 'first', 'rate', 'tokens', 'server']) setText(speed[key], '-');\n  }\n"

note JavaScript busy
text js29 "  function busy(on) {\n    sendButton.disabled = on;\n    stopButton.disabled = !on;\n    root.dataset.busy = String(on);\n    for (const example of examples.querySelectorAll('button')) example.disabled = on;\n  }\n"

note JavaScript onEvent
text js30 "  /* One server event. Times are this page's own clock: queue wait runs from\n     Send to the start event, model time to first token from the start event to\n     the first non-empty token, and the rate counts tokens after the first. */\n  function onEvent(name, data, clock, render) {\n    let value;\n    try {\n      value = JSON.parse(data);\n    } catch (_) {\n      return;\n    }\n    const now = performance.now();\n    if (name === 'message') {\n      if (typeof value !== 'string') return;\n      clock.tokens += 1;\n      if (Number.isNaN(clock.first)) {\n        if (value) {\n          clock.first = now;\n          setText(speed.ttft, ms(now - clock.start));\n          setText(speed.first, ms(now - clock.sent));\n          notice('Allen is answering.');\n        }\n      } else {\n        clock.after += 1;\n        clock.last = now;\n        const span = clock.last - clock.first;\n        if (span > 0) setText(speed.rate, (clock.after * 1000 / span).toFixed(1));\n      }\n      setText(speed.tokens, String(clock.tokens));\n      if (value) render.push(value);\n    } else if (name === 'queue' && value && Number.isSafeInteger(value.position)) {\n      setText(speed.queue, `waiting, ${value.position} ahead`);\n      notice(`In line: ${value.position} ${value.position === 1 ? 'request' : 'requests'} ahead of you.`);\n    } else if (name === 'start' && value) {\n      clock.start = now;\n      setText(speed.queue, `${ms(now - clock.sent)} (server ${count(value.queued_ms)} ms)`);\n      if (typeof value.model === 'string' && value.model.length <= 80) setText(speed.model, value.model);\n      notice('The model has your message.');\n    } else if (name === 'done' && value) {\n      clock.finished = true;\n      setText(speed.server, `prompt ${count(value.prompt_tokens)}, completion ${count(value.completion_tokens)} tokens; first token ${count(value.upstream_ttft_ms)} ms, whole reply ${count(value.upstream_ms)} ms`);\n      if (value.finish === 'length') clock.outcome = 'The reply reached its length limit and was cut off.';\n    } else if (name === 'error' && value) {\n      clock.finished = true;\n      const said = typeof value.message === 'string' ? value.message.slice(0, 300) : 'no message';\n      clock.outcome = value.code === 'busy' ? `Allen is busy: ${said}` : value.code === 'timeout' ? `The model took too long: ${said}` : `The model stopped with an error: ${said}`;\n    }\n  }\n"

note JavaScript stream
text js31 "  async function stream(body, clock, render) {\n    const reader = body.getReader();\n    const decoder = new TextDecoder();\n    const parser = sse((name, data) => onEvent(name, data, clock, render));\n    for (;;) {\n      const { value, done } = await reader.read();\n      if (done) break;\n      parser.feed(decoder.decode(value, { stream: true }));\n    }\n    parser.feed(decoder.decode());\n    parser.end();\n    if (!clock.finished && !clock.outcome) clock.outcome = 'The connection closed before Allen finished.';\n  }\n"

note JavaScript ask
text js32 "  async function ask(raw) {\n    const text = cut(String(raw).trim(), LIMIT.each);\n    if (!text) return;\n    if (active) {\n      notice('Allen is still answering. Stop that reply first, or wait for it.');\n      return;\n    }\n    const mine = epoch;\n    const controller = new AbortController();\n    active = controller;\n    busy(true);\n    speedReset();\n    turns.push({ role: 'user', content: text });\n    message('user', 'You').body.append(el('p', 'allen-p', text));\n    const reply = message('allen', 'Allen');\n    reply.item.setAttribute('aria-busy', 'true');\n    const render = renderer(reply.body);\n    const clock = { sent: performance.now(), start: NaN, first: NaN, last: NaN, tokens: 0, after: 0, finished: false, outcome: '' };\n    let wait = 0;\n    notice('Sending.');\n    try {\n      const response = await fetch(CHAT, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream' }, body: JSON.stringify({ messages: fit(turns) }), cache: 'no-store', credentials: 'omit', signal: controller.signal });\n      if (!response.ok) {\n        const body = await response.json().catch(() => null);\n        wait = retryAfter(response, body);\n        clock.outcome = refusal(response.status, body);\n      } else if (!response.body || !(response.headers.get('content-type') || '').includes('text/event-stream')) {\n        clock.outcome = 'Allen answered in a form this page does not read.';\n      } else {\n        await stream(response.body, clock, render);\n      }\n    } catch (error) {\n      clock.outcome = controller.signal.aborted ? 'Stopped.' : 'Could not reach Allen. Check your connection and try again.';\n    }\n    const said = render.finish();\n    reply.item.removeAttribute('aria-busy');\n    if (active === controller) active = null;\n    busy(false);\n    if (mine !== epoch) return;\n    if (said) {\n      turns.push({ role: 'assistant', content: said });\n    } else {\n      turns.pop();\n      if (!input.value) input.value = text;\n    }\n    if (clock.outcome) reply.item.append(el('p', 'allen-err', clock.outcome));\n    notice(clock.outcome && !said ? clock.outcome : '', wait);\n  }\n"

note JavaScript bind
text js33 "  form.addEventListener('submit', event => {\n    event.preventDefault();\n    if (active) {\n      notice('Allen is still answering. Stop that reply first, or wait for it.');\n      return;\n    }\n    const text = input.value;\n    if (!text.trim()) return;\n    input.value = '';\n    ask(text);\n  });\n  input.addEventListener('keydown', event => {\n    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {\n      event.preventDefault();\n      form.requestSubmit();\n    }\n  });\n  stopButton.addEventListener('click', () => {\n    if (active) active.abort();\n  });\n  newButton.addEventListener('click', () => {\n    epoch += 1;\n    if (active) active.abort();\n    turns.length = 0;\n    for (const machine of runners) machine.stop();\n    runners.clear();\n    log.replaceChildren();\n    speedReset();\n    notice('New conversation. Nothing from the last one was kept.');\n    input.focus();\n  });\n  for (const example of examples.querySelectorAll('button')) {\n    example.addEventListener('click', () => ask(example.textContent));\n  }\n  root.dataset.ready = 'true';\n})();\n"

