note Allen install offer generator: public/js/allen-install.js on fd 1 and
note public/assets/allen-install.css on fd 3. The browser behaviour is authored
note here as the emitted texts; check.sh only compares and publishes them.
note Offer rules: shown only after a visitor-started exchange ends with a reply
note that has text and no outcome; never on load, the greeting or a silent send.
note beforeinstallprompt is captured and prompt() runs only inside the tap on
note the offer. One localStorage key, allen-install, holds dismissed, accepted,
note guided or installed; storage failures fall back to page memory and never
note throw. iOS Safari gets a two-step Share then Add to Home Screen guide with
note local SVG icons. Installed success is said only on appinstalled.
note The card is offered to the page through the cancelable document event
note allen-pane-request (detail id title node focus, host sets detail.handle);
note unhandled, it is placed inline beside the latest reply.
note Source language checked at omega-mv 55f9b0af47de70a3d06357985cf99ae3e45c016f.
text js1 "/* Generated from om/allen-install/install.om; never hand-edit.\n *\n * The offer to put Allen on the home screen. It appears only after the first\n * exchange the visitor started that ended with a real reply, never on load or\n * on the greeting. The browser install prompt opens only inside the visitor's\n * tap on the offer. One local preference (dismissed, accepted, guided or\n * installed) stops further offers; nothing else is stored and nothing is sent.\n * Success is reported only when the browser fires appinstalled.\n */\n(() => {\n'use strict';\nif (window.AllenInstall) return;\nconst KEY = 'allen-install';\nconst TITLE = 'Put me on your home screen';\nconst SVG = 'http://www.w3.org/2000/svg';\nlet deferred = null, earned = false, asked = false, open = null, memo = '', connected = false;\nfunction remembered() {\n if (memo) return memo;\n try { return window.localStorage.getItem(KEY) || ''; } catch (_) { return ''; }\n}\nfunction remember(value) {\n memo = value;\n try { window.localStorage.setItem(KEY, value); } catch (_) {}\n}\nfunction installed() {\n try { if (window.navigator.standalone === true) return true; } catch (_) {}\n try {\n  for (const mode of ['standalone', 'minimal-ui', 'fullscreen', 'window-controls-overlay']) if (window.matchMedia(`(display-mode: ${mode})`).matches) return true;\n } catch (_) {}\n return false;\n}\nfunction appleSafari() {\n const ua = String(window.navigator.userAgent || '');\n const apple = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && window.navigator.maxTouchPoints > 1);\n return apple && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS|GSA|FBAN|FBAV|Instagram/.test(ua);\n}\nfunction el(tag, cls, text) {\n const node = document.createElement(tag);\n if (cls) node.className = cls;\n if (text) node.textContent = text;\n return node;\n}\n"
text js2 "function button(cls, text, fn) {\n const node = el('button', cls, text);\n node.type = 'button';\n node.addEventListener('click', fn);\n return node;\n}\nfunction icon(label, lines) {\n const svg = document.createElementNS(SVG, 'svg');\n svg.setAttribute('viewBox', '0 0 24 24');\n svg.setAttribute('width', '28');\n svg.setAttribute('height', '28');\n svg.setAttribute('class', 'allen-install-icon');\n if (label) {\n  svg.setAttribute('role', 'img');\n  svg.setAttribute('aria-label', label);\n } else svg.setAttribute('aria-hidden', 'true');\n for (const d of lines) {\n  const path = document.createElementNS(SVG, 'path');\n  path.setAttribute('d', d);\n  svg.appendChild(path);\n }\n return svg;\n}\nfunction step(svg, before, strong, after) {\n const item = el('li', 'allen-install-step');\n const words = el('span', 'allen-install-words');\n words.append(before, el('strong', '', strong), after);\n item.append(svg, words);\n return item;\n}\nfunction guide() {\n const list = el('ol', 'allen-install-steps');\n list.setAttribute('role', 'list');\n list.append(\n  step(icon('Share icon: a square with an arrow pointing up', ['M8 10H6v10h12V10h-2', 'M12 15V3', 'M8 7l4-4 4 4']), 'In Safari, tap ', 'Share', '. If you do not see it, tap the three dots first.'),\n  step(icon('Add to Home Screen icon: a square with a plus', ['M7 4h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3z', 'M12 8v8', 'M8 12h8']), 'Choose ', 'Add to Home Screen', ', then tap Add.')\n );\n return list;\n}\nfunction offer() {\n if (open || !earned || remembered() || installed()) return;\n if (!deferred && !appleSafari()) return;\n const box = el('div', 'allen-install');\n const lede = el('p', 'allen-install-lede', 'Keep me one tap away. Your browser adds me to your home screen, and you can remove me the way you remove any app.');\n"
text js3 " const state = el('p', 'allen-install-state');\n state.setAttribute('role', 'status');\n const actions = el('div', 'allen-install-actions');\n const card = { box, state, actions, buttons: [], handle: null, inline: null, watch: null, closing: false };\n open = card;\n card.buttons.push(button('allen-pane-act allen-pane-run allen-install-yes', TITLE, () => accept(card)), button('allen-pane-act allen-install-no', 'No thanks', () => dismiss(card)));\n actions.append(...card.buttons);\n box.append(lede, actions, state);\n place(card);\n}\nfunction dismiss(card) {\n if (!remembered()) remember('dismissed');\n shut(card);\n}\nfunction finish(card, text) {\n card.state.textContent = text;\n card.actions.replaceChildren(button('allen-pane-act allen-install-done', 'Close', () => shut(card)));\n}\nfunction accept(card) {\n const event = deferred;\n if (event) {\n  deferred = null;\n  for (const b of card.buttons) b.disabled = true;\n  let asking;\n  try { asking = Promise.resolve(event.prompt()); } catch (_) { asking = Promise.reject(new Error('prompt')); }\n  asking.then(() => event.userChoice).then(choice => {\n   if (remembered() === 'installed') return;\n   if (choice && choice.outcome === 'accepted') {\n    remember('accepted');\n    finish(card, 'Your browser is adding me. I will say so here when it confirms.');\n   } else {\n    remember('dismissed');\n    finish(card, 'No problem. I will not ask again on this device.');\n   }\n  }, () => finish(card, 'Your browser did not open its install prompt, so nothing changed.'));\n  return;\n }\n if (appleSafari()) {\n  card.box.insertBefore(guide(), card.actions);\n  remember('guided');\n  finish(card, 'I cannot see your home screen from here, so I will not offer this again on this device.');\n }\n}\nfunction shut(card) {\n if (card.closing) return;\n card.closing = true;\n"
text js4 " if (card.watch) card.watch.disconnect();\n if (open === card) open = null;\n if (card.handle && typeof card.handle.close === 'function') card.handle.close();\n if (card.inline) card.inline.remove();\n else card.box.remove();\n}\nfunction place(card) {\n const detail = { id: 'install', title: TITLE, node: card.box, focus: false, handle: null };\n const request = new CustomEvent('allen-pane-request', { cancelable: true, detail });\n if (!document.dispatchEvent(request) && detail.handle && detail.handle.ok) card.handle = detail.handle;\n else {\n  const aside = el('aside', 'allen-install-inline');\n  aside.setAttribute('aria-label', TITLE);\n  const head = el('div', 'allen-install-head');\n  const close = button('allen-install-close', '', () => dismiss(card));\n  close.setAttribute('aria-label', 'Close, and do not offer this again');\n  close.appendChild(icon('', ['M6 6l12 12', 'M18 6L6 18']));\n  head.append(el('p', 'allen-install-title', TITLE), close);\n  aside.append(head, card.box);\n  const answer = document.getElementById('allen-answer');\n  const spot = document.getElementById('allen-install-slot') || (answer && answer.parentNode) || document.getElementById('allen') || document.body;\n  spot.appendChild(aside);\n  card.inline = aside;\n }\n if (typeof MutationObserver === 'function') {\n  card.watch = new MutationObserver(() => {\n   if (!card.box.isConnected && !card.closing) dismiss(card);\n  });\n  card.watch.observe(document.documentElement, { childList: true, subtree: true });\n }\n}\nfunction connect() {\n const api = window.allen;\n if (connected || !api || typeof api.on !== 'function') return;\n connected = true;\n api.on('send', event => { asked = !event.silent; });\n api.on('reply', event => {\n"
text js5 "  const good = asked && !event.outcome && typeof event.text === 'string' && event.text.trim() !== '';\n  asked = false;\n  if (!good) return;\n  earned = true;\n  offer();\n });\n}\nwindow.addEventListener('beforeinstallprompt', event => {\n event.preventDefault();\n deferred = event;\n offer();\n});\nwindow.addEventListener('appinstalled', () => {\n deferred = null;\n remember('installed');\n if (open) finish(open, 'Your browser says I am installed. Open me from your home screen or app list.');\n});\ndocument.addEventListener('allen-ready', connect);\nconnect();\nwindow.AllenInstall = Object.freeze({ version: 1 });\n})();\n"
text css1 "/* Generated from om/allen-install/install.om; never hand-edit. */\n.allen-install { display: grid; gap: 10px; font-size: 13px; line-height: 1.55; color: var(--text-secondary); text-align: left; }\n.allen-install-lede { margin: 0; }\n.allen-install-actions { display: flex; flex-wrap: wrap; gap: 8px; }\n.allen-install-state { margin: 0; min-height: 1.55em; color: var(--text-primary); }\n.allen-install-state:empty { min-height: 0; }\n.allen-install-steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }\n.allen-install-step { display: grid; grid-template-columns: 44px 1fr; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--border-subtle); border-radius: 14px; background: color-mix(in srgb, var(--bg-card) 72%, transparent); }\n.allen-install-icon { width: 28px; height: 28px; justify-self: center; fill: none; stroke: var(--text-primary); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }\n.allen-install-step .allen-install-icon { width: 44px; height: 44px; padding: 8px; border-radius: 12px; background: color-mix(in srgb, var(--bg-surface) 80%, transparent); border: 1px solid var(--border-subtle); }\n.allen-install-words strong { color: var(--text-primary); font-weight: 500; }\n.allen-install-inline { pointer-events: auto; margin: 12px auto 0; width: min(420px, 100%); padding: 14px 16px; border: 1px solid var(--border-subtle); border-radius: 18px; background: color-mix(in srgb, var(--bg-surface) 82%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 12px 40px color-mix(in srgb, var(--bg-base) 60%, transparent); animation: allen-install-in 360ms ease-out both; }\n"
text css2 ".allen-install-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }\n.allen-install-title { margin: 0; font-size: 14px; color: var(--text-primary); }\n.allen-install-close { display: inline-grid; place-items: center; width: 32px; height: 32px; padding: 0; border-radius: 999px; border: 1px solid var(--border-subtle); background: transparent; color: var(--text-secondary); cursor: pointer; }\n.allen-install-close:hover { background: var(--bg-card-hover); color: var(--text-primary); }\n.allen-install-close .allen-install-icon { width: 16px; height: 16px; stroke: currentColor; }\n.allen-install button:focus-visible, .allen-install-close:focus-visible { outline: 2px solid var(--accent-green); outline-offset: 2px; }\n@keyframes allen-install-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n@media (prefers-reduced-motion: reduce) { .allen-install-inline { animation: none; } }\n@media (max-width: 720px) { .allen-install-inline { width: 100%; } .allen-install-actions button { min-height: 44px; } }\n"
fn main to int
w = write 1 js1 0 len js1
if ne w long len js1
ret 1
end
w = write 1 js2 0 len js2
if ne w long len js2
ret 1
end
w = write 1 js3 0 len js3
if ne w long len js3
ret 1
end
w = write 1 js4 0 len js4
if ne w long len js4
ret 1
end
w = write 1 js5 0 len js5
if ne w long len js5
ret 1
end
w = write 3 css1 0 len css1
if ne w long len css1
ret 1
end
w = write 3 css2 0 len css2
if ne w long len css2
ret 1
end
ret 0
end
