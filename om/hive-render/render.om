fn main to int
n = ulong 0
while lt n len inp
r = read 0 inp n sub len inp n
if lt r 0
ret 1
end
if eq r 0
break
end
n = add n ulong r
end
if eq n len inp
r = read 0 dec 0 1
if ne r 0
ret 2
end
end
put st 1 n
parse
graph
msgids
render
n = get st 5
p = ulong 0
while lt p n
k = sub n p
if lt p len out
if gt k sub len out p
k = sub len out p
end
r = write 1 out p k
if le r 0
ret 3
end
p = add p ulong r
else
r = write 1 out2 sub p len out k
if le r 0
ret 3
end
p = add p ulong r
end
end
ret 0
end
