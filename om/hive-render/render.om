fn uintval to ulong
v = ulong 0
n = ulong 0
while and ge peek 48 le peek 57 bound 9
v = add mul v 10 ulong sub peek 48
put st 0 add get st 0 1
n = add n 1
end
if eq n 0
trap 8
end
ret v
end
fn boolval to void
if eq peek 116
take 116
