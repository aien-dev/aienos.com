if eq need 0
if or lt cp low gt cp 1114111
trap 8
end
if and ge cp 55296 le cp 57343
trap 8
end
end
end
end
if ne need 0
trap 8
end
end
fn value a ulong kind ulong cap ulong to void
if eq peek 110
take 110
take 117
take 108
take 108
