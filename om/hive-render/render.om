end
fn decimal v ulong to void
if ge v 10
decimal div v 10
end
push uchar add rem v 10 48
end
text options "working|waiting|idle|completed|failed|unknown|running|finished|unknown|drake|assistant|"
fn optmatch a ulong p ulong n ulong to bool
if ne n get fld add a 1
ret false
end
q = get fld a
for i ulong n
x = get dec add q i
if ne x get options add p i
ret false
end
end
ret true
end
fn option a ulong p ulong n ulong to void
for j ulong n
start = p
while ne get options p 124 bound 20
p = add p 1
end
ok = optmatch a start sub p start
if ok
ret
end
p = add p 1
end
trap 8
end
