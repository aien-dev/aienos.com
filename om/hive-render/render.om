c = add mul h 16 hex
if ge c 32
trap 8
end
if lt c 32
if not or or eq c 8 eq c 9 or eq c 10 or eq c 12 eq c 13
trap 8
end
end
else
if eq c 110
c = 10
else
if eq c 114
c = 13
else
if eq c 116
c = 9
else
if eq c 98
c = 8
else
if eq c 102
c = 12
else
if not or eq c 34 eq c 92
trap 8
end
end
end
end
end
end
end
end
if eq c 0
trap 8
end
decoded c
end
put st 4 sub get st 2 get st 3
end
fn equal a ulong b ulong to bool
n = get fld add a 1
if ne n get fld add b 1
ret false
end
for i ulong n
x = get dec add get fld a i
y = get dec add get fld b i
if ne x y
ret false
end
end
ret true
end
fn ident a ulong to void
n = get fld add a 1
if or eq n 0 gt n 128
trap 8
end
for i ulong n
c = get dec add get fld a i
ok = or and ge c 48 le c 57 and ge c 65 le c 90
ok = or ok and ge c 97 le c 122
ok = or ok or eq c 45 eq c 95
if not ok
trap 8
end
end
end
fn digit a ulong i ulong to ulong
c = get dec add get fld a i
if or lt c 48 gt c 57
trap 8
end
ret ulong sub c 48
end
fn number a ulong i ulong n ulong to ulong
v = ulong 0
for j ulong n
v = add mul v 10 digit a add i j
end
ret v
end
fn leap y ulong to bool
ok = or ne rem y 100 0 eq rem y 400 0
ret and eq rem y 4 0 ok
end
fn stamp a ulong to void
n = get fld add a 1
if or lt n 20 gt n 40
trap 8
end
p = get fld a
ok = and eq get dec add p 4 45 eq get dec add p 7 45
ok = and ok eq get dec add p 10 84
ok = and ok eq get dec add p 13 58
ok = and ok eq get dec add p 16 58
if not ok
trap 8
end
if ne get dec sub add p n 1 90
trap 8
end
y = number a 0 4
m = number a 5 2
d = number a 8 2
if or eq m 0 gt m 12
trap 8
end
lim = ulong 31
if or or eq m 4 eq m 6 or eq m 9 eq m 11
lim = 30
end
if eq m 2
lim = 28
if leap y
lim = 29
end
end
if or eq d 0 gt d lim
trap 8
end
if gt number a 11 2 23
trap 8
end
if gt number a 14 2 59
trap 8
end
if gt number a 17 2 60
trap 8
end
if gt n 20
if eq n 21
trap 8
end
if ne get dec add p 19 46
trap 8
end
for i ulong sub n 21
v = digit a add i 20
end
end
end
fn utf8 p ulong n ulong to void
need = ulong 0
cp = ulong 0
low = ulong 0
for i ulong n
c = ulong get dec add p i
if eq need 0
if ge c 128
if and ge c 194 le c 223
need = 1
cp = and c 31
low = 128
else
if and ge c 224 le c 239
need = 2
cp = and c 15
low = 2048
else
if and ge c 240 le c 244
need = 3
cp = and c 7
low = 65536
else
trap 8
end
end
end
