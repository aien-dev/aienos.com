fn push c uchar to void
p = get st 5
if lt p len out
put out p c
else
put out2 sub p len out c
end
put st 5 add p 1
end
fn escape p ulong n ulong to void
for i ulong n
c = get dec add p i
if eq c 38
lit 0
else
if eq c 60
lit 1
else
if eq c 62
lit 2
else
if eq c 34
lit 3
else
if eq c 39
lit 4
else
push c
end
end
end
end
end
end
end
fn field a ulong to void
