fn graph to void
n = get st 6
roots = ulong 0
for i ulong n
a = add 64 mul i 32
p = n
if ne get fld add a 13 0
found = false
for j ulong n
b = add 64 mul j 32
if equal add a 12 add b 4
p = j
found = true
end
end
if not found
trap 8
end
else
roots = add roots 1
end
for j ulong i
if equal add a 4 add 68 mul j 32
trap 8
end
end
put par i p
end
if ne roots get st 8
trap 8
end
for i ulong n
p = i
while lt p n bound 10000
if eq get seen p 1
trap 8
end
put seen p 1
p = get par p
end
p = i
while lt p n bound 10000
put seen p 0
p = get par p
end
end
for i ulong add n 1
put first i n
end
for rev ulong n
i = sub sub n rev 1
p = get par i
put next i get first p
put first p i
end
end
fn msgids to void
for i ulong get st 7
for j ulong i
a = add 320068 mul i 16
b = add 320068 mul j 16
if equal a b
trap 8
end
end
end
end
note Gregorian ordinal and duration verified by Wolfram query recorded in DEPLOY-board.md.
fn seconds a ulong to ulong
note Shift calendar by one 400-year cycle so year 0000 has unsigned ordinals.
y = add number a 0 4 399
days = sub add add mul y 365 div y 4 div y 400 div y 100
m = number a 5 2
for i ulong sub m 1
v = ulong 31
if or or eq i 3 eq i 5 or eq i 8 eq i 10
v = 30
end
if eq i 1
v = 28
yr = add y 1
if leap yr
v = 29
end
end
days = add days v
end
days = add days number a 8 2
v = add mul days 24 number a 11 2
v = add mul v 60 number a 14 2
ret add mul v 60 number a 17 2
end
fn millis a ulong to ulong
v = mul seconds a 1000
n = get fld add a 1
f = ulong 0
for i ulong 3
f = mul f 10
if gt n add i 21
f = add f digit a add i 20
end
end
ret add v f
end
fn age a ulong to void
if eq get fld add a 1 0
lit 5
ret
end
now = millis 0
then = millis a
if gt then now
lit 6
else
decimal div sub now then 1000
lit 7
end
end
fn row i ulong to void
a = add 64 mul i 32
lit 8
field add a 4
lit 9
field add a 4
lit 10
field add a 4
lit 11
field add a 4
lit 12
field add a 8
lit 13
field add a 22
lit 14
field add a 6
lit 15
field add a 14
lit 16
age add a 20
lit 17
field a
lit 18
age add a 10
lit 19
end
fn tree to void
n = get st 6
i = get first n
while lt i n bound 10000
row i
if lt get first i n
i = get first i
else
while true bound 10001
lit 20
if lt get next i n
i = get next i
break
end
i = get par i
if eq i n
break
end
end
end
end
end
fn manifest i ulong to void
a = add 64 mul i 32
lit 21
field add a 4
lit 22
field add a 8
lit 23
lit 24
field add a 0
lit 25
lit 26
field add a 2
lit 25
lit 27
field add a 4
lit 25
lit 28
field add a 6
lit 25
lit 29
field add a 8
lit 25
lit 30
field add a 10
lit 25
lit 31
field add a 12
lit 25
lit 32
field add a 14
lit 25
lit 33
field add a 16
lit 25
lit 34
field add a 18
lit 25
lit 35
field add a 20
lit 25
lit 36
field add a 22
lit 25
lit 37
field add a 24
lit 25
lit 38
field add a 26
lit 25
lit 39
end
fn chat i ulong to void
a = add 320064 mul i 16
lit 40
field add a 4
lit 11
field a
lit 41
field add a 10
lit 42
field add a 6
lit 15
field add a 8
lit 43
field add a 2
lit 44
field add a 14
lit 45
end
fn render to void
lit 46
field 0
lit 47
field 2
lit 48
field 0
lit 49
decimal get st 6
lit 50
decimal get st 8
lit 51
field 8
lit 52
field 10
lit 53
tree
lit 54
for i ulong get st 6
manifest i
end
lit 55
for i ulong get st 7
chat i
end
lit 56
end
