fn peek to uchar
p = get st 0
if ge p get st 1
trap 8
end
ret get inp p
end
fn take c uchar to void
if ne peek c
trap 8
end
put st 0 add get st 0 1
end
fn decoded c uchar to void
p = get st 2
put dec p c
put st 2 add p 1
end
fn hex to uchar
c = peek
put st 0 add get st 0 1
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret add sub c 97 10
end
trap 8
end
fn string to void
