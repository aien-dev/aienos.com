note Browser controller for native Allen. See provenance.txt for temporary C-WASM boundary.
note Text literals are emitted verbatim; public JS is never edited.
global out uchar 16384
global used ulong 1
fn flush to void
off = ulong 0
while lt off get used 0
n = write int 1 out off sub get used 0 off
if le n 0
exit 2
end
off = add off ulong n
end
put used 0 0
end
fn byteput c uchar to void
if eq get used 0 len out
flush
end
put out get used 0 c
put used 0 add get used 0 1
end
text j0 "/* Generated from om/allen-scene/scene.om by pinned seeded Omega.\n"
text j1 " * Controller: Omega-generated JavaScript. Rendering/audio: unchanged native C,\n"
text j2 " * aien-dev/aienux@da55660ea7337f2b6a42095fcd1fb6ddebe1cc7c, compiled to WASM.\n"
text j3 " * This source pin was staged, not hardware-confirmed by the available report.\n"
text j4 " * Web opening reuses native dusk; enter('birth') is the original binary merger.\n"
text j5 " * Catalogue/licences and native dependency boundary: om/allen-scene/provenance.txt.\n"
text j6 " * WolframLanguageEvaluator: 1000/30 -> 100/3 ms;\n"
text j7 " * 48000 (12300-11360)/1000 -> 45120 frames (native chirp non-silent window).\n"
text j8 " */\n"
text j9 "(() => {\n"
text j10 "  'use strict';\n"
text j11 "  const PIN = 'da55660ea7337f2b6a42095fcd1fb6ddebe1cc7c';\n"
text j12 "  const mounted = new WeakMap();\n"
text j13 "  let compiled;\n"
text j14 "  function module() {\n"
text j15 "    if (!compiled) compiled = fetch('/allen/scene.wasm', {credentials:'omit'})\n"
text j16 "      .then(response => { if (!response.ok) throw new Error('Native scene unavailable'); return response.arrayBuffer(); })\n"
text j17 "      .then(bytes => WebAssembly.compile(bytes)).catch(error => { compiled = null; throw error; });\n"
text j18 "    return compiled;\n"
text j19 "  }\n"
text j20 "  function mount(canvas, options = {}) {\n"
text j21 "    if (!(canvas instanceof HTMLCanvasElement)) throw new TypeError('AllenScene requires a canvas');\n"
text j22 "    if (mounted.has(canvas)) return mounted.get(canvas);\n"
text j23 "    const compact = Boolean(options.compact), interactive = Boolean(options.interactive) && !compact;\n"
text j24 "    const ctx = canvas.getContext('2d', {alpha:false});\n"
text j25 "    if (!ctx) throw new Error('Canvas rendering unavailable');\n"
text j26 "    const motion = matchMedia('(prefers-reduced-motion: reduce)');\n"
text j27 "    const cleanup = [], letters = Array.from({length:64}, () => ({char:0,start:0,slot:0}));\n"
text j28 "    const wordTimes = new Float64Array(256);\n"
text j29 "    let ex, image, width = 0, height = 0, disposed = false, failed = false;\n"
text j30 "    let raf = 0, lastWall = 0, clock = 20000, kind = 0, modeValue = 0;\n"
text j31 "    let visible = true, reduced = motion.matches, dirty = true, resizePending = true;\n"
text j32 "    let letterHead = 0, wordRead = 0, wordWrite = 0, lastWord = -1000, speakUntil = 0, keyUntil = 0;\n"
text j33 "    let ra = 113697000, dec = -72757000, fov = 80000, viewPending = false;\n"
text j34 "    let dragId = null, dragX = 0, dragY = 0;\n"
text j35 "    let ownsAudio = false, completeSent = false, resolveSize, rejectSize;\n"
text j36 "    let pendingEnter = compact ? null : 1, pendingStatic = false;\n"
text j37 "    canvas.dataset.sceneSource = PIN;\n"
text j38 "    canvas.dataset.sceneEngine = 'loading';\n"
text j39 "    function listen(target, name, fn, opts) {\n"
text j40 "      target.addEventListener(name, fn, opts);\n"
text j41 "      cleanup.push(() => target.removeEventListener(name, fn, opts));\n"
text j42 "    }\n"
text j43 "    function stopAudio() {\n"
text j44 "      if (ownsAudio && window.AllenAudio) window.AllenAudio.stop();\n"
text j45 "      ownsAudio=false;\n"
text j46 "    }\n"
text j47 "    function awake() { return !disposed && !failed && !document.hidden && visible; }\n"
text j48 "    function request() {\n"
text j49 "      if (!raf && ex && awake() && (!(reduced || compact) || dirty)) raf = requestAnimationFrame(tick);\n"
text j50 "    }\n"
text j51 "    function size() {\n"
text j52 "      const box = canvas.getBoundingClientRect();\n"
text j53 "      if (box.width <= 0 || box.height <= 0) return false;\n"
text j54 "      // Policy bound, not a physical-resolution claim. Same aspect ratio, native design scaling.\n"
text j55 "      const scale = Math.min(devicePixelRatio || 1, 1280 / Math.max(box.width,box.height));\n"
text j56 "      const w = Math.max(64,Math.round(box.width*scale)), h = Math.max(64,Math.round(box.height*scale));\n"
text j57 "      resizePending = false;\n"
text j58 "      if (w === width && h === height) return true;\n"
text j59 "      width=w; height=h; canvas.width=w; canvas.height=h;\n"
text j60 "      if (!ex.scene_init(w,h,compact?1:0)) throw new Error('Native scene size refused');\n"
text j61 "      image = new ImageData(new Uint8ClampedArray(ex.memory.buffer,ex.scene_pixels(),w*h*4),w,h);\n"
text j62 "      ex.scene_enter(kind);\n"
text j63 "      // Resize keeps phase and mode but does not manufacture the old frame history.\n"
text j64 "      ex.scene_step(Math.floor(clock),modeValue,0);\n"
text j65 "      viewPending=true;\n      if(resolveSize) {resolveSize();resolveSize=null;rejectSize=null;}\n"
text j66 "      return true;\n"
text j67 "    }\n"
text j68 "    function reset(kindValue) {\n"
text j69 "      kind=kindValue; clock=kind===0?20000:0; lastWall=0;completeSent=false;\n"
text j70 "      wordRead=wordWrite=0; lastWord=-1000; speakUntil=keyUntil=0; modeValue=0;\n"
text j71 "      for (const letter of letters) letter.char=0;\n"
text j72 "      stopAudio();\n"
text j73 "      if (ex && width) ex.scene_enter(kind);\n"
text j74 "      dirty=true; request();\n"
text j75 "    }\n"
text j76 "    function render() {\n"
text j77 "      if (!ex || !awake()) return;\n"
text j78 "      if (resizePending && !size()) return;\n"
text j79 "      if (!image) return;\n"
text j80 "      if (viewPending && !(kind===1 && clock<4200)) {\n"
text j81 "        if (!ex.scene_view(Math.round(ra),Math.round(dec),Math.round(fov))) throw new Error('Native sky view refused');\n"
text j82 "        viewPending=false;\n"
text j83 "      }\n"
text j84 "      const time=Math.floor(clock);\n"
text j85 "      while(wordRead!==wordWrite && wordTimes[wordRead]<=clock) {\n"
text j86 "        lastWord=wordTimes[wordRead];ex.scene_word(Math.floor(lastWord));wordRead=(wordRead+1)%wordTimes.length;\n"
text j87 "      }\n"
text j88 "      let currentMode=modeValue;\n"
text j89 "      if(clock<speakUntil) currentMode=3;\n"
text j90 "      else if(currentMode===3) currentMode=0;\n"
text j91 "      if(currentMode===0 && clock<keyUntil) currentMode=1;\n"
text j92 "      // Native allen_ui.c voice envelope (per-word exp decay, 200 ms).\n"
text j93 "      const voice=clock<speakUntil && lastWord>=0?ex.scene_voice(time,Math.floor(lastWord)):0;\n"
text j94 "      const shimmer=clock<speakUntil?256:0;\n"
text j95 "      ex.scene_step(time,currentMode,reduced?0:voice);\n"
text j96 "      ex.scene_draw(reduced?0:shimmer,reduced?0:voice);\n"
text j97 "      if(!reduced && !compact) for(const letter of letters) {\n"
text j98 "        if(!letter.char || clock<letter.start) continue;\n"
text j99 "        const u=Math.min(1,(clock-letter.start)/900);\n"
text j100 "        if(u>=1) {letter.char=0;continue;}\n"
text j101 "        // Web enhancement: native glyphs lift from input to Allen. No HTML/text injection.\n"
text j102 "        const ease=1-(1-u)*(1-u)*(1-u);\n"
text j103 "        const x=width/2+(letter.slot-4)*width/90*(1-ease);\n"
text j104 "        const y=height*(0.86+(0.4-0.86)*ease);\n"
text j105 "        ex.scene_glyph(letter.char,Math.round(x),Math.round(y),Math.round(256*(1-u)));\n"
text j106 "      }\n"
text j107 "      ctx.putImageData(image,0,0);\n"
text j108 "      canvas.dataset.scenePhase=kind===1 && clock<4200?'tube':kind===2 && clock<12300?'merger':clock<(kind===1?7200:15300)?'forming':'presence';\n"
text j109 "      canvas.dataset.sceneTime=String(time);\n"
text j110 "      canvas.dataset.sceneEngine='native-wasm';\n"
text j111 "      dirty=false;\n      if(!completeSent && (kind===0 || clock>=(kind===1?7200:15300))) {\n        completeSent=true;\n        canvas.dispatchEvent(new CustomEvent('allen-scene-complete',{bubbles:true,detail:{kind:kind===2?'birth':kind===1?'dusk':'idle',time}}));\n      }\n      return true;\n"
text j112 "    }\n"
text j113 "    function error(err) {\n"
text j114 "      failed=true;cancelAnimationFrame(raf);raf=0;stopAudio();\n      if(rejectSize) {rejectSize(err);resolveSize=null;rejectSize=null;}\n"
text j115 "      canvas.dataset.sceneEngine='unavailable';\n"
text j116 "      canvas.dispatchEvent(new CustomEvent('allen-scene-error',{bubbles:true,detail:{message:String(err.message||err)}}));\n"
text j117 "    }\n"
text j118 "    function tick(wall) {\n"
text j119 "      raf=0;\n"
text j120 "      if(!awake()) {lastWall=0;return;}\n"
text j121 "      const dt=lastWall?wall-lastWall:0;\n"
text j122 "      if(!(reduced || compact) && dt<1000/30 && !dirty) {request();return;}\n"
text j123 "      lastWall=wall;\n"
text j124 "      if(!(reduced || compact)) clock+=dt; // source clock advances; native integrators bound their own catch-up\n"
text j125 "      let drawn=false;\n      try { drawn=render(); } catch(err) { error(err); }\n"
text j126 "      if(drawn && !(reduced || compact)) request();\n"
text j127 "    }\n"
text j128 "    function motionChanged() {\n"
text j129 "      reduced=motion.matches;lastWall=0;cancelAnimationFrame(raf);raf=0;stopAudio();\n"
text j130 "      if(reduced) { reset(0); pendingStatic=true; }\n"
text j131 "      dirty=true;request();\n"
text j132 "    }\n"
text j133 "    function visibility() {\n"
text j134 "      lastWall=0;\n"
text j135 "      if(!awake()) {cancelAnimationFrame(raf);raf=0;if(ownsAudio && window.AllenAudio) window.AllenAudio.pause();}\n"
text j136 "      else {if(ownsAudio && !reduced && window.AllenAudio) void window.AllenAudio.resume();dirty=true;request();}\n"
text j137 "    }\n"
text j138 "    function changeView(dx,dy,zoom) {\n"
text j139 "      if(!interactive || kind===1 && clock<4200) return;\n"
text j140 "      ra=((ra+dx)%360000000+360000000)%360000000;\n"
text j141 "      dec=Math.max(-89000000,Math.min(89000000,dec+dy));\n"
text j142 "      fov=Math.max(10000,Math.min(120000,fov*zoom));\n"
text j143 "      viewPending=dirty=true;request();\n"
text j144 "    }\n"
text j145 "    function home() {ra=113697000;dec=-72757000;fov=80000;viewPending=dirty=true;request();}\n"
text j146 "    const api = {\n"
text j147 "      key(text) {\n"
text j148 "        if(disposed) return;\n"
text j149 "        text=String(text).slice(-64);keyUntil=clock+4000;\n"
text j150 "        if(ex) ex.scene_key(Math.floor(clock));\n"
text j151 "        if(!reduced && !compact) for(let i=0;i<text.length;i++) {\n"
text j152 "          const c=text.charCodeAt(i);if(c<32 || c>126) continue;\n"
text j153 "          const letter=letters[letterHead];letterHead=(letterHead+1)%letters.length;\n"
text j154 "          letter.char=c;letter.start=clock+i*35;letter.slot=i%9;\n"
text j155 "        }\n"
text j156 "        dirty=true;request();\n"
text j157 "      },\n"
text j158 "      speak(text) {\n"
text j159 "        if(disposed) return;\n"
text j160 "        text=String(text).slice(0,4096);\n"
text j161 "        let offset=0;const start=Math.max(clock,speakUntil-300);\n"
text j162 "        for(let i=0;i<text.length;i++) {\n"
text j163 "          if(!/\\s/.test(text[i]) && (i===0 || /\\s/.test(text[i-1]))) {\n"
text j164 "            const next=(wordWrite+1)%wordTimes.length;\n"
text j165 "            if(next===wordRead) break;\n"
text j166 "            wordTimes[wordWrite]=start+offset;wordWrite=next;\n"
text j167 "          }\n"
text j168 "          offset+=35;\n"
text j169 "        }\n"
text j170 "        speakUntil=Math.min(clock+30000,start+offset+300);dirty=true;request();\n"
text j171 "      },\n"
text j172 "      mode(name) {\n"
text j173 "        const modes={idle:0,listening:1,listen:1,thinking:2,think:2,speaking:3,speak:3};\n"
text j174 "        if(Object.prototype.hasOwnProperty.call(modes,name)) {modeValue=modes[name];dirty=true;request();}\n"
text j175 "      },\n"
text j176 "      enter(name='dusk') {\n"
text j177 "        if(disposed) return;\n"
text j178 "        const next=compact || reduced?0:(name==='birth' || name==='boot' || name==='night')?2:1;\n"
text j179 "        if(next===2) ownsAudio=false; // caller starts audio in this same gesture before entering\n        pendingEnter=next;reset(next);\n"
text j180 "        if(next===2 && window.AllenAudio) {\n"
text j181 "          ownsAudio=true;\n"
text j182 "          // AudioPort is invoked by the caller's gesture; this instance only owns its pause/stop lifecycle.\n"
text j183 "        }\n"
text j184 "        if(ex && width) pendingEnter=null;\n"
text j185 "        request();\n"
text j186 "      },\n"
text j187 "      home,\n"
text j188 "      frame(ms) {\n"
text j189 "        if(!Number.isFinite(ms) || ms<0 || ms>86400000) throw new RangeError('Scene time outside one day');\n"
text j190 "        cancelAnimationFrame(raf);raf=0;lastWall=0;\n"
text j191 "        if(reduced) clock=20000;else clock=ms;\n"
text j192 "        dirty=true;\n"
text j193 "        if(ex) {try {render();} catch(err) {error(err);}}\n"
text j194 "      },\n"
text j195 "      destroy() {\n"
text j196 "        if(disposed) return;\n"
text j197 "        disposed=true;cancelAnimationFrame(raf);raf=0;stopAudio();\n        if(rejectSize) {rejectSize(new Error('Scene destroyed before initialization'));resolveSize=null;rejectSize=null;}\n"
text j198 "        for(const fn of cleanup) fn();\n"
text j199 "        mounted.delete(canvas);image=null;ex=null;\n"
text j200 "        canvas.dataset.sceneEngine='destroyed';\n"
text j201 "      }\n"
text j202 "    };\n"
text j203 "    mounted.set(canvas,api);\n"
text j204 "    listen(document,'visibilitychange',visibility);\n"
text j205 "    listen(motion,'change',motionChanged);\n"
text j206 "    if(typeof ResizeObserver==='function') {\n"
text j207 "      const resize=new ResizeObserver(() => {resizePending=dirty=true;request();});resize.observe(canvas);cleanup.push(() => resize.disconnect());\n"
text j208 "    } else listen(window,'resize',() => {resizePending=dirty=true;request();});\n"
text j209 "    if(typeof IntersectionObserver==='function') {\n"
text j210 "      const observer=new IntersectionObserver(entries => {visible=entries[0].isIntersecting;visibility();});observer.observe(canvas);cleanup.push(() => observer.disconnect());\n"
text j211 "    }\n"
text j212 "    if(interactive) {\n"
text j213 "      const oldTouch=canvas.style.touchAction;canvas.style.touchAction='none';cleanup.push(() => {canvas.style.touchAction=oldTouch;});\n"
text j214 "      listen(canvas,'pointerdown',event => {\n"
text j215 "        if(event.button!==0) return;\n"
text j216 "        dragId=event.pointerId;dragX=event.clientX;dragY=event.clientY;\n"
text j217 "        canvas.setPointerCapture(dragId);canvas.focus({preventScroll:true});\n"
text j218 "      });\n"
text j219 "      listen(canvas,'pointermove',event => {\n"
text j220 "        if(event.pointerId!==dragId) return;\n"
text j221 "        const box=canvas.getBoundingClientRect();\n"
text j222 "        changeView(-(event.clientX-dragX)*fov*1000/Math.max(1,box.width),(event.clientY-dragY)*fov*1000/Math.max(1,box.width),1);\n"
text j223 "        dragX=event.clientX;dragY=event.clientY;\n"
text j224 "      });\n"
text j225 "      const release=event => {if(event.pointerId===dragId) {if(canvas.hasPointerCapture(dragId)) canvas.releasePointerCapture(dragId);dragId=null;}};\n"
text j226 "      listen(canvas,'pointerup',release);listen(canvas,'pointercancel',release);listen(canvas,'lostpointercapture',() => {dragId=null;});\n"
text j227 "      listen(canvas,'wheel',event => {event.preventDefault();changeView(0,0,Math.pow(2,Math.max(-600,Math.min(600,event.deltaY))/600));},{passive:false});\n"
text j228 "      listen(canvas,'keydown',event => {\n"
text j229 "        const step=fov*1000/20;\n"
text j230 "        switch(event.key) {\n"
text j231 "          case 'ArrowLeft':changeView(-step,0,1);break;\n"
text j232 "          case 'ArrowRight':changeView(step,0,1);break;\n"
text j233 "          case 'ArrowUp':changeView(0,step,1);break;\n"
text j234 "          case 'ArrowDown':changeView(0,-step,1);break;\n"
text j235 "          case '+':case '=':changeView(0,0,1/1.1);break;\n"
text j236 "          case '-':changeView(0,0,1.1);break;\n"
text j237 "          case 'Home':home();break;\n"
text j238 "          default:return;\n"
text j239 "        }\n"
text j240 "        event.preventDefault();\n"
text j241 "      });\n"
text j242 "    }\n"
text j243 "    api.ready=module().then(module => WebAssembly.instantiate(module,{})).then(async instance => {\n"
text j244 "      if(disposed) return api;\n"
text j245 "      ex=instance.exports;\n"
text j246 "      const initial=reduced?0:pendingEnter===null?0:pendingEnter;\n"
text j247 "      // Preserve an audio gesture made before compilation completes.\n"
text j248 "      const audioOwner=ownsAudio;ownsAudio=false;reset(initial);ownsAudio=audioOwner;\n"
text j249 "      pendingEnter=null;\n"
text j250 "      if(!size()) await new Promise((resolve,reject) => {resolveSize=resolve;rejectSize=reject;});\n      if(disposed) return api;\n"
text j251 "      if(reduced || pendingStatic) {clock=20000;ex.scene_step(20000,0,0);pendingStatic=false;}\n"
text j252 "      render();request();\n      canvas.dispatchEvent(new CustomEvent('allen-scene-initialized',{bubbles:true,detail:{source:PIN}}));\n"
text j253 "      return api;\n"
text j254 "    }).catch(err => {if(!disposed) error(err);throw err;});\n"
text j255 "    // Expose the rejection to callers while avoiding an unhandled rejection for decorative mounts.\n"
text j256 "    api.ready.catch(() => {});\n"
text j257 "    return api;\n"
text j258 "  }\n"
text j259 "  window.AllenScene=Object.freeze({mount,source:PIN});\n"
text j260 "  document.dispatchEvent(new CustomEvent('allen-scene-ready'));\n"
text j261 "})();\n"
