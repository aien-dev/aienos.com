note Edge-board client. The Omega renderer owns every feed text node and row.
note Browser state only: fetch/freshness, keyed morph, native details, search and selection.
text client "/* Generated by om/hive-page/hive-js.om. Never edit this artifact.\n * Only same-origin edge-rendered HTML enters DOMParser; never render JSON here. */\n(() => {\n  'use strict';\n  const page = document.getElementById('~9~');\n  if (!page) return;\n  const get = id => document.getElementById(id);\n  const tree = get('~20~'), chat = get('~36~'), search = get('~17~');\n  const store = get('~64~'), panel = get('~23~');\n  let selected = new URLSearchParams(location.hash.slice(1)).get('agent');\n  let scope = 'all', query = '', board = null, connected = false, regressed = false;\n  let advancedAt = 0, sourceAge = 0, trusted = false, active = false;\n  let searchOpen = null;\n  const say = (id, value) => { const node = get(id); if (node && node.textContent !== value) node.textContent = value; };\n\n  // Patch in place. Id-keyed nodes survive reordering; unkeyed structure is paired\n  // positionally. A stack avoids recursion through deeply nested mission trees.\n  function morph(target, source) {\n    const work = [[target, source]];\n    while (work.length) {\n      const [old, fresh] = work.pop();\n      if (old.isEqualNode(fresh)) continue;\n      if (old.nodeType !== fresh.nodeType || old.nodeName !== fresh.nodeName) { old.replaceWith(fresh.cloneNode(true)); continue; }\n      if (old.nodeType !== Node.ELEMENT_NODE) { old.nodeValue = fresh.nodeValue; continue; }\n      const preserve = name => (old.tagName === 'DETAILS' && name === 'open') || name === 'hidden' || name === 'data-selected';\n      for (const attr of [...old.attributes]) if (!preserve(attr.name) && !fresh.hasAttribute(attr.name)) old.removeAttribute(attr.name);\n      for (const attr of fresh.attributes) if (!preserve(attr.name) && old.getAttribute(attr.name) !== attr.value) old.setAttribute(attr.name, attr.value);\n      const keyed = new Map([...old.childNodes].filter(node => node.id).map(node => [node.id, node]));\n      const wanted = new Set();\n      let at = old.firstChild;\n      for (const child of fresh.childNodes) {\n        let node = child.id ? keyed.get(child.id) : at && !at.id && at.nodeName === child.nodeName ? at : null;\n        if (!node) node = child.cloneNode(true);\n        if (node !== at) old.insertBefore(node, at);\n        wanted.add(node);\n        work.push([node, child]);\n        at = node.nextSibling;\n      }\n      for (const child of [...old.childNodes]) if (!wanted.has(child)) child.remove();\n    }\n  }\n\n  function filters() {\n    const visible = new Set();\n    let hits = 0;\n    for (const row of tree.querySelectorAll('.hive-node')) {\n      const id = row.id.slice(5), card = get('manifest-' + id);\n      const matches = !query || (row.querySelector('summary')?.textContent + ' ' + card?.textContent).toLowerCase().includes(query);\n      if (matches) {\n        hits += 1;\n        for (let up = row; up && up !== tree; up = up.parentElement) {\n          if (up.matches('.hive-node')) visible.add(up);\n          if (query && up.tagName === 'DETAILS') up.open = true;\n        }\n      }\n    }\n    for (const row of tree.querySelectorAll('.hive-node')) row.hidden = !visible.has(row);\n    say('~18~', query ? `${hits} matching agents` : '');\n    for (const item of chat.children) item.hidden = scope === 'selected' && item.dataset.agent !== selected;\n    get('~32~').setAttribute('aria-pressed', String(scope === 'all'));\n    get('~33~').setAttribute('aria-pressed', String(scope === 'selected'));\n  }\n\n  function choose(id, fragment = true, reveal = true) {\n    if (panel.firstElementChild) store.append(panel.firstElementChild);\n    const card = get('manifest-' + id), row = get('node-' + id);\n    selected = id;\n    panel.hidden = !card;\n    get('~22~').hidden = Boolean(card);\n    if (card) { card.open = true; panel.append(card); }\n    for (const item of tree.querySelectorAll('.hive-node')) item.dataset.selected = String(item === row);\n    if (row && reveal) for (let up = row.parentElement; up && up !== tree; up = up.parentElement) if (up.tagName === 'DETAILS') up.open = true;\n    if (fragment && row) { try { history.replaceState(null, '', '#agent=' + encodeURIComponent(id)); } catch (_) {} }\n    filters();\n  }\n\n  function freshness() {\n    if (!board) { page.dataset.fresh = 'false'; return; }\n    const elapsed = Math.max(0, performance.now() - advancedAt);\n    const stale = sourceAge + elapsed > Number(board.dataset.staleAfter);\n    page.dataset.fresh = String(connected && !stale && trusted);\n    say('~12~', !connected ? regressed ? 'Snapshot timestamp moved backwards; last observation retained' : 'Connection interrupted; last snapshot retained' : stale ? 'Source stale; last observation retained' : !trusted ? 'Connected; source age not verified' : 'Receiving source observations');\n    say('~13~', `${Math.floor(elapsed / 1000)}s since the source timestamp advanced. Last observation retained on interruption.`);\n  }\n\n  function ingest(markup, serverDate) {\n    const document = new DOMParser().parseFromString(markup, 'text/html');\n    const incoming = document.getElementById('~63~');\n    const generated = Date.parse(incoming?.dataset.generated || '');\n    if (!incoming || !Number.isFinite(generated) || incoming.dataset.staleAfter !== '~65~' || !incoming.dataset.sequence || incoming.dataset.sequence.length > 128) throw new Error('Invalid edge board');\n    if (board && generated < Date.parse(board.dataset.generated)) { regressed = true; throw new Error('Snapshot moved backwards'); }\n    for (const id of ['~20~', '~36~', '~64~', '~10~', '~14~', '~15~']) if (!incoming.querySelector('#' + id)) throw new Error('Incomplete edge board');\n    if (!board || generated > Date.parse(board.dataset.generated)) {\n      advancedAt = performance.now();\n      const server = Date.parse(serverDate || '');\n      trusted = Number.isFinite(server) && generated <= server + ~61~;\n      sourceAge = trusted ? Math.max(0, server - generated) : 0;\n      regressed = false;\n    }\n    const focused = window.document.activeElement;\n    const scroll = [chat.scrollTop, tree.parentElement.scrollTop, panel.parentElement.scrollTop];\n    if (panel.firstElementChild) store.append(panel.firstElementChild);\n    for (const id of ['~20~', '~36~', '~64~', '~10~', '~14~', '~15~']) morph(get(id), incoming.querySelector('#' + id));\n    board = incoming;\n    for (const name of ['generated', 'sequence', 'staleAfter']) page.dataset[name] = incoming.dataset[name];\n    connected = true;\n    get('~19~').hidden = tree.children.length > 0;\n    get('~35~').hidden = chat.children.length > 0;\n    say('~11~', new Date().toISOString());\n    choose(selected, false, false);\n    [chat.scrollTop, tree.parentElement.scrollTop, panel.parentElement.scrollTop] = scroll;\n    if (focused?.isConnected && window.document.activeElement !== focused) focused.focus({ preventScroll: true });\n    freshness();\n  }\n\n  async function poll() {\n    if (active) return;\n    active = true;\n    const controller = new AbortController();\n    const timeout = setTimeout(() => controller.abort(), ~62~);\n    try {\n      const response = await fetch('~66~', { cache: 'no-store', credentials: 'omit', signal: controller.signal, headers: { Accept: 'text/html' } });\n      if (!response.ok || !response.headers.get('content-type')?.toLowerCase().includes('text/html')) throw new Error('Board unavailable');\n      ingest(await response.text(), response.headers.get('date'));\n    } catch (_) {\n      connected = false;\n      if (!board) say('~12~', 'Telemetry unavailable; no source observation received');\n      freshness();\n    } finally { clearTimeout(timeout); active = false; }\n  }\n\n  search.addEventListener('input', () => {\n    query = search.value.trim().toLowerCase();\n    if (query && !searchOpen) searchOpen = new Map([...tree.querySelectorAll('details[id]')].map(node => [node.id, node.open]));\n    if (!query && searchOpen) { for (const [id, open] of searchOpen) { const node = get(id); if (node) node.open = open; } searchOpen = null; }\n    filters();\n  });\n  tree.addEventListener('click', event => { const link = event.target.closest('a[data-agent]'); if (link) { event.preventDefault(); choose(link.dataset.agent); } });\n  get('~32~').addEventListener('click', () => { scope = 'all'; filters(); });\n  get('~33~').addEventListener('click', () => { scope = 'selected'; filters(); });\n  addEventListener('hashchange', () => choose(new URLSearchParams(location.hash.slice(1)).get('agent'), false));\n  setInterval(freshness, ~59~);\n  setInterval(poll, ~59~);\n  poll();\n})();\n"
fn javascript to void
flush
put target 0 3
for i ulong len client
byteput get client i
end
flush
put target 0 1
end
