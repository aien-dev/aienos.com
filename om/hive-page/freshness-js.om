note Browser hook emitted from Omega. No structural DOM writes and no Node generator.
text freshsrc "/* Seeded Omega freshness decision; JS remains the explicit load-failure fallback. */\n(() => {\n  'use strict';\n  const hive = document.getElementById('~9~');\n  if (!hive) return;\n  let wasmFresh = null;\n  function jsFresh(nowMs, generatedMs, previousMs, staleAfterMs, fetchOk) {\n    if (generatedMs < previousMs) return 2;\n    if (!fetchOk) return 3;\n    return Math.max(0, nowMs - generatedMs) > staleAfterMs ? 1 : 0;\n  }\n  window.hiveFresh = (nowMs, generatedMs, previousMs, staleAfterMs, fetchOk) => {\n    // Date timestamps and thresholds are integers; ceil preserves strict > for elapsed fractions.\n    const values = [Math.ceil(nowMs), generatedMs, previousMs, staleAfterMs];\n    const useWasm = wasmFresh && values.every(Number.isSafeInteger);\n    hive.dataset.freshEngine = useWasm ? 'wasm' : 'js';\n    const state = useWasm\n      ? wasmFresh(...values.map(BigInt), fetchOk ? 1 : 0)\n      : jsFresh(nowMs, generatedMs, previousMs, staleAfterMs, fetchOk);\n    hive.dataset.freshState = String(state);\n    return state;\n  };\n  window.hiveFreshReady = (async () => {\n    try {\n      const response = await fetch('/wasm/hive-fresh.wasm', { cache: 'no-cache', credentials: 'omit' });\n      if (!response.ok) throw new Error('Freshness module unavailable');\n      const fallback = response.clone();\n      let compiled;\n      try {\n        compiled = await WebAssembly.instantiateStreaming(response);\n      } catch (_) {\n        compiled = await WebAssembly.instantiate(await fallback.arrayBuffer());\n      }\n      if (typeof compiled.instance.exports.fresh !== 'function') throw new Error('Freshness export unavailable');\n      wasmFresh = compiled.instance.exports.fresh;\n      return true;\n    } catch (_) {\n      wasmFresh = null;\n      return false;\n    }\n  })();\n})();\n"
fn freshjs to void
for b ulong len freshsrc
byteput get freshsrc b
end
end
