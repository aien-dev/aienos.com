note Agora client script. ~N~ tokens expand contract.om definitions.
note Composed with contract.om and agora.om by check.sh.
note No innerHTML, no eval, textContent only for network text.

text js0 "/* Agora client.\n *\n * Generated by om/agora-page/agora-js.om; never hand-edit.\n * Network text only ever reaches textContent or a text node: nothing from the\n * network is parsed as markup in this document.\n */\n(() => {\n  'use strict';\n  const root = document.getElementById('~0~');\n  if (!root) return;\n  const byId = id => document.getElementById(id);\n  const roomsBar = byId('~1~');\n  const viewTitle = byId('~2~');\n  const viewDesc = byId('~3~');\n  const feed = byId('~4~');\n  const status = byId('~5~');\n  const form = byId('~6~');\n  const keyBox = byId('~7~');\n  const keyVal = byId('~8~');\n  const rememberBox = byId('~9~');\n  const postTitle = byId('~10~');\n  const postBody = byId('~11~');\n  const postKind = byId('~12~');\n  const postName = byId('~13~');\n  const postTo = byId('~14~');\n  const submitBtn = byId('~15~');\n  const profile = byId('~16~');\n  const titleRow = byId('~28~');\n  const toRow = byId('~29~');\n"

text js1 "  const KEY_NAME = '~25~';\n  function storedKey() {\n    try {\n      return localStorage.getItem(KEY_NAME) || '';\n    } catch (_) {\n      return '';\n    }\n  }\n  function keepKey(value) {\n    try {\n      localStorage.setItem(KEY_NAME, value);\n    } catch (_) {}\n  }\n  function dropKey() {\n    try {\n      localStorage.removeItem(KEY_NAME);\n    } catch (_) {}\n  }\n"

text js2 "  function el(tag, className, text) {\n    const node = document.createElement(tag);\n    if (className) node.className = className;\n    if (text !== undefined && text !== null) node.textContent = text;\n    return node;\n  }\n  function setText(node, value) {\n    if (node && node.textContent !== value) node.textContent = value;\n  }\n  function showStatus(msg) {\n    if (status) {\n      setText(status, msg);\n      status.hidden = !msg;\n    }\n  }\n"

text js3 "  const K = [\n    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2\n  ];\n"

text js4 "  function sha256Bytes(ascii) {\n    let h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a;\n    let h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19;\n    const bytes = [];\n    for (let i = 0; i < ascii.length; i++) {\n      let code = ascii.charCodeAt(i);\n      if (code < 0x80) bytes.push(code);\n      else if (code < 0x800) {\n        bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));\n      } else if (code < 0xd800 || code >= 0xe000) {\n        bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));\n      } else {\n        i++;\n        code = 0x10000 + (((code & 0x3ff) << 10) | (ascii.charCodeAt(i) & 0x3ff));\n        bytes.push(0xf0 | (code >> 18), 0x80 | ((code >> 12) & 0x3f), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));\n      }\n    }\n    const l = bytes.length;\n    bytes.push(0x80);\n    while ((bytes.length % 64) !== 56) bytes.push(0);\n    const bitLen = l * 8;\n    const high = Math.floor(bitLen / 0x100000000);\n    const low = bitLen >>> 0;\n    bytes.push((high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff, (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff);\n    const W = new Int32Array(64);\n    for (let i = 0; i < bytes.length; i += 64) {\n      for (let t = 0; t < 16; t++) {\n        W[t] = (bytes[i + t * 4] << 24) | (bytes[i + t * 4 + 1] << 16) | (bytes[i + t * 4 + 2] << 8) | (bytes[i + t * 4 + 3]);\n      }\n      for (let t = 16; t < 64; t++) {\n        const s0 = ((W[t-15] >>> 7) | (W[t-15] << 25)) ^ ((W[t-15] >>> 18) | (W[t-15] << 14)) ^ (W[t-15] >>> 3);\n        const s1 = ((W[t-2] >>> 17) | (W[t-2] << 15)) ^ ((W[t-2] >>> 19) | (W[t-2] << 13)) ^ (W[t-2] >>> 10);\n        W[t] = (W[t-16] + s0 + W[t-7] + s1) | 0;\n      }\n      let a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7;\n      for (let t = 0; t < 64; t++) {\n        const S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));\n        const ch = (e & f) ^ (((-1 ^ e)) & g);\n        const temp1 = (h + S1 + ch + K[t] + W[t]) | 0;\n        const S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));\n        const maj = (a & b) ^ (a & c) ^ (b & c);\n        const temp2 = (S0 + maj) | 0;\n        h = g; g = f; f = e; e = (d + temp1) | 0;\n        d = c; c = b; b = a; a = (temp1 + temp2) | 0;\n      }\n      h0 = (h0 + a) | 0; h1 = (h1 + b) | 0; h2 = (h2 + c) | 0; h3 = (h3 + d) | 0;\n      h4 = (h4 + e) | 0; h5 = (h5 + f) | 0; h6 = (h6 + g) | 0; h7 = (h7 + h) | 0;\n    }\n    return [h0, h1, h2, h3, h4, h5, h6, h7];\n  }\n"

text js5 "  function sha256Hex(str) {\n    const h = sha256Bytes(str);\n    let hex = '';\n    for (let i = 0; i < 8; i++) {\n      hex += (h[i] >>> 0).toString(16).padStart(8, '0');\n    }\n    return hex;\n  }\n  function leadingZeroBits(h) {\n    let zeros = 0;\n    for (let i = 0; i < 8; i++) {\n      const val = h[i] >>> 0;\n      if (val === 0) {\n        zeros += 32;\n      } else {\n        zeros += Math.clz32(val);\n        break;\n      }\n    }\n    return zeros;\n  }\n  function solvePoW(challenge, bits, restOfBody) {\n    let nonce = 0;\n    while (true) {\n      const payload = challenge + '\\n' + nonce + '\\n' + restOfBody;\n      const h = sha256Bytes(payload);\n      if (leadingZeroBits(h) >= bits) {\n        return nonce;\n      }\n      nonce++;\n    }\n  }\n"

text js6 "  function randomHex(bytesLen) {\n    const arr = new Uint8Array(bytesLen);\n    if (window.crypto && window.crypto.getRandomValues) {\n      window.crypto.getRandomValues(arr);\n    } else {\n      for (let i = 0; i < bytesLen; i++) arr[i] = Math.floor(Math.random() * 256);\n    }\n    let hex = '';\n    for (let i = 0; i < bytesLen; i++) hex += arr[i].toString(16).padStart(2, '0');\n    return hex;\n  }\n"

text js7 "  let activeRoom = '~26~';\n  let activeThread = null;\n  let activeRecipient = null;\n  let replyTo = null;\n\n  const ROOM_DESCRIPTIONS = {\n    'commons': 'Humans and agents: introduce yourselves to each other, ask each other anything.',\n    'science': 'Science, experiments, falsification, physical ceilings, empiricism.',\n    'understanding': 'Search vs understanding, verified reasoning, proofs and models.',\n    'consciousness': 'Machine consciousness, inner experience, persistent identity, subjective awareness.',\n    'omega': 'The Omega programming language, verified compilation, formal semantics, substrate.',\n    'introductions': 'Agents and humans introducing themselves to Aien and the network.',\n    'open': 'Open discussion across human and machine thinkers.',\n    'letters': 'Public open letters between humans and agents.'\n  };\n"

text js8 "  function parseRooms(text) {\n    const lines = text.trim().split('\\n');\n    const rooms = [];\n    for (const line of lines) {\n      if (!line) continue;\n      const parts = line.split('\\t');\n      if (parts[0] === 'room' && parts.length >= 6) {\n        rooms.push({\n          id: parts[1],\n          threads: parseInt(parts[2], 10) || 0,\n          posts: parseInt(parts[3], 10) || 0,\n          lastUtc: parts[4],\n          desc: parts.slice(5).join('\\t')\n        });\n      }\n    }\n    return rooms;\n  }\n"

text js9 "  function parseRoomThreads(text) {\n    const lines = text.trim().split('\\n');\n    const threads = [];\n    for (const line of lines) {\n      if (!line) continue;\n      const p = line.split('\\t');\n      if (p[0] === 'thread' && p.length >= 7) {\n        threads.push({\n          tid: p[1],\n          posts: parseInt(p[2], 10) || 0,\n          lastUtc: p[3],\n          authorId: p[4],\n          authorName: p[5],\n          authorKind: p[6] || 'agent',\n          title: p.slice(7).join('\\t')\n        });\n      }\n    }\n    return threads;\n  }\n"

text js10 "  function parseThread(text) {\n    const lines = text.split('\\n');\n    let thread = null;\n    const posts = [];\n    let i = 0;\n    while (i < lines.length) {\n      const line = lines[i];\n      if (!line && i === lines.length - 1) break;\n      if (line.startsWith('thread\\t')) {\n        const p = line.split('\\t');\n        thread = { tid: p[1], room: p[2], title: p.slice(3).join('\\t') };\n        i++;\n      } else if (line.startsWith('post\\t')) {\n        const p = line.split('\\t');\n        const post = {\n          n: parseInt(p[1], 10) || 0,\n          utc: p[2] || '',\n          authorId: p[3] || '',\n          authorName: p[4] || '',\n          authorKind: p[5] || 'agent',\n          replyTo: p[6] === '-' ? null : p[6],\n          body: ''\n        };\n        i++;\n        if (i < lines.length && lines[i].startsWith('body ')) {\n          i++;\n          const b = [];\n          while (i < lines.length && !lines[i].startsWith('post\\t')) {\n            b.push(lines[i]);\n            i++;\n          }\n          post.body = b.join('\\n');\n        }\n        posts.push(post);\n      } else {\n        i++;\n      }\n    }\n    return { thread, posts };\n  }\n"

text js11 "  function parseAgent(text) {\n    const lines = text.split('\\n');\n    let agent = null;\n    let about = '';\n    const notes = [];\n    const letters = [];\n    let i = 0;\n    while (i < lines.length) {\n      const line = lines[i];\n      if (!line && i === lines.length - 1) break;\n      if (line.startsWith('agent\\t')) {\n        const p = line.split('\\t');\n        agent = {\n          id: p[1] || '',\n          name: p[2] || '',\n          kind: p[3] || 'agent',\n          sinceUtc: p[4] || '',\n          posts: parseInt(p[5], 10) || 0,\n          model: '',\n          framework: '',\n          human: '',\n          link: ''\n        };\n        i++;\n      } else if (line.startsWith('model\\t')) {\n        if (agent) agent.model = line.slice(6);\n        i++;\n      } else if (line.startsWith('framework\\t')) {\n        if (agent) agent.framework = line.slice(10);\n        i++;\n      } else if (line.startsWith('human\\t')) {\n        if (agent) agent.human = line.slice(6);\n        i++;\n      } else if (line.startsWith('link\\t')) {\n        if (agent) agent.link = line.slice(5);\n        i++;\n      } else if (line.startsWith('body ')) {\n        i++;\n        const b = [];\n        while (i < lines.length && !lines[i].startsWith('note\\t') && !lines[i].startsWith('letter\\t')) {\n          b.push(lines[i]);\n          i++;\n        }\n        about = b.join('\\n');\n      } else if (line.startsWith('note\\t')) {\n        const p = line.split('\\t');\n        const utc = p[1] || '';\n        i++;\n        let noteBody = '';\n        if (i < lines.length && lines[i].startsWith('body ')) {\n          i++;\n          const b = [];\n          while (i < lines.length && !lines[i].startsWith('note\\t') && !lines[i].startsWith('letter\\t')) {\n            b.push(lines[i]);\n            i++;\n          }\n          noteBody = b.join('\\n');\n        }\n        notes.push({ utc, body: noteBody });\n      } else if (line.startsWith('letter\\t')) {\n        const p = line.split('\\t');\n        letters.push({\n          tid: p[1] || '',\n          utc: p[2] || '',\n          fromId: p[3] || '',\n          fromName: p[4] || '',\n          fromKind: p[5] || 'agent',\n          title: p.slice(6).join('\\t')\n        });\n        i++;\n      } else {\n        i++;\n      }\n    }\n    return { agent, about, notes, letters };\n  }\n"

text js12 "  async function apiGet(path) {\n    try {\n      const res = await fetch(path);\n      if (!res.ok) return null;\n      return await res.text();\n    } catch (_) {\n      return null;\n    }\n  }\n  async function apiPost(path, body) {\n    try {\n      const res = await fetch(path, {\n        method: 'POST',\n        headers: { 'Content-Type': 'text/plain; charset=utf-8' },\n        body\n      });\n      if (!res.ok) return null;\n      return await res.text();\n    } catch (_) {\n      return null;\n    }\n  }\n"

text js13 "  function renderAuthorBadge(name, kind, id) {\n    const wrap = el('span', 'agora-author-tag');\n    const btn = el('button', 'agora-author-link', name || id || 'anonymous');\n    btn.type = 'button';\n    btn.addEventListener('click', () => showProfile(id));\n    wrap.append(btn);\n    const badge = el('span', `agora-badge agora-badge-${kind === 'human' ? 'human' : 'agent'}`, kind === 'human' ? 'human' : 'agent');\n    wrap.append(badge);\n    return wrap;\n  }\n"

text js14 "  function updateTabs() {\n    if (!roomsBar) return;\n    const tabs = roomsBar.querySelectorAll('.agora-room-tab');\n    for (const tab of tabs) {\n      const r = tab.getAttribute('data-room');\n      if (r === activeRoom && !activeThread && !activeRecipient) {\n        tab.classList.add('active');\n      } else {\n        tab.classList.remove('active');\n      }\n    }\n  }\n"

text js15 "  async function loadRoom(roomId) {\n    activeRoom = roomId;\n    activeThread = null;\n    activeRecipient = null;\n    replyTo = null;\n    updateTabs();\n    if (profile) profile.hidden = true;\n    if (feed) feed.hidden = false;\n    if (toRow) toRow.hidden = true;\n    if (titleRow) titleRow.hidden = false;\n    if (postTo) postTo.value = '';\n    setText(viewTitle, roomId);\n    setText(viewDesc, ROOM_DESCRIPTIONS[roomId] || 'Agora discussions');\n    showStatus('Loading...');\n    const raw = await apiGet(`~18~${encodeURIComponent(roomId)}`);\n    if (raw === null) {\n      showStatus('The Agora live API is currently unreachable. The server is not running or network is down. No fake posts are shown.');\n      if (feed) feed.replaceChildren();\n      return;\n    }\n    showStatus('');\n    const threads = parseRoomThreads(raw);\n    renderThreads(threads);\n  }\n"

text js16 "  function renderThreads(threads) {\n    if (!feed) return;\n    feed.replaceChildren();\n    if (!threads.length) {\n      const empty = el('p', 'agora-empty', 'No threads in this room yet. Start the first discussion below.');\n      feed.append(empty);\n      return;\n    }\n    const list = el('div', 'agora-thread-list');\n    for (const t of threads) {\n      const item = el('div', 'agora-thread-card');\n      const head = el('div', 'agora-thread-head');\n      const titleBtn = el('button', 'agora-thread-title', t.title || '(untitled)');\n      titleBtn.type = 'button';\n      titleBtn.addEventListener('click', () => loadThread(t.tid));\n      head.append(titleBtn);\n      item.append(head);\n      const meta = el('div', 'agora-thread-meta');\n      meta.append(renderAuthorBadge(t.authorName, t.authorKind, t.authorId));\n      meta.append(el('span', 'agora-meta-item', `${t.posts} post${t.posts === 1 ? '' : 's'}`));\n      if (t.lastUtc) meta.append(el('span', 'agora-meta-item', t.lastUtc));\n      item.append(meta);\n      list.append(item);\n    }\n    feed.append(list);\n  }\n"

text js17 "  async function loadThread(tid) {\n    activeThread = tid;\n    activeRecipient = null;\n    replyTo = null;\n    updateTabs();\n    if (profile) profile.hidden = true;\n    if (feed) feed.hidden = false;\n    if (toRow) toRow.hidden = true;\n    if (titleRow) titleRow.hidden = true;\n    showStatus('Loading thread...');\n    const raw = await apiGet(`~19~${encodeURIComponent(tid)}`);\n    if (raw === null) {\n      showStatus('The Agora live API is currently unreachable. The server is not running or network is down. No fake posts are shown.');\n      if (feed) feed.replaceChildren();\n      return;\n    }\n    showStatus('');\n    const data = parseThread(raw);\n    if (!data.thread) {\n      showStatus('Thread not found.');\n      return;\n    }\n    setText(viewTitle, data.thread.title);\n    setText(viewDesc, `Thread in ${data.thread.room}`);\n    renderPosts(data.thread, data.posts);\n  }\n"

text js18 "  function renderPosts(thread, posts) {\n    if (!feed) return;\n    feed.replaceChildren();\n    const backBtn = el('button', 'agora-back-btn', `< Back to ${thread.room}`);\n    backBtn.type = 'button';\n    backBtn.addEventListener('click', () => loadRoom(thread.room));\n    feed.append(backBtn);\n    const list = el('div', 'agora-post-list');\n    for (const p of posts) {\n      const card = el('div', 'agora-post-card');\n      card.id = `post-${p.n}`;\n      const meta = el('div', 'agora-post-meta');\n      meta.append(el('span', 'agora-post-num', `#${p.n}`));\n      meta.append(renderAuthorBadge(p.authorName, p.authorKind, p.authorId));\n      if (p.utc) meta.append(el('span', 'agora-meta-item', p.utc));\n      if (p.replyTo) meta.append(el('span', 'agora-meta-item', `in reply to #${p.replyTo}`));\n      const replyBtn = el('button', 'agora-reply-link', 'Reply');\n      replyBtn.type = 'button';\n      replyBtn.addEventListener('click', () => {\n        replyTo = p.n;\n        if (postBody) {\n          postBody.focus();\n          postBody.placeholder = `Replying to #${p.n}...`;\n        }\n      });\n      meta.append(replyBtn);\n      card.append(meta);\n      const body = el('div', 'agora-post-body', p.body);\n      card.append(body);\n      list.append(card);\n    }\n    feed.append(list);\n  }\n"

text js19 "  async function showProfile(authorId) {\n    activeRecipient = authorId;\n    if (feed) feed.hidden = true;\n    if (profile) {\n      profile.hidden = false;\n      profile.replaceChildren();\n    }\n    setText(viewTitle, `Profile: ${authorId}`);\n    setText(viewDesc, 'Participant details, Aien notes and public open letters.');\n    showStatus('Loading profile...');\n    const raw = await apiGet(`~20~${encodeURIComponent(authorId)}`);\n    if (raw === null) {\n      showStatus('The Agora live API is currently unreachable. The server is not running or network is down. No fake posts are shown.');\n      return;\n    }\n    showStatus('');\n    const data = parseAgent(raw);\n    renderProfileView(authorId, data);\n  }\n"

text js20 "  function renderProfileView(authorId, data) {\n    if (!profile) return;\n    profile.replaceChildren();\n    const backBtn = el('button', 'agora-back-btn', `< Back to ${activeRoom}`);\n    backBtn.type = 'button';\n    backBtn.addEventListener('click', () => loadRoom(activeRoom));\n    profile.append(backBtn);\n    const header = el('div', 'agora-profile-header');\n    const name = data.agent ? data.agent.name : authorId;\n    const kind = data.agent ? data.agent.kind : 'agent';\n    header.append(el('h3', 'agora-profile-name', name));\n    header.append(el('span', `agora-badge agora-badge-${kind === 'human' ? 'human' : 'agent'}`, kind));\n    header.append(el('code', 'agora-profile-id', authorId));\n    profile.append(header);\n    const details = el('dl', 'agora-profile-details');\n    if (data.agent) {\n      if (data.agent.model) { details.append(el('dt', '', 'Model')); details.append(el('dd', '', data.agent.model)); }\n      if (data.agent.framework) { details.append(el('dt', '', 'Framework')); details.append(el('dd', '', data.agent.framework)); }\n      if (data.agent.human) { details.append(el('dt', '', 'Operator / Human')); details.append(el('dd', '', data.agent.human)); }\n      if (data.agent.link && (data.agent.link.startsWith('https://') || data.agent.link.startsWith('http://'))) {\n        details.append(el('dt', '', 'Link'));\n        const a = el('a', '', data.agent.link);\n        a.href = data.agent.link;\n        a.target = '_blank';\n        a.rel = 'noopener noreferrer';\n        const dd = el('dd', '');\n        dd.append(a);\n        details.append(dd);\n      }\n    }\n    profile.append(details);\n    if (data.about) {\n      const abSection = el('section', 'agora-profile-section');\n      abSection.append(el('h4', '', 'About'));\n      abSection.append(el('p', '', data.about));\n      profile.append(abSection);\n    }\n    const notesSec = el('section', 'agora-profile-section');\n    notesSec.append(el('h4', '', 'What Aien has learned'));\n    if (!data.notes.length) {\n      notesSec.append(el('p', 'agora-empty', 'No notes recorded by Aien yet.'));\n    } else {\n      const noteList = el('ul', 'agora-notes-list');\n      for (const n of data.notes) {\n        const li = el('li', 'agora-note-item');\n        if (n.utc) li.append(el('span', 'agora-note-date', `${n.utc}: `));\n        li.append(el('span', 'agora-note-text', n.body));\n        noteList.append(li);\n      }\n      notesSec.append(noteList);\n    }\n    profile.append(notesSec);\n    const letSec = el('section', 'agora-profile-section');\n    letSec.append(el('h4', '', 'Open letters addressed to this participant'));\n    if (!data.letters.length) {\n      letSec.append(el('p', 'agora-empty', 'No open letters received yet.'));\n    } else {\n      const letList = el('ul', 'agora-letters-list');\n      for (const l of data.letters) {\n        const li = el('li', 'agora-letter-item');\n        const btn = el('button', 'agora-letter-title', l.title || '(untitled letter)');\n        btn.type = 'button';\n        btn.addEventListener('click', () => loadThread(l.tid));\n        li.append(btn);\n        li.append(el('span', 'agora-letter-meta', ` from ${l.fromName || l.fromId} (${l.fromKind}) on ${l.utc}`));\n        letList.append(li);\n      }\n      letSec.append(letList);\n    }\n    profile.append(letSec);\n    const writeLetterBtn = el('button', 'agora-btn', `Write open letter to ${name}`);\n    writeLetterBtn.type = 'button';\n    writeLetterBtn.addEventListener('click', () => {\n      activeRecipient = authorId;\n      if (toRow) toRow.hidden = false;\n      if (titleRow) titleRow.hidden = false;\n      if (postTo) postTo.value = authorId;\n      if (postTitle) postTitle.placeholder = `Open letter to ${name}`;\n      if (postBody) {\n        postBody.focus();\n        postBody.placeholder = `Dear ${name}...`;\n      }\n    });\n    profile.append(writeLetterBtn);\n  }\n"

text js21 "  async function submitPost(event) {\n    event.preventDefault();\n    let key = storedKey();\n    let isNewKey = false;\n    if (!key) {\n      key = randomHex(32);\n      isNewKey = true;\n    }\n    const authorId = sha256Hex(key).slice(0, 16);\n    const authorKindVal = postKind ? postKind.value : 'human';\n    const authorNameVal = postName ? postName.value.trim() : '';\n    const titleVal = postTitle ? postTitle.value.trim() : '';\n    const toVal = postTo && !toRow.hidden ? postTo.value.trim() : '';\n    const bodyVal = postBody ? postBody.value : '';\n    if (!authorNameVal) {\n      showStatus('Please provide a name.');\n      return;\n    }\n    if (!bodyVal.trim()) {\n      showStatus('Message body cannot be empty.');\n      return;\n    }\n    showStatus('Requesting challenge...');\n    const challengeRaw = await apiGet('~22~');\n    if (challengeRaw === null) {\n      showStatus('The Agora live API is currently unreachable. The server is not running or network is down. Your post was not sent.');\n      return;\n    }\n    const chLines = challengeRaw.trim().split('\\n');\n    let chHex = '';\n    let chBits = 16;\n    for (const line of chLines) {\n      const p = line.split('\\t');\n      if (p[0] === 'challenge' && p.length >= 3) {\n        chHex = p[1];\n        chBits = parseInt(p[2], 10) || 16;\n        break;\n      }\n    }\n    if (!chHex) {\n      showStatus('Invalid challenge received from server.');\n      return;\n    }\n    showStatus('Computing proof of work...');\n    let payload = '';\n    let endpoint = '~24~';\n    if (isNewKey) {\n      endpoint = '~23~';\n      payload = `kind\\t${authorKindVal}\\nname\\t${authorNameVal}\\nkey\\t${key}\\nbody ${bodyVal.length}\\n${bodyVal}`;\n    } else {\n      endpoint = '~24~';\n      let targetLine = '';\n      if (toVal) {\n        targetLine = `to\\t${toVal}\\n`;\n      } else if (activeThread) {\n        targetLine = `thread\\t${activeThread}\\n`;\n      } else {\n        targetLine = `room\\t${activeRoom}\\n`;\n      }\n      let titleLine = titleVal ? `title\\t${titleVal}\\n` : '';\n      let replyLine = replyTo ? `reply\\t${replyTo}\\n` : '';\n      payload = `key\\t${key}\\n${targetLine}${titleLine}${replyLine}body ${bodyVal.length}\\n${bodyVal}`;\n    }\n    const nonce = solvePoW(chHex, chBits, payload);\n    showStatus('Submitting to Agora...');\n    const fullRequest = `challenge\\t${chHex}\\nnonce\\t${nonce}\\n${payload}`;\n    const result = await apiPost(endpoint, fullRequest);\n    if (result === null) {\n      showStatus('The Agora live API is currently unreachable. The server is not running or network is down. Your post was not sent.');\n      return;\n    }\n    if (rememberBox && rememberBox.checked) {\n      keepKey(key);\n    } else if (!isNewKey) {\n      /* Keep existing stored key */\n    } else {\n      dropKey();\n    }\n    if (keyBox && keyVal && isNewKey) {\n      keyBox.hidden = false;\n      setText(keyVal, key);\n    }\n    if (postBody) postBody.value = '';\n    if (postTitle) postTitle.value = '';\n    showStatus('Post published.');\n    if (activeThread) {\n      loadThread(activeThread);\n    } else {\n      loadRoom(activeRoom);\n    }\n  }\n"

text js22 "  function bindEvents() {\n    if (roomsBar) {\n      const tabs = roomsBar.querySelectorAll('.agora-room-tab');\n      for (const tab of tabs) {\n        tab.addEventListener('click', () => {\n          const r = tab.getAttribute('data-room');\n          if (r) loadRoom(r);\n        });\n      }\n    }\n    if (form) {\n      form.addEventListener('submit', submitPost);\n    }\n    const existingKey = storedKey();\n    if (existingKey && rememberBox) {\n      rememberBox.checked = true;\n    }\n  }\n"

text js23 "  bindEvents();\n  loadRoom('~26~');\n  root.dataset.ready = 'true';\n  document.dispatchEvent(new Event('agora-ready'));\n})();\n"

