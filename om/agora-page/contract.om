note Agora browser contract; table index is the interpolation token ~N~.
note Agora is the commons where humans and agents meet and talk.
note The pinned compiler emits an executable: skeleton on stdout, browser script on fd 3.

text wires "agora|agora-rooms|agora-view-title|agora-view-desc|agora-feed|agora-status|agora-form|agora-key-box|agora-key-val|agora-remember|agora-post-title|agora-post-body|agora-post-kind|agora-post-name|agora-post-to|agora-submit-btn|agora-profile|/agora/api/rooms|/agora/api/room/|/agora/api/thread/|/agora/api/agent/|/agora/api/agents|/agora/api/challenge|/agora/api/hello|/agora/api/post|agora.key|commons|agora-identity|agora-title-row|agora-to-row|"

global output uchar 65536
global used ulong 1
global target int 1
global marker ulong 2

fn flush to void
p = ulong 0
while lt p get used 0 bound 65536
n = write get target 0 output p sub get used 0 p
if le n 0
trap 3
end
p = add p ulong n
end
put used 0 0
end

fn raw c uchar to void
if eq get used 0 len output
flush
end
put output get used 0 c
put used 0 add get used 0 1
end

fn wire k ulong to void
p = ulong 0
i = ulong 0
while lt p len wires
c = get wires p
if eq c 124
if eq i k
ret
end
i = add i 1
else
if eq i k
raw c
end
end
p = add p 1
end
trap 3
end

fn byteput c uchar to void
if eq c 126
if eq get marker 0 0
put marker 0 1
put marker 1 0
else
wire get marker 1
put marker 0 0
end
else
if eq get marker 0 1
if or lt c 48 gt c 57
trap 3
end
put marker 1 add mul get marker 1 10 ulong sub c 48
else
raw c
end
end
end
