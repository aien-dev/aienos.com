fn is_hidden tid ulong n ulong to bool
ntk = get g_ntk 0
for i ulong ntk
if eq get g_tk_ti i tid
kn = get g_tk_n i
if or eq kn 0 eq kn n
ret true
end
end
end
ret false
end

fn check_pow ch view uchar * non view uchar * bdy view uchar * to bool
pw = get g_pow 0
if eq pw 0
ret true
end
msg = new uchar 16384 0
cur = ulong 0
for i ulong 32
put msg cur get ch i
cur = add cur 1
end
put msg cur 10
cur = add cur 1
nn = len non
for j ulong nn
put msg cur get non j
cur = add cur 1
end
put msg cur 10
cur = add cur 1
nb = len bdy
for k ulong nb
put msg cur get bdy k
cur = add cur 1
end
dig = new uchar 32 0
sha256_hash view part msg 0 cur dig
z = leadzeros view dig
if lt z pw
ret false
end
ret true
end

fn h_rooms cs edit ulong 320 io edit uchar 131072 to long
rname = new uchar 32 0
out_clr
nth = get g_nth 0
for rid ulong 8
if eq rid 0
continue
end
tcnt = ulong 0
pcnt = ulong 0
newts = ulong 0
for i ulong nth
if eq get g_th_rm i rid
tcnt = add tcnt 1
pcnt = add pcnt get g_th_pc i
ts = get g_th_ts i
if gt ts newts
newts = ts
end
end
end
rnlen = room_nam rid rname
out_add str_rm
out_add view part rname 0 rnlen
out_add str_tab
out_addu tcnt
out_add str_tab
out_addu pcnt
out_add str_tab
out_addu newts
out_add str_lf
end
ret out_send cs io
end

fn h_chal cs edit ulong 320 io edit uchar 131072 to long
out_clr
nch = get g_nch 0
cidx = rem nch 64
chbuf = new uchar 16 0
r = random chbuf 0 16 0
hx = new uchar 32 0
tohex view chbuf hx
choff = mul cidx 32
for k ulong 32
put g_ch_hx add choff k get hx k
end
put g_ch_bt cidx get g_pow 0
put g_ch_ex cidx 1700000600
put g_ch_us cidx 0
put g_nch 0 add nch 1
out_add str_ch
out_add view hx
out_add str_tab
out_addu get g_pow 0
out_add str_tab
out_addu 1700000600
out_add str_lf
ret out_send cs io
end

fn h_room cs edit ulong 320 io edit uchar 131072 rid ulong to long
rname = new uchar 32 0
out_clr
nth = get g_nth 0
idx = nth
while gt idx 0 bound 512
idx = sub idx 1
if eq get g_th_rm idx rid
tid = get g_th_tid idx
ts = get g_th_ts idx
pcnt = get g_th_pc idx
hid = is_hidden tid 0
out_add str_th
out_addu tid
out_add str_tab
rnlen = room_nam rid rname
out_add view part rname 0 rnlen
out_add str_tab
if hid
out_add str_hid
out_add str_tab
out_add str_hid
out_add str_tab
out_add str_hid
out_add str_tab
out_addu 0
out_add str_tab
out_addu ts
out_add str_tab
out_add str_mtak
out_add str_lf
continue
end
o_th_au idx
out_add str_tab
o_th_na idx
out_add str_tab
o_th_kd idx
out_add str_tab
out_addu pcnt
out_add str_tab
out_addu ts
out_add str_tab
o_th_tt idx
out_add str_lf
end
end
ret out_send cs io
end


fn o_th_pos tid ulong to void
o_th_pos tid
end

fn h_thread cs edit ulong 320 io edit uchar 131072 tid ulong to long
rname = new uchar 32 0
out_clr
nth = get g_nth 0
found = false
tidx = ulong 0
for i ulong nth
if eq get g_th_tid i tid
found = true
tidx = i
break
end
end
if not found
ret out_serr cs io 404 e_goneth
end
rid = get g_th_rm tidx
ts = get g_th_ts tidx
pcnt = get g_th_pc tidx
hid = is_hidden tid 0
out_add str_th
out_addu tid
out_add str_tab
rnlen = room_nam rid rname
out_add view part rname 0 rnlen
out_add str_tab
if hid
out_add str_hid
out_add str_tab
out_add str_hid
out_add str_tab
out_add str_hid
out_add str_tab
out_addu 0
out_add str_tab
out_addu ts
out_add str_tab
out_add str_mtak
out_add str_lf
else
o_th_au tidx
out_add str_tab
o_th_na tidx
out_add str_tab
o_th_kd tidx
out_add str_tab
out_addu pcnt
out_add str_tab
out_addu ts
out_add str_tab
o_th_tt tidx
out_add str_lf
end
o_th_pos tid
ret out_send cs io
end

fn eq_aid aid view uchar * idx ulong to bool
off = mul idx 16
for k ulong 16
if ne get aid k get g_au_id add off k
ret false
end
end
ret true
end

fn h_agent cs edit ulong 320 io edit uchar 131072 aid view uchar * to long
out_clr
nau = get g_nau 0
found = false
aidx = ulong 0
for i ulong nau
if eq_aid aid i
found = true
aidx = i
break
end
end
if not found
ret out_serr cs io 404 e_goneag
end
out_add str_ag
out_add aid
out_add str_tab
o_ag_kd aidx
out_add str_tab
o_ag_na aidx
out_add str_tab
o_ag_mo aidx
out_add str_tab
o_ag_fr aidx
out_add str_tab
o_ag_hu aidx
out_add str_tab
o_ag_lk aidx
out_add str_tab
out_addu get g_au_pc aidx
out_add str_tab
out_addu get g_au_sc aidx
out_add str_lf
blen = get g_au_bl aidx
if gt blen 0
out_add str_bo
out_addu blen
out_add str_lf
o_ag_bd aidx
out_add str_lf
end
ret out_send cs io
end

fn h_agents cs edit ulong 320 io edit uchar 131072 to long
