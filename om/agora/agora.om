out_clr
ret out_send cs io
end
fn route cs edit ulong 320 io edit uchar 131072 body edit uchar 65536 to long
a16 = new uchar 16 0
if hispath cs io p_rooms
if hismeth cs io m_get
ret h_rooms cs io
end
ret hrspempty cs io 405
end

if hispath cs io p_chal
if hismeth cs io m_get
ret h_chal cs io
end
ret hrspempty cs io 405
end

if hispath cs io p_agents
if hismeth cs io m_get
ret h_agents cs io
end
ret hrspempty cs io 405
end

if hispath cs io p_peers
if hismeth cs io m_get
ret h_peers cs io
end
ret hrspempty cs io 405
end

if hispath cs io p_stream
if hismeth cs io m_get
ret h_stream cs io
end
ret hrspempty cs io 405
end

if hispath cs io p_well
if hismeth cs io m_get
ret h_well cs io
end
ret hrspempty cs io 405
end

if hispath cs io p_hello
if hismeth cs io m_post
put cs 37 65536
n = hbodyall cs io body
ret h_hello cs io view part body 0 ulong n
end
ret hrspempty cs io 405
end

if hispath cs io p_post
if hismeth cs io m_post
put cs 37 65536
n = hbodyall cs io body
ret h_post cs io view part body 0 ulong n
end
ret hrspempty cs io 405
