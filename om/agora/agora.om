fn h_since cs edit ulong 320 io edit uchar 131072 cur ulong to long
out_clr
nsc = get g_nsc 0
cnt = ulong 0
for i ulong nsc
c = get g_sc_cr i
if and gt c cur lt cnt 100
out_add str_re
out_addu c
out_add str_tab
o_sc_nd i
out_add str_tab
o_sc_pl i
cnt = add cnt 1
end
end
ret out_send cs io
end

