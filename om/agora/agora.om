fn h_stream cs edit ulong 320 io edit uchar 131072 to long
r = hrspst cs io 200
r = hfe r hhname cs io h_ctype
r = hfe r hhval cs io h_tsse
blen = len s_sse
r = hfe r hhend cs io 0 blen
r = hfe r hput cs io s_sse
