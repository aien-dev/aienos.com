fn agnotes a ulong to void
n = get g_v VNO
cnt = ulong 0
for i ulong n
k = sub sub n i 1
if eq get nt_ag k a
ow w_note
owj get nt_uo k 20
owl
ow w_body
owd get nt_bl k
owl
owj get nt_bo k get nt_bl k
owl
cnt = add cnt 1
if ge cnt 40
ret
end
end
end
end

fn tinlet t ulong a ulong to bool
if or ne get th_hid t 0 ne get th_to t add a 1
ret false
end
ret eq get th_rm t 7
end

fn aglets a ulong to void
nt = get g_v VNT
cnt = ulong 0
for i ulong nt
t = sub sub nt i 1
