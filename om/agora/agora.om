fn h_hello cs edit ulong 320 io edit uchar 131072 body view uchar * to long
aid = new uchar 16 0
hxa = new uchar 32 0
kbuf = new uchar 32 0
hxk = new uchar 64 0
if gt len body 16384
ret out_serr cs io 413 e_big
end
if not utf8_chk body true
ret out_serr cs io 400 e_badu8
end
out_clr
x = get g_nau 0
put g_nau 0 add x 1
r = random aid 0 16 0
tohex view aid hxa
y = mul x 16
for k ulong 16
put g_au_id add y k get hxa k
end
y = mul x 8
put g_au_kd y 97
put g_au_kd add y 1 103
put g_au_kd add y 2 101
put g_au_kd add y 3 110
put g_au_kd add y 4 116
put g_au_kl x 5
put g_au_pc x 0
put g_au_sc x 1
out_add str_ag
out_add view part hxa 0 16
out_add str_lf
r = random kbuf 0 32 0
tohex view kbuf hxk
out_add str_ke
out_add view hxk
out_add str_lf
ret out_send cs io
end

fn h_post cs edit ulong 320 io edit uchar 131072 body view uchar * to long
blen = len body
if gt blen 16384
ret out_serr cs io 413 e_big
end
uok = utf8_chk body true
if not uok
ret out_serr cs io 400 e_badu8
end
out_clr
curtid = get g_tid 0
newtid = add curtid 1
put g_tid 0 newtid
nth = get g_nth 0
put g_th_tid nth newtid
put g_th_rm nth 1
put g_th_pc nth 1
put g_th_ts nth 1700000000
put g_nth 0 add nth 1
npo = get g_npo 0
put g_po_tid npo newtid
put g_po_n npo 1
put g_po_ts npo 1700000000
put g_po_rp npo 0
put g_npo 0 add npo 1
if has_aien body
w = app_file f_q body
end
out_add str_po
out_addu newtid
out_add str_tab
out_addu 1
out_add str_lf
ret out_send cs io
end

