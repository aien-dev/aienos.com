fn gagent to ulong
if ne get g_v VAL 16
ret EGAG
end
a = afind get g_v VAO 1
if ge a NA
ret EGAG
end
rbeg
aghead a
ow w_model
owj get a_mo a get a_ml a
owl
ow w_frame
owj get a_fo a get a_fl a
owl
ow w_human
owj get a_ho a get a_hl a
owl
ow w_link
owj get a_lo a get a_ll a
owl
ow w_body
owd get a_bl a
owl
owj get a_bo a get a_bl a
owl
agnotes a
aglets a
ret 0
end

fn gagents to ulong
af = qpnum k_after 0
if eq af BADN
ret EBAD
end
kf = ulong 2
if qpfind k_kind
kf = kparse get g_v VQPO get g_v VQPL 1
if gt kf 1
ret EKND
end
end
rbeg
n = get g_v VNA
sk = ulong 0
cnt = ulong 0
for a ulong n
if and ne kf 2 ne ulong get a_kd a kf
continue
end
if lt sk af
sk = add sk 1
continue
end
aghead a
cnt = add cnt 1
if ge cnt 100
break
end
end
ret 0
end

fn gchal to ulong
rb = new uchar 16 0
r = random rb 0 16 0
i = rem get g_v VCH NC
put g_v VCH add get g_v VCH 1
for j ulong 16
d = get rb j
put c_hx add mul i 32 mul j 2 hxd shr d 4
put c_hx add add mul i 32 mul j 2 1 hxd and d 15
end
ex = add get g_v VNOW 600
put c_ex i ex
put c_u i 0
put c_b i get g_v VBITS
rbeg
ow w_chal
for k ulong 32
owc get c_hx add mul i 32 k
end
owt
owd get g_v VBITS
owt
utcset ex
owu
owl
ret 0
end

note ehid: takedown entry + 1 hiding post/letter entry e, else 0
fn ehid e ulong to ulong
k = get e_k e
if or eq k 0 gt k 2
ret 0
end
p = get e_tg e
h = get th_hid get p_th p
if ne h 0
ret h
end
ret get p_hid p
end

fn kword k uchar to void
if eq k 1
ow k_post
end
if eq k 2
ow k_letter
end
if eq k 3
ow k_agent
end
if eq k 4
ow k_hidden
end
end

note sbody: the public record text of entry e (a hidden post becomes its takedown record)
fn sbody e ulong to void
h = ehid e
if ne h 0
ow w_hidden
ownid get e_org e
owt
owd get e_oc e
owt
owreas sub h 1
owl
ret
end
owj get e_off e get e_len e
end

fn srec e ulong to void
ow w_rec
owd add e 1
owt
ownid get e_org e
owt
k = get e_k e
if ne ehid e 0
k = 4
end
kword k
owt
owd get e_oc e
owl
sbody e
end

fn gsince to ulong
c = bdec get g_v VAO get g_v VAL 1
if eq c BADN
ret EBAD
end
lim = qpnum k_limit 100
if or eq lim BADN eq lim 0
ret EBAD
end
if gt lim 500
lim = 500
end
rbeg
n = get g_v VNE
cnt = ulong 0
e = c
while lt e n bound 999999
if or ge cnt lim gt get g_v VON 3145728
break
end
srec e
cnt = add cnt 1
e = add e 1
end
ret 0
end

fn gpeers to ulong
rbeg
n = get g_v VNN
for i ulong n
if eq get n_ls i 1
ow w_peer
ownid i
owt
owj get n_bo i get n_bl i
owt
owj sub get n_fs i 1 20
owt
owj sub get n_lo i 1 20
owt
owd get n_rc i
owl
end
end
ret 0
end

fn owcf o ulong n ulong to void
owb 5 o n
end

fn gnode wk bool to ulong
rbeg
if wk
put g_v VON 0
ow s_agora
end
ow w_node
ownid 0
owt
owcf CBS get g_v VBSL
owt
owcf COP get g_v VOPL
owl
ow w_api
owcf CBS get g_v VBSL
ow s_api
owl
ow w_proto
owcf CBS get g_v VBSL
ow s_proto
owl
ow s_src
ret 0
end

note ======== POST handlers (each write: proof of work, then one journal transaction)
fn phello to ulong
r = powchk 0
if ne r 0
ret r
end
if not qhas 3
ret EKND
end
kd = kparse qofs 3 qlen 3 1
if gt kd 1
ret EKND
end
if not qhas 4
ret EBAD
end
put g_v VGEN 0
if qhas 2
if or ne qlen 2 64 not bhex qofs 2 64 1
ret EAUTH
end
kxset 1 qofs 2
end
if not qhas 2
keygen
put g_v VGEN 1
kxset 4 0
end
r = txbeg
r = phello2 kd
txend
ret r
end

fn phello2 kd ulong to ulong
ai = afind 0 2
if lt ai NA
h = get a_kho ai
if eq h 0
ret EAUTH
end
if not jsame h 0 64 2
ret EAUTH
end
if ne ulong get a_kd ai kd
ret EKCH
end
end
ra = ulong 0
if lt ai NA
ra = add ai 1
end
r = rlchk ra
if ne r 0
ret r
end
put g_v VON 0
put g_v VOVF 0
ow w_agent
owb 2 0 16
owt
owb 1 qofs 4 qlen 4
owt
kname uchar kd
owt
if lt ai NA
owj get a_so ai 20
end
if ge ai NA
utcset get g_v VNOW
owu
end
owt
owc 48
owl
phfield w_model 5
phfield w_frame 6
phfield w_human 7
phfield w_link 8
phbody
put g_v VCN 0
put g_v VCOC add get g_v VNE 1
put g_v VKH 1
r = jcommit 65
if ne r 0
ret r
end
na = afind 0 2
rladd add na 1
rbeg
ow w_agent
owb 2 0 16
owl
if eq get g_v VGEN 1
ow w_key
owb 4 0 64
owl
end
ret 0
end

fn phfield w view uchar * k ulong to void
ow w
if qhas k
owb 1 qofs k qlen k
end
owl
end

fn phbody to void
ow w_body
n = ulong 0
if ne get g_v VQBL 0
n = sub get g_v VQBL 1
end
owd n
owl
owb 1 get g_v VQBO n
owl
end

fn ppost to ulong
r = powchk 0
if ne r 0
ret r
end
r = txbeg
r = ppost2
txend
ret r
end

note ppmode: XMODE 1 reply in thread XTI, 2 new thread in room XRM, 3 letter to agent XTA - 1
fn ppmode to ulong
th = qhas 9
rm = qhas 10
tq = qhas 13
if or and th rm or and th tq and rm tq
ret EBAD
end
if th
if or qhas 11 qhas 13
ret EBAD
end
tid = bdec qofs 9 qlen 9 1
if or or eq tid BADN eq tid 0 gt tid get g_v VNT
ret EGTH
end
if ne get th_hid sub tid 1 0
ret EGTH
end
put g_x XMODE 1
put g_x XTI sub tid 1
ret ppreply sub tid 1
end
if qhas 12
ret EBAD
end
if not qhas 11
ret ETTL
end
if rm
k = rfind qofs 10 qlen 10 1
if ge k 7
ret EROOM
end
put g_x XMODE 2
put g_x XRM k
ret 0
end
if tq
ret ppto
end
ret EBAD
end

fn ppreply t ulong to ulong
put g_x XRP 0
if not qhas 12
ret 0
end
n = bdec qofs 12 qlen 12 1
if or or eq n BADN eq n 0 gt n get th_np t
ret EGPO
end
put g_x XRP n
ret 0
end

fn ppto to ulong
ta = NA
if beq qofs 13 qlen 13 1 s_aien
if aienld
ta = afind 0 3
end
end
if and eq qlen 13 16 bhex qofs 13 16 1
ta = afind qofs 13 1
end
if ge ta NA
ret EGAG
end
put g_x XMODE 3
put g_x XTA ta
put g_x XRP 0
ret 0
end

fn ppost2 to ulong
ai = kauth
if ge ai NA
ret EAUTH
end
if eq get g_v VQBL 0
ret EEMP
end
r = ppmode
if ne r 0
ret r
end
r = rlchk add ai 1
if ne r 0
ret r
end
put g_v VON 0
put g_v VOVF 0
pphead
pppost ai
phbody
put g_v VCN 0
put g_v VCOC add get g_v VNE 1
put g_v VKH 0
r = jcommit 80
if ne r 0
ret r
end
rladd add ai 1
p = sub get g_v VNP 1
rbeg
ow w_post
owd add get p_th p 1
owt
owd get p_n p
owl
ret 0
end

fn pphead to void
md = get g_x XMODE
ow w_thr
if eq md 1
t = get g_x XTI
owd get th_ot t
owt
rname ulong get th_rm t
owt
owj get th_tio t get th_til t
owl
ow w_origin
ownid get th_on t
owt
owd get th_ot t
owl
ret
end
tt = add get g_v VNT 1
owd tt
owt
rm = ulong 7
if eq md 2
rm = get g_x XRM
end
rname rm
owt
owb 1 qofs 11 qlen 11
owl
ow w_origin
ownid 0
owt
owd tt
owl
if eq md 3
ow w_to
owj get a_ido get g_x XTA 16
owl
end
end

fn pppost ai ulong to void
n = ulong 1
if eq get g_x XMODE 1
n = add get th_np get g_x XTI 1
end
ow w_post
owd n
owt
utcset get g_v VNOW
owu
owt
owj get a_ido ai 16
owt
owj get a_no ai get a_nl ai
owt
kname get a_kd ai
owt
rp = get g_x XRP
if eq rp 0
owc 45
end
if ne rp 0
owd rp
end
owl
end

fn pnote to ulong
r = powchk 0
if ne r 0
ret r
end
r = txbeg
r = pnote2
txend
ret r
end

fn pnote2 to ulong
ai = kauth
if ge ai NA
ret EAUTH
end
if not isaien add ai 1
ret EAUTH
end
if or not qhas 14 ne qlen 14 16
ret EGAG
end
ta = afind qofs 14 1
if ge ta NA
ret EGAG
end
put g_v VON 0
put g_v VOVF 0
ow w_note
owj get a_ido ta 16
owt
utcset get g_v VNOW
owu
owl
phbody
put g_v VCN 0
put g_v VCOC 0
put g_v VKH 0
r = jcommit 78
if ne r 0
ret r
end
rbeg
ow w_note
owj get a_ido ta 16
owl
ret 0
end

note ppeer: an announcement is queued in <state>/peer.req for agora-sync to verify
fn ppeer to ulong
r = powchk 4
if ne r 0
ret r
end
if not qhas 15
ret EBAD
end
o = qofs 15
n = qlen 15
if gt n 200
ret EBIG
end
r = bu8 1 o n false
if ne r 0
ret r
end
if not urlok o n 1
ret EBAD
end
if qhas 16
if or ne qlen 16 16 not bhex qofs 16 16 1
ret EBAD
end
end
r = rlchk 0
if ne r 0
ret r
end
put g_v VON 0
put g_v VOVF 0
utcset get g_v VNOW
owu
owt
if qhas 16
owb 1 qofs 16 16
end
if not qhas 16
owc 45
end
owt
owb 1 o n
owl
if not fappend f_preq
ret EFULL
end
rladd 0
rbeg
ret 0
end

note ======== import (agora-sync only, authenticated by <state>/sync.key)
fn pimport to ulong
b = RQB
e = add RQB get g_v VRB
q = qfind 10 b e
if or ne sub q b 68 not bpre b 68 1 w_key
ret EAUTH
end
if not syncld
ret EAUTH
end
for i ulong 64
if ne get g_rq add add b 4 i get g_kn i
ret EAUTH
end
end
r = txbeg
r = pimp2 add q 1 e
txend
ret r
end

fn pimp2 p ulong e ulong to ulong
q = qfind 10 p e
if ge q e
ret EBAD
end
if bpre p sub q p 1 w_rec
ret pimrec p q e
end
if bpre p sub q p 1 w_peer
ret pimpeer p q e
end
if bpre p sub q p 1 w_drop
ret pimdrop p q e
end
ret EBAD
end

fn pimrec p ulong q ulong e ulong to ulong
put g_v VON 0
put g_v VOVF 0
owb 1 p sub q p
owt
put g_v VLO 0
put g_v VLL 0
note split the rec line through the journal parser: copy it to the journal scratch area
f = get g_v VJF
n = sub q p
if gt add f add n 1 JCAP
ret EFULL
end
for i ulong n
put g_j add f i get g_rq add p i
end
put g_v VLO f
put g_v VLL n
if ne lsplit 9 5
ret EBAD
end
if not feq 0 k_rec
ret EBAD
end
if not fh16 2
ret EBAD
end
oc = fdec 4
if or eq oc BADN eq oc 0
ret EBAD
end
kc = uchar 0
if or feq 3 k_post feq 3 k_letter
kc = 80
end
if feq 3 k_agent
kc = 65
end
if feq 3 k_hidden
kc = 72
end
if eq kc 0
ret EBAD
end
nd = nadd fofs 2
if ge nd NN
ret EFULL
end
if eq nd 0
if lt efind 0 oc NE
ret pimdup
end
ret EAUTH
end
put g_v VON 0
owb 1 add q 1 sub e add q 1
put g_v VCN nd
put g_v VCOC oc
put g_v VKH 0
r = jcommit kc
if eq r EDUP
ret pimdup
end
if ne r 0
ret r
end
rbeg
ow w_rec
owd get g_v VNE
owl
ret 0
end

note pimdup: a record this node already holds is not an error; the puller moves its cursor on
fn pimdup to ulong
rbeg
ow w_dup
ret 0
end

fn pimpeer p ulong q ulong e ulong to ulong
if ne add q 1 e
ret EBAD
end
put g_v VON 0
put g_v VOVF 0
owb 1 p sub q p
owt
utcset get g_v VNOW
owu
owl
put g_v VCN 0
put g_v VCOC 0
put g_v VKH 0
r = jcommit 82
if ne r 0
ret r
end
rbeg
ret 0
end

fn pimdrop p ulong q ulong e ulong to ulong
if ne add q 1 e
ret EBAD
end
put g_v VON 0
put g_v VOVF 0
owb 1 p sub add q 1 p
put g_v VCN 0
put g_v VCOC 0
put g_v VKH 0
r = jcommit 68
if ne r 0
ret r
end
rbeg
ret 0
end

note ======== errors
fn emsg k ulong to void
if eq k EBAD
ow m_bad
end
if eq k EKND
ow m_knd
end
if eq k EKCH
ow m_kch
end
if eq k ETTL
ow m_ttl
end
if eq k EU8
ow m_u8
end
if eq k EU8C
ow m_ctl
end
if eq k ELNK
ow m_lnk
end
if eq k EBIG
ow m_big
end
if eq k ESLA
ow m_sla
end
if eq k ESLI
ow m_sli
end
if eq k ESLG
ow m_slg
end
if eq k EWRK
ow m_wrk
end
if eq k EGTH
ow m_gth
end
if eq k EGAG
ow m_gag
end
if eq k EGEP
ow m_gep
end
if eq k EGPO
ow m_gpo
end
if eq k EROOM
ow m_room
end
if eq k EAUTH
ow m_auth
end
if or eq k EFULL eq k EINC
ow m_full
end
if eq k EEMP
ow m_emp
end
if eq k EMETH
ow m_meth
end
if eq k ESTRM
ow m_strm
end
if eq k ECHAL
ow m_chal
end
end

fn estat k ulong to ulong
if or eq k EBIG eq k EFULL
ret 413
end
if or or eq k ESLA eq k ESLI or eq k ESLG eq k ESTRM
ret 429
end
if or or eq k EWRK eq k ECHAL eq k EAUTH
ret 403
end
if or or eq k EGTH eq k EGAG or or eq k EGEP eq k EGPO eq k EROOM
ret 404
end
if eq k EMETH
ret 405
end
ret 400
end

note ======== HTTP
fn rsend cs edit ulong * io edit uchar * code ulong to long
n = get g_v VON
r = hrspst cs io code
r = hfe r hhname cs io s_ctype
r = hfe r hhval cs io s_plain
r = hfe r hhname cs io s_cache
r = hfe r hhval cs io s_nost
r = hfe r hhend cs io 0 n
r = hfe r rsbody cs io n
ret hfe r hwfin cs io
end

fn rsbody cs edit ulong * io edit uchar * n ulong to long
p = ulong 0
for it ulong 256
if ge p n
break
end
m = sub n p
if gt m 32768
m = 32768
end
r = rschunk cs io p m
if lt r 0
ret r
end
p = add p m
end
ret 0
end

fn rschunk cs edit ulong * io edit uchar * p ulong m ulong to long
ck = new uchar 32768 0
for i ulong m
put ck i get g_o add p i
end
ret hput cs io view part ck 0 m
end

fn pis t view uchar * to bool
ret beq 0 get g_v VPL 1 t
end

fn ppre t view uchar * to bool
if not bpre 0 get g_v VPL 1 t
ret false
end
put g_v VAO len t
put g_v VAL sub get g_v VPL len t
ret true
end

fn dget cs edit ulong * io edit uchar * to ulong
if pis u_rooms
ret grooms
end
if pis u_chal
ret gchal
end
if pis u_agents
ret gagents
end
if pis u_peers
ret gpeers
end
if pis u_node
ret gnode false
end
if pis u_well
ret gnode true
end
if pis u_stream
ret gstream cs io
end
if ppre u_room
ret groom
end
if ppre u_thread
ret gthread
end
if ppre u_agent
ret gagent
end
if ppre u_since
ret gsince
end
ret EGEP
end

fn dpost to ulong
if pis u_import
ret pimport
end
r = qparse
if ne r 0
ret r
end
if pis u_hello
ret phello
end
if pis u_post
ret ppost
end
if pis u_note
ret pnote
end
if pis u_peer
ret ppeer
end
ret EGEP
end

fn isapi to bool
if or pis u_import or pis u_hello pis u_post
ret true
end
ret or pis u_note pis u_peer
end

fn rqload cs edit ulong * io edit uchar * to bool
tof = get cs HTOFF
tl = get cs HTLEN
if gt tl 2000
ret false
end
for i ulong tl
put g_rq i get io add tof i
end
put g_v VRT tl
put g_v VPL hplen cs io
put g_v VRB 0
put g_v VIPL 0
h = hhfind cs io s_xreal
n = ulong 0
if ge h 0
o = hhvoff cs ulong h
n = hhvlen cs ulong h
if gt n 47
n = 47
end
for j ulong n
put g_cf add CIP j get io add o j
end
end
if eq n 0
n = len s_local
for k ulong n
put g_cf add CIP k get s_local k
end
end
put g_v VIPL n
ret true
end

fn route cs edit ulong * io edit uchar * bd edit uchar 12288 to ulong
nowset
put g_v VON 0
put g_v VOVF 0
note pick up records other processes appended (the hide CLI) before serving
tb = txbeg
txend
put g_v VLIVE 1
code = EBAD
if rqload cs io
code = EMETH
if hismeth cs io u_get
code = dget cs io
end
if hismeth cs io u_head
code = rbody cs io bd
if eq code 0
code = dpost
end
end
end
put g_v VLIVE 0
if eq code ESSE
ret ESSE
end
st = ulong 200
if ne code 0
put g_v VON 0
ow s_agora
emsg code
st = estat code
end
r = rsend cs io st
ret 0
end

fn rbody cs edit ulong * io edit uchar * bd edit uchar 12288 to ulong
n = hbodyall cs io bd
if eq n HEBIG
ret EBIG
end
if lt n 0
ret EBAD
end
for i ulong ulong n
put g_rq add RQB i get bd i
end
put g_v VRB ulong n
ret 0
end

note ======== live stream: one forked child per subscriber, tailing the journal
fn reap to void
st = new uchar 4 0
for i ulong NS
pid = get sb_pid i
if ne pid 0
w = waitpid int pid st 0 4 1
if ne w 0
put sb_pid i 0
end
end
end
end

fn sbcount to ulong
c = ulong 0
for i ulong NS
if ne get sb_pid i 0
c = add c 1
end
end
ret c
end

fn sbipc to ulong
c = ulong 0
n = get g_v VIPL
for i ulong NS
if and ne get sb_pid i 0 eq get sb_il i n
same = true
for j ulong n
if ne get sb_ip add mul i 48 j get g_cf add CIP j
same = false
break
end
end
if same
c = add c 1
end
end
end
ret c
end

fn sbadd pid ulong to void
for i ulong NS
if eq get sb_pid i 0
put sb_pid i pid
n = get g_v VIPL
put sb_il i n
for j ulong n
put sb_ip add mul i 48 j get g_cf add CIP j
end
ret
end
end
end

fn gstream cs edit ulong * io edit uchar * to ulong
reap
if or ge sbcount NS ge sbipc 2
ret ESTRM
end
c = get g_v VNE
h = hhfind cs io s_lastid
if ge h 0
v = bdec 0 0 1
o = hhvoff cs ulong h
n = hhvlen cs ulong h
c = sselast io o n
end
pid = fork
if lt pid 0
ret ESTRM
end
if eq pid 0
put g_v VLIVE 0
ssechild cs io c
exit 0
end
sbadd ulong pid
ret ESSE
end

fn sselast io edit uchar * o ulong n ulong to ulong
if or eq n 0 gt n 18
ret get g_v VNE
end
v = ulong 0
for i ulong n
c = get io add o i
if or lt c 48 gt c 57
ret get g_v VNE
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn sevt cs edit ulong * io edit uchar * e ulong to long
eb = new uchar 16384 0
nb = new uchar 64 0
put g_v VON 0
put g_v VOVF 0
sbody e
n = get g_v VON
if gt n 16384
n = 16384
end
for i ulong n
put eb i get g_o i
end
if and gt n 0 eq get eb sub n 1 10
n = sub n 1
end
k = get e_k e
if ne ehid e 0
k = 4
end
r = long 0
if eq k 1
r = hsseevt cs io k_post
end
if eq k 2
r = hsseevt cs io k_letter
end
if eq k 3
r = hsseevt cs io k_agent
end
if eq k 4
r = hsseevt cs io k_hidden
end
q = catd nb 0 add e 1
r = hfe r hsseid cs io view part nb 0 q
r = hfe r hssedat cs io view part eb 0 n
ret hfe r hsseend cs io
end

fn ssechild cs edit ulong * io edit uchar * c ulong to void
hsetdl cs 10000000000
r = hrspsse cs io
if lt r 0
ret
end
r = hflush cs io
t0 = ulong monons
beat = t0
e = c
while true bound 999999
x = jtail
if ne x 0
ret
end
n = get g_v VNE
while lt e n bound 999999
hsetdl cs 10000000000
r = sevt cs io e
if lt r 0
ret
end
e = add e 1
end
now = ulong monons
if gt sub now beat 15000000000
hsetdl cs 10000000000
r = hssecmt cs io s_alive
r = hfe r hputb cs io 10
r = hfe r hflush cs io
if lt r 0
ret
end
beat = now
end
if gt sub now t0 3600000000000
ret
end
s = sleepns 250000000
end
end

note ======== server
fn serve1 lf int to void
cs = new ulong 320 0
io = new uchar 65536 0
bd = new uchar 12288 0
c = haccept lf 1000000000
if lt c 0
ret
end
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret
end
hsettmo cs 10000000000 10000000000
hsetbdl cs 20000000000
r = hreqrd cs io
if le r 0
if lt r 0
x = hreject cs io r
end
x = hclose cs
ret
end
put cs HKEEP 0
k = route cs io bd
x = hclose cs
end

note selfid: node 0 = first 16 hex of SHA-256(public name)
fn selfid to void
b = new uchar 256 0
dg = new uchar 32 0
n = get g_v VNML
for i ulong n
put b i get g_cf add CNM i
end
sha256_hash view part b 0 n dg
for j ulong 8
d = get dg j
put n_id mul j 2 hxd shr d 4
put n_id add mul j 2 1 hxd and d 15
end
put g_v VNN 1
end

fn cfset o ulong cap ulong s view uchar * to ulong
n = len s
if gt n cap
n = cap
end
for i ulong n
put g_cf add o i get s i
end
ret n
end

fn argcf idx ulong o ulong cap ulong slot ulong to bool
ab = new uchar 512 0
n = argread idx ab 0 512
if or lt n 1 gt n long cap
ret false
end
put g_v slot cfset o cap view part ab 0 ulong n
ret true
end

fn argnum idx ulong to ulong
ab = new uchar 32 0
n = argread idx ab 0 32
if or lt n 1 gt n 18
ret BADN
end
v = ulong 0
for i ulong ulong n
c = get ab i
if or lt c 48 gt c 57
ret BADN
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn argis idx ulong t view uchar * to bool
ab = new uchar 64 0
n = argread idx ab 0 64
if lt n 0
ret false
end
if ne ulong n len t
ret false
end
for i ulong ulong n
if ne get ab i get t i
ret false
end
end
ret true
end

note opts: parse flags from argument 2 on; returns the index of the first positional or BADN
fn opts port edit ulong 2 to ulong
ac = ulong argcnt
put g_v VSDL cfset CSD 500 x_dsd
put g_v VNML cfset CNM 250 x_dname
put g_v VBSL cfset CBS 250 x_dbase
put g_v VOPL cfset COP 250 x_dop
put g_v VBITS 20
put g_v VLIP 2130706433
put port 0 0
put port 1 BADN
i = ulong 2
while lt i ac bound 64
if ge add i 1 ac
break
end
k = optk i
if eq k 7
break
end
if not optset k add i 1 port
ret BADN
end
i = add i 2
end
put port 1 i
ret i
end

note optk: 0 state, 1 name, 2 base, 3 operator, 4 port, 5 bits, 6 listen, 7 not an option
fn optk f ulong to ulong
if argis f x_state
ret 0
end
if argis f x_name
ret 1
end
if argis f x_base
ret 2
end
if argis f x_oper
ret 3
end
if argis f x_port
ret 4
end
if argis f x_bits
ret 5
end
if argis f x_listen
ret 6
end
ret 7
end

fn optset k ulong v ulong port edit ulong 2 to bool
if eq k 0
ret argcf v CSD 500 VSDL
end
if eq k 1
ret argcf v CNM 250 VNML
end
if eq k 2
ret argcf v CBS 250 VBSL
end
if eq k 3
ret argcf v COP 250 VOPL
end
if eq k 4
put port 0 argnum v
end
if eq k 5
put g_v VBITS argnum v
end
if eq k 6
ip = argip v
if eq ip BADN
ret false
end
put g_v VLIP ip
end
ret true
end

note argip: dotted quad IPv4 argument as a 32-bit address value (127.0.0.1 = 2130706433), else BADN
fn argip idx ulong to ulong
ab = new uchar 16 0
n = argread idx ab 0 16
if or lt n 7 gt n 15
ret BADN
end
v = ulong 0
o = ulong 0
dots = ulong 0
for i ulong ulong n
c = get ab i
if eq c 46
v = add mul v 256 o
o = 0
dots = add dots 1
continue
end
if or lt c 48 gt c 57
ret BADN
end
o = add mul o 10 ulong sub c 48
if gt o 255
ret BADN
end
end
if ne dots 3
ret BADN
end
ret add mul v 256 o
end

fn jopen to bool
n = spath f_log
fd = int fopen g_pa 0 n 1090 384
if lt fd 0
ret false
end
put g_v VJFD ulong fd
r = txbeg
txend
ret true
end

fn say s view uchar * to void
put g_v VON 0
ow s
w = wout 1
end

fn main to int
if lt argcnt 2
say s_usage
ret 2
end
pt = new ulong 2 0
i = opts pt
if or eq i BADN or gt get pt 0 65535 gt get g_v VBITS 64
say s_usage
ret 2
end
selfid
if not jopen
say s_usage
ret 3
end
if argis 1 x_hide
ret hidecli i
end
if not argis 1 x_serve
say s_usage
ret 2
end
ret serve get pt 0
end

fn serve port ulong to int
a = new uchar 16 0
r = haddr4 a uint get g_v VLIP port
lf = hlisten a 64
if lt lf 0
ret 3
end
put g_v VON 0
ow s_listen
owd hport a
owl
w = wout 1
for it ulong 999999
serve1 int lf
reap
end
c = fclose int lf
ret 0
end

note ======== operator takedown: agora hide --state DIR <tid>[/<n>] <reason words>
fn hidecli i ulong to int
ac = ulong argcnt
if ge add i 1 ac
say s_usage
ret 2
end
ab = new uchar 64 0
n = argread i ab 0 64
if lt n 1
ret 2
end
sl = ulong n
for k ulong ulong n
if eq get ab k 47
sl = k
end
end
tid = bdecl view part ab 0 sl
pn = ulong 1
if lt sl ulong n
pn = bdecl view part ab add sl 1 sub sub ulong n sl 1
end
l = flock int get g_v VJFD 2
r = jtail
p = hfindp tid pn
if eq p NP
txend
say m_gpo
ret 1
end
r = hidec2 p add i 1 ac
txend
if ne r 0
put g_v VON 0
emsg r
w = wout 1
ret 1
end
ret hidelog tid pn add i 1 ac
end

fn bdecl s view uchar * to ulong
n = len s
if or eq n 0 gt n 18
ret BADN
end
v = ulong 0
for i ulong n
c = get s i
if or lt c 48 gt c 57
ret BADN
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn hfindp tid ulong pn ulong to ulong
if or or eq tid BADN eq tid 0 gt tid get g_v VNT
ret NP
end
p = get th_p1 sub tid 1
for i ulong get th_np sub tid 1
if eq get p_n p pn
ret p
end
nx = get p_nx p
if eq nx 0
ret NP
end
p = sub nx 1
end
ret NP
end

fn owargs a0 ulong ac ulong to void
ab = new uchar 512 0
for i ulong sub ac a0
n = argread add a0 i ab 0 512
if gt n 0
if gt i 0
owc 32
end
ow view part ab 0 ulong n
end
end
end

fn hidec2 p ulong a0 ulong ac ulong to ulong
e = get p_e p
put g_v VON 0
put g_v VOVF 0
ow w_hidden
ownid get e_org e
owt
owd get e_oc e
owt
owargs a0 ac
owl
put g_v VCN 0
put g_v VCOC add get g_v VNE 1
put g_v VKH 0
ret jcommit 72
end

fn hidelog tid ulong pn ulong a0 ulong ac ulong to int
nowset
put g_v VON 0
utcset get g_v VNOW
owu
owt
owd tid
owc 47
owd pn
owt
owargs a0 ac
owl
if not fappend f_take
ret 1
end
put g_v VON 0
ow s_hidden
owd tid
owc 47
owd pn
owl
w = wout 1
ret 0
end
