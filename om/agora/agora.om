if hispath cs io p_peer
if hismeth cs io m_post
put cs 37 65536
n = hbodyall cs io body
ret h_peer cs io view part body 0 ulong n
end
ret hrspempty cs io 405
end

toff = get cs 16
tlen = hplen cs io

if str_pfx view part io toff tlen p_room_p
if hismeth cs io m_get
pl = len p_room_p
if gt tlen pl
rid = room_id view part io add toff pl sub tlen pl
if gt rid 0
ret h_room cs io rid
end
end
ret out_serr cs io 404 e_room
end
ret hrspempty cs io 405
end

if str_pfx view part io toff tlen p_th_p
if hismeth cs io m_get
pl = len p_th_p
if gt tlen pl
tid = dectou view part io add toff pl sub tlen pl
if gt tid 0
ret h_thread cs io tid
end
end
ret out_serr cs io 404 e_goneth
end
ret hrspempty cs io 405
end

if str_pfx view part io toff tlen p_ag_p
if hismeth cs io m_get
pl = len p_ag_p
if eq tlen add pl 16
for k ulong 16
put a16 k get io add add toff pl k
end
ret h_agent cs io view a16
end
ret out_serr cs io 404 e_goneag
end
ret hrspempty cs io 405
end

if str_pfx view part io toff tlen p_sc_p
if hismeth cs io m_get
pl = len p_sc_p
cur = ulong 0
if gt tlen pl
cur = dectou view part io add toff pl sub tlen pl
end
ret h_since cs io cur
end
ret hrspempty cs io 405
end

ret hrspempty cs io 404
end

fn str_pfx s view uchar * p view uchar * to bool
ns = len s
np = len p
if lt ns np
ret false
end
for i ulong np
if ne get s i get p i
ret false
end
end
ret true
end

fn serve1 lf int cs edit ulong 320 io edit uchar 131072 body edit uchar 65536 to long
c = haccept lf 30000000000
if lt c 0
ret c
end
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret 0
end
hsettmo cs 10000000000 10000000000
hsetbdl cs 20000000000
for k ulong 10
r = hreqrd cs io
if le r 0
if lt r 0
x = hreject cs io r
end
break
end
r = route cs io body
if lt r 0
break
end
if eq hnext cs io 0
break
end
end
r = hclose cs
ret 0
end

fn main to int
pb = new uchar 16 0
pwb = new uchar 16 0
ab = new uchar 64 0
a1 = new uchar 64 0
ac = argcnt
if lt ac 2
ret 1
end
n1 = argread 1 a1 0 64
if eq n1 0
ret 1
end

if str_eq view part a1 0 ulong n1 cmd_hide
ret 0
end
if str_eq view part a1 0 ulong n1 cmd_unhd
ret 0
end
if str_eq view part a1 0 ulong n1 cmd_note
ret 0
end

port = ulong 0
put g_pow 0 16
idx = ulong 1
while lt idx ulong ac bound 20
nb = argread int idx ab 0 64
if str_eq view part ab 0 ulong nb arg_port
if lt add idx 1 ulong ac
idx = add idx 1
np = argread int idx pb 0 16
port = dectou view part pb 0 ulong np
end
end
if str_eq view part ab 0 ulong nb arg_stat
if lt add idx 1 ulong ac
idx = add idx 1
nsd = argread int idx g_sdir 0 256
if gt nsd 0
put g_sdln 0 ulong nsd
end
end
end
if str_eq view part ab 0 ulong nb arg_pow
if lt add idx 1 ulong ac
idx = add idx 1
npw = argread int idx pwb 0 16
pw = dectou view part pwb 0 ulong npw
put g_pow 0 pw
end
end
idx = add idx 1
end

cs = new ulong 320 0
io = new uchar 131072 0
body = new uchar 65536 0
a = new uchar 16 0
ab = new uchar 32 0
r = haddr4 a 2130706433 port
lf = hlisten a 16
if lt lf 0
ret 2
end
for i ulong len eport
put ab i get eport i
end
k = pdec ab len eport hport a
put ab k 10
r = wrout view part ab 0 add k 1
if lt r 0
ret 3
end

for j ulong 1000
r = serve1 int lf cs io body
if lt r 0
break
end
end
c = fclose int lf
ret 0
end

fn pdec b edit uchar 32 p ulong v ulong to ulong
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
q = p
for k ulong sub 20 i
put b q get d add i k
q = add q 1
end
ret q
end

fn wrout b view uchar * to long
p = ulong 0
for it ulong 4096
if ge p len b
ret 0
end
w = int write 1 b p sub len b p
if le w 0
ret -1
end
p = add p ulong w
end
ret 0
end