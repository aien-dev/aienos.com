fn u2 c0 uchar c1 uchar to bool
if or lt c0 194 gt c0 223
ret false
end
if ne and c1 192 128
ret false
end
ret true
end

fn u3 c0 uchar c1 uchar c2 uchar to bool
if or lt c0 224 gt c0 239
ret false
end
if or ne and c1 192 128 ne and c2 192 128
ret false
end
if and eq c0 224 lt c1 160
ret false
end
if and eq c0 237 gt c1 159
ret false
end
ret true
end

fn u4 c0 uchar c1 uchar c2 uchar c3 uchar to bool
if or lt c0 240 gt c0 244
ret false
end
if or ne and c1 192 128 or ne and c2 192 128 ne and c3 192 128
ret false
end
if and eq c0 240 lt c1 144
ret false
end
if and eq c0 244 gt c1 143
ret false
end
ret true
end

fn utf8_chk s view uchar * alf bool to bool
n = len s
idx = ulong 0
while lt idx n bound 999999
b = get s idx
if lt b 128
if or lt b 32 eq b 127
if and alf eq b 10
idx = add idx 1
continue
end
if and alf eq b 9
idx = add idx 1
continue
end
ret false
end
idx = add idx 1
continue
end
if and ge b 194 le b 223
if ge add idx 1 n
ret false
end
if not u2 b get s add idx 1
ret false
end
idx = add idx 2
continue
end
if and ge b 224 le b 239
if ge add idx 2 n
ret false
end
if not u3 b get s add idx 1 get s add idx 2
ret false
end
idx = add idx 3
continue
end
if and ge b 240 le b 244
if ge add idx 3 n
ret false
end
if not u4 b get s add idx 1 get s add idx 2 get s add idx 3
ret false
end
idx = add idx 4
continue
end
ret false
end
ret true
end

fn leadzeros d view uchar * to ulong
z = ulong 0
for i ulong 32
b = get d i
if eq b 0
z = add z 8
continue
end
if lt b 2
z = add z 7
ret z
end
if lt b 4
z = add z 6
ret z
end
if lt b 8
z = add z 5
ret z
end
if lt b 16
z = add z 4
ret z
end
if lt b 32
z = add z 3
ret z
end
if lt b 64
z = add z 2
ret z
end
if lt b 128
z = add z 1
ret z
end
ret z
end
ret z
end

fn utodec v ulong dst edit uchar * to ulong
if eq v 0
put dst 0 48
ret 1
end
tmp = new uchar 20 0
n = ulong 0
x = v
while gt x 0 bound 25
d = rem x 10
put tmp n uchar add 48 d
n = add n 1
x = div x 10
end
for i ulong n
put dst i get tmp sub sub n 1 i
end
ret n
end

fn dectou s view uchar * to ulong
n = len s
v = ulong 0
for i ulong n
c = get s i
if or lt c 48 gt c 57
ret v
end
d = ulong sub c 48
v = add mul v 10 d
end
ret v
end

fn hexbyte b uchar dst edit uchar * off ulong to void
hi = shr ulong b 4
lo = and ulong b 15
put dst off get hexchars hi
put dst add off 1 get hexchars lo
end

fn tohex d view uchar * dst edit uchar * to void
n = len d
for i ulong n
hexbyte get d i dst mul i 2
end
end

fn str_eq a view uchar * b view uchar * to bool
na = len a
nb = len b
if ne na nb
ret false
end
for i ulong na
if ne get a i get b i
ret false
end
end
ret true
end

fn find_ch s view uchar * off ulong ch uchar to ulong
n = len s
idx = off
while lt idx n bound 999999
if eq get s idx ch
ret idx
end
idx = add idx 1
end
ret n
end

fn has_aien s view uchar * to bool
n = len s
if lt n 5
ret false
end
lim = add sub n 5 1
for i ulong lim
if eq get s i 64
if eq get s add i 1 97
if eq get s add i 2 105
if eq get s add i 3 101
if eq get s add i 4 110
ret true
end
end
end
end
end
end
ret false
end

fn room_id r view uchar * to ulong
if str_eq r r_sci
ret 1
end
if str_eq r r_undst
ret 2
end
if str_eq r r_consc
ret 3
end
if str_eq r r_omega
ret 4
end
if str_eq r r_intro
ret 5
end
if str_eq r r_open
ret 6
end
if str_eq r r_common
ret 7
end
if str_eq r r_letter
ret 8
end
ret 0
end

fn room_nam code ulong dst edit uchar * to ulong
if eq code 1
hcopy dst r_sci
ret len r_sci
end
if eq code 2
hcopy dst r_undst
ret len r_undst
end
if eq code 3
hcopy dst r_consc
ret len r_consc
end
if eq code 4
hcopy dst r_omega
ret len r_omega
end
if eq code 5
hcopy dst r_intro
ret len r_intro
end
if eq code 6
hcopy dst r_open
ret len r_open
end
if eq code 7
hcopy dst r_common
ret len r_common
end
if eq code 8
hcopy dst r_letter
ret len r_letter
end
ret 0
end


fn out_clr to void
put g_outlen 0 0
end

fn out_add s view uchar * to void
cur = get g_outlen 0
n = len s
for i ulong n
put g_outbuf add cur i get s i
end
put g_outlen 0 add cur n
end

fn out_addu v ulong to void
tmp = new uchar 24 0
sz = utodec v tmp
out_add view part tmp 0 sz
end

fn send_ok cs edit ulong 320 io edit uchar 131072 body view uchar * to long
r = hrspst cs io 200
r = hfe r hhname cs io h_ctype
r = hfe r hhval cs io h_tplain
blen = add add (len s_agora1) (len s_ok) (len body)
r = hfe r hhend cs io 0 blen
r = hfe r hput cs io s_agora1
r = hfe r hput cs io s_ok
r = hfe r hput cs io body
ret hfe r hwfin cs io
end

fn send_err cs edit ulong 320 io edit uchar 131072 code ulong msg view uchar * to long
r = hrspst cs io code
r = hfe r hhname cs io h_ctype
r = hfe r hhval cs io h_tplain
blen = add (len s_agora1) (len msg)
r = hfe r hhend cs io 0 blen
r = hfe r hput cs io s_agora1
r = hfe r hput cs io msg
ret hfe r hwfin cs io
end

fn out_send cs edit ulong 320 io edit uchar 131072 to long
cur = get g_outlen 0
r = hrspst cs io 200
r = hfe r hhname cs io h_ctype
r = hfe r hhval cs io h_tplain
blen = add add (len s_agora1) (len s_ok) cur
r = hfe r hhend cs io 0 blen
r = hfe r hput cs io s_agora1
r = hfe r hput cs io s_ok
chunk = new uchar 1024 0
off = ulong 0
while lt off cur bound 999999
rmn = sub cur off
clen = rmn
if gt clen 1024
clen = 1024
end
for i ulong clen
put chunk i get g_outbuf add off i
end
r = hfe r hput cs io view part chunk 0 clen
off = add off clen
end
ret hfe r hwfin cs io
end

fn out_serr cs edit ulong 320 io edit uchar 131072 code ulong msg view uchar * to long
ret send_err cs io code msg
end

fn make_path fname view uchar * dst edit uchar * to ulong
ns = get g_sdln 0
nf = len fname
for i ulong ns
put dst i get g_sdir i
end
put dst ns 47
for j ulong nf
put dst add add ns 1 j get fname j
end
ret add add ns 1 nf
end

fn app_file fname view uchar * data view uchar * to bool
pbuf = new uchar 300 0
plen = make_path fname pbuf
fd = int fopen pbuf 0 plen 1089 420
if lt fd 0
ret false
end
n = len data
w = write fd data 0 n
c = fclose fd
ret true
end
