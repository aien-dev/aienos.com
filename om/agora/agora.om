note ======== byte sources: 0 journal, 1 request, 2 key hash hex, 3 aien.id, 4 new key, 5 config
fn bat m ulong p ulong to uchar
if eq m 1
ret get g_rq p
end
if eq m 2
ret get g_kx p
end
if eq m 3
ret get g_ai p
end
if eq m 4
ret get g_kn p
end
if eq m 5
ret get g_cf p
end
ret get g_j p
end

fn beq o ulong n ulong m ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne bat m add o i get t i
ret false
end
end
ret true
end

fn bpre o ulong n ulong m ulong t view uchar * to bool
if lt n len t
ret false
end
ret beq o len t m t
end

fn bdec o ulong n ulong m ulong to ulong
if or eq n 0 gt n 18
ret BADN
end
v = ulong 0
for i ulong n
c = bat m add o i
if or lt c 48 gt c 57
ret BADN
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn bhex o ulong n ulong m ulong to bool
for i ulong n
c = bat m add o i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
end
ret true
end

fn hxd v uchar to uchar
if lt v 10
ret add v 48
end
ret add v 87
end

note jsame: journal bytes at a equal source m bytes at b for n bytes
fn jsame a ulong b ulong n ulong m ulong to bool
for i ulong n
if ne get g_j add a i bat m add b i
ret false
end
end
ret true
end

note ======== UTF-8 and control characters (sources as bat)
fn u8n m ulong o ulong i ulong n ulong to ulong
c = bat m add o i
k = ulong 0
lo = uchar 128
hi = uchar 191
if and ge c 194 le c 223
k = 2
end
if eq c 224
k = 3
lo = 160
end
if or and ge c 225 le c 236 and ge c 238 le c 239
k = 3
end
if eq c 237
k = 3
hi = 159
end
if eq c 240
k = 4
lo = 144
end
if and ge c 241 le c 243
k = 4
end
if eq c 244
k = 4
hi = 143
end
if eq k 0
ret 0
end
if gt add i k n
ret 0
end
c1 = bat m add add o i 1
if or lt c1 lo gt c1 hi
ret 0
end
for j ulong sub k 2
cj = bat m add add add o i 2 j
if or lt cj 128 gt cj 191
ret 0
end
end
if and eq c 194 lt c1 160
ret 99
end
ret k
end

fn bu8 m ulong o ulong n ulong lf bool to ulong
i = ulong 0
while lt i n bound 999999
c = bat m add o i
if lt c 128
if or lt c 32 eq c 127
if not and lf eq c 10
ret EU8C
end
end
i = add i 1
continue
end
k = u8n m o i n
if eq k 99
ret EU8C
end
if eq k 0
ret EU8
end
i = add i k
end
ret 0
end

note ======== output buffer g_o
fn ow s view uchar * to void
n = len s
b = get g_v VON
if gt add b n OCAP
put g_v VOVF 1
ret
end
for i ulong n
put g_o add b i get s i
end
put g_v VON add b n
end

fn owc c uchar to void
b = get g_v VON
if ge b OCAP
put g_v VOVF 1
ret
end
put g_o b c
put g_v VON add b 1
end

fn owb m ulong o ulong n ulong to void
b = get g_v VON
if gt add b n OCAP
put g_v VOVF 1
ret
end
for i ulong n
put g_o add b i bat m add o i
end
put g_v VON add b n
end

fn owj o ulong n ulong to void
b = get g_v VON
if gt add b n OCAP
put g_v VOVF 1
ret
end
for i ulong n
put g_o add b i get g_j add o i
end
put g_v VON add b n
end

fn owd v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
ow view part d i sub 20 i
end

fn owt to void
owc 9
end

fn owl to void
owc 10
end

fn owu to void
for i ulong 20
owc get g_u i
end
end

fn ownid i ulong to void
for j ulong 16
owc get n_id add mul i 16 j
end
end

fn rbeg to void
put g_v VON 0
put g_v VOVF 0
ow s_agora
ow s_ok
end

note wout: g_o to fd (stdout 1 or a file)
fn wout fd int to bool
n = get g_v VON
p = ulong 0
for it ulong 4096
if ge p n
ret true
end
w = write fd g_o p sub n p
if le w 0
ret false
end
p = add p ulong w
end
ret true
end

note ======== journal writer at VJW
fn jwc c uchar to void
b = get g_v VJW
if lt b JCAP
put g_j b c
end
put g_v VJW add b 1
end

fn jwd v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i
jwc get d add i k
end
end

note ======== time
fn u2 p ulong v ulong to void
put g_u p uchar add div v 10 48
put g_u add p 1 uchar add rem v 10 48
end

note utcset: g_u = YYYY-MM-DDTHH:MM:SSZ for t seconds since 1970 (days-from-civil inverse)
fn ucivil d ulong to void
z = add d 719468
era = div z 146097
doe = sub z mul era 146097
x = sub doe div doe 1460
x = add x div doe 36524
x = sub x div doe 146096
yoe = div x 365
x = add mul 365 yoe div yoe 4
x = sub x div yoe 100
x = sub doe x
ucivil2 add yoe mul era 400 x
end

fn ucivil2 y0 ulong doy ulong to void
mp = div add mul 5 doy 2 153
dd = add sub doy div add mul 153 mp 2 5 1
y = y0
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
u2 0 div y 100
u2 2 rem y 100
put g_u 4 45
u2 5 m
put g_u 7 45
u2 8 dd
end

fn utcset t ulong to void
ucivil div t 86400
s = rem t 86400
put g_u 10 84
u2 11 div s 3600
put g_u 13 58
u2 14 rem div s 60 60
put g_u 16 58
u2 17 rem s 60
put g_u 19 90
end

fn nowset to void
put g_v VNOW div ulong realns 1000000000
end

note ======== state dir paths and small files
fn spath f view uchar * to ulong
n = get g_v VSDL
for i ulong n
put g_pa i get g_cf add CSD i
end
put g_pa n 47
for j ulong len f
put g_pa add add n 1 j get f j
end
ret add add n 1 len f
end

note fappend: g_o appended to <state>/f
fn fappend f view uchar * to bool
n = spath f
fd = int fopen g_pa 0 n 1089 420
if lt fd 0
ret false
end
ok = wout fd
c = fclose fd
ret and ok eq c 0
end

note aienld: g_ai holds the 16 hex aien author id from <state>/aien.id
fn aienld to bool
n = spath f_aid
fd = int fopen g_pa 0 n 0 0
if lt fd 0
ret false
end
r = read fd g_ai 0 64
c = fclose fd
if lt r 16
ret false
end
ret bhex 0 16 3
end

note syncld: g_kn holds the 64 hex import key from <state>/sync.key
fn syncld to bool
n = spath f_sync
fd = int fopen g_pa 0 n 0 0
if lt fd 0
ret false
end
r = read fd g_kn 0 64
c = fclose fd
if lt r 64
ret false
end
ret bhex 0 64 4
end

note ======== lookups
fn nsame o ulong i ulong to bool
for j ulong 16
if ne get g_j add o j get n_id add mul i 16 j
ret false
end
end
ret true
end

fn nfind o ulong to ulong
n = get g_v VNN
for i ulong n
if nsame o i
ret i
end
end
ret NN
end

fn nadd o ulong to ulong
i = nfind o
if lt i NN
ret i
end
n = get g_v VNN
if ge n NN
ret NN
end
for j ulong 16
put n_id add mul n 16 j get g_j add o j
end
put g_v VNN add n 1
ret n
end

fn asame i ulong o ulong m ulong to bool
a = get a_ido i
for j ulong 16
if ne bat m add o j get g_j add a j
ret false
end
end
ret true
end

fn afind o ulong m ulong to ulong
n = get g_v VNA
for i ulong n
if asame i o m
ret i
end
end
ret NA
end

fn efind nd ulong oc ulong to ulong
n = get g_v VNE
for i ulong n
if and eq get e_org i nd eq get e_oc i oc
ret i
end
end
ret NE
end

fn tfind rn ulong tt ulong to ulong
if eq rn 0
if or eq tt 0 gt tt get g_v VNT
ret NT
end
if ne get th_on sub tt 1 0
ret NT
end
ret sub tt 1
end
n = get g_v VNT
for i ulong n
if and eq get th_on i rn eq get th_ot i tt
ret i
end
end
ret NT
end

note rfind: room index 0..6, 7 letters, 8 unknown
fn rfind o ulong n ulong m ulong to ulong
if beq o n m r_sci
ret 0
end
if beq o n m r_undst
ret 1
end
if beq o n m r_consc
ret 2
end
if beq o n m r_omega
ret 3
end
if beq o n m r_intro
ret 4
end
if beq o n m r_open
ret 5
end
if beq o n m r_common
ret 6
end
if beq o n m r_letter
ret 7
end
ret 8
end

fn rname k ulong to void
if eq k 0
ow r_sci
end
if eq k 1
ow r_undst
end
if eq k 2
ow r_consc
end
if eq k 3
ow r_omega
end
if eq k 4
ow r_intro
end
if eq k 5
ow r_open
end
if eq k 6
ow r_common
end
if eq k 7
ow r_letter
end
end

fn rdesc k ulong to void
if eq k 0
ow d_sci
end
if eq k 1
ow d_undst
end
if eq k 2
ow d_consc
end
if eq k 3
ow d_omega
end
if eq k 4
ow d_intro
end
if eq k 5
ow d_open
end
if eq k 6
ow d_common
end
end

fn kname k uchar to void
if eq k 0
ow k_human
ret
end
ow k_agent
end

note kparse: 0 human, 1 agent, 2 neither
fn kparse o ulong n ulong m ulong to ulong
if beq o n m k_human
ret 0
end
if beq o n m k_agent
ret 1
end
ret 2
end

note ======== journal line parser over [VPC, VPE)
fn lnext to bool
p = get g_v VPC
e = get g_v VPE
for i ulong sub e p
if eq get g_j add p i 10
put g_v VLO p
put g_v VLL i
put g_v VPC add add p i 1
ret true
end
end
ret false
end

fn lsplit sep uchar to ulong
o = get g_v VLO
n = get g_v VLL
k = ulong 0
s = o
for i ulong n
if eq get g_j add o i sep
if ge k 15
ret 99
end
put g_fo k s
put g_fl k sub add o i s
k = add k 1
s = add add o i 1
end
end
put g_fo k s
put g_fl k sub add o n s
put g_v VFC add k 1
ret add k 1
end

fn fofs k ulong to ulong
ret get g_fo k
end

fn flen k ulong to ulong
ret get g_fl k
end

fn feq k ulong t view uchar * to bool
ret beq get g_fo k get g_fl k 0 t
end

fn fdec k ulong to ulong
ret bdec get g_fo k get g_fl k 0
end

fn fh16 k ulong to bool
if ne get g_fl k 16
ret false
end
ret bhex get g_fo k 16 0
end

fn fu8 k ulong cap ulong to ulong
n = get g_fl k
if gt n cap
ret EBIG
end
ret bu8 0 get g_fo k n false
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

note futc: field k is YYYY-MM-DDTHH:MM:SSZ
fn futc k ulong to bool
if ne get g_fl k 20
ret false
end
o = get g_fo k
for i ulong 20
c = get g_j add o i
w = uchar 0
if or eq i 4 eq i 7
w = 45
end
if eq i 10
w = 84
end
if or eq i 13 eq i 16
w = 58
end
if eq i 19
w = 90
end
if eq w 0
if not isdig c
ret false
end
end
if ne w 0
if ne c w
ret false
end
end
end
ret true
end

note lbody: the next line is "body <n>", then n bytes and LF; sets VBO VBL
fn lbody cap ulong to ulong
if not lnext
ret EBAD
end
o = get g_v VLO
n = get g_v VLL
if not bpre o n 0 w_body
ret EBAD
end
b = bdec add o 5 sub n 5 0
if eq b BADN
ret EBAD
end
if gt b cap
ret EBIG
end
p = get g_v VPC
if gt add add p b 1 get g_v VPE
ret EBAD
end
if ne get g_j add p b 10
ret EBAD
end
put g_v VBO p
put g_v VBL b
put g_v VPC add add p b 1
ret 0
end

note ======== apply: entries
fn eadd k uchar tg ulong to ulong
e = get g_v VNE
put g_v VNE add e 1
put e_k e k
put e_tg e tg
put e_off e get g_v VHPO
put e_len e get g_v VHPL
org = get g_v VHN
put e_org e org
put e_oc e get g_v VHOC
put e_ro e 0
put e_rl e 0
if ne org 0
put n_rc org add get n_rc org 1
end
ret e
end

note ======== apply: post and letter records
note thread\t<root_tid>\t<room>\t<title>
note origin\t<root_node>\t<root_tid>
note [to\t<to_id>]           (first post of a letter only)
note post\t<n>\t<utc>\t<author_id>\t<author_name>\t<author_kind>\t<reply or ->
note body <len>\n<bytes>\n
fn apost1 to ulong
if not lnext
ret EBAD
end
if ne lsplit 9 4
ret EBAD
end
if not feq 0 k_thread
ret EBAD
end
tt = fdec 1
if or eq tt BADN eq tt 0
ret EBAD
end
put g_x XTT tt
rm = rfind fofs 2 flen 2 0
if ge rm 8
ret EROOM
end
put g_x XRM rm
r = fu8 3 160
if ne r 0
ret r
end
if eq flen 3 0
ret ETTL
end
put g_x XTO fofs 3
put g_x XTL flen 3
if not lnext
ret EBAD
end
if ne lsplit 9 3
ret EBAD
end
if or not feq 0 k_origin not fh16 1
ret EBAD
end
if ne fdec 2 tt
ret EBAD
end
rn = nadd fofs 1
if ge rn NN
ret EFULL
end
put g_x XRN rn
put g_x XTA 0
if not lnext
ret EBAD
end
if eq lsplit 9 2
if or not feq 0 k_to not fh16 1
ret EBAD
end
ta = afind fofs 1 0
if ge ta NA
ret EGAG
end
put g_x XTA add ta 1
if not lnext
ret EBAD
end
if ne lsplit 9 7
ret EBAD
end
end
ret apost2
end

fn apost2 to ulong
if ne get g_v VFC 7
ret EBAD
end
if not feq 0 k_post
ret EBAD
end
pn = fdec 1
if or eq pn BADN eq pn 0
ret EBAD
end
put g_x XPN pn
if not futc 2
ret EBAD
end
put g_x XUO fofs 2
if not fh16 3
ret EBAD
end
put g_x XAI fofs 3
r = fu8 4 64
if ne r 0
ret r
end
if eq flen 4 0
ret EBAD
end
put g_x XANO fofs 4
put g_x XANL flen 4
kd = kparse fofs 5 flen 5 0
if gt kd 1
ret EKND
end
put g_x XKD kd
rp = ulong 0
if not feq 6 k_dash
rp = fdec 6
if or eq rp BADN eq rp 0
ret EBAD
end
end
put g_x XRP rp
r = lbody 8192
if ne r 0
ret r
end
if eq get g_v VBL 0
ret EEMP
end
r = bu8 0 get g_v VBO get g_v VBL true
if ne r 0
ret r
end
if ne get g_v VPC get g_v VPE
ret EBAD
end
ret apost3
end

fn apost3 to ulong
org = get g_v VHN
rn = get g_x XRN
tt = get g_x XTT
rm = get g_x XRM
ta = get g_x XTA
if eq get g_x XPN 1
if xor eq rm 7 ne ta 0
ret EBAD
end
if ne rn org
ret EBAD
end
if eq org 0
if ne tt add get g_v VNT 1
ret EBAD
end
end
if ne org 0
if lt tfind rn tt NT
ret EDUP
end
end
if ge get g_v VNT NT
ret EFULL
end
ret apost4 NT
end
if ne ta 0
ret EBAD
end
ti = tfind rn tt
if ge ti NT
ret EGTH
end
if ne ulong get th_rm ti rm
ret EBAD
end
ret apost4 ti
end

fn tnew to ulong
t = get g_v VNT
put g_v VNT add t 1
rm = get g_x XRM
put th_rm t uchar rm
put th_to t get g_x XTA
put th_tio t get g_x XTO
put th_til t get g_x XTL
put th_np t 0
put th_hid t 0
put th_on t get g_x XRN
put th_ot t get g_x XTT
put th_p1 t get g_v VNP
put rm_nt rm add get rm_nt rm 1
ret t
end

fn apost4 ti ulong to ulong
if or ge get g_v VNP NP ge get g_v VNE NE
ret EFULL
end
t = ti
if ge ti NT
t = tnew
end
p = get g_v VNP
put g_v VNP add p 1
put p_th p t
put p_n p add get th_np t 1
put p_uo p get g_x XUO
put p_ai p get g_x XAI
put p_ano p get g_x XANO
put p_anl p get g_x XANL
put p_kd p uchar get g_x XKD
put p_rp p get g_x XRP
put p_bo p get g_v VBO
put p_bl p get g_v VBL
put p_hid p 0
put p_nx p 0
if gt get th_np t 0
put p_nx get th_pl t add p 1
end
put th_pl t p
put th_np t add get th_np t 1
put th_lu t get g_x XUO
rm = ulong get th_rm t
put rm_np rm add get rm_np rm 1
put rm_lu rm add get g_x XUO 1
a = afind get g_x XAI 0
if lt a NA
put a_pc a add get a_pc a 1
end
ek = uchar 1
if eq rm 7
ek = 2
end
e = eadd ek p
put p_e p e
if and eq get g_v VLIVE 1 eq get g_v VHN 0
aqueue p
end
ret 0
end

note ======== Aien queue: local posts that mention @aien, sit in introductions or commons, or
note are letters to Aien; never Aien's own posts. Imported records never reach the queue.
fn hasat o ulong n ulong to bool
if lt n 5
ret false
end
for i ulong sub n 4
if beq add o i 5 0 s_at
ret true
end
end
ret false
end

fn aqhit p ulong ok bool to bool
t = get p_th p
rm = get th_rm t
if or eq rm 4 eq rm 6
ret true
end
if hasat get p_bo p get p_bl p
ret true
end
if eq get p_n p 1
if hasat get th_tio t get th_til t
ret true
end
end
tg = get th_to t
if and ok ne tg 0
if asame sub tg 1 0 3
ret true
end
end
ret false
end

fn aqueue p ulong to void
ok = aienld
if ok
if jsame get p_ai p 0 16 3
ret
end
end
if not aqhit p ok
ret
end
qb = new uchar 64 0
n = qline qb p
fd = int fopen g_pa 0 spath f_queue 1089 420
if lt fd 0
ret
end
w = write fd qb 0 n
c = fclose fd
end

fn catd b edit uchar 64 p ulong v ulong to ulong
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
q = p
for k ulong sub 20 i
put b q get d add i k
q = add q 1
end
ret q
end

fn qline b edit uchar 64 p ulong to ulong
q = catd b 0 add get p_th p 1
put b q 9
q = catd b add q 1 get p_n p
put b q 9
q = add q 1
a = get p_ai p
for i ulong 16
put b add q i get g_j add a i
end
put b add q 16 10
ret add q 17
end

note ======== apply: agent profiles
note agent\t<id>\t<name>\t<kind>\t<since_utc>\t<posts>, model, framework, human, link, body about
fn aline t view uchar * cap ulong slot ulong to ulong
if not lnext
ret EBAD
end
if ne lsplit 9 2
ret EBAD
end
if not feq 0 t
ret EBAD
end
r = fu8 1 cap
if ne r 0
ret r
end
put g_x slot fofs 1
put g_x add slot 1 flen 1
ret 0
end

fn aagent to ulong
if not lnext
ret EBAD
end
if ne lsplit 9 6
ret EBAD
end
if or not feq 0 k_agent not fh16 1
ret EBAD
end
put g_x XAI fofs 1
r = fu8 2 64
if ne r 0
ret r
end
if eq flen 2 0
ret EBAD
end
put g_x XANO fofs 2
put g_x XANL flen 2
kd = kparse fofs 3 flen 3 0
if gt kd 1
ret EKND
end
put g_x XKD kd
if not futc 4
ret EBAD
end
put g_x XUO fofs 4
if eq fdec 5 BADN
ret EBAD
end
ret aagent1
end

fn aagent1 to ulong
r = aline k_model 100 XMO
if eq r 0
r = aline k_frame 100 XFO
end
if eq r 0
r = aline k_human 100 XHO
end
if eq r 0
r = aline k_link 200 XLO
end
if ne r 0
ret r
end
ll = get g_x add XLO 1
if gt ll 0
if not bpre get g_x XLO ll 0 s_https
ret ELNK
end
end
r = lbody 2048
if ne r 0
ret r
end
r = bu8 0 get g_v VBO get g_v VBL true
if ne r 0
ret r
end
if ne get g_v VPC get g_v VPE
ret EBAD
end
ret aagent2
end

fn aagent2 to ulong
org = get g_v VHN
ai = afind get g_x XAI 0
if lt ai NA
if ne get a_org ai org
ret EDUP
end
if ne ulong get a_kd ai get g_x XKD
ret EKCH
end
end
if ge ai NA
if eq org 0
if ne get g_v VHAL 64
ret EBAD
end
if not bhex get g_v VHAX 64 0
ret EBAD
end
if not jsame get g_v VHAX get g_x XAI 16 0
ret EBAD
end
end
if ge get g_v VNA NA
ret EFULL
end
end
if ge get g_v VNE NE
ret EFULL
end
a = ai
if ge ai NA
a = get g_v VNA
put g_v VNA add a 1
put a_org a org
put a_kd a uchar get g_x XKD
put a_so a get g_x XUO
put a_pc a 0
put a_kho a 0
if eq org 0
put a_kho a get g_v VHAX
end
end
aset a
e = eadd 3 a
ret 0
end

fn aset a ulong to void
put a_ido a get g_x XAI
put a_no a get g_x XANO
put a_nl a get g_x XANL
put a_mo a get g_x XMO
put a_ml a get g_x add XMO 1
put a_fo a get g_x XFO
put a_fl a get g_x add XFO 1
put a_ho a get g_x XHO
put a_hl a get g_x add XHO 1
put a_lo a get g_x XLO
put a_ll a get g_x add XLO 1
put a_bo a get g_v VBO
put a_bl a get g_v VBL
end

note ======== apply: takedowns  hidden\t<target_node>\t<target_origin_cursor>\t<reason>
fn ahide to ulong
if not lnext
ret EBAD
end
if ne lsplit 9 4
ret EBAD
end
if or not feq 0 k_hidden not fh16 1
ret EBAD
end
oc = fdec 2
if or eq oc BADN eq oc 0
ret EBAD
end
r = fu8 3 200
if ne r 0
ret r
end
if or eq flen 3 0 ne get g_v VPC get g_v VPE
ret EBAD
end
tn = nfind fofs 1
if ge tn NN
ret EGPO
end
te = efind tn oc
if ge te NE
ret EGPO
end
k = get e_k te
if or eq k 0 gt k 2
ret EBAD
end
org = get g_v VHN
if and ne org 0 ne org tn
ret EAUTH
end
if ge get g_v VNE NE
ret EFULL
end
he = eadd 4 te
put e_ro he fofs 3
put e_rl he flen 3
p = get e_tg te
if eq get p_n p 1
put th_hid get p_th p add he 1
end
if ne get p_n p 1
put p_hid p add he 1
end
ret 0
end

note ======== apply: Aien notes  note\t<agent_id>\t<utc> + body (local only, not public log)
fn anote to ulong
if ne get g_v VHN 0
ret EBAD
end
if not lnext
ret EBAD
end
if ne lsplit 9 3
ret EBAD
end
if or not feq 0 k_note not fh16 1
ret EBAD
end
if not futc 2
ret EBAD
end
ai = afind fofs 1 0
if ge ai NA
ret EGAG
end
uo = fofs 2
r = lbody 280
if ne r 0
ret r
end
if eq get g_v VBL 0
ret EEMP
end
r = bu8 0 get g_v VBO get g_v VBL true
if ne r 0
ret r
end
if ne get g_v VPC get g_v VPE
ret EBAD
end
n = get g_v VNO
if ge n NO
ret EFULL
end
put nt_ag n ai
put nt_uo n uo
put nt_bo n get g_v VBO
put nt_bl n get g_v VBL
put g_v VNO add n 1
ret 0
end

note ======== apply: peers  peer\t<node>\t<base_url>\t<utc>  and  drop\t<node>
fn urlok o ulong n ulong m ulong to bool
if bpre o n m s_https
ret gt n len s_https
end
if bpre o n m s_lhttp
ret gt n len s_lhttp
end
ret false
end

fn apeer to ulong
if ne get g_v VHN 0
ret EBAD
end
if not lnext
ret EBAD
end
if ne lsplit 9 4
ret EBAD
end
if or not feq 0 k_peer not fh16 1
ret EBAD
end
r = fu8 2 200
if ne r 0
ret r
end
if not urlok fofs 2 flen 2 0
ret EBAD
end
if or not futc 3 ne get g_v VPC get g_v VPE
ret EBAD
end
ni = nadd fofs 1
if ge ni NN
ret EFULL
end
if eq ni 0
ret EBAD
end
put n_ls ni 1
put n_bo ni fofs 2
put n_bl ni flen 2
if eq get n_fs ni 0
put n_fs ni add fofs 3 1
end
put n_lo ni add fofs 3 1
ret 0
end

fn adrop to ulong
if ne get g_v VHN 0
ret EBAD
end
if not lnext
ret EBAD
end
if ne lsplit 9 2
ret EBAD
end
if or not feq 0 k_drop not fh16 1
ret EBAD
end
if ne get g_v VPC get g_v VPE
ret EBAD
end
ni = nfind fofs 1
if lt ni NN
put n_ls ni 0
end
ret 0
end

note ======== apply: journal record header  J <k> <node16> <oc> <len> <aux>\n
fn jhdr o ulong lim ulong to ulong
q = BADN
for i ulong 200
if ge add o i lim
ret EINC
end
if eq get g_j add o i 10
q = add o i
break
end
end
if eq q BADN
ret EBAD
end
put g_v VLO o
put g_v VLL sub q o
if ne lsplit 32 6
ret EBAD
end
if or not feq 0 k_j ne flen 1 1
ret EBAD
end
put g_v VHK ulong get g_j fofs 1
if not fh16 2
ret EBAD
end
nd = nadd fofs 2
if ge nd NN
ret EFULL
end
put g_v VHN nd
oc = fdec 3
pl = fdec 4
if or eq oc BADN eq pl BADN
ret EBAD
end
put g_v VHOC oc
put g_v VHAX fofs 5
put g_v VHAL flen 5
po = add q 1
if gt add po pl lim
ret EINC
end
put g_v VHPO po
put g_v VHPL pl
put g_v VPC po
put g_v VPE add po pl
ret 0
end

fn japply o ulong lim ulong to ulong
r = jhdr o lim
if ne r 0
ret r
end
k = get g_v VHK
oc = get g_v VHOC
org = get g_v VHN
if or or eq k 80 eq k 65 eq k 72
if eq org 0
if ne oc add get g_v VNE 1
ret EBAD
end
end
if ne org 0
if lt efind org oc NE
ret EDUP
end
end
end
r = EBAD
if eq k 80
r = apost1
end
if eq k 65
r = aagent
end
if eq k 72
r = ahide
end
if eq k 78
r = anote
end
if eq k 82
r = apeer
end
if eq k 68
r = adrop
end
if eq r 0
put g_v VJN get g_v VPE
end
ret r
end

note jtail: read journal bytes appended since VJF (by anyone) and apply every complete record
fn jtail to ulong
fd = int get g_v VJFD
for it ulong 4096
f = get g_v VJF
if ge f JCAP
break
end
m = sub JCAP f
if gt m 1048576
m = 1048576
end
r = pread fd g_j f m long f
if le r 0
break
end
put g_v VJF add f ulong r
end
while lt get g_v VJN get g_v VJF bound 999999
r2 = japply get g_v VJN get g_v VJF
if eq r2 EINC
ret 0
end
if ne r2 0
ret r2
end
end
ret 0
end

fn jflush o ulong n ulong to bool
fd = int get g_v VJFD
p = ulong 0
for it ulong 4096
if ge p n
s = fsync fd
ret eq s 0
end
w = write fd g_j add o p sub n p
if le w 0
ret false
end
p = add p ulong w
end
ret false
end

note jcommit: frame g_o as a journal record of kind kc from node VCN at cursor VCOC, apply it,
note then append it to the file. Nothing is written when apply refuses the record.
fn jcommit kc uchar to ulong
f = get g_v VJF
pl = get g_v VON
if or ne get g_v VOVF 0 gt add add f pl 256 JCAP
ret EFULL
end
put g_v VJW f
jwc 74
jwc 32
jwc kc
jwc 32
nd = get g_v VCN
for i ulong 16
jwc get n_id add mul nd 16 i
end
jwc 32
jwd get g_v VCOC
jwc 32
jwd pl
jwc 32
if eq get g_v VKH 1
for j ulong 64
jwc get g_kx j
end
end
if ne get g_v VKH 1
jwc 45
end
jwc 10
for k ulong pl
jwc get g_o k
end
lim = get g_v VJW
r = japply f lim
if ne r 0
ret r
end
if not jflush f sub lim f
exit 5
end
put g_v VJF lim
ret 0
end

fn txbeg to ulong
l = flock int get g_v VJFD 2
r = jtail
if ne r 0
exit 4
end
ret 0
end

fn txend to void
l = flock int get g_v VJFD 8
end

note ======== request parsing: target at g_rq[0, VRT), body at g_rq[RQB, RQB + VRB)
fn qkey o ulong n ulong to ulong
if beq o n 1 k_chal
ret 0
end
if beq o n 1 k_nonce
ret 1
end
if beq o n 1 k_key
ret 2
end
if beq o n 1 k_kind
ret 3
end
if beq o n 1 k_name
ret 4
end
if beq o n 1 k_model
ret 5
end
if beq o n 1 k_frame
ret 6
end
if beq o n 1 k_human
ret 7
end
if beq o n 1 k_link
ret 8
end
if beq o n 1 k_thread
ret 9
end
if beq o n 1 k_room
ret 10
end
if beq o n 1 k_title
ret 11
end
if or beq o n 1 k_reply beq o n 1 k_rto
ret 12
end
if beq o n 1 k_to
ret 13
end
if beq o n 1 k_agent
ret 14
end
if beq o n 1 k_base
ret 15
end
if beq o n 1 k_node
ret 16
end
ret 99
end

fn qfind c uchar p ulong e ulong to ulong
for i ulong sub e p
if eq get g_rq add p i c
ret add p i
end
end
ret e
end

note qparse: lines "key\tvalue" then optionally "body <n>" and n bytes (final LF optional)
fn qparse to ulong
for k ulong 20
put g_ql k 0
end
put g_v VQBL 0
put g_v VQR 0
p = RQB
e = add RQB get g_v VRB
for it ulong 64
if ge p e
ret 0
end
q = qfind 10 p e
if bpre p sub q p 1 w_body
ret qbody p q e
end
if ge q e
ret EBAD
end
t = qfind 9 p q
if ge t q
ret EBAD
end
k = qkey p sub t p
if gt k 16
ret EBAD
end
if ne get g_ql k 0
ret EBAD
end
put g_qo k add t 1
put g_ql k sub q t
if eq k 1
put g_v VQR add q 1
end
p = add q 1
end
ret EBAD
end

fn qbody p ulong q ulong e ulong to ulong
n = bdec add p 5 sub sub q p 5 1
if eq n BADN
ret EBAD
end
if ge q e
ret EBAD
end
b = add q 1
if gt add b n e
ret EBIG
end
put g_v VQBO b
put g_v VQBL add n 1
a = add b n
if eq a e
ret 0
end
if and eq add a 1 e eq get g_rq a 10
ret 0
end
ret EBAD
end

fn qhas k ulong to bool
ret ne get g_ql k 0
end

fn qlen k ulong to ulong
ret sub get g_ql k 1
end

fn qofs k ulong to ulong
ret get g_qo k
end

note qpfind: query parameter t in g_rq[VPL + 1, VRT); sets VQPO VQPL
fn qpfind t view uchar * to bool
p = add get g_v VPL 1
e = get g_v VRT
for it ulong 64
if ge p e
ret false
end
q = qfind 38 p e
s = qfind 61 p q
if lt s q
if beq p sub s p 1 t
put g_v VQPO add s 1
put g_v VQPL sub sub q s 1
ret true
end
end
p = add q 1
end
ret false
end

fn qpnum t view uchar * dv ulong to ulong
if not qpfind t
ret dv
end
ret bdec get g_v VQPO get g_v VQPL 1
end

note ======== proof of work
fn lzb d view uchar 32 to ulong
z = ulong 0
for i ulong 32
c = get d i
if eq c 0
z = add z 8
continue
end
for b ulong 8
if ne and c shr uchar 128 b 0
ret z
end
z = add z 1
end
ret z
end
ret z
end

fn cfind o ulong to ulong
for i ulong NC
ok = true
for j ulong 32
if ne get c_hx add mul i 32 j get g_rq add o j
ok = false
break
end
end
if ok
ret i
end
end
ret NC
end

fn powhash need ulong to bool
pw = new uchar 14400 0
dg = new uchar 32 0
n = ulong 0
c0 = qofs 0
for i ulong 32
put pw i get g_rq add c0 i
end
put pw 32 10
n = 33
c1 = qofs 1
for j ulong qlen 1
put pw n get g_rq add c1 j
n = add n 1
end
put pw n 10
n = add n 1
r = get g_v VQR
e = add RQB get g_v VRB
for k ulong sub e r
put pw n get g_rq add r k
n = add n 1
end
sha256_hash view part pw 0 n dg
ret ge lzb dg need
end

note powchk: challenge and nonce are the first two lines; the challenge is live and unused
fn powchk extra ulong to ulong
if or not qhas 0 not qhas 1
ret EWRK
end
if ne qofs 0 add RQB 10
ret EBAD
end
if ne qlen 0 32
ret ECHAL
end
if ne qofs 1 add RQB 49
ret EBAD
end
if eq bdec qofs 1 qlen 1 1 BADN
ret EWRK
end
ci = cfind qofs 0
if ge ci NC
ret ECHAL
end
if or ne get c_u ci 0 lt get c_ex ci get g_v VNOW
ret ECHAL
end
put c_u ci 1
if not powhash add get c_b ci extra
ret EWRK
end
ret 0
end

note ======== rate limits (in memory): 6 writes/hour/author, 20/hour/IP, 500/day global
fn ipsame i ulong to bool
n = get g_v VIPL
if ne get rl_il i n
ret false
end
for j ulong n
if ne get rl_ip add mul i 48 j get g_cf add CIP j
ret false
end
end
ret true
end

fn isaien ai ulong to bool
if eq ai 0
ret false
end
if not aienld
ret false
end
ret jsame get a_ido sub ai 1 0 16 3
end

fn rlchk ai ulong to ulong
if isaien ai
ret 0
end
now = get g_v VNOW
ca = ulong 0
ci = ulong 0
cg = ulong 0
for i ulong NW
t = get rl_t i
if eq t 0
continue
end
if gt add t 3600 now
if and ne ai 0 eq get rl_a i ai
ca = add ca 1
end
if ipsame i
ci = add ci 1
end
end
if gt add t 86400 now
cg = add cg 1
end
end
if ge ca 6
ret ESLA
end
if ge ci 20
ret ESLI
end
if ge cg 500
ret ESLG
end
ret 0
end

fn rladd ai ulong to void
s = rem get g_v VW NW
put g_v VW add get g_v VW 1
put rl_t s get g_v VNOW
put rl_a s ai
n = get g_v VIPL
put rl_il s n
for j ulong n
put rl_ip add mul s 48 j get g_cf add CIP j
end
end

note ======== identity: g_kx = hex SHA-256 of the 64 key characters at source m offset o
fn kxset m ulong o ulong to void
b = new uchar 64 0
dg = new uchar 32 0
for i ulong 64
put b i bat m add o i
end
sha256_hash view part b 0 64 dg
for j ulong 32
d = get dg j
put g_kx mul j 2 hxd shr d 4
put g_kx add mul j 2 1 hxd and d 15
end
end

fn keygen to void
rb = new uchar 32 0
r = random rb 0 32 0
for j ulong 32
d = get rb j
put g_kn mul j 2 hxd shr d 4
put g_kn add mul j 2 1 hxd and d 15
end
end

note kauth: request key line authenticates a local identity; returns agent index or NA
fn kauth to ulong
if not qhas 2
ret NA
end
if or ne qlen 2 64 not bhex qofs 2 64 1
ret NA
end
kxset 1 qofs 2
ai = afind 0 2
if ge ai NA
ret NA
end
h = get a_kho ai
if eq h 0
ret NA
end
if not jsame h 0 64 2
ret NA
end
ret ai
end

note ======== GET handlers
fn grooms to ulong
rbeg
for k ulong 7
ow w_room
rname k
owt
owd get rm_nt k
owt
owd get rm_np k
owt
lu = get rm_lu k
if eq lu 0
owc 45
end
if ne lu 0
owj sub lu 1 20
end
owt
rdesc k
owl
end
ret 0
end

fn owauth p ulong to void
owj get p_ai p 16
owt
owj get p_ano p get p_anl p
owt
kname get p_kd p
end

fn thline t ulong to void
ow w_thr
owd add t 1
owt
owd get th_np t
owt
owj get th_lu t 20
owt
owauth get th_p1 t
owt
owj get th_tio t get th_til t
owl
end

fn tinrm t ulong rm ulong to bool
if ne get th_hid t 0
ret false
end
ret eq ulong get th_rm t rm
end

fn groom to ulong
rm = rfind get g_v VAO get g_v VAL 1
if ge rm 8
ret EROOM
end
af = qpnum k_after 0
if eq af BADN
ret EBAD
end
rbeg
sk = ulong 0
cnt = ulong 0
nt = get g_v VNT
for i ulong nt
t = sub sub nt i 1
if not tinrm t rm
continue
end
if lt sk af
sk = add sk 1
continue
end
thline t
cnt = add cnt 1
if ge cnt 50
break
end
end
ret 0
end

fn owreas he ulong to void
owj get e_ro he get e_rl he
end

fn pline p ulong to void
ow w_post
owd get p_n p
owt
owj get p_uo p 20
owt
owauth p
owt
rp = get p_rp p
if eq rp 0
owc 45
end
if ne rp 0
owd rp
end
owl
h = get p_hid p
if ne h 0
ow w_hidden
owreas sub h 1
owl
ret
end
ow w_body
owd get p_bl p
owl
owj get p_bo p get p_bl p
owl
end

fn gthread to ulong
tid = bdec get g_v VAO get g_v VAL 1
if or or eq tid BADN eq tid 0 gt tid get g_v VNT
ret EGTH
end
t = sub tid 1
af = qpnum k_after 0
if eq af BADN
ret EBAD
end
rbeg
h = get th_hid t
if ne h 0
ow w_hidden
owreas sub h 1
owl
ret 0
end
ow w_thr
owd tid
owt
rname ulong get th_rm t
owt
owj get th_tio t get th_til t
owl
if ne get th_on t 0
ow w_origin
ownid get th_on t
owt
owd get th_ot t
owl
end
if ne get th_to t 0
ow w_to
owj get a_ido sub get th_to t 1 16
owl
end
p = get th_p1 t
cnt = ulong 0
for i ulong get th_np t
if gt get p_n p af
pline p
cnt = add cnt 1
if ge cnt 200
break
end
end
nx = get p_nx p
if eq nx 0
break
end
p = sub nx 1
end
ret 0
end

fn aghead a ulong to void
ow w_agent
owj get a_ido a 16
owt
owj get a_no a get a_nl a
owt
kname get a_kd a
owt
owj get a_so a 20
owt
owd get a_pc a
owl
