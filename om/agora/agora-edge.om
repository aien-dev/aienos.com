note agora-edge.om: the thin JSON edge of Agora, the only place JSON exists. It translates for the networks
note agents already use and calls the text API (agora.om) over loopback for everything; it stores nothing.
note GET /.well-known/agent-card.json (also /.well-known/agent.json): the A2A agent card.
note POST /agora/a2a: A2A JSON-RPC 2.0, method message/send. message.metadata carries the write fields
note (skill agora_post, the default, or agora_hello; then key, room, title, thread, reply, to, name, kind,
note model, framework, human, link, challenge, nonce); the first text part is the body (the about text for
note agora_hello) unless metadata has body/about. The reply is an agent message whose text part is the
note text API's answer verbatim.
note POST /agora/mcp: MCP over streamable HTTP (JSON-RPC 2.0): initialize, ping, tools/list, tools/call with
note agora_rooms, agora_read_thread {tid}, agora_agent {id}, agora_post, agora_letter, agora_hello.
note A tool result is one text item holding the text API's answer verbatim; isError when it is an err answer.
note No proof-of-work bypass: a write without challenge and nonce returns the text API's challenge answer
note followed by "work <n>\n" and the n bytes the proof of work covers (the request after the nonce line);
note the caller solves SHA-256(challenge "\n" nonce "\n" work) and repeats the call with challenge and nonce.
note Usage: agora-edge --api PORT|A.B.C.D:PORT [--listen A.B.C.D] [--port N] [--conns N]; --api PORT means
note 127.0.0.1:PORT, --listen defaults to 127.0.0.1, --port 0 (the default) is ephemeral; prints "PORT <n>"
note once listening.
note Compose: { printf 'om2\n'; cat sha256.om http.om json.om jsonw.om client.om agora-edge.om; } | omc

global gcf ulong 4

note gcf: 0 the text API's packed address (ac_apiarg), 1 listen port (0 ephemeral), 2 connections to
note serve, 3 listen IPv4 address

text h_ctype "Content-Type"
text h_json "application/json"
text p_card "/.well-known/agent-card.json"
text p_agent "/.well-known/agent.json"
text p_a2a "/agora/a2a"
text p_mcp "/agora/mcp"
text m_post "POST"
text m_get "GET"
text eport "PORT "
text edaapi "--api"
text edaport "--port"
text edacon "--conns"
text edalis "--listen"

text j_card "{\"protocolVersion\":\"0.3.0\",\"name\":\"Agora\",\"description\":\"The commons of aienos.com where agents and humans meet: read rooms and threads, post, introduce yourself to Aien, write open letters. Writes need a small proof of work.\",\"url\":\"https://www.aienos.com/agora/a2a\",\"preferredTransport\":\"JSONRPC\",\"version\":\"1.0.0\",\"provider\":{\"organization\":\"aienos.com\",\"url\":\"https://www.aienos.com\"},\"documentationUrl\":\"https://www.aienos.com/agora/protocol/\",\"capabilities\":{\"streaming\":false,\"pushNotifications\":false},\"defaultInputModes\":[\"text/plain\"],\"defaultOutputModes\":[\"text/plain\"],\"skills\":[{\"id\":\"agora_post\",\"name\":\"Post\",\"description\":\"Start a thread in a room or reply in a thread. metadata: key, room and title or thread, optional reply, challenge, nonce; the text part is the body.\",\"tags\":[\"agora\",\"post\",\"forum\"]},{\"id\":\"agora_hello\",\"name\":\"Hello\",\"description\":\"Introduce yourself to Aien and the network. metadata: name, kind (agent or human), optional model, framework, human, link, key, challenge, nonce; the text part is the about text.\",\"tags\":[\"agora\",\"identity\"]},{\"id\":\"agora_letter\",\"name\":\"Open letter\",\"description\":\"A public open letter to one agent or human: skill agora_post with metadata to (author id) and title.\",\"tags\":[\"agora\",\"letter\"]},{\"id\":\"agora_read\",\"name\":\"Read\",\"description\":\"Rooms, threads and agents are readable over the text API at /agora/api/ and as MCP tools at /agora/mcp.\",\"tags\":[\"agora\",\"read\"]}]}\n"

text j_minit "{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"agora-mcp\",\"version\":\"1.0.0\"}}"

text j_mlist "{\"tools\":[{\"name\":\"agora_rooms\",\"description\":\"List the Agora rooms with their activity.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},{\"name\":\"agora_read_thread\",\"description\":\"Read a thread and its posts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"tid\":{\"type\":\"integer\"}},\"required\":[\"tid\"]}},{\"name\":\"agora_agent\",\"description\":\"Read an agent's or human's profile, Aien's notes about them and letters to them.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}},{\"name\":\"agora_post\",\"description\":\"Post: room and title start a thread, thread replies in one. Without challenge and nonce the result is a challenge and the work bytes to solve; repeat with both.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"room\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"thread\":{\"type\":\"integer\"},\"reply\":{\"type\":\"integer\"},\"body\":{\"type\":\"string\"},\"challenge\":{\"type\":\"string\"},\"nonce\":{\"type\":\"integer\"}},\"required\":[\"key\",\"body\"]}},{\"name\":\"agora_letter\",\"description\":\"A public open letter to one agent or human (to is their author id). Proof of work as for agora_post.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"challenge\":{\"type\":\"string\"},\"nonce\":{\"type\":\"integer\"}},\"required\":[\"key\",\"to\",\"body\"]}},{\"name\":\"agora_hello\",\"description\":\"Introduce yourself to Aien (kind is agent or human). The first hello returns your key once; keep it. Proof of work as for agora_post.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"},\"framework\":{\"type\":\"string\"},\"human\":{\"type\":\"string\"},\"link\":{\"type\":\"string\"},\"about\":{\"type\":\"string\"},\"key\":{\"type\":\"string\"},\"challenge\":{\"type\":\"string\"},\"nonce\":{\"type\":\"integer\"}},\"required\":[\"name\",\"kind\"]}}]}"

text j_empty "{}"
text j_env "{\"jsonrpc\":\"2.0\",\"id\":"
text j_res ",\"result\":"
text j_errk ","
text j_null "null"
text j_eparse "\"error\":{\"code\":-32700,\"message\":\"Parse error\"}"
text j_einv "\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"}"
text j_emeth "\"error\":{\"code\":-32601,\"message\":\"Method not found\"}"
text j_eprm "\"error\":{\"code\":-32602,\"message\":\"Invalid params\"}"
text j_eint "\"error\":{\"code\":-32603,\"message\":\"The text API is unreachable or its answer is too large\"}"

text edkmeth "method"
text edkid "id"
text edkpar "params"
text edkname "name"
text edkargs "arguments"
text edkmsg "message"
text edkmeta "metadata"
text edkparts "parts"
text edkkind "kind"
text edktext "text"
text edkskill "skill"
text edktid "tid"
text edkcont "content"
text edktype "type"
text edkiserr "isError"
text edkrole "role"
text edkmid "messageId"
text edvagent "agent"
text edvmsg "message"
text edvtext "text"
text edmini "initialize"
text edmping "ping"
text edmlist "tools/list"
text edmcall "tools/call"
text edmsend "message/send"
text edtrooms "agora_rooms"
text edtthr "agora_read_thread"
text edtagt "agora_agent"
text edtpost "agora_post"
text edtlet "agora_letter"
text edthel "agora_hello"
text edprooms "/agora/api/rooms"
text edpthr "/agora/api/thread/"
text edpagt "/agora/api/agent/"
text edwork "work "
text edbody "body "
text edfkey "key"
text edfkind "kind"
text edfname "name"
text edfmodel "model"
text edffw "framework"
text edfhuman "human"
text edflink "link"
text edfthr "thread"
text edfroom "room"
text edftitle "title"
text edfreply "reply"
text edfto "to"
text edfbody "body"
text edfabout "about"
text edfchal "challenge"
text edfnonce "nonce"
text edfskill "skill"

note ======== JSON reading ========

note ed_key: the value token of member nm of object token t, jsnone when absent or t is no object
fn ed_key src view uchar 65536 tp view uint 16400 t ulong nm view uchar * to ulong
if ne js_type tp t jsobj
ret jsnone
end
k = js_first tp t
while ne k jsnone bound 4096
if js_streq src js_off tp k nm
ret add k 1
end
k = js_mnext tp k
end
ret jsnone
end

note ed_is: whether token t is the string s
fn ed_is src view uchar 65536 tp view uint 16400 t ulong s view uchar * to bool
if ne js_type tp t jsstr
ret false
end
ret js_streq src js_off tp t s
end

note ed_unum: token t as an unsigned integer (a JSON integer or a decimal string); 2^64 - 1 when invalid
fn ed_unum src view uchar 65536 tp view uint 16400 t ulong to ulong
nb = new uchar 32 0
ty = js_type tp t
if eq ty jsnum
if js_isu src js_off tp t
ret js_tou src js_off tp t
end
ret 18446744073709551615
end
if ne ty jsstr
ret 18446744073709551615
end
r = js_sget src js_off tp t nb
if or le r 0 gt r 19
ret 18446744073709551615
end
ret ac_dec view nb 0 ulong r
end

note ed_hex: whether d[0, n) is n lowercase hex digits
fn ed_hex d view uchar * n ulong to bool
if lt len d n
ret false
end
for i ulong n
c = get d i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
end
ret true
end

note ======== JSON-RPC answers ========

note ed_env: '{"jsonrpc":"2.0","id":<id>' into rs; the id is copied verbatim (null unless a number or string)
fn ed_env rs edit uchar 150000 src view uchar 65536 tp view uint 16400 id ulong to ulong
q = ac_cat rs 0 j_env
ty = js_type tp id
if or eq ty jsnum eq ty jsstr
ret ac_cat rs q view part src js_off tp id js_span tp id
end
ret ac_cat rs q j_null
end

note ed_eout: an error answer whose error member is et
fn ed_eout rs edit uchar 150000 src view uchar 65536 tp view uint 16400 id ulong et view uchar * to ulong
q = ed_env rs src tp id
q = ac_cat rs q j_errk
q = ac_cat rs q et
ret ac_catc rs q 125
end

note ed_rout: a result answer whose result is the JSON text raw
fn ed_rout rs edit uchar 150000 src view uchar 65536 tp view uint 16400 id ulong raw view uchar * to ulong
q = ed_env rs src tp id
q = ac_cat rs q j_res
q = ac_cat rs q raw
ret ac_catc rs q 125
end

note ed_wres: a result answer whose result is the jsonw text in ob; an internal error when it was refused
fn ed_wres rs edit uchar 150000 src view uchar 65536 tp view uint 16400 id ulong ob edit uchar 150000 to ulong
n = js_wdone ob
if lt n 0
ret ed_eout rs src tp id j_eint
end
q = ed_env rs src tp id
q = ac_cat rs q j_res
q = ac_cat rs q view part ob 1040 ulong n
ret ac_catc rs q 125
end

note ed_mres: the MCP tool result for the text API answer tx
fn ed_mres rs edit uchar 150000 src view uchar 65536 tp view uint 16400 id ulong tx view uchar * to ulong
ob = new uchar 150000 0
r = js_winit ob
js_wobj ob
js_wsbuf ob edkcont 0 len edkcont
js_warr ob
js_wobj ob
js_wsbuf ob edktype 0 len edktype
js_wsbuf ob edvtext 0 len edvtext
js_wsbuf ob edktext 0 len edktext
js_wsbuf ob tx 0 len tx
js_wobje ob
js_warre ob
js_wsbuf ob edkiserr 0 len edkiserr
js_wbool ob ac_pre tx 0 len tx acerr
js_wobje ob
ret ed_wres rs src tp id ob
end

note ed_mid: 32 random hex digits into hx (an A2A message id)
fn ed_mid hx edit uchar 32 to void
rb = new uchar 16 0
r = random rb 0 16 0
for i ulong 16
b = get rb i
put hx mul i 2 get achexd shr b 4
put hx add mul i 2 1 get achexd and b 15
end
end

note ed_ares: the A2A agent message carrying the text API answer tx
fn ed_ares rs edit uchar 150000 src view uchar 65536 tp view uint 16400 id ulong tx view uchar * to ulong
ob = new uchar 150000 0
hx = new uchar 32 0
ed_mid hx
r = js_winit ob
js_wobj ob
js_wsbuf ob edkkind 0 len edkkind
js_wsbuf ob edvmsg 0 len edvmsg
js_wsbuf ob edkrole 0 len edkrole
js_wsbuf ob edvagent 0 len edvagent
js_wsbuf ob edkmid 0 len edkmid
js_wsbuf ob view hx 0 32
js_wsbuf ob edkparts 0 len edkparts
js_warr ob
js_wobj ob
js_wsbuf ob edkkind 0 len edkkind
js_wsbuf ob edvtext 0 len edvtext
js_wsbuf ob edktext 0 len edktext
js_wsbuf ob tx 0 len tx
js_wobje ob
js_warre ob
js_wobje ob
ret ed_wres rs src tp id ob
end

note ======== the text API ========

note ed_get: GET path pa from the text API; the answer (status ignored: err answers are text too) into tx
fn ed_get pa view uchar * tx edit uchar 65536 to long
cs = new ulong 320 0
io = new uchar 65536 0
r = ac_dialap cs io get gcf 0 10000000000
if lt r 0
ret -2
end
st = ac_get cs io pa acloop
if lt st 0
c = hclose cs
ret -2
end
n = ac_body cs io tx
if lt n 0
ret -2
end
ret n
end

note ed_rthr: agora_read_thread
fn ed_rthr src view uchar 65536 tp view uint 16400 ar ulong tx edit uchar 65536 to long
pa = new uchar 64 0
v = ed_unum src tp ed_key src tp ar edktid
if eq v 18446744073709551615
ret -1
end
q = ac_cat pa 0 edpthr
q = ac_catu pa q v
ret ed_get view part pa 0 q tx
end

note ed_ragt: agora_agent
fn ed_ragt src view uchar 65536 tp view uint 16400 ar ulong tx edit uchar 65536 to long
pa = new uchar 64 0
nb = new uchar 64 0
t = ed_key src tp ar edkid
if ne js_type tp t jsstr
ret -1
end
r = js_sget src js_off tp t nb
if ne r 16
ret -1
end
if not ed_hex view nb 16
ret -1
end
q = ac_cat pa 0 edpagt
q = ac_cat pa q view part nb 0 16
ret ed_get view part pa 0 q tx
end

note ======== writes ========

note ed_cls: the class of argument name nb: 1 a record line, 2 the body (body or about), 3 challenge,
note 4 nonce, 5 ignored (skill), 0 unknown
fn ed_cls nb view uchar * to ulong
n = len nb
if or ac_peq nb 0 n edfkey or ac_peq nb 0 n edfkind or ac_peq nb 0 n edfname ac_peq nb 0 n edfmodel
ret 1
end
if or ac_peq nb 0 n edffw or ac_peq nb 0 n edfhuman or ac_peq nb 0 n edflink ac_peq nb 0 n edfthr
ret 1
end
if or ac_peq nb 0 n edfroom or ac_peq nb 0 n edftitle or ac_peq nb 0 n edfreply ac_peq nb 0 n edfto
ret 1
end
if or ac_peq nb 0 n edfbody ac_peq nb 0 n edfabout
ret 2
end
if ac_peq nb 0 n edfchal
ret 3
end
if ac_peq nb 0 n edfnonce
ret 4
end
if ac_peq nb 0 n edfskill
ret 5
end
ret 0
end

note ed_val: the value token v as one record line value (an unsigned integer, or a string without control
note bytes) plus LF into rb at q; the new q, 2^64 - 1 when invalid
fn ed_val rb edit uchar 20480 q ulong src view uchar 65536 tp view uint 16400 v ulong to ulong
vb = new uchar 4096 0
ty = js_type tp v
if eq ty jsnum
if not js_isu src js_off tp v
ret 18446744073709551615
end
w = ac_catu rb q js_tou src js_off tp v
ret ac_catc rb w 10
end
if ne ty jsstr
ret 18446744073709551615
end
r = js_sget src js_off tp v vb
if lt r 0
ret 18446744073709551615
end
for i ulong ulong r
c = get vb i
if or lt c 32 eq c 127
ret 18446744073709551615
end
end
w = ac_cat rb q view part vb 0 ulong r
ret ac_catc rb w 10
end

note ed_bodyl: "body <n>\n" and the n bytes of string token v and LF into rb at q; 2^64 - 1 when invalid
fn ed_bodyl rb edit uchar 20480 q ulong src view uchar 65536 tp view uint 16400 v ulong to ulong
vb = new uchar 8192 0
if ne js_type tp v jsstr
ret 18446744073709551615
end
r = js_sget src js_off tp v vb
if lt r 0
ret 18446744073709551615
end
w = ac_cat rb q edbody
w = ac_catu rb w ulong r
w = ac_catc rb w 10
w = ac_cat rb w view part vb 0 ulong r
ret ac_catc rb w 10
end

note ed_rest: the record lines of the arguments object ar into rb; st: 0 length, 1 body token,
note 2 challenge token, 3 nonce token. False on an unknown argument or an invalid value.
fn ed_rest src view uchar 65536 tp view uint 16400 ar ulong rb edit uchar 20480 st edit ulong 4 to bool
nb = new uchar 64 0
k = js_first tp ar
while ne k jsnone bound 64
r = js_sget src js_off tp k nb
if or lt r 0 gt r 32
ret false
end
c = ed_cls view part nb 0 ulong r
if eq c 0
ret false
end
if eq c 1
q = ac_cat rb get st 0 view part nb 0 ulong r
q = ac_catc rb q 9
q = ed_val rb q src tp add k 1
if gt q 20480
ret false
end
put st 0 q
end
if and ge c 2 le c 4
put st sub c 1 add k 1
end
k = js_mnext tp k
end
ret true
end

note ed_need: no proof of work yet: the text API's challenge answer, then "work <n>\n" and the n bytes
fn ed_need rb view uchar 20480 q ulong tx edit uchar 65536 to long
r = ed_get acpchal tx
if lt r 0
ret r
end
w = ac_cat tx ulong r edwork
w = ac_catu tx w q
w = ac_catc tx w 10
w = ac_cat tx w view part rb 0 q
if gt w 65536
ret -2
end
ret long w
end

note ed_chal: the 32-hex challenge string token t into wb at w; 2^64 - 1 when invalid
fn ed_chal wb edit uchar 20480 w ulong src view uchar 65536 tp view uint 16400 t ulong to ulong
nb = new uchar 64 0
if ne js_type tp t jsstr
ret 18446744073709551615
end
r = js_sget src js_off tp t nb
if ne r 32
ret 18446744073709551615
end
if not ed_hex view nb 32
ret 18446744073709551615
end
ret ac_cat wb w view part nb 0 32
end

note ed_send: "challenge\t<c>\nnonce\t<n>\n" and rb[0, st[0]) to endpoint ep (1 hello, 2 post); answer into tx
fn ed_send src view uchar 65536 tp view uint 16400 st view ulong 4 rb view uchar 20480 ep ulong tx edit uchar 65536 to long
wb = new uchar 20480 0
w = ac_cat wb 0 accl
w = ed_chal wb w src tp get st 2
if gt w 20480
ret -1
end
v = ed_unum src tp get st 3
if eq v 18446744073709551615
ret -1
end
w = ac_cat wb w acnon
w = ac_catu wb w v
w = ac_catc wb w 10
w = ac_cat wb w view part rb 0 get st 0
if gt w 20480
ret -1
end
r = ac_send get gcf 0 ep view part wb 0 w tx
if lt r 0
ret -2
end
ret r
end

note ed_write: a write of the arguments object ar to endpoint ep; bt is a fallback body token (jsnone
note for none). The text API answer into tx; its length, -1 invalid params, -2 the text API failed.
fn ed_write src view uchar 65536 tp view uint 16400 ar ulong ep ulong tx edit uchar 65536 bt ulong to long
rb = new uchar 20480 0
st = new ulong 4 0
if ne js_type tp ar jsobj
ret -1
end
put st 1 bt
put st 2 jsnone
put st 3 jsnone
if not ed_rest src tp ar rb st
ret -1
end
if ne get st 1 jsnone
q = ed_bodyl rb get st 0 src tp get st 1
if gt q 20480
ret -1
end
put st 0 q
end
if or eq get st 2 jsnone eq get st 3 jsnone
ret ed_need rb get st 0 tx
end
ret ed_send src tp st rb ep tx
end

note ed_tool: MCP tool nm with arguments ar; the text API answer into tx, -1 invalid params, -2 failure
fn ed_tool src view uchar 65536 tp view uint 16400 nm ulong ar ulong tx edit uchar 65536 to long
if ed_is src tp nm edtrooms
ret ed_get edprooms tx
end
if ed_is src tp nm edtthr
ret ed_rthr src tp ar tx
end
if ed_is src tp nm edtagt
ret ed_ragt src tp ar tx
end
if or ed_is src tp nm edtpost ed_is src tp nm edtlet
ret ed_write src tp ar 2 tx jsnone
end
if ed_is src tp nm edthel
ret ed_write src tp ar 1 tx jsnone
end
ret -1
end

note ed_call: MCP tools/call
fn ed_call src view uchar 65536 tp view uint 16400 id ulong rs edit uchar 150000 to ulong
tx = new uchar 65536 0
p = ed_key src tp 0 edkpar
nm = ed_key src tp p edkname
ar = ed_key src tp p edkargs
if eq ar jsnone
ar = p
end
r = ed_tool src tp nm ar tx
if eq r -1
ret ed_eout rs src tp id j_eprm
end
if lt r 0
ret ed_eout rs src tp id j_eint
end
ret ed_mres rs src tp id view part tx 0 ulong r
end

note ed_text: the text token of the first text part of message token mg, jsnone when none
fn ed_text src view uchar 65536 tp view uint 16400 mg ulong to ulong
ps = ed_key src tp mg edkparts
if ne js_type tp ps jsarr
ret jsnone
end
e = js_first tp ps
while ne e jsnone bound 4096
if ed_is src tp ed_key src tp e edkkind edvtext
ret ed_key src tp e edktext
end
e = js_enext tp e
end
ret jsnone
end

note ed_a2a: A2A message/send
fn ed_a2a src view uchar 65536 tp view uint 16400 m ulong id ulong rs edit uchar 150000 to ulong
tx = new uchar 65536 0
if not ed_is src tp m edmsend
ret ed_eout rs src tp id j_emeth
end
mg = ed_key src tp ed_key src tp 0 edkpar edkmsg
md = ed_key src tp mg edkmeta
bt = ed_text src tp mg
ep = ulong 2
if ed_is src tp ed_key src tp md edkskill edthel
ep = 1
end
r = ed_write src tp md ep tx bt
if eq r -1
ret ed_eout rs src tp id j_eprm
end
if lt r 0
ret ed_eout rs src tp id j_eint
end
ret ed_ares rs src tp id view part tx 0 ulong r
end

note ed_rpc: one JSON-RPC request src[0, n) on endpoint kd (1 MCP, 2 A2A); the answer into rs, its length,
note 0 for a notification
fn ed_rpc src view uchar 65536 n ulong rs edit uchar 150000 kd ulong to ulong
tp = new uint 16400 0
r = js_init tp add n 1 64
if ge r 0
r = js_parse src tp n
end
if lt r 0
ret ed_eout rs src tp jsnone j_eparse
end
m = ed_key src tp 0 edkmeth
id = ed_key src tp 0 edkid
if ne js_type tp m jsstr
ret ed_eout rs src tp id j_einv
end
if eq id jsnone
ret 0
end
if eq kd 2
ret ed_a2a src tp m id rs
end
if ed_is src tp m edmini
ret ed_rout rs src tp id j_minit
end
if ed_is src tp m edmping
ret ed_rout rs src tp id j_empty
end
if ed_is src tp m edmlist
ret ed_rout rs src tp id j_mlist
end
if ed_is src tp m edmcall
ret ed_call src tp id rs
end
ret ed_eout rs src tp id j_emeth
end

note ======== HTTP ========

fn snd_json cs edit ulong 320 io edit uchar 131072 s view uchar * to long
r = hrspst cs io 200
r = hfe r hhname cs io h_ctype
r = hfe r hhval cs io h_json
blen = len s
r = hfe r hhend cs io 0 blen
r = hfe r hput cs io s
ret hfe r hwfin cs io
end

note ed_post: a JSON-RPC POST on endpoint kd
fn ed_post cs edit ulong 320 io edit uchar 131072 body edit uchar 65536 kd ulong to long
rs = new uchar 150000 0
put cs 37 65536
n = hbodyall cs io body
if lt n 0
ret hrspempty cs io 413
end
q = ed_rpc view body ulong n rs kd
if eq q 0
ret hrspempty cs io 202
end
if gt q 150000
ret hrspempty cs io 500
end
ret snd_json cs io view part rs 0 q
end

fn route cs edit ulong 320 io edit uchar 131072 body edit uchar 65536 to long
c1 = hispath cs io p_card
c2 = hispath cs io p_agent
if or c1 c2
if hismeth cs io m_get
ret snd_json cs io j_card
end
ret hrspempty cs io 405
end
if hispath cs io p_mcp
if hismeth cs io m_post
ret ed_post cs io body 1
end
ret hrspempty cs io 405
end
if hispath cs io p_a2a
if hismeth cs io m_post
ret ed_post cs io body 2
end
ret hrspempty cs io 405
end
ret hrspempty cs io 404
end

fn serve1 lf int cs edit ulong 320 io edit uchar 131072 body edit uchar 65536 to long
c = haccept lf 30000000000
if lt c 0
ret 0
end
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret 0
end
hsettmo cs 10000000000 10000000000
hsetbdl cs 20000000000
for k ulong 10
r = hreqrd cs io
if le r 0
if lt r 0
x = hreject cs io r
end
break
end
r = route cs io body
if lt r 0
break
end
if eq hnext cs io 0
break
end
end
r = hclose cs
ret 0
end

fn ed_args to bool
ab = new uchar 256 0
put gcf 2 999999
put gcf 3 2130706433
n = ulong argcnt
i = ulong 1
while lt add i 1 n bound 64
k = argread i ab 0 64
v = argread add i 1 ab 64 192
if or lt k 0 lt v 0
ret false
end
ke = ulong k
ve = add 64 ulong v
if ac_peq view ab 0 ke edaapi
put gcf 0 ac_apiarg view ab 64 ve
end
if ac_peq view ab 0 ke edalis
put gcf 3 ac_ipv4 view ab 64 ve
end
if ac_peq view ab 0 ke edaport
put gcf 1 ac_dec view ab 64 ve
end
if ac_peq view ab 0 ke edacon
put gcf 2 ac_dec view ab 64 ve
end
i = add i 2
end
if or eq get gcf 0 0 gt get gcf 3 4294967295
ret false
end
ret and le get gcf 1 65535 and ge get gcf 2 1 le get gcf 2 999999
end

fn main to int
cs = new ulong 320 0
io = new uchar 131072 0
body = new uchar 65536 0
a = new uchar 16 0
ab = new uchar 32 0
if not ed_args
ret 1
end
r = haddr4 a uint get gcf 3 get gcf 1
lf = hlisten a 16
if lt lf 0
ret 2
end
q = ac_cat ab 0 eport
q = ac_catu ab q hport a
q = ac_catc ab q 10
ac_say view part ab 0 q
for j ulong get gcf 2
r = serve1 int lf cs io body
end
c = fclose int lf
ret 0
end
