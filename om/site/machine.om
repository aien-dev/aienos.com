note Machine dashboard renderers. Composition supplies om2 and shared runtime/JSON/chrome.
note Data is loaded at render time. Historical observations retain their dates and limitations.
fn sm_need obj ulong key view uchar * to ulong
nd = sj_find obj key
if eq nd 0
sr_flush
sr_diag key
exit 65
end
ret nd
end

fn sm_field obj ulong key view uchar * to void
sj_emit sm_need obj key
end

fn sm_prefix nd ulong pre view uchar * base view uchar * to bool
if sj_prefix nd pre
sr_raw base
sj_slice nd len pre
ret true
end
ret false
end

fn sm_url nd ulong to void
if ne sj_kind nd 3
exit 65
end
sz = sj_size nd
if eq sz 0
exit 65
end
for ix ulong sz
by = sj_byte nd ix
if or le by 32 eq by 92
exit 65
end
if eq by 46
if lt add ix 1 sz
if eq sj_byte nd add ix 1 46
exit 65
end
end
end
end
if sj_prefix nd smt0
sj_href nd
ret
end
if sj_prefix nd smt1
if sj_prefix nd smt2
exit 65
end
sj_href nd
ret
end
if sj_prefix nd smt3
sj_href nd
ret
end
if sm_prefix nd smt4 smt5
ret
end
if sm_prefix nd smt6 smt7
ret
end
if sm_prefix nd smt8 smt9
ret
end
if sm_prefix nd smt10 smt11
ret
end
if sm_prefix nd smt12 smt13
ret
end
if sm_prefix nd smt14 smt15
ret
end
if sm_prefix nd smt16 smt17
ret
end
if sm_prefix nd smt18 smt19
ret
end
if sm_prefix nd smt20 smt21
ret
end
if sj_prefix nd smt22
sm_pinned nd 4
end
if sm_prefix nd smt22 smt23
ret
end
if sm_prefix nd smt24 smt25
ret
end
if sj_prefix nd smt26
sm_pinned nd 4
end
if sm_prefix nd smt26 smt27
ret
end
if sj_prefix nd smt28
sm_pinned nd 4
end
if sm_prefix nd smt28 smt29
ret
end
if sj_prefix nd smt30
sm_pinned nd 5
end
if sm_prefix nd smt30 smt31
ret
end
if sm_prefix nd smt32 smt33
ret
end
exit 65
end

fn sm_isurl nd ulong to bool
if eq nd 0
ret false
end
if ne sj_kind nd 3
ret false
end
if or sj_prefix nd smt0 sj_prefix nd smt1
ret true
end
if or sj_prefix nd smt3 sj_prefix nd smt8
ret true
end
if or sj_prefix nd smt4 sj_prefix nd smt6
ret true
end
if or sj_prefix nd smt10 sj_prefix nd smt12
ret true
end
if or sj_prefix nd smt14 sj_prefix nd smt16
ret true
end
if or sj_prefix nd smt18 sj_prefix nd smt24
ret true
end
if or sj_prefix nd smt20 sj_prefix nd smt22
ret true
end
if or sj_prefix nd smt26 sj_prefix nd smt28
ret true
end
ret or sj_prefix nd smt30 sj_prefix nd smt32
end

fn sm_anchor nd ulong to void
sr_raw smt34
sm_url nd
sr_raw smt35
sj_emit nd
sr_raw smt36
end

fn sm_foot nd ulong to void
sr_raw smt37
if eq nd 0
sr_raw smt38
else
if not sm_isurl nd
exit 65
end
if or sj_prefix nd smt1 sj_prefix nd smt3
exit 65
end
if sj_prefix nd smt0
if not sj_prefix nd smt39
exit 65
end
end
sm_url nd
end
if sm_contains nd smxep
sr_raw smxev
else
sr_raw smt40
end
end

fn sm_value nd ulong to void
kind = sj_kind nd
if eq kind 1
sm_fields nd 0
ret
end
if eq kind 2
sr_raw smt41
it = sj_first nd
while ne it 0 bound 100000
sr_raw smt42
sm_value it
sr_raw smt43
it = sj_next it
end
sr_raw smt44
ret
end
if sm_isurl nd
sm_anchor nd
else
sj_emit nd
end
end

fn sm_fields nd ulong omit ulong to void
sr_raw smt45
it = sj_first nd
while ne it 0 bound 100000
if ne it omit
sr_raw smt46
sm_label nd it
sr_raw smt49
if or eq it sj_find nd smt50 eq it sj_find nd smk8
sr_raw smt51
sj_emit it
sr_raw smt52
else
if or eq it sj_find nd smk12 eq it sj_find nd smk13
sm_links it
else
sm_value it
end
end
sr_raw smt53
end
it = sj_next it
end
sr_raw smt54
end

fn sm_title nd ulong to ulong
hd = sj_find nd smt55
if eq hd 0
hd = sj_find nd smt56
end
if eq hd 0
hd = sj_find nd smt57
end
if eq hd 0
hd = sj_find nd smt58
end
if eq hd 0
hd = sj_find nd smt59
end
if eq hd 0
hd = sj_find nd smt60
end
ret hd
end

fn sm_card nd ulong to void
sr_raw smt61
sm_cardid nd
sr_raw smt62
hd = sm_title nd
if ne hd 0
sr_raw smt63
sj_emit hd
sr_raw smt64
end
sm_fields nd hd
ft = sj_find nd smt65
if eq ft 0
ft = sj_find nd smt66
end
if eq ft 0
ft = sj_find nd smt67
end
if eq ft 0
rc = sj_find nd smt68
if sm_isurl rc
ft = rc
end
end
sm_foot ft
sr_raw smt69
end

fn sm_cards nd ulong to void
if ne sj_kind nd 2
exit 65
end
sr_raw smt70
it = sj_first nd
while ne it 0 bound 100000
sm_card it
it = sj_next it
end
sr_raw smt71
end

fn sm_section ident view uchar * title view uchar * to void
sr_raw smt72
sr_esc ident
sr_raw smt73
sr_esc title
sr_raw smt74
end

fn sm_intro title view uchar * body view uchar * to void
sr_raw smt75
sr_esc title
sr_raw smt76
sr_esc body
sr_raw smt77
end

fn sm_par nd ulong to void
sr_raw smt78
sj_emit nd
sr_raw smt79
end

fn sm_status_valid st ulong cuda bool to void
if cuda
if or sj_eq st smt80 sj_eq st smt81
ret
end
if or sj_eq st smt82 sj_eq st smt83
ret
end
else
if or sj_eq st smt80 sj_eq st smt81
ret
end
if or sj_eq st smt84 sj_eq st smt85
ret
end
end
exit 65
end

fn sm_contains nd ulong word view uchar * to bool
if eq nd 0
ret false
end
if ne sj_kind nd 3
ret false
end
sz = sj_size nd
if lt sz len word
ret false
end
for ix ulong add sub sz len word 1
match = true
for jx ulong len word
if ne sj_byte nd add ix jx get word jx
match = false
end
end
if match
ret true
end
end
ret false
end

fn sm_checkrows nd ulong cuda bool hops bool to void
it = sj_first nd
while ne it 0 bound 100000
st = sm_need it smt50
sm_status_valid st cuda
if cuda
if sj_eq st smt82
lg = sm_need it smt86
if not sj_prefix lg smt87
exit 65
end
if lt sj_size lg 2
exit 65
end
for ix ulong sub sj_size lg 1
by = sj_byte lg add ix 1
if or lt by 48 gt by 57
exit 65
end
end
end
if not hops
if or sj_eq st smt83 sj_eq st smt81
exit 65
end
end
end
rc = sj_find it smt68
if hops
rc = sm_need it smt65
end
if sj_eq st smt80
if not sm_contains rc smt88
exit 65
end
if and cuda not hops
cmd = sm_need it smt89
if eq sj_kind cmd 7
exit 65
end
end
else
if not cuda
if ne rc 0
if ne sj_kind rc 7
exit 65
end
end
end
end
it = sj_next it
end
end

