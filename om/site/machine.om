perf = sm_need rt smt92
sm_checkrows sm_need perf smt91 false false
ly = sm_need rt smt93
if lt sj_len ly 13
exit 65
end
it = sj_first ly
while ne it 0 bound 100000
sm_status_valid sm_need it smt50 false
it = sj_next it
end
