note Schema fields use optional ? prefixes. Every other field must exist; unknown fields refuse.
fn sm_shape nd ulong spec view uchar * to void
if ne sj_kind nd 1
exit 65
end
count = ulong 0
start = ulong 0
for ix ulong add len spec 1
stop = eq ix len spec
if not stop
stop = eq get spec ix 124
end
if stop
begin = start
opt = false
if lt begin ix
if eq get spec begin 63
opt = true
begin = add begin 1
end
end
keynd = sj_find nd part spec begin sub ix begin
if eq keynd 0
if not opt
exit 65
end
else
count = add count 1
end
start = add ix 1
end
end
if ne count sj_len nd
exit 65
end
end

fn sm_clean nd ulong to void
kind = sj_kind nd
if or eq kind 1 eq kind 2
it = sj_first nd
while ne it 0 bound 100000
sm_clean it
it = sj_next it
end
ret
end
if eq kind 3
if or sm_contains nd smt284 sm_contains nd smt285
exit 65
end
end
end

fn sm_shapelist nd ulong spec view uchar * to void
if ne sj_kind nd 2
exit 65
end
it = sj_first nd
while ne it 0 bound 100000
sm_shape it spec
it = sj_next it
end
end

fn sm_order nd ulong spec view uchar * to void
it = sj_first nd
start = ulong 0
for ix ulong add len spec 1
stop = eq ix len spec
if not stop
stop = eq get spec ix 124
end
if stop
if eq it 0
exit 65
end
if not sj_eq sm_need it smt60 part spec start sub ix start
exit 65
end
it = sj_next it
start = add ix 1
end
end
if ne it 0
exit 65
end
end

fn sm_checkomega rt ulong to void
sm_clean rt
sm_shape rt smt286
src = sm_need rt smt99
sm_shape src smt287
if not sj_prefix sm_need src smt288 smt289
exit 65
end
sm_shapelist sm_need rt smt108 smt290
sm_shape sm_need rt smt110 smt290
sm_shapelist sm_need rt smt93 smt291
sm_shape sm_need rt smt68 smt292
sm_shapelist sm_need rt smt119 smt293
sm_shapelist sm_need rt smt122 smt293
sm_shapelist sm_need rt smt91 smt294
sm_order sm_need rt smt91 smt295
pf = sm_need rt smt92
sm_shape pf smt296
sm_shapelist sm_need pf smt91 smt294
sm_order sm_need pf smt91 smt297
end

fn sm_checkcuda rt ulong to void
sm_clean rt
sm_shape rt smt298
src = sm_need rt smt99
sm_shape src smt299
vis = sm_need src smt300
if not or sj_eq vis smt301 sj_eq vis smt302
exit 65
end
sm_shapelist sm_need rt smt130 smt303
sm_shapelist sm_need rt smt146 smt293
sm_shapelist sm_need rt smt131 smt304
sm_shapelist sm_need rt smt132 smt304
end

fn sm_pinned nd ulong offset ulong to void
if le sj_size nd add offset 40
exit 65
end
for ix ulong 40
by = sj_byte nd add offset ix
ok = and ge by 48 le by 57
ok = or ok and ge by 97 le by 102
ok = or ok and ge by 65 le by 70
if not ok
exit 65
end
end
if ne sj_byte nd add offset 40 47
exit 65
end
end

fn sm_uint nd ulong to void
if ne sj_kind nd 4
exit 65
end
sj_emit nd
end

