fn sm_researchrow rid view uchar * impl bool to void
rt = sj_load smt177
arr = sj_find rt smt178
if impl
arr = sm_need rt smt179
end
it = sj_first arr
while ne it 0 bound 100000
if sj_eq sm_need it smt60 rid
sm_card it
ret
end
it = sj_next it
end
exit 65
end

fn sm_machine_section wanted view uchar * to void
rt = sj_load smt180
it = sj_first sm_need rt smt181
while ne it 0 bound 100000
if sj_eq sm_need it smt60 wanted
sr_raw smt182
sr_esc wanted
sr_raw smt73
sm_field it smt55
sr_raw smt74
ps = sj_first sm_need it smt183
while ne ps 0 bound 100000
sm_par ps
ps = sj_next ps
end
sm_value sm_need it smt184
if sr_equal wanted smt185
sm_value sm_need rt smt186
sr_raw smt187
end
if sr_equal wanted smt188
sr_raw smt189
sm_field rt smt190
sr_raw smt191
end
sm_foot 0
sr_raw smt107
ret
end
it = sj_next it
end
exit 65
end

