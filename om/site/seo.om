end
si_required_data
si_expected
sx_inventory
end

fn ss_robots_txt to void
sr_raw SS0082
end

fn ss_literal value view uchar * to void
c = get value 0
if lt c 32
trap 10
end
if eq c 60
sr_raw ssltesc
else
sr_raw value
end
end
