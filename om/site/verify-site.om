note ---------------------------------------------------------------- helpers
fn sv_pg rel view uchar * rule view uchar * to ulong
ws = sv_loadrel rel
if eq ws 0
sv_fail rule vtmisspg
end
ret ws
end
fn sv_must s ulong t view uchar * rule view uchar * to void
for wk ulong sv_tcount t
wa = sv_tat t wk
if not sv_has s part t wa sv_tlen t wa
sv_failt rule vtneed part t wa sv_tlen t wa
end
end
end
fn sv_must1 s ulong n view uchar * rule view uchar * to void
if not sv_has s n
sv_failt rule vtneed n
end
end
fn sv_mustno s ulong n view uchar * rule view uchar * to void
if sv_has s n
sv_failt rule vtnot n
end
end
fn sv_files t view uchar * rule view uchar * to void
for wk ulong sv_tcount t
wa = sv_tat t wk
sv_prel part t wa sv_tlen t wa
if not sv_exists
sv_failt rule vtmisspg part t wa sv_tlen t wa
end
end
end
fn sv_nodash s ulong rule view uchar * to void
if sv_dash s
sv_fail rule vtdsh
end
end
fn sv_forbid s ulong rule view uchar * to void
for wk ulong sv_tcount vforbid
wa = sv_tat vforbid wk
if sv_hasc s part vforbid wa sv_tlen vforbid wa
sv_failt rule vtfor part vforbid wa sv_tlen vforbid wa
end
end
end

note ---------------------------------------------------------------- V1-V18
fn sv_v1v2 to void
if sv_there vfnow
sv_prel vfnow
wled = sv_vledger
end
wz = sv_pg vfzhp vrv2
if ne wz 0
sv_mustno wz vagd vrv2
sv_drop wz
end
end
fn sv_vroot to void
wr = sv_pg vfroot vrr0
if eq wr 0
ret
end
sv_mustno wr vfont vrr0
sv_nodash wr vrr0
sv_forbid wr vrv5
sv_root wr
sv_drop wr
end
fn sv_vclassic to void
wc = sv_pg vfcls vrv3
if eq wc 0
ret
end
sv_must wc vv3 vrv3
sv_mustno wc vfont vrv3
sv_must wc vv4 vrv4
sv_must wc vv5 vrv5
sv_forbid wc vrv5
sv_nodash wc vrv7
sv_must1 wc vomh vrv11
sv_must1 wc vcpl vrv12
sv_drop wc
end
fn sv_v6 to void
ws = sv_pg vfsty vrv6
if eq ws 0
ret
end
wd = long 0
wneg = false
for wj ulong sv_n ws
c = sv_b ws wj
if eq c 123
wd = add wd 1
end
if eq c 125
wd = sub wd 1
end
if lt wd 0
wneg = true
end
end
if or wneg ne wd 0
sv_fail vrv6 vtbrace
end
sv_must ws vv6 vrv6
sv_drop ws
end
fn sv_v8 to void
if sv_there vcrumb
sv_fail vrv8 vtcrumb
end
end
fn sv_v11 to void
wo = sv_pg vfomega vrv11
if eq wo 0
ret
end
if not or sv_has wo vv11a sv_has wo vv11b
sv_failt vrv11 vtneed vv11a
end
sv_must wo vv11 vrv11
sv_must1 wo vcpl vrv12
sv_drop wo
wc = sv_pg vfcuda vrv12
if eq wc 0
ret
end
sv_must wc vv12 vrv12
sv_drop wc
end
fn sv_v13 to void
for wk ulong sv_tcount vv13
wa = sv_tat vv13 wk
ws = sv_pg part vv13 wa sv_tlen vv13 wa vrv13
if ne ws 0
sv_nodash ws vrv13
sv_must1 ws vogt vrv13
sv_drop ws
end
end
end
fn sv_v15 rel view uchar * to void
ws = sv_pg rel vrv15
if eq ws 0
ret
end
sv_nodash ws vrv15
sv_must1 ws vogt vrv15
sv_must1 ws vrsb vrv15
sv_mustno ws vstb vrv15
if sv_fis0 rel vfmach
sv_must ws vv17 vrv17
wa = sv_find ws vrm 0
wb = sv_find ws vloop 0
if or eq wb VNONE ge wa wb
sv_fail vrv17 vtorder
end
end
sv_drop ws
end
fn sv_fis0 a view uchar * b view uchar * to bool
ret sr_equal a b
end
fn sv_v16 to void
ws = sv_pg vfown vrv16
if eq ws 0
ret
end
sv_must1 ws vthes vrv16
sv_must1 ws vsign vrv16
sv_must1 ws vogt vrv16
sv_nodash ws vrv16
sv_mustno ws vrsb vrv16
sv_drop ws
end
fn sv_v18 to void
ws = sv_pg vfstart vrv18
if eq ws 0
ret
end
sv_must ws vv18 vrv18
sv_drop ws
end
fn sv_v19 to void
for wk ulong sv_tcount vgen
wa = sv_tat vgen wk
wf = sv_tat vgenf wk
wfl = ulong 0
for wj ulong sv_tlen vgenf wf
wfl = add mul wfl 10 ulong sub get vgenf add wf wj 48
end
ws = sv_pg part vgen wa sv_tlen vgen wa vrv19
if ne ws 0
wn = sv_boxes ws vrv19
if lt wn wfl
sv_failn vrv19 vtfloor wn
end
sv_drop ws
end
end
wt = sv_pg vftl vrv19
if ne wt 0
sv_must1 wt vblafter vrv19
sv_drop wt
end
end
note N1: now.rs page_holds_invariants, on the published page: inside the <main> element (the
note rendered /now/ body; the shared head, JSON-LD and consent loader stay outside it) no <script
note and no Renda dial.
fn sv_n1 to void
ws = sv_pg vfnowp vrn1
if eq ws 0
ret
end
wa = sv_findc ws vxmain 0
wb = VNONE
if ne wa VNONE
wb = sv_findx ws vxmainc wa sv_n ws true
end
if or eq wa VNONE eq wb VNONE
sv_fail vrn1 vtnowb
else
wl = sv_lower ws
if or sv_hasn wl vxscro wa wb sv_hasn wl vrenda wa wb
sv_fail vrn1 vtnowb
end
end
sv_drop ws
end

note ---------------------------------------------------------------- E box links
note sv_boxes: boxlink.rs check_boxes over page slot s; returns the number of boxes, failures reported.
fn sv_cval s ulong t0 ulong t1 ulong to ulong
wv = sv_findn s vbcls t0 add t1 1
if eq wv VNONE
ret VNONE
end
wv = add wv len vbcls
wz = sv_findb2 s 34 wv
if or eq wz VNONE gt wz t1
ret VNONE
end
put vav 0 sub wz wv
ret wv
end
fn sv_isbox s ulong t0 ulong t1 ulong to bool
wv = sv_cval s t0 t1
if eq wv VNONE
ret false
end
wn = get vav 0
for wk ulong sv_tcount vboxc
wa = sv_tat vboxc wk
if sv_hastok s wv wn part vboxc wa sv_tlen vboxc wa true
ret true
end
end
ret false
end
fn sv_islink s ulong t0 ulong t1 ulong to bool
if not sv_eqat s t0 vbla
ret false
end
wv = sv_cval s t0 t1
if eq wv VNONE
ret false
end
ret sv_hastok s wv get vav 0 vblink true
end
fn sv_linkok s ulong t0 ulong t1 ulong to bool
wv = sv_findn s vbhref t0 add t1 1
if eq wv VNONE
ret false
end
wv = add wv len vbhref
wz = sv_findb2 s 34 wv
if or eq wz VNONE gt wz t1
ret false
end
ret and ge sub wz wv len vgh sv_eqat s wv vgh
end
fn sv_boxes s ulong rule view uchar * to ulong
wn = ulong 0
wopen = false
wres = true
wbx = ulong 0
wi = ulong 0
while true bound 999999
wl = sv_findb2 s 60 wi
if eq wl VNONE
break
end
wg = sv_tagend s wl
if eq wg VNONE
break
end
wi = add wg 1
wc = sv_bat s add wl 1
if not or eq wc 47 eq wc 33
if sv_isbox s wl wg
if and wopen not wres
sv_boxfail s wbx vtnobox rule
end
wopen = true
wres = false
wbx = wl
wn = add wn 1
else
if and wopen not wres
if sv_islink s wl wg
wres = true
if not sv_linkok s wl wg
sv_boxfail s wbx vtoffgh rule
end
end
end
end
end
end
if and wopen not wres
sv_boxfail s wbx vtnobox rule
end
ret wn
end
fn sv_boxfail s ulong wpos ulong why view uchar * rule view uchar * to void
wg = sv_tagend s wpos
wn = sub add wg 1 wpos
if gt wn 90
wn = 90
end
sv_failx rule why add sv_off s wpos wn
end

note ---------------------------------------------------------------- H hubs
fn sv_hub k ulong to void
wa = sv_tat vhubs k
ws = sv_pg part vhubs wa sv_tlen vhubs wa vrh
if eq ws 0
ret
end
wf = sv_find ws vfooter 0
if eq wf VNONE
wf = sv_n ws
end
if eq k 0
sv_hubreq ws vhub0 wf
sv_hubrows ws
end
if eq k 1
sv_hubreq ws vhub1 wf
sv_hubnost ws
end
if eq k 2
sv_hubreq ws vhub2 wf
sv_hubnost ws
end
sv_nodash ws vrh
wb = sv_boxes ws vrh
sv_dests ws
sv_drop ws
end
fn sv_hubreq s ulong t view uchar * wf ulong to void
for wk ulong sv_tcount t
wa = sv_tat t wk
if not sv_hasn s part t wa sv_tlen t wa 0 wf
sv_failt vrh vtneed part t wa sv_tlen t wa
end
end
end
fn sv_hubnost s ulong to void
for wk ulong sv_tcount vrstat
wa = sv_tat vrstat wk
if sv_has s part vrstat wa sv_tlen vrstat wa
sv_failt vrh vtstatw part vrstat wa sv_tlen vrstat wa
end
end
end
note sv_hubrows: every turing row of the published research-status.json has its card,
note data-row="ID" data-status="STATUS" (the hub renders from the same data).
fn sv_hubrows s ulong to void
sv_prel vfrsj
if not sv_exists
sv_fail vrh vtrow
ret
end
wr = sv_jload
wc = sj_first sj_find wr vktrows
while ne wc 0 bound 65536
wn = sv_snew
sv_pusht vdrow
sv_pushn sj_find wc vkid
sv_pusht vdst
sv_pushn sj_find wc vkstatus
sv_pusht vxquote
if eq sv_finda s 0 sv_n s sv_off wn sv_n wn VNONE
sv_failx vrh vtrow sv_off wn sv_n wn
end
sv_drop wn
wc = sj_next wc
end
end
fn sv_pushn node ulong to void
if ne sj_kind node 3
ret
end
for wj ulong sj_size node
sv_push sj_byte node wj
end
end

note ---------------------------------------------------------------- file loop
fn sv_each1 q ulong to void
if eq get vfk q 2
ret
end
wh = ulong 0
if sv_fext q vxhtm
wh = sv_fload q
if eq wh 0
ret
end
sv_c1 wh
sv_contact q wh
sv_assets wh
sv_voice1 q wh
sv_drop wh
ret
end
if or sv_fext q vxmd sv_fext q vxtxt
wh = sv_fload q
if ne wh 0
sv_voice1 q wh
sv_drop wh
end
ret
end
if sv_fext q vxjs
wh = sv_fload q
if ne wh 0
sv_c1js q wh
sv_drop wh
end
end
end
fn sv_eachf to void
for wq ulong get vfc 0
sv_pfile wq
sv_each1 wq
end
end

