sv_v13
for wk ulong 3
sv_hub wk
end
sv_v15 vfmach
sv_v15 vfdisc
sv_v16
sv_v18
sv_v19
sv_n1
ret and wok eq get vfail 0 0
end
note sv_pregen: B1-B4 over the repository before any output is written (paths relative to the
note current directory: the repository root). The generator calls this first and stops on false.
text vsnow "public/data/now.tsv"
text vsfacts "facts.json"
text vsagent "public/data/agent-repos.json"
text vsmach "crates/site-builder/data/machines.json"
text vsomega "crates/site-builder/data/omega.json"
text vscuda "crates/site-builder/data/cudaplusplus.json"
text vsres "crates/site-builder/data/research_status.json"
text vsstat "crates/site-builder/data/status.json"
text vsprog "public/data/project-progress.json"
text vsquote "data/quotes.json"
text vsengr "public/data/engineer.json"
fn sv_pregen to bool
sv_vinit
wok = true
put vpn 0 0
sv_padd vsnow
sv_ctxp
if sv_exists
wok = sv_vdata vkledg vsnow
end
wok = and sv_vdata vkfacts vsfacts wok
wok = and sv_vdata vkagent vsagent wok
wok = and sv_vdata vkmach vsmach wok
wok = and sv_vdata vkomega vsomega wok
wok = and sv_vdata vkcuda vscuda wok
wok = and sv_vdata vkres vsres wok
wok = and sv_vdata vkstat vsstat wok
wok = and sv_vdata vkprog vsprog wok
wok = and sv_vdata vkquote vsquote wok
wok = and sv_vdata vkengr vsengr wok
ret and wok eq get vfail 0 0
end
