fn sg_kind row ulong to void
if st_match row 6 sspaper
ss_quote sgpaper
else
if st_match row 6 ssart
ss_quote sgartype
else
if st_match row 6 sgcoll
ss_quote sgcoltyp
else
ss_quote sgweb
end
end
end
end

fn sg_basic row ulong to void
sr_raw sgid
sg_kind row
sr_raw sgurl
st_emit row 0 false
sr_raw sgurl2
st_emit row 0 false
sr_raw sgname
ss_qfield row 1
sr_raw sghl
ss_qfield row 1
sr_raw sgdesc
ss_qfield row 2
sr_raw sglang
if lt row get steng 0
ss_quote sgen
else
ss_quote sgzh
end
sr_raw sgpub
ss_qfield row 7
sr_raw sgmod
ss_modified row
sr_raw sgimage
st_emit row 8 false
sr_raw sgdim
if or st_match row 6 sspaper st_match row 6 ssart
sr_raw sgauthor
st_emit row 0 false
sr_raw ssquote
else
sr_raw sgbread
st_emit row 0 false
sr_raw sgbend
end
end

fn sg_paper row ulong to void
buf = new uchar 4096 0
sr_raw sgpre
n = st_field row 9 buf
if gt n 0
sr_raw sgdoi
ss_quote part buf 0 n
sr_raw sgsame
sr_raw part buf 0 n
sr_raw ssquote
end
sr_raw sgenc
st_emit row 10 false
sr_raw sgpdf
end

fn sg_translation row ulong to void
buf = new uchar 512 0
n = st_field row 10 buf
for i ulong get stcount 0
if ne i row
if st_match i 10 part buf 0 n
if ge row get steng 0
sr_raw sgtrof
else
sr_raw sgtrans
end
st_emit i 0 false
sr_raw sgobj
ret
end
end
end
end

fn sg_breadcrumb row ulong to void
sr_raw sgbstart
st_emit row 0 false
sr_raw sgbitems
if not st_match row 0 stroot
sr_raw sgbitem
ss_qfield row 1
sr_raw sgburl
st_emit row 0 false
sr_raw sgobj
end
sr_raw sgbclose
end

fn sg_dataset path view uchar * to void
root = sj_load ssfields
node = sj_first root
while ne node 0 bound 1024
if sj_eq sj_find node SG0007 path
sr_raw SG0001
sr_raw path
sr_raw SG0002
sr_raw path
sr_raw SG0003
ss_quote path
sr_raw SG0004
sg_qnode sj_find node SG0008
sr_raw SG0005
sg_dataset_stamp path
sr_raw SG0006
ret
end
node = sj_next node
end
trap 10
end

fn sg_qnode node ulong to void
buf = new uchar 4096 0
n = sj_string node buf
ss_quote part buf 0 n
end

fn sg_datasets row ulong to void
if st_match row 10 sglive
sg_dataset SG0013
end
if or st_match row 10 stroot st_match row 10 stclass
sg_dataset SG0013
sg_dataset SG0009
sg_dataset SG0010
sg_dataset SG0011
sg_dataset SG0012
sg_software
end
if st_match row 10 SG0016
sg_dataset SG0009
end
if st_match row 10 SG0017
sg_dataset SG0014
end
if st_match row 10 SG0018
sg_dataset SG0015
end
if or st_match row 10 SG0019 st_match row 10 SG0020
sg_dataset SG0012
end
end

fn sg_software to void
root = sj_load SG0021
arr = sj_find root SG0022
node = sj_first arr
while ne node 0 bound 1024
sr_raw SG0026
sg_qnode sj_find node SG0023
sr_raw SG0027
sg_qnode sj_find node SG0024
sr_raw SG0028
sg_qnode sj_find node SG0025
sr_raw SG0029
node = sj_next node
end
end

fn sg_graph row ulong to void
sr_raw sgopen
sg_basic row
if st_match row 6 sspaper
sg_paper row
end
sg_translation row
sr_raw sgbrace
sg_breadcrumb row
sr_raw sgident
sr_raw sgsite
sg_datasets row
sr_raw sgclose
end

fn sg_dataset_stamp path view uchar * to void
if sr_equal path SG0010
sf_facts
ret
end
if sr_equal path SG0013
sp_ledger_stamp
ret
end
st_stamp
end
