fn sd_get node ulong key view uchar * to ulong
v = sj_find node key
if ne sj_kind v 3
exit 72
end
ret v
end

fn sd_arr node ulong key view uchar * to ulong
v = sj_find node key
if ne sj_kind v 2
exit 72
end
ret v
end

fn sd_value node ulong key view uchar * to void
sj_emit sd_get node key
end

fn sd_field node ulong key view uchar * label view uchar * to void
sr_raw ddt
sr_esc label
sr_raw ddd
sd_value node key
sr_raw dddend
end

fn sd_nth arr ulong idx ulong to ulong
item = sj_first arr
for k ulong idx
if eq item 0
exit 72
end
item = sj_next item
end
if eq item 0
exit 72
end
ret item
end

fn sd_expect arr ulong idx ulong value view uchar * to void
if not sj_eq sd_nth arr idx value
exit 72
end
end

fn sd_member node ulong arr ulong to bool
item = sj_first arr
while ne item 0 bound 999999
if sj_same node item
ret true
end
item = sj_next item
end
ret false
end

fn sd_find arr ulong key view uchar * value ulong to ulong
item = sj_first arr
while ne item 0 bound 999999
if sj_same sd_get item key value
ret item
end
item = sj_next item
end
ret 0
end

fn sd_named arr ulong value view uchar * to ulong
item = sj_first arr
while ne item 0 bound 999999
if sj_eq sd_get item dkid value
ret item
end
item = sj_next item
end
exit 72
end

fn sd_enums root ulong to void
a = sd_arr root dkallow
if ne sj_len a 7
exit 72
end
sd_expect a 0 dpass
sd_expect a 1 dfail
sd_expect a 2 dincompl
sd_expect a 3 dblocked
sd_expect a 4 dpartial
sd_expect a 5 dnotest
sd_expect a 6 dnotstrt
b = sd_arr root dkastate
if ne sj_len b 4
exit 72
end
sd_expect b 0 dachieve
sd_expect b 1 dpart
sd_expect b 2 dnotach
sd_expect b 3 dnotatt
c = sd_arr root dkacls
if ne sj_len c 5
exit 72
end
sd_expect c 0 dimpl
sd_expect c 1 dpimpl
sd_expect c 2 dexper
sd_expect c 3 dplan
sd_expect c 4 dhypoth
end

fn sd_check_rows arr ulong allowed ulong key view uchar * to void
item = sj_first arr
if eq item 0
exit 72
end
while ne item 0 bound 999999
ident = sd_get item dkid
if not sd_member sd_get item key allowed
exit 72
end
other = sj_next item
while ne other 0 bound 999999
if sj_same ident sd_get other dkid
exit 72
end
other = sj_next other
end
item = sj_next item
end
end

fn sd_check_ladder root ulong to void
arr = sd_arr root dkladder
if ne sj_len arr 8
exit 72
end
sd_expect_level arr 0 dl0
sd_expect_level arr 1 dl1
sd_expect_level arr 2 dl2
sd_expect_level arr 3 dl3
sd_expect_level arr 4 dl4
sd_expect_level arr 5 dl5
sd_expect_level arr 6 dl6
sd_expect_level arr 7 dl7
allowed = sd_arr root dkastate
item = sj_first arr
top = ulong 0
gap = false
while ne item 0 bound 999999
value = sd_get item dkstate
if not sd_member value allowed
exit 72
end
if sj_eq value dachieve
if gap
exit 72
end
top = sd_get item dklevel
else
gap = true
end
item = sj_next item
end
if eq top 0
exit 72
end
if not sj_same top sd_get sj_find root dkcurr dklevel
exit 72
end
end

fn sd_expect_level arr ulong idx ulong value view uchar * to void
if not sj_eq sd_get sd_nth arr idx dklevel value
exit 72
end
end

fn sd_check_attempts root ulong to void
arr = sd_arr root dkattemp
item = sj_first arr
while ne item 0 bound 999999
row = sd_find sd_arr root dkturing dkid sd_get item dkid
if eq row 0
exit 72
end
if not sj_same sd_get row dkstatus sd_get item dkoutcom
exit 72
end
if eq sd_find sd_arr root dkladder dklevel sd_get item dkbeside 0
exit 72
end
if eq sd_find sd_arr root dkturing dkid sd_get item dkled 0
exit 72
end
item = sj_next item
end
end

fn sd_load to ulong
root = sj_load dpath
sd_enums root
sd_check_ladder root
sd_check_rows sd_arr root dkturing sd_arr root dkallow dkstatus
sd_check_rows sd_arr root dkimpl sd_arr root dkacls dkclass
sd_check_attempts root
ret root
end

fn sd_prefix txt view uchar * prefix view uchar * to bool
if lt len txt len prefix
ret false
end
for k ulong len prefix
if ne get txt k get prefix k
ret false
end
end
ret true
end

fn sd_suffix txt view uchar * suffix view uchar * to bool
if lt len txt len suffix
ret false
end
start = sub len txt len suffix
for k ulong len suffix
if ne get txt add start k get suffix k
ret false
end
end
ret true
end

fn sd_safehref node ulong github bool to void
if github
if not sj_prefix node dgit
exit 72
end
else
if sj_prefix node dslash
if gt sj_size node 1
if eq sj_byte node 1 47
exit 72
end
end
else
if not sj_prefix node dhttps
exit 72
end
end
end
sj_href node
end

fn sd_source to void
sr_raw dfsrc
sr_raw dsource
sr_raw dfoots
end

fn sd_urlfoot url ulong evidence bool to void
if evidence
sr_raw dfoot
else
sr_raw dfsrc
end
sd_safehref url true
if evidence
sr_raw dfoote
else
sr_raw dfoots
end
end

fn sd_fileext txt view uchar * to bool
if sd_suffix txt deh
ret true
end
if sd_suffix txt dec
ret true
end
if sd_suffix txt demd
ret true
end
if sd_suffix txt desh
ret true
end
if sd_suffix txt dejson
ret true
end
if sd_suffix txt demk
ret true
end
if sd_suffix txt detxt
ret true
end
if sd_suffix txt detsv
ret true
end
ret false
end

fn sd_qsfoot txt view uchar * to void
sr_raw dfoot
sr_raw dqs
if gt len txt 3
k = ulong 3
while lt k len txt bound 999999
b = get txt k
if or lt b 48 gt b 57
break
end
k = add k 1
end
if gt k 3
sr_raw dline
sr_esc part txt 3 sub k 3
end
end
sr_raw dfoote
end

fn sd_pathfoot txt view uchar * repo ulong to bool
colon = len txt
slash = false
for k ulong len txt
b = get txt k
if eq b 58
colon = k
break
end
if eq b 47
slash = true
end
if eq b 46
if lt add k 1 len txt
if eq get txt add k 1 46
ret false
end
end
end
end
special = sr_equal part txt 0 colon dcurdoc
if not special
if not slash
ret false
end
if eq get txt 0 47
ret false
end
if not sd_fileext part txt 0 colon
ret false
end
end
sr_raw dfoot
sr_raw dgit
if eq repo 1
sr_raw daienux
else
if eq repo 2
sr_raw darch
else
if eq repo 3
sr_raw datlas
else
sr_raw domega
end
end
end
sr_raw dblob
if special
sr_raw dcurpth
else
sr_esc part txt 0 colon
end
if lt colon len txt
start = add colon 1
finish = start
while lt finish len txt bound 999999
b = get txt finish
if or lt b 48 gt b 57
break
end
finish = add finish 1
end
if gt finish start
sr_raw dline
sr_esc part txt start sub finish start
end
end
sr_raw dfoote
ret true
end

fn sd_citation txt view uchar * to bool
start = ulong 0
while lt start len txt bound 999999
if gt get txt start 32
break
end
start = add start 1
end
repo = ulong 0
if sd_prefix part txt start sub len txt start dpreos
repo = 1
start = add start len dpreos
else
if sd_prefix part txt start sub len txt start dprear
repo = 2
start = add start len dprear
else
if sd_prefix part txt start sub len txt start dpreat
repo = 3
start = add start len dpreat
else
if sd_prefix part txt start sub len txt start dpreom
start = add start len dpreom
end
end
end
end
finish = start
while lt finish len txt bound 999999
if le get txt finish 32
break
end
finish = add finish 1
end
while gt finish start bound 999999
b = get txt sub finish 1
if not or or eq b 44 eq b 59 eq b 58
break
end
finish = sub finish 1
end
if eq finish start
ret false
end
if or sr_equal part txt start sub finish start dqsword sd_prefix part txt start sub finish start dqscolon
sd_qsfoot part txt start sub finish start
ret true
end
ret sd_pathfoot part txt start sub finish start repo
end

fn sd_optional_link node ulong to ulong
url = sj_find node dklink
if eq url 0
ret 0
end
if eq sj_kind url 7
ret 0
end
if ne sj_kind url 3
exit 72
end
ret url
end

fn sd_evidence node ulong key view uchar * to void
buf = new uchar 4096 0
url = sd_optional_link node
if ne url 0
sd_urlfoot url true
ret
end
ev = sd_get node key
n = sj_string ev buf
if not sd_citation part buf 0 n
sd_source
end
end

fn sd_slug node ulong to void
buf = new uchar 1 0
pending = false
wrote = false
for k ulong sj_size node
b = sj_byte node k
if and ge b 65 le b 90
b = add b 32
end
if or and ge b 97 le b 122 and ge b 48 le b 57
if pending
sr_raw ddash
pending = false
end
put buf 0 b
sr_raw buf
wrote = true
else
if wrote
pending = true
end
end
end
end

