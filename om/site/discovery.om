text dledto " Led to "
fn sd_attempts root ulong level ulong to void
item = sj_first sd_arr root dkattemp
while ne item 0 bound 999999
if sj_same sd_get item dkbeside level
sr_raw dattempt
sd_value item dkid
sr_raw datth
sd_badge sd_get item dkoutcom
sr_raw dspace
sd_value item dkid
sr_raw dattkeep
sd_value item dksum
sr_raw dledto
sd_value item dkled
sr_raw dpend
sr_raw ddivend
end
item = sj_next item
end
end

fn sd_ladder_data root ulong to void
sr_raw dladopen
sd_current root
sr_raw dladhint
item = sj_first sd_arr root dkladder
while ne item 0 bound 999999
sr_raw dstep
sd_value item dklevel
sr_raw dststate
sd_value item dkstate
sr_raw dsteph
sd_value item dklevel
sr_raw dcolon
sd_value item dkname
sr_raw dh3end
sr_raw dp
sd_value item dkstate
sr_raw dpend
sr_raw dp
sd_value item dkdetail
sr_raw dpend
sr_raw dbasis
sd_value item dkbasis
sr_raw dpend
sd_evidence item dkbasis
sd_attempts root sd_get item dklevel
sr_raw dliend
item = sj_next item
end
sr_raw dladend
end

fn sd_ladder to void
root = sd_load
sd_ladder_data root
end

