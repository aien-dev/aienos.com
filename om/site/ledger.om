note Smallest account number above prev (or any when first) for provider p; 0 flag in lkok.
fn lk_nexta p uchar prev ulong first bool to ulong
xb = ulong 0
put lkok 0 0
for xi ulong get lkann 0
if eq get lkap xi p
xn = get lkan xi
if or first gt xn prev
if or eq get lkok 0 0 lt xn xb
xb = xn
put lkok 0 1
end
end
end
end
ret xb
end

fn lk_acct p uchar n ulong to void
sr_raw ld12
lk_un n
xf = lk_afirst p n
xl = get lkapl add mul xf 2 1
if gt xl 0
sr_raw ld13
lk_e get lkapl mul xf 2 xl
sr_raw lkspc
end
sr_raw ld14
for xw uchar 2
for xi ulong get lkann 0
if eq get lkap xi p
if eq get lkan xi n
if eq get lkaw xi xw
lk_dlimit xi
end
end
end
end
end
sr_raw ld14
end

fn lk_afirst p uchar n ulong to ulong
for xi ulong get lkann 0
if and eq get lkap xi p eq get lkan xi n
ret xi
end
end
ret 0
end

fn lk_pcard p uchar to void
xn = lk_nexta p 0 true
if eq get lkok 0 0
ret
end
