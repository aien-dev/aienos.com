note Length of the keeper/renda prefix when the rest is all digits, else 0.
fn lk_keepn i ulong to ulong
xo = lk_fo i 2
xl = lk_fl i 2
xp = ulong 0
if lk_eqpre xo xl lkokp
xp = 6
else
if lk_eqpre xo xl lkkrn
xp = 5
end
end
if eq xp 0
ret 0
end
for xj ulong sub xl xp
if not lk_dg get lkcl add add xo xp xj
ret 0
end
end
ret xp
end

fn lk_eqpre o ulong l ulong s view uchar * to bool
if lt l len s
ret false
end
ret lk_eqat o 0 s
end

fn lk_iskeep i ulong to bool
if ne get lkown i 0
ret false
end
ret ne lk_keepn i 0
end

fn lk_olabel i ulong to void
xk = get lkown i
if eq xk 1
sr_raw lkol0
ret
end
if eq xk 2
sr_raw lkol1
ret
end
if eq xk 3
sr_raw lkol2
ret
end
if eq xk 4
sr_raw lkol3
ret
end
xp = lk_keepn i
if ne xp 0
lk_okeeper i xp
ret
end
sr_raw lkol6
lk_oagent i
end

fn lk_okeeper i ulong p ulong to void
xo = lk_fo i 2
xl = lk_fl i 2
if eq xl p
sr_raw lkol4
ret
end
sr_raw lkol5
lk_e add xo p sub xl p
end

note sa-3-dfa217d1 reads "dfa217"; any other owner stays as written.
fn lk_oagent i ulong to void
xo = lk_fo i 2
xl = lk_fl i 2
xe = add xo xl
xa = lk_find 1 xo xe 45
if and lt xa xe lk_eqt xo sub xa xo lksa
xb = lk_find 1 add xa 1 xe 45
if lt xb xe
xc = lk_find 1 add xb 1 xe 45
xs = add xb 1
xn = sub xc xs
if gt xn 6
xn = 6
end
lk_e xs xn
ret
end
end
lk_e xo xl
end

