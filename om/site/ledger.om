note repo_name(short) over lkcl [a, b): full-name index, 255 when unknown.
fn lk_repo a ulong b ulong to uchar
xl = sub b a
if or lk_eqt a xl lkrs0 lk_eqt a xl lkrf0
ret 0
end
if or or lk_eqt a xl lkrs1 lk_eqt a xl lkrs2 lk_eqt a xl lkrf1
ret 1
end
if or or lk_eqt a xl lkrf2 lk_eqt a xl lkrs3 lk_eqt a xl lkrs4
ret 2
end
if or or lk_eqt a xl lkrs5 lk_eqt a xl lkrs6 lk_eqt a xl lkrf3
ret 3
end
if or lk_eqt a xl lkrs7 lk_eqt a xl lkrf4
ret 4
end
if or lk_eqt a xl lkrs8 lk_eqt a xl lkrf5
ret 5
end
if or lk_eqt a xl lkrs9 lk_eqt a xl lkrf6
ret 6
end
if lk_eqt a xl lkrf7
ret 7
end
if lk_eqt a xl lkrf8
ret 8
end
if lk_eqt a xl lkrf9
ret 9
end
ret 255
end

fn lk_drepo s uchar to uchar
if or eq s 0 eq s 4
ret 0
end
if eq s 1
ret 1
end
if eq s 2
ret 7
end
if eq s 3
ret 2
end
if eq s 5
ret 8
end
ret 255
end

fn lk_tokc c uchar to bool
if or or lk_up c lk_lo c lk_dg c
ret true
end
ret or or eq c 46 eq c 95 or or eq c 47 eq c 64 or eq c 35 eq c 45
end

fn lk_tpush s ulong e ulong to void
xn = get lktn 0
if ge xn LKTOK
lk_fail lkemfld 0
end
put lkts xn s
put lkte xn e
put lktn 0 add xn 1
end

fn lk_tokens o ulong l ulong to void
put lktn 0 0
xs = ulong 0
xin = false
for xi ulong l
xc = get lkcl add o xi
if lk_tokc xc
if not xin
xs = add o xi
xin = true
end
else
if xin
lk_tpush xs add o xi
xin = false
end
end
end
if xin
lk_tpush xs add o l
end
end

fn lk_starts s ulong e ulong t view uchar * to bool
if lt sub e s len t
ret false
end
ret lk_eqat s 0 t
end

note A URL runs to the next White_Space, ')', '"' or '>'.
fn lk_urlend s ulong e ulong to ulong
while lt s e bound 999999
xc = get lkcl s
if or eq xc 41 or eq xc 34 eq xc 62
ret s
end
if ne lk_wsat 1 s e 0
ret s
end
s = add s 1
end
ret e
end

fn lk_punct c uchar to bool
ret or or eq c 46 eq c 44 or eq c 59 eq c 58
end

note Tokens: URL extension, then trailing .,;: stripped, empties dropped; in place.
fn lk_tfix o ulong l ulong to void
xe = add o l
xw = ulong 0
xskip = o
for xr ulong get lktn 0
xs = get lkts xr
xt = get lkte xr
if ge xs xskip
if or lk_starts xs xe lkhttps lk_starts xs xe lkhttp
xt = lk_urlend xs xe
xskip = xt
end
while gt xt xs bound 999999
if not lk_punct get lkcl sub xt 1
break
end
xt = sub xt 1
end
if gt xt xs
put lkts xw xs
put lkte xw xt
xw = add xw 1
end
end
end
put lktn 0 xw
end

fn lk_last s ulong e ulong c uchar to ulong
xp = e
while gt xp s bound 999999
xp = sub xp 1
if eq get lkcl xp c
ret xp
end
end
ret e
end

fn lk_alldg s ulong e ulong to bool
if ge s e
ret false
end
while lt s e bound 999999
if not lk_dg get lkcl s
ret false
end
s = add s 1
end
ret true
end

fn lk_issha s ulong e ulong to bool
xn = sub e s
if or lt xn 7 gt xn 40
ret false
end
while lt s e bound 64
xc = get lkcl s
if not or lk_dg xc and ge xc 97 le xc 102
ret false
end
s = add s 1
end
ret true
end

fn lk_isbr s ulong e ulong to bool
if ge s e
ret false
end
if or eq get lkcl s 47 eq get lkcl sub e 1 47
ret false
end
while lt s e bound 999999
xc = get lkcl s
if not or or lk_lo xc lk_dg xc or or eq xc 47 eq xc 46 or eq xc 95 eq xc 45
ret false
end
s = add s 1
end
ret true
end

fn lk_hasdd s ulong e ulong to bool
while lt add s 1 e bound 999999
if and eq get lkcl s 46 eq get lkcl add s 1 46
ret true
end
s = add s 1
end
ret false
end

note Kind: 0 none, 1 issue, 2 commit, 3 url, 4 evidence, 5 repository name (sets the repo).
fn lk_tclass k ulong to void
xs = get lkts k
xe = get lkte k
put lktk k 0
put lktr k 255
if or lk_starts xs xe lkhttps lk_starts xs xe lkhttp
put lktk k 3
ret
end
xh = lk_last xs xe 35
if lt xh xe
lk_tissue k xs xh xe
ret
end
xa = lk_find 1 xs xe 64
if lt xa xe
if and lk_isbr xs xa lk_issha add xa 1 xe
put lktk k 2
end
ret
end
if lk_starts xs xe lkevp
if and gt sub xe xs 9 not lk_hasdd add xs 9 xe
put lktk k 4
end
ret
end
xr = lk_repo xs xe
if ne xr 255
put lktk k 5
put lktr k xr
end
end

fn lk_tissue k ulong s ulong h ulong e ulong to void
xs = s
if lk_starts s h lkadv0
xs = add s 9
end
if not lk_alldg add h 1 e
ret
end
xr = lk_repo xs h
if ne xr 255
put lktk k 1
put lktr k xr
end
end

note Resolve commit repositories left to right and evidence paths against the first commit.
fn lk_tresolve s uchar to void
xlast = lk_drepo s
put lkfc 0 0
for xk ulong get lktn 0
lk_tclass xk
xt = get lktk xk
if eq xt 5
xlast = get lktr xk
put lktk xk 0
end
if eq xt 2
if eq xlast 255
put lktk xk 0
else
put lktr xk xlast
lk_tfirst xk xlast
end
end
end
for xj ulong get lktn 0
if eq get lktk xj 4
if eq get lkfc 0 0
put lktk xj 0
end
end
end
end

fn lk_tfirst k ulong r uchar to void
if ne get lkfc 0 0
ret
end
xs = get lkts k
put lkfc 0 1
put lkfc 1 ulong r
put lkfc 2 xs
put lkfc 3 lk_find 1 xs get lkte k 64
end

fn lk_thref k ulong to void
xt = get lktk k
xs = get lkts k
xe = get lkte k
if eq xt 3
lk_e xs sub xe xs
ret
end
sr_raw lkgh
if eq xt 4
lk_evhref xs xe
ret
end
lk_rfull get lktr k
if eq xt 1
sr_raw lkgi
xh = lk_last xs xe 35
lk_e add xh 1 sub sub xe xh 1
ret
end
sr_raw lkgc
xa = lk_find 1 xs xe 64
lk_e add xa 1 sub sub xe xa 1
end

fn lk_evhref s ulong e ulong to void
lk_rfull uchar get lkfc 1
sr_raw lkgt
xb = get lkfc 2
lk_e xb sub get lkfc 3 xb
sr_raw lkslash
while gt e s bound 999999
if ne get lkcl sub e 1 47
break
end
e = sub e 1
end
lk_e s sub e s
end

note A note with its references linked; plain runs pass through keeper_name.
fn lk_note o ulong l ulong s uchar to void
lk_tokens o l
lk_tfix o l
lk_tresolve s
xcur = o
for xk ulong get lktn 0
if ne get lktk xk 0
xs = get lkts xk
xe = get lkte xk
if gt xs xcur
lk_k xcur sub xs xcur
end
sr_raw lkref0
lk_thref xk
sr_raw lkfa2
lk_e xs sub xe xs
sr_raw lkref1
xcur = xe
end
end
if lt xcur add o l
lk_k xcur sub add o l xcur
end
end

fn lk_lastnote i ulong to void
xn = add get lknf i sub get lknc i 1
lk_note get lkno xn get lknl xn get lkstrm i
end

note ---------------------------------------------------------------- item sets

fn lk_cur i ulong to bool
xa = get lkage i
ret and ge xa 0 lt xa 86400
end

note 1 operator, 2 queued, 3 moving, 4 moving now, 5 moving quiet, 6 queued now,
note 7 queued quiet, 8 settled, 9 settled now, 10 open.
fn lk_in i ulong set uchar to bool
xs = get lkstat i
if eq set 8
ret or eq xs 2 eq xs 3
end
if eq set 9
ret and or eq xs 2 eq xs 3 lk_cur i
end
if ne xs 1
ret false
end
if eq set 10
ret true
end
xo = eq get lkown i 1
if eq set 1
ret xo
end
if xo
ret false
end
xq = or eq get lkown i 4 eq get lknc i 0
if eq set 2
ret xq
end
if eq set 3
ret not xq
end
if eq set 4
ret and not xq lk_cur i
end
if eq set 5
ret and not xq not lk_cur i
end
if eq set 6
ret and xq lk_cur i
end
ret and xq not lk_cur i
end

fn lk_count set uchar to ulong
xn = ulong 0
for xi ulong get lkn 0
if lk_in xi set
xn = add xn 1
end
end
ret xn
end

fn lk_scount set uchar s uchar to ulong
xn = ulong 0
for xi ulong get lkn 0
if and lk_in xi set eq get lkstrm xi s
xn = add xn 1
end
end
ret xn
end

fn lk_akey i ulong to long
xa = get lkage i
if lt xa 0
ret 9223372036854775807
end
ret xa
end

note Stable sort of all rows by age (unknown last) into lkperm.
fn lk_sort to void
xn = get lkn 0
for xi ulong xn
put lkperm xi xi
end
for xj ulong xn
if gt xj 0
xv = get lkperm xj
xk = xj
while gt xk 0 bound 999999
if le lk_akey get lkperm sub xk 1 lk_akey xv
break
end
put lkperm xk get lkperm sub xk 1
xk = sub xk 1
end
put lkperm xk xv
end
end
end

fn lk_hands to ulong
xn = ulong 0
for xi ulong get lkn 0
if lk_hand xi
if not lk_seen xi
xn = add xn 1
end
end
end
ret xn
end

fn lk_hand i ulong to bool
if or ne get lkstat i 1 ne get lkown i 0
ret false
end
xa = get lkage i
ret and ge xa 0 lt xa 7200
end

fn lk_seen i ulong to bool
for xj ulong i
if lk_hand xj
if lk_sameo xj i
ret true
end
end
end
ret false
end

fn lk_sameo a ulong b ulong to bool
xl = lk_fl a 2
if ne xl lk_fl b 2
ret false
end
xo = lk_fo a 2
xp = lk_fo b 2
for xj ulong xl
if ne get lkcl add xo xj get lkcl add xp xj
ret false
end
end
ret true
end

