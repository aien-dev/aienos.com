fn lk_fo i ulong k ulong to ulong
ret get lkio add mul i 8 k
end

fn lk_fl i ulong k ulong to ulong
ret get lkil add mul i 8 k
end

note Exact byte equality of an lkcl string with a text.
fn lk_eqt o ulong l ulong s view uchar * to bool
if ne l len s
ret false
end
for xj ulong l
if ne get lkcl add o xj get s xj
ret false
end
end
ret true
end

fn lk_lb c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note to_ascii_lowercase(lkcl[o..o+l]) starts with / contains s (s lowercase).
fn lk_lat o ulong l ulong p ulong s view uchar * to bool
if gt add p len s l
ret false
end
for xj ulong len s
if ne lk_lb get lkcl add add o p xj get s xj
ret false
end
end
ret true
end

fn lk_lpre o ulong l ulong s view uchar * to bool
ret lk_lat o l 0 s
end

fn lk_lhas o ulong l ulong s view uchar * to bool
for xp ulong l
if lk_lat o l xp s
ret true
end
end
ret eq len s 0
end

fn lk_okind o ulong l ulong to uchar
if lk_eqt o l lkow0
ret 1
end
if lk_eqt o l lkow1
ret 2
end
if lk_eqt o l lkow2
ret 3
end
if lk_eqt o l lkow3
ret 4
end
ret 0
end

note classify(item, owner): stream index into lk_sname order.
fn lk_class i ulong to uchar
xo = lk_fo i 4
xl = lk_fl i 4
if or or lk_lpre xo xl lkc0 lk_lhas xo xl lkc1 or or lk_lhas xo xl lkc2 lk_lhas xo xl lkc3 lk_lhas xo xl lkc4
ret 4
end
if or or lk_lpre xo xl lkc5 lk_lhas xo xl lkc6 or lk_lhas xo xl lkc7 lk_lhas xo xl lkc8
ret 0
end
if or lk_lhas xo xl lkc9 lk_lhas xo xl lkc10
ret 0
end
if lk_lpre xo xl lkc11
ret 2
end
if or or lk_lhas xo xl lkc12 lk_lhas xo xl lkc13 or lk_lhas xo xl lkc14 lk_lhas xo xl lkc15
ret 5
end
if or or lk_lhas xo xl lkc16 lk_lhas xo xl lkc17 or lk_lhas xo xl lkc18 lk_lhas xo xl lkc19
ret 1
end
if or or lk_lhas xo xl lkc20 lk_lhas xo xl lkc21 or lk_lhas xo xl lkc22 lk_lhas xo xl lkc23
ret 3
end
if lk_lhas xo xl lkc24
ret 3
end
if or eq get lkown i 2 or lk_lpre xo xl lkc25 lk_lpre xo xl lkc26
ret 6
end
if or lk_lhas xo xl lkc27 lk_lhas xo xl lkc28
ret 6
end
ret 7
end

fn lk_lower o ulong l ulong to void
for xj ulong l
put lkcl add o xj lk_lb get lkcl add o xj
end
end

note Status code: 1 open, 2 done, 3 dropped, 0 anything else (kept and shown as written).
fn lk_scode o ulong l ulong to uchar
if lk_eqt o l lkst0
ret 1
end
if lk_eqt o l lkst1
ret 2
end
if lk_eqt o l lkst2
ret 3
end
ret 0
end

fn lk_notes i ulong to void
xo = lk_fo i 6
xe = add xo lk_fl i 6
put lknf i get lknn 0
put lknc i 0
xs = xo
while true bound 999999
xq = lk_nsep xs xe
lk_trim 1 xs xq
xa = ulong get lkt 6
xb = ulong get lkt 7
if gt xb xa
xn = get lknn 0
if ge xn LKNOTES
lk_fail lkemrow 0
end
put lkno xn xa
put lknl xn sub xb xa
put lknn 0 add xn 1
put lknc i add get lknc i 1
end
if ge xq xe
break
end
xs = add xq 3
end
end

fn lk_nsep p ulong e ulong to ulong
while le add p 3 e bound 999999
if eq get lkcl p 32
if eq get lkcl add p 1 124
if eq get lkcl add p 2 32
ret p
end
end
end
p = add p 1
end
ret e
end

fn lk_row p ulong e ulong line ulong to void
xi = get lkn 0
if ge xi LKROWS
lk_fail lkemrow line
end
xs = p
xk = ulong 0
while lt xk 8 bound 9
xf = lk_find 0 xs e 9
put lkio add mul xi 8 xk lk_clean xs xf
put lkil add mul xi 8 xk get lklast 0
xk = add xk 1
if ge xf e
break
end
xs = add xf 1
end
if lt xk 5
lk_fail lkemrst line
end
while lt xk 8 bound 9
put lkio add mul xi 8 xk get lkcn 0
put lkil add mul xi 8 xk 0
xk = add xk 1
end
put lkline xi line
lk_lower lk_fo xi 3 lk_fl xi 3
put lkstat xi lk_scode lk_fo xi 3 lk_fl xi 3
put lkown xi lk_okind lk_fo xi 2 lk_fl xi 2
put lkstrm xi lk_class xi
lk_notes xi
lk_rowtime xi
put lkn 0 add xi 1
end

fn lk_rowtime i ulong to void
xo = lk_fo i 7
xv = lk_utc 1 xo add xo lk_fl i 7
put lkupd i xv
put lkupv i get lkok 0
xo = lk_fo i 1
xv = lk_utc 1 xo add xo lk_fl i 1
put lkopd i xv
put lkopv i get lkok 0
xat = lk_now
put lkage i -1
if ne get lkupv i 0
put lkage i sub xat get lkupd i
else
if ne get lkopv i 0
put lkage i sub xat get lkopd i
end
end
end

note parse_ledger over the guarded projection: header line skipped, every other line a row.
fn lk_parse to void
put lkn 0 0
put lknn 0 0
if eq get lkhas 0 0
ret
end
xp = lk_roff 0
xe = add xp lk_rlen 0
xl = lk_find 0 xp xe 10
xs = add xl 1
xline = ulong 2
while lt xs xe bound 999999
xl = lk_find 0 xs xe 10
lk_row xs xl xline
xline = add xline 1
xs = add xl 1
end
end

note Rust str::lines: split at LF, drop one CR before it; no empty trailing line.
fn lk_lend p ulong e ulong to ulong
xl = lk_find 0 p e 10
if gt xl p
if eq get lkraw sub xl 1 13
ret sub xl 1
end
end
ret xl
end

fn lk_pulse to void
put lkpn 0 0
if eq get lkhas 1 0
ret
end
xp = lk_roff 1
xe = add xp lk_rlen 1
while lt xp xe bound 999999
xl = lk_lend xp xe
xt = lk_find 0 xp xl 9
if lt xt xl
lk_pair xp xt xl
end
xp = add lk_find 0 xp xe 10 1
end
end

fn lk_pair p ulong t ulong e ulong to void
xn = get lkpn 0
if ge xn 1024
lk_fail lkemrow 0
end
put lkpk mul xn 2 lk_clean p t
put lkpk add mul xn 2 1 get lklast 0
put lkpv mul xn 2 lk_clean add t 1 e
put lkpv add mul xn 2 1 get lklast 0
put lkpn 0 add xn 1
end

text lkmk0 "checked"
text lkmk1 "model"
text lkmk2 "plan"
text lkmk3 "limit"

note Copy raw [p, e) into lkcl unchanged (trimmed by the caller); length in lklast.
fn lk_copy p ulong e ulong to ulong
xo = get lkcn 0
while lt p e bound 999999
lk_cput get lkraw p
p = add p 1
end
put lklast 0 sub get lkcn 0 xo
ret xo
end

fn lk_rawt p ulong e ulong s view uchar * to bool
lk_trim 0 p e
ret lk_rawis ulong get lkt 6 ulong get lkt 7 s
end

note parse_models_check: last valid checked line wins; model ids in order.
fn lk_mcheck to void
put lkmcv 0 0
put lkmidn 0 0
if eq get lkhas 2 0
ret
end
xp = lk_roff 2
xe = add xp lk_rlen 2
while lt xp xe bound 999999
xl = lk_lend xp xe
xt = lk_find 0 xp xl 9
if lt xt xl
lk_mline xp xt xl
end
xp = add lk_find 0 xp xe 10 1
end
end

fn lk_mline p ulong t ulong e ulong to void
if lk_rawt p t lkmk0
xv = lk_utc 0 add t 1 e
if eq get lkok 0 1
lk_trim 0 add t 1 e
put lkmc 0 lk_copy ulong get lkt 6 ulong get lkt 7
put lkmc 1 get lklast 0
put lkmcv 0 1
end
ret
end
if lk_rawt p t lkmk1
lk_trim 0 add t 1 e
if gt get lkt 7 get lkt 6
xn = get lkmidn 0
if ge xn 1024
lk_fail lkemrow 0
end
put lkmid mul xn 2 lk_clean add t 1 e
put lkmid add mul xn 2 1 get lklast 0
put lkmidn 0 add xn 1
end
end
end

note Split [p, e) at tabs into lkt-free scratch: field starts/ends in the caller's arrays.
fn lk_fields p ulong e ulong fs edit ulong 16 fe edit ulong 16 to ulong
xk = ulong 0
xs = p
while lt xk 16 bound 17
xf = lk_find 0 xs e 9
put fs xk xs
put fe xk xf
xk = add xk 1
if ge xf e
break
end
xs = add xf 1
end
ret xk
end

note parse_utc(..).map(fmt_utc) into lkcl; 0 length when None.
fn lk_utcfmt p ulong e ulong to ulong
xv = lk_utc 0 p e
if eq get lkok 0 0
put lklast 0 0
ret get lkcn 0
end
ret lk_fmt xv false
end

note usage_words (dash false, 40) and dash word() filtering (true, 48); then trim.
fn lk_words p ulong e ulong dash bool to ulong
xo = get lkcn 0
xk = ulong 0
xmax = ulong 40
if dash
xmax = 48
end
while lt p e bound 999999
if ge xk xmax
break
end
xc = get lkraw p
xn = lk_u8len p e
if eq xn 1
if lk_wkeep xc dash
lk_cput xc
xk = add xk 1
end
end
if eq xn 0
xn = 1
end
p = add p xn
end
lk_trim 1 xo get lkcn 0
xa = ulong get lkt 6
xb = ulong get lkt 7
put lklast 0 sub xb xa
ret xa
end

fn lk_wkeep c uchar dash bool to bool
if or or and ge c 48 le c 57 and ge c 65 le c 90 or and ge c 97 le c 122 eq c 32
ret true
end
if eq c 46
ret true
end
if not dash
ret false
end
if or or eq c 58 eq c 95 or eq c 47 eq c 38
ret true
end
ret or or eq c 40 eq c 41 or eq c 43 eq c 45
end

note f64 parse, round half away from zero, clamp 0..100 (NaN 0); lkok 0 when it does not parse.
fn lk_pct p ulong e ulong to ulong
lk_trim 0 p e
xs = ulong get lkt 6
xe = ulong get lkt 7
put lkok 0 0
if ge xs xe
ret 0
end
xneg = false
xc = get lkraw xs
if or eq xc 43 eq xc 45
xneg = eq xc 45
xs = add xs 1
end
if lk_pinf xs xe
put lkok 0 1
if xneg
ret 0
end
ret 100
end
if lk_pnan xs xe
put lkok 0 1
ret 0
end
xv = lk_pdec xs xe
if xneg
ret 0
end
ret xv
end

text lkfinf "inf"
text lkfinfy "infinity"
text lkfnan "nan"

fn lk_rawci p ulong e ulong s view uchar * to bool
if ne sub e p len s
ret false
end
for xj ulong len s
if ne lk_lb get lkraw add p xj get s xj
ret false
end
end
ret true
end

fn lk_pinf p ulong e ulong to bool
ret or lk_rawci p e lkfinf lk_rawci p e lkfinfy
end

fn lk_pnan p ulong e ulong to bool
ret lk_rawci p e lkfnan
end

note Decimal digits[.digits][(e|E)[+-]digits]; value from the integer part and first fraction digit.
fn lk_pdec p ulong e ulong to ulong
xdg = new uchar 512 0
xnd = ulong 0
xip = long 0
xdot = false
while lt p e bound 999999
xc = get lkraw p
if and ge xc 48 le xc 57
if lt xnd 512
put xdg xnd sub xc 48
xnd = add xnd 1
end
if not xdot
xip = add xip 1
end
else
if and eq xc 46 not xdot
xdot = true
else
break
end
end
p = add p 1
end
if eq xnd 0
ret 0
end
if lt p e
xc = get lkraw p
if not or eq xc 101 eq xc 69
ret 0
end
xx = lk_pint 0 add p 1 e
if eq get lkok 0 0
ret 0
end
xip = add xip xx
end
put lkok 0 1
ret lk_round view xdg xnd xip
end

fn lk_rinp ip long nd ulong to bool
if lt ip 0
ret false
end
ret lt ulong ip nd
end

fn lk_round dg view uchar 512 nd ulong ip long to ulong
xv = ulong 0
xi = long 0
while lt xi ip bound 999999
if lt ulong xi nd
xv = add mul xv 10 ulong get dg ulong xi
else
xv = mul xv 10
end
if gt xv 100
ret 100
end
xi = add xi 1
end
if lk_rinp ip nd
if ge get dg ulong ip 5
xv = add xv 1
end
end
if gt xv 100
ret 100
end
ret xv
end

note claude-usage.tsv: checked/plan/limit rows; limits capped at 1024 (refusal beyond).
fn lk_usage to void
put lkun 0 0
put lkuv 0 0
put lkuc 1 0
put lkup 1 0
if eq get lkhas 3 0
ret
end
xp = lk_roff 3
xe = add xp lk_rlen 3
xfs = new ulong 16 0
xfe = new ulong 16 0
while lt xp xe bound 999999
xl = lk_lend xp xe
xn = lk_fields xp xl xfs xfe
lk_uline xn xfs xfe
xp = add lk_find 0 xp xe 10 1
end
if and ne get lkuc 1 0 gt get lkun 0 0
put lkuv 0 1
end
end

text lkuk0 "session"
text lkuk1 "weekly_all"
text lkuk2 "weekly_scoped"

fn lk_uline n ulong fs view ulong 16 fe view ulong 16 to void
if lt n 2
ret
end
if lk_rawis get fs 0 get fe 0 lkmk0
put lkuc 0 lk_utcfmt get fs 1 get fe 1
put lkuc 1 get lklast 0
ret
end
if lk_rawis get fs 0 get fe 0 lkmk2
put lkup 0 lk_words get fs 1 get fe 1 false
put lkup 1 get lklast 0
ret
end
if lt n 4
ret
end
if lk_rawis get fs 0 get fe 0 lkmk3
lk_ulimit n fs fe
end
end

fn lk_ulimit n ulong fs view ulong 16 fe view ulong 16 to void
xpc = lk_pct get fs 2 get fe 2
if eq get lkok 0 0
ret
end
xso = get lkcn 0
xsl = ulong 0
if gt n 4
xso = lk_words get fs 4 get fe 4 false
xsl = get lklast 0
end
xk = uchar 255
if lk_rawis get fs 1 get fe 1 lkuk0
xk = 0
end
if lk_rawis get fs 1 get fe 1 lkuk1
xk = 1
end
if and lk_rawis get fs 1 get fe 1 lkuk2 gt xsl 0
xk = 2
end
if eq xk 255
ret
end
xi = get lkun 0
if ge xi 1024
lk_fail lkemrow 0
end
put lkuk xi xk
put lkus mul xi 2 xso
put lkus add mul xi 2 1 xsl
put lkupc xi xpc
put lkur mul xi 2 lk_utcfmt get fs 3 get fe 3
put lkur add mul xi 2 1 get lklast 0
put lkun 0 add xi 1
end

note ---------------------------------------------------------------- dash inputs

text lkpv0 "Anthropic"
text lkpv1 "OpenAI Codex"
text lkpv2 "Google Antigravity"
text lkpv3 "xAI Grok"
text lkwin0 "5h"
text lkwin1 "week"
text lkexh "exhausted"
text lkrk0 "role"
text lkrk1 "agent"
text lkrk2 "seat"
text lkadv "advisor"

fn lk_hexb c uchar to bool
ret or and ge c 48 le c 57 or and ge c 97 le c 102 and ge c 65 le c 70
end

note looks_private: '@', an 8hex-4hex run, or a token ending in a mail domain with a letter host.
fn lk_priv p ulong e ulong to bool
for xi ulong sub e p
if eq get lkraw add p xi 64
ret true
end
end
if gt sub e p 12
for xj ulong sub sub e p 12
if lk_uuidish add p xj
ret true
end
end
end
ret lk_dom p e
end

fn lk_uuidish p ulong to bool
for xj ulong 8
if not lk_hexb get lkraw add p xj
ret false
end
end
if ne get lkraw add p 8 45
ret false
end
for xk ulong 4
if not lk_hexb get lkraw add add p 9 xk
ret false
end
end
ret true
end

fn lk_dtok c uchar to bool
ret or or and ge c 48 le c 57 and ge c 65 le c 90 or and ge c 97 le c 122 or eq c 46 eq c 45
end

fn lk_dom p ulong e ulong to bool
xs = p
while lt xs e bound 999999
xt = xs
while lt xt e bound 999999
if not lk_dtok get lkraw xt
break
end
xt = add xt 1
end
if lk_domt xs xt
ret true
end
xt = add xt lk_skip1 xt e
xs = xt
end
ret false
end

fn lk_skip1 p ulong e ulong to ulong
if ge p e
ret 1
end
xn = lk_u8len p e
if eq xn 0
ret 1
end
ret xn
end

text lktld0 "com"
text lktld1 "org"
text lktld2 "net"
text lktld3 "io"
text lktld4 "ai"
text lktld5 "dev"
text lktld6 "co"
text lktld7 "us"

fn lk_domt p ulong e ulong to bool
if or or lk_tld p e lktld0 lk_tld p e lktld1 or lk_tld p e lktld2 lk_tld p e lktld3
ret true
end
ret or or lk_tld p e lktld4 lk_tld p e lktld5 or lk_tld p e lktld6 lk_tld p e lktld7
end

note token ends ".tld" (ASCII case-insensitive) and the host before it has an ASCII letter.
fn lk_tld p ulong e ulong s view uchar * to bool
xn = add len s 1
if gt xn sub e p
ret false
end
xd = sub e xn
if ne get lkraw xd 46
ret false
end
if not lk_rawci add xd 1 e s
ret false
end
while lt p xd bound 999999
xc = lk_lb get lkraw p
if and ge xc 97 le xc 122
ret true
end
p = add p 1
end
ret false
end

note dash word(): None when private; the kept string otherwise. lkok 0 for None.
fn lk_dword p ulong e ulong to ulong
if lk_priv p e
put lkok 0 0
put lklast 0 0
ret 0
end
xo = lk_words p e true
put lkok 0 1
ret xo
end

fn lk_pvidx p ulong e ulong to uchar
if lk_rawis p e lkpv0
ret 0
end
if lk_rawis p e lkpv1
ret 1
end
if lk_rawis p e lkpv2
ret 2
end
if lk_rawis p e lkpv3
ret 3
end
ret 255
end

note u32 parse after trim: optional '+', digits, at most 4294967295.
fn lk_pu32 p ulong e ulong to ulong
lk_trim 0 p e
xs = ulong get lkt 6
xe = ulong get lkt 7
put lkok 0 0
if and lt xs xe eq get lkraw xs 43
xs = add xs 1
end
if ge xs xe
ret 0
end
xv = ulong 0
while lt xs xe bound 999999
xc = get lkraw xs
if or lt xc 48 gt xc 57
ret 0
end
xv = add mul xv 10 ulong sub xc 48
if gt xv 4294967295
ret 0
end
xs = add xs 1
end
put lkok 0 1
ret xv
end

fn lk_accts to void
put lkann 0 0
put lkdcv 0 0
if eq get lkhas 4 0
ret
end
xp = lk_roff 4
xe = add xp lk_rlen 4
xfs = new ulong 16 0
xfe = new ulong 16 0
while lt xp xe bound 999999
xl = lk_lend xp xe
xn = lk_fields xp xl xfs xfe
lk_aline xn xfs xfe
xp = add lk_find 0 xp xe 10 1
end
end

fn lk_aline n ulong fs view ulong 16 fe view ulong 16 to void
if and ge n 2 lk_rawis get fs 0 get fe 0 lkmk0
put lkdc 0 lk_utcfmt get fs 1 get fe 1
put lkdc 1 get lklast 0
put lkdcv 0 0
if gt get lklast 0 0
put lkdcv 0 1
end
ret
end
if lt n 9
ret
end
if not lk_rawis get fs 0 get fe 0 lkmk3
ret
end
xpv = lk_pvidx get fs 1 get fe 1
if eq xpv 255
ret
end
xan = lk_pu32 get fs 2 get fe 2
if eq get lkok 0 0
ret
end
lk_alimit n fs fe xpv xan
end

fn lk_alimit n ulong fs view ulong 16 fe view ulong 16 pv uchar an ulong to void
xpc = lk_pct get fs 6 get fe 6
if eq get lkok 0 0
ret
end
xw = uchar 255
if lk_rawis get fs 4 get fe 4 lkwin0
xw = 0
end
if lk_rawis get fs 4 get fe 4 lkwin1
xw = 1
end
if eq xw 255
ret
end
xlo = lk_dword get fs 5 get fe 5
if eq get lkok 0 0
ret
end
xll = get lklast 0
xpo = lk_dword get fs 3 get fe 3
if eq get lkok 0 0
ret
end
xi = get lkann 0
if ge xi 1024
lk_fail lkemrow 0
end
lk_apput xi xpo xlo xll
lk_alast xi fs fe pv an
put lkaw xi xw
put lkapc xi xpc
put lkann 0 add xi 1
end

note lk_apput: the four lkapl/lkal cells of limit row i (split out of lk_alimit for registers).
fn lk_apput i ulong po ulong lo ulong ll ulong to void
put lkapl mul i 2 po
put lkapl add mul i 2 1 get lklast 0
put lkal mul i 2 lo
put lkal add mul i 2 1 ll
end

fn lk_alast i ulong fs view ulong 16 fe view ulong 16 pv uchar an ulong to void
put lkap i pv
put lkan i an
put lkar mul i 2 lk_utcfmt get fs 7 get fe 7
put lkar add mul i 2 1 get lklast 0
put lkax i 0
if lk_rawis get fs 8 get fe 8 lkexh
put lkax i 1
end
end

fn lk_routes to void
put lkrcnt 0 0
put lkseat 0 0
if eq get lkhas 5 0
ret
end
xp = lk_roff 5
xe = add xp lk_rlen 5
xfs = new ulong 16 0
xfe = new ulong 16 0
while lt xp xe bound 999999
xl = lk_lend xp xe
xn = lk_fields xp xl xfs xfe
if ge xn 3
lk_rline xfs xfe
end
xp = add lk_find 0 xp xe 10 1
end
end

fn lk_rline fs view ulong 16 fe view ulong 16 to void
xno = lk_dword get fs 1 get fe 1
if eq get lkok 0 0
ret
end
xnl = get lklast 0
xmo = lk_dword get fs 2 get fe 2
if eq get lkok 0 0
ret
end
xml = get lklast 0
if or eq xnl 0 eq xml 0
ret
end
xk = uchar 255
if lk_rawis get fs 0 get fe 0 lkrk0
xk = 0
end
if lk_rawis get fs 0 get fe 0 lkrk1
xk = 1
end
if lk_rawis get fs 0 get fe 0 lkrk2
xk = 2
put lkseat 0 1
end
if eq xk 255
ret
end
xi = get lkrcnt 0
if ge xi 1024
lk_fail lkemrow 0
end
put lkrk xi xk
put lkrnm mul xi 2 xno
put lkrnm add mul xi 2 1 xnl
put lkrmd mul xi 2 xmo
put lkrmd add mul xi 2 1 xml
put lkrcnt 0 add xi 1
end

