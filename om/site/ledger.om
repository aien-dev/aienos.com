fn lk_mchk to void
if eq get lkmcv 0 0
sr_raw lhnev
ret
end
lk_e get lkmc 0 get lkmc 1
end

fn lk_mcard root ulong m ulong to void
xst = lk_mstate m
sr_raw lh70
lk_mstx m xst
sr_raw lh2
sj_emit sj_find m lkmj2
sr_raw lh71
sj_emit sj_find m lkmj6
sr_raw lh72
lk_mstx m xst
sr_raw lhq
lk_mwords m xst
sr_raw lh73
sj_emit sj_find m lkmj3
sr_raw lh74
sj_emit sj_find m lkmj7
sr_raw lh9
lk_mbody m xst
lk_figs sj_find m lkmj10
lk_mfoot root m
sr_raw lh11
end

fn lk_mbody m ulong st uchar to void
if eq st 0
xj = lk_served m
sr_raw lh75
lk_e get lkmid mul xj 2 get lkmid add mul xj 2 1
sr_raw lh76
lk_mchk
sr_raw lh77
ret
end
if eq st 1
sr_raw lh80
ret
end
if sj_eq sj_find m lkmj5 lkms2
sr_raw lh78
lk_mchk
sr_raw lh79
end
end

fn lk_figs a ulong to void
if eq sj_len a 0
ret
end
sr_raw lh81
xf = sj_first a
while ne xf 0 bound 65536
sr_raw lh82
sj_emit sj_find xf lkmj11
sr_raw lh83
sj_emit sj_find xf lkmj13
sr_raw lh84
lk_url sj_find xf lkmj14
sr_raw lh85
xf = sj_next xf
end
sr_raw lh86
end

text lh90 "<section class=\"now-section\" id=\"models\" aria-labelledby=\"now-models-h\"><div class=\"container\"><p class=\"kicker\">On the Spark</p><h2 id=\"now-models-h\" class=\"now-h2\">Models doing the work</h2><p class=\"now-sub\">The models the plan names, what each one is for, and whether it answered the Spark's own check of its model servers. The Spark checks every five minutes; this page shows the check from its last build"
text lh91 " (<span class=\"mono\">"
text lh92 "</span>)"
text lh93 ". Every speed links to its receipt. A token is a word or a piece of one. The plan: <a class=\"prose-link\" href=\""
text lh94 "</a>.</p><div class=\"now-grid\">"
text lh95 "</div></div></section>"

fn lk_models to void
xr = lk_roster
sr_raw lh90
if ne get lkmcv 0 0
sr_raw lh91
lk_mchk
sr_raw lh92
end
sr_raw lh93
xp = sj_find xr lkmj0
lk_url sj_find xp lkmj12
sr_raw lhq
sj_emit sj_find xp lkmj11
sr_raw lh94
xm = sj_first sj_find xr lkmj1
while ne xm 0 bound 65536
lk_mcard xr xm
xm = sj_next xm
end
sr_raw lh95
end

fn lk_nmodels to ulong
xr = lk_roster
ret sj_len sj_find xr lkmj1
end

