text lkrn10 "media"
text lkrn11 "Users"
text lkrn12 "private"

fn lk_sep i ulong to ulong
xc = lk_f i
if or eq xc 95 eq xc 45
ret add i 1
end
ret i
end

note First keyword alternative that fits at i (end index), 0 when none.
fn lk_kw i ulong to ulong
if lk_lit i lkk0
ret add i 8
end
if lk_lit i lkk1
ret add i 6
end
if lk_lit i lkk2
ret add i 6
end
if lk_lit i lkk3
xq = lk_sep add i 3
if lk_lit xq lkk4
ret add xq 3
end
end
if lk_lit i lkk5
xq = lk_sep add i 7
if lk_lit xq lkk4
ret add xq 3
end
end
if lk_lit i lkk6
xq = lk_sep add i 6
if lk_lit xq lkk7
ret add xq 5
end
end
if lk_lit i lkk8
ret add i 13
end
if lk_lit i lkk9
ret add i 4
end
if lk_lit i lkk10
ret add i 6
end
if lk_lit i lkk11
ret lk_kwses add i 7
end
ret 0
end

fn lk_kwses i ulong to ulong
xq = lk_sep i
if lk_lit xq lkk4
ret add xq 3
end
if lk_lit xq lkk7
ret add xq 5
end
if lk_lit xq lkk12
ret add xq 2
end
ret 0
end

note auth(?:orization)? backtracks to the bare auth when the long form's tail fails.
fn lk_kw2 i ulong to ulong
if lk_lit i lkk8
ret add i 4
end
ret 0
end

note \s*(?:=|:|\bis\b)\s*\S+ from q; returns match end, 0 if none.
fn lk_s1r q ulong to ulong
xr = lk_skws q
xc = lk_c xr
xt = ulong 0
if or eq xc 61 eq xc 58
xt = add xr 1
else
if not and lk_lit xr lkkis and lk_wb xr lk_wb add xr 2
ret 0
end
xt = add xr 2
end
xt = lk_skws xt
if ge xt get lkcpn 0
ret 0
end
ret lk_nsend xt
end

fn lk_s1 i ulong to ulong
if not lk_wb i
ret 0
end
xk = lk_kw i
if eq xk 0
ret 0
end
xe = lk_s1r xk
if ne xe 0
ret xe
end
xk = lk_kw2 i
if eq xk 0
ret 0
end
ret lk_s1r xk
end

fn lk_s2t k ulong to bool
if not lk_isws k
ret false
end
ret lt lk_skws k get lkcpn 0
end

fn lk_s2k q ulong to bool
xk = lk_kw q
if ne xk 0
if lk_s2t xk
ret true
end
end
xk = lk_kw2 q
if ne xk 0
ret lk_s2t xk
end
ret false
end

fn lk_s2 i ulong to bool
if not lk_lit i lkkdd
ret false
end
xq = add i 2
while lt xq get lkcpn 0 bound 999999
if lk_s2k xq
ret true
end
xr = xq
while lk_an lk_f xr bound 999999
xr = add xr 1
end
if eq xr xq
ret false
end
xc = lk_f xr
if not or eq xc 95 eq xc 45
ret false
end
xq = add xr 1
end
ret false
end

fn lk_s3 i ulong to bool
if not lk_wb i
ret false
end
xp = ulong 0
if lk_lit i lkksk
xp = add i 3
end
if lk_lit i lkkghp
xp = add i 4
end
if lk_lit i lkkgho
xp = add i 4
end
if lk_lit i lkkgpat
xp = add i 11
end
if lk_lit i lkkakia
xp = add i 4
end
if lk_lit i lkkxox
xc = lk_f add i 3
if and or or eq xc 98 eq xc 97 or or eq xc 112 eq xc 114 eq xc 115 eq lk_f add i 4 45
xp = add i 5
end
end
if eq xp 0
ret false
end
xc = lk_f xp
ret or lk_an xc or eq xc 95 eq xc 45
end

fn lk_s4p q ulong to bool
if not lk_lit q lkk5
ret false
end
if not lk_isws add q 7
ret false
end
ret lk_lit lk_skws add q 7 lkk4
end

fn lk_s4 i ulong to bool
if not lk_lit i lkkbeg
ret false
end
xq = add i 10
if not lk_isws xq
ret false
end
xq = lk_skws xq
while lt xq get lkcpn 0 bound 999999
if lk_s4p xq
ret true
end
xr = xq
while lk_az lk_f xr bound 999999
xr = add xr 1
end
if eq xr xq
ret false
end
if not lk_isws xr
ret false
end
xq = lk_skws xr
end
ret false
end

fn lk_s5 i ulong to bool
if not and lk_wb i lk_lit i lkkbear
ret false
end
xq = add i 6
if not lk_isws xq
ret false
end
xq = lk_skws xq
xk = ulong 0
while true bound 999999
xc = lk_f xq
if not or lk_an xc or or eq xc 46 eq xc 95 eq xc 45
break
end
xk = add xk 1
xq = add xq 1
end
ret ge xk 8
end

fn lk_s6 i ulong to bool
if not lk_az lk_f i
ret false
end
xk = add i 1
while true bound 999999
xc = lk_f xk
if not or lk_an xc or or eq xc 43 eq xc 46 eq xc 45
break
end
xk = add xk 1
end
if not lk_litc xk lkkcss
ret false
end
ret lk_s6u add xk 3
end

note [^\s/@]+:[^\s/@]+@ from u.
fn lk_s6u u ulong to bool
xr = u
xcol = false
while lt xr get lkcpn 0 bound 999999
xc = lk_c xr
if or lk_sp xc or eq xc 47 eq xc 64
break
end
if and eq xc 58 and gt xr u lt add xr 1 get lkcpn 0
if lk_s6y add xr 1
xcol = true
end
end
xr = add xr 1
end
ret and xcol eq lk_c xr 64
end

fn lk_s6y p ulong to bool
xc = lk_c p
ret not or lk_sp xc or or eq xc 47 eq xc 64 ge p get lkcpn 0
end

fn lk_exctx to bool
for xi ulong get lkcpn 0
if lk_lita xi lkrfc
ret true
end
end
ret false
end

fn lk_exm i ulong e ulong to bool
if ne sub e i len lkrfck
ret false
end
ret lk_lita i lkrfck
end

fn lk_secret to bool
xex = lk_exctx
for xi ulong get lkcpn 0
xe = lk_s1 xi
if ne xe 0
if not and xex lk_exm xi xe
ret true
end
else
if lk_secr2 xi
ret true
end
end
end
ret false
end

fn lk_secr2 i ulong to bool
if or lk_s2 i or lk_s3 i lk_s4 i
ret true
end
ret or lk_s5 i lk_s6 i
end

fn lk_eml c uint to bool
ret or lk_an c or or eq c 46 eq c 95 or or eq c 37 eq c 43 eq c 45
end

fn lk_emd c uint to bool
ret or lk_an c or eq c 46 eq c 45
end

fn lk_emr b ulong to bool
xe = b
while lk_emd lk_f xe bound 999999
xe = add xe 1
end
xj = add b 1
while lt xj xe bound 999999
if eq lk_c xj 46
xl = add xj 1
while lk_az lk_f xl bound 999999
xl = add xl 1
end
if and ge sub xl add xj 1 2 lk_wb xl
ret true
end
end
xj = add xj 1
end
ret false
end

fn lk_ema a ulong to bool
xs = a
while gt xs 0 bound 999999
if not lk_eml lk_f sub xs 1
break
end
xs = sub xs 1
end
if eq xs a
ret false
end
xok = false
xj = xs
while lt xj a bound 999999
if lk_wb xj
xok = true
break
end
xj = add xj 1
end
if not xok
ret false
end
ret lk_emr add a 1
end

fn lk_email to bool
for xi ulong get lkcpn 0
if eq lk_c xi 64
if lk_ema xi
ret true
end
end
end
ret false
end

fn lk_ctrl to bool
for xi ulong get lkcpn 0
xc = lk_c xi
if or lt xc 32 lk_inr xc 127 159
ret true
end
end
ret false
end

fn lk_pdel c uint to bool
if lk_sp c
ret true
end
if or or eq c 40 eq c 60 or eq c 96 eq c 34
ret true
end
ret or or eq c 39 eq c 91 or or eq c 61 eq c 58 eq c 44
end

fn lk_seg c uint to bool
ret or lk_an c or or eq c 46 eq c 95 eq c 45
end

fn lk_path i ulong to bool
if gt i 0
if not lk_pdel lk_c sub i 1
ret false
end
end
xc = lk_c i
if eq xc 126
xd = lk_c add i 1
ret or eq xd 47 eq xd 92
end
if ne xc 47
ret false
end
xr = add i 1
while lk_seg lk_f xr bound 999999
xr = add xr 1
end
ret and gt xr add i 1 eq lk_c xr 47
end

fn lk_rootn q ulong s view uchar * to bool
if not lk_litc q s
ret false
end
ret eq lk_c add q len s 47
end

fn lk_root i ulong to bool
if or lk_litc i lkrt0 lk_litc i lkrt1
ret true
end
if ne lk_c i 47
ret false
end
xq = add i 1
if or or lk_rootn xq lkrn0 lk_rootn xq lkrn1 or lk_rootn xq lkrn2 lk_rootn xq lkrn3
ret true
end
if or or lk_rootn xq lkrn4 lk_rootn xq lkrn5 or lk_rootn xq lkrn6 lk_rootn xq lkrn7
ret true
end
if or or lk_rootn xq lkrn8 lk_rootn xq lkrn9 or lk_rootn xq lkrn10 lk_rootn xq lkrn11
ret true
end
ret lk_rootn xq lkrn12
end

fn lk_hexn q ulong k ulong to bool
for xj ulong k
if not lk_hx lk_f add q xj
ret false
end
end
ret true
end

fn lk_uuid i ulong to bool
if not and lk_wb i lk_hexn i 8
ret false
end
if not and eq lk_c add i 8 45 lk_hexn add i 9 4
ret false
end
if not and eq lk_c add i 13 45 lk_hexn add i 14 4
ret false
end
if not and eq lk_c add i 18 45 lk_hexn add i 19 4
ret false
end
if not and eq lk_c add i 23 45 lk_hexn add i 24 12
ret false
end
ret lk_wb add i 36
end

fn lk_hc c uint to bool
ret or lk_an c or eq c 95 eq c 45
end

fn lk_hpre d ulong to bool
if eq d 0
ret false
end
if not lk_hc lk_f sub d 1
ret false
end
xs = sub d 1
while true bound 999999
xc = lk_f xs
if lk_hc xc
if lk_wb xs
ret true
end
else
if ne xc 46
ret false
end
if eq xs 0
ret false
end
if not lk_hc lk_f sub xs 1
ret false
end
end
if eq xs 0
ret false
end
xs = sub xs 1
end
ret false
end

fn lk_hsuf d ulong s view uchar * to bool
if not lk_lit add d 1 s
ret false
end
if not lk_wb add add d 1 len s
ret false
end
ret lk_hpre d
end

fn lk_host i ulong to bool
if and lk_wb i lk_lit i lkklh
if lk_wb add i 9
ret true
end
end
if ne lk_c i 46
ret false
end
ret or lk_hsuf i lkkloc or lk_hsuf i lkkint lk_hsuf i lkkts
end

fn lk_drun q ulong to ulong
xk = ulong 0
while lk_nd lk_c add q xk bound 999999
if ge add q xk get lkcpn 0
break
end
xk = add xk 1
end
ret xk
end

fn lk_ip4 i ulong to bool
if not lk_wb i
ret false
end
xq = i
for xo ulong 3
xk = lk_drun xq
if or eq xk 0 gt xk 3
ret false
end
xq = add xq xk
if ne lk_c xq 46
ret false
end
xq = add xq 1
end
xk = lk_drun xq
if or eq xk 0 gt xk 3
ret false
end
ret lk_wb add xq xk
end

fn lk_ip6 i ulong to bool
if ne lk_c i 91
ret false
end
xr = add i 1
while true bound 999999
xc = lk_f xr
if not or lk_hx xc eq xc 58
break
end
xr = add xr 1
end
ret and ge sub xr add i 1 2 eq lk_c xr 93
end

fn lk_port i ulong to bool
if not lk_litc i lkk18
ret false
end
if not and lk_ad lk_c add i 3 and lk_ad lk_c add i 4 lk_ad lk_c add i 5
ret false
end
ret lk_wb add i 6
end

fn lk_pid i ulong to bool
if not and lk_wb i lk_lit i lkkpid
ret false
end
xq = lk_skws add i 3
xr = xq
while lk_ad lk_c xr bound 999999
xr = add xr 1
end
if eq xr xq
ret false
end
ret lk_wb xr
end

fn lk_redact to bool
for xi ulong get lkcpn 0
if or or lk_path xi lk_root xi or lk_uuid xi lk_host xi
ret true
end
if or or lk_ip4 xi lk_ip6 xi or lk_port xi lk_pid xi
ret true
end
end
ret false
end

note Decode raw [p, e) into lkcp (input already UTF-8 validated).
fn lk_decode p ulong e ulong to void
xn = ulong 0
while lt p e bound 999999
if ge xn len lkcp
lk_fail lkemfld 0
end
put lkcp xn lk_dcp p
p = add p get lkdl 0
xn = add xn 1
end
put lkcpn 0 xn
end

note 0 public, 1 credential, 2 email, 3 control, 4 needs redaction.
fn lk_fchk p ulong e ulong to uchar
lk_decode p e
if lk_secret
ret 1
end
if lk_email
ret 2
end
if lk_ctrl
ret 3
end
if lk_redact
ret 4
end
ret 0
end

fn lk_lineok p ulong e ulong line ulong to bool
xcnt = ulong 0
xred = false
xs = p
while true bound 999999
xf = lk_find 0 xs e 9
if eq xcnt 8
lk_fail lkem9 line
end
xr = lk_fchk xs xf
if eq xr 1
lk_fail lkemsc line
end
if eq xr 2
lk_fail lkemem line
end
if eq xr 3
lk_fail lkemct line
end
if eq xr 4
xred = true
end
xcnt = add xcnt 1
if ge xf e
break
end
xs = add xf 1
end
if lt xcnt 5
lk_fail lkem4 line
end
ret not xred
end

note check_public over a loaded region; lkhas must be set and UTF-8 already proven.
fn lk_guard slot ulong to void
xp = lk_roff slot
xn = lk_rlen slot
xe = add xp xn
if eq xn 0
lk_fail lkemnl 0
end
if ne get lkraw sub xe 1 10
lk_fail lkemnl 0
end
for xi ulong xn
if eq get lkraw add xp xi 13
lk_fail lkemnl 0
end
end
xl = lk_find 0 xp xe 10
if not lk_rawis xp xl lkhead
lk_fail lkemhd 0
end
xpub = true
xline = ulong 2
xs = add xl 1
while lt xs xe bound 999999
xl = lk_find 0 xs xe 10
if not lk_lineok xs xl xline
xpub = false
end
xline = add xline 1
xs = add xl 1
end
if not xpub
lk_fail lkempj 0
end
end

fn lk_rawis p ulong e ulong s view uchar * to bool
if ne sub e p len s
ret false
end
for xj ulong len s
if ne get lkraw add p xj get s xj
ret false
end
end
ret true
end

fn sp_ledger_check to void
put lkrn 0 0
lk_read lkp0 0
if eq get lkhas 0 0
ret
end
if not lk_utf8 0
lk_fail lkemrd 0
end
lk_guard 0
end

fn sp_ledger_check_at path view uchar * to void
put lkrn 0 0
lk_read path 0
if eq get lkhas 0 0
ret
end
if not lk_utf8 0
lk_fail lkemrd 0
end
lk_guard 0
end

