fn lk_jc c uchar to void
if eq c 34
sr_raw ljbq
ret
end
if eq c 92
sr_raw ljbs
ret
end
if ge c 32
sr_byte c
ret
end
if eq c 8
sr_raw ljb
ret
end
if eq c 12
sr_raw ljf
ret
end
if eq c 10
sr_raw ljn
ret
end
if eq c 13
sr_raw ljr
ret
end
if eq c 9
sr_raw ljt
ret
end
sr_raw lju
sr_byte get ljhex ulong shr c 4
sr_byte get ljhex ulong and c 15
end

fn lk_js o ulong l ulong to void
sr_raw ljq
for xj ulong l
lk_jc get lkcl add o xj
end
sr_raw ljq
end

fn lk_jt s view uchar * to void
sr_raw ljq
for xj ulong len s
lk_jc get s xj
end
sr_raw ljq
end

fn lk_jn n ulong to void
sr_raw ljq
for xj ulong sj_size n
lk_jc sj_byte n xj
end
sr_raw ljq
end

note Newline, indent d levels, "key": .
