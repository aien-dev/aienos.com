text lji0 "id"
text lji1 "line"
text lji2 "opened_utc"
text lji3 "owner"
text lji4 "owner_kind"
text lji5 "status"
text lji6 "item"
text lji7 "done_when"
text lji8 "notes"
text lji9 "updated_utc"
text lji10 "stream"
text lji11 "age_s"
text ljm0 "state"
text ljm1 "served_as"
text ljc0 "checked_utc"
text ljc1 "limits"
text ljc2 "used_pct"
text ljc3 "resets_utc"

fn lk_jitem i ulong first bool to void
lk_jnl 2 first
sr_raw ljob
lk_jk 3 lji0 true
lk_js lk_fo i 0 lk_fl i 0
lk_jk 3 lji1 false
lk_un get lkline i
lk_jk 3 lji2 false
lk_js lk_fo i 1 lk_fl i 1
lk_jk 3 lji3 false
lk_js lk_fo i 2 lk_fl i 2
lk_jk 3 lji4 false
sr_raw ljq
lk_kind get lkown i
sr_raw ljq
lk_jk 3 lji5 false
lk_js lk_fo i 3 lk_fl i 3
lk_jk 3 lji6 false
lk_js lk_fo i 4 lk_fl i 4
lk_jk 3 lji7 false
lk_js lk_fo i 5 lk_fl i 5
lk_jk 3 lji8 false
lk_jnotes i
lk_jk 3 lji9 false
lk_js lk_fo i 7 lk_fl i 7
lk_jk 3 lji10 false
sr_raw ljq
lk_sname get lkstrm i
sr_raw ljq
lk_jk 3 lji11 false
lk_ln get lkage i
lk_jclose 2 ljoe
end

fn lk_jnotes i ulong to void
xc = get lknc i
if eq xc 0
sr_raw ljempty
ret
end
sr_raw ljab
xf = get lknf i
for xj ulong xc
lk_jnl 4 eq xj 0
lk_js get lkno add xf xj get lknl add xf xj
end
lk_jclose 3 ljae
end

fn lk_jlink d ulong n ulong to void
if ne sj_kind n 1
sr_raw ljnull
ret
end
sr_raw ljob
lk_jk add d 1 lkmj11 true
lk_jn sj_find n lkmj11
lk_jk add d 1 lkmj12 false
lk_jn sj_find n lkmj12
lk_jclose d ljoe
end

fn lk_jopt n ulong to void
if ne sj_kind n 3
sr_raw ljnull
ret
end
lk_jn n
end

fn lk_jmodel m ulong first bool to void
xst = lk_mstate m
lk_jnl 2 first
sr_raw ljob
lk_jk 3 lkmj2 true
lk_jn sj_find m lkmj2
lk_jk 3 lkmj3 false
lk_jn sj_find m lkmj3
lk_jk 3 ljm0 false
if eq xst 0
lk_jt lkms0
else
if eq xst 1
lk_jt lkms1
else
lk_jn sj_find m lkmj5
end
end
lk_jk 3 ljm1 false
xj = lk_served m
if eq xj 9999
sr_raw ljnull
else
lk_js get lkmid mul xj 2 get lkmid add mul xj 2 1
end
lk_jmrest m
lk_jclose 2 ljoe
end

fn lk_jmrest m ulong to void
lk_jk 3 lkmj6 false
lk_jn sj_find m lkmj6
lk_jk 3 lkmj7 false
lk_jn sj_find m lkmj7
lk_jk 3 lkmj8 false
lk_jopt sj_find m lkmj8
lk_jk 3 lkmj9 false
lk_jlink 3 sj_find m lkmj9
lk_jk 3 lkmj10 false
xa = sj_find m lkmj10
if eq sj_len xa 0
sr_raw ljempty
ret
end
sr_raw ljab
xf = sj_first xa
xfirst = true
while ne xf 0 bound 65536
lk_jnl 4 xfirst
xfirst = false
sr_raw ljob
lk_jk 5 lkmj11 true
lk_jn sj_find xf lkmj11
lk_jk 5 lkmj13 false
lk_jn sj_find xf lkmj13
lk_jk 5 lkmj14 false
lk_jn sj_find xf lkmj14
lk_jclose 4 ljoe
xf = sj_next xf
end
lk_jclose 3 ljae
end

fn lk_jusage to void
if eq get lkuv 0 0
sr_raw ljnull
ret
end
sr_raw ljob
lk_jk 2 ljc0 true
lk_js get lkuc 0 get lkuc 1
lk_jk 2 lkmj0 false
if eq get lkup 1 0
lk_jt lkuclau
else
lk_js get lkup 0 get lkup 1
end
lk_jk 2 ljc1 false
sr_raw ljab
for xi ulong get lkun 0
lk_jnl 3 eq xi 0
sr_raw ljob
lk_jk 4 lkmj11 true
sr_raw ljq
lk_julabel xi
sr_raw ljq
lk_jk 4 ljc2 false
lk_un get lkupc xi
lk_jk 4 ljc3 false
lk_js get lkur mul xi 2 get lkur add mul xi 2 1
lk_jclose 3 ljoe
end
lk_jclose 2 ljae
lk_jclose 1 ljoe
end

note Labels are fixed ASCII plus usage_words output, so no JSON escapes are needed.
fn lk_julabel i ulong to void
xk = get lkuk i
if eq xk 0
sr_raw lku0
ret
end
if eq xk 1
sr_raw lku1
ret
end
sr_raw lku2
lk_r get lkus mul i 2 get lkus add mul i 2 1
sr_raw lku3
end

fn lk_jwr to void
xs = lk_written
if eq get lkok 0 0
lk_jt lhnev
ret
end
xc = get lkcn 0
xo = lk_fmt xs false
lk_js xo get lklast 0
put lkcn 0 xc
end

fn lk_jmc to void
if eq get lkmcv 0 0
lk_jt lhnev
ret
end
lk_js get lkmc 0 get lkmc 1
end

fn sp_now_json to void
lk_load_all
sr_raw ljob
lk_jk 1 ljk0 true
xc = get lkcn 0
xo = lk_fmt lk_now false
lk_js xo get lklast 0
put lkcn 0 xc
lk_jk 1 ljk1 false
lk_jwr
lk_jk 1 ljk2 false
if eq get lkn 0 0
sr_raw ljempty
else
sr_raw ljab
for xi ulong get lkn 0
lk_jitem xi eq xi 0
end
lk_jclose 1 ljae
end
lk_jk 1 ljk3 false
lk_jpulse
lk_jk 1 ljk4 false
lk_jmc
lk_jmods
lk_jk 1 ljk5 false
lk_jusage
lk_jclose 0 ljoe
end

fn lk_jpulse to void
if eq get lkpn 0 0
sr_raw ljempty
ret
end
sr_raw ljab
for xi ulong get lkpn 0
lk_jnl 2 eq xi 0
sr_raw ljob
lk_jk 3 lkmj2 true
lk_js get lkpk mul xi 2 get lkpk add mul xi 2 1
lk_jk 3 lkmj13 false
lk_js get lkpv mul xi 2 get lkpv add mul xi 2 1
lk_jclose 2 ljoe
end
lk_jclose 1 ljae
end

fn lk_jmods to void
xr = lk_roster
lk_jk 1 lkmj0 false
lk_jlink 1 sj_find xr lkmj0
lk_jk 1 lkmj1 false
xa = sj_find xr lkmj1
if eq sj_len xa 0
sr_raw ljempty
ret
end
sr_raw ljab
xm = sj_first xa
xfirst = true
while ne xm 0 bound 65536
lk_jmodel xm xfirst
xfirst = false
xm = sj_next xm
end
lk_jclose 1 ljae
end

note ---------------------------------------------------------------- /now/feed.xml

text lfx0 "&amp;"
text lfx1 "&lt;"
text lfx2 "&gt;"
text lfx3 "&quot;"
text lfhead0 "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<feed xmlns=\"http://www.w3.org/2005/Atom\">\n  <title>AienOS: settled work from the live ledger</title>\n  <subtitle>Every coordination ledger line that reached done or dropped, with the evidence that settled it.</subtitle>\n  <link href=\"https://www.aienos.com/now/feed.xml\" rel=\"self\" type=\"application/atom+xml\"/>\n  <link href=\"https://www.aienos.com/\" rel=\"alternate\" type=\"text/html\"/>\n  <id>https://www.aienos.com/now/feed.xml</id>\n  <updated>"
text lfhead1 "</updated>\n  <author><name>M. Drake Stapleton</name><uri>https://www.drakestapleton.com</uri></author>\n  <rights>Apache-2.0 WITH LLVM-exception</rights>\n  <icon>https://www.aienos.com/logo.png</icon>\n  <logo>https://www.aienos.com/og.png</logo>\n"
text lfe0 "  <entry>\n    <title>"
text lfe1 ": "
text lfe2 " ("
text lfe3 ")</title>\n    <link href=\"https://www.aienos.com/now/#"
text lfe4 "\" rel=\"alternate\" type=\"text/html\"/>\n    <id>https://www.aienos.com/now/#"
text lfe5 "</id>\n    <published>"
text lfe6 "</published>\n    <updated>"
text lfe7 "</updated>\n    <content type=\"text\">"
text lfe8 "</content>\n    <category term=\""
text lfe9 "\"/>\n  </entry>\n"
text lfend "</feed>\n"
text lfb0 "Status: "
text lfb1 ". Owner: "
text lfb2 ". Stream: "
text lfb3 "."
text lfb4 "\nDone when: "
text lfb5 "\nEvidence:"
text lfb6 "\n- "

fn lk_xc c uchar to void
if eq c 38
sr_raw lfx0
ret
end
if eq c 60
sr_raw lfx1
ret
end
if eq c 62
sr_raw lfx2
ret
end
if eq c 34
sr_raw lfx3
ret
end
sr_byte c
end

fn lk_x o ulong l ulong to void
for xj ulong l
lk_xc get lkcl add o xj
end
end

fn lk_xf i ulong k ulong to void
lk_x lk_fo i k lk_fl i k
end

note Feed order: updated descending (unparsable last), then id descending, bytewise.
fn lk_fbefore a ulong b ulong to bool
xa = get lkupv a
xb = get lkupv b
if ne xa xb
ret gt xa xb
end
if and ne xa 0 ne get lkupd a get lkupd b
ret gt get lkupd a get lkupd b
end
ret lk_idgt a b
end

fn lk_idgt a ulong b ulong to bool
xo = lk_fo a 0
xl = lk_fl a 0
xp = lk_fo b 0
xm = lk_fl b 0
for xj ulong xl
if ge xj xm
ret true
end
xc = get lkcl add xo xj
xd = get lkcl add xp xj
if ne xc xd
ret gt xc xd
end
end
ret false
end

fn lk_fsort to ulong
xn = ulong 0
for xi ulong get lkn 0
if lk_in xi 8
xk = xn
while gt xk 0 bound 999999
if not lk_fbefore xi get lkperm sub xk 1
break
end
put lkperm xk get lkperm sub xk 1
xk = sub xk 1
end
put lkperm xk xi
xn = add xn 1
end
end
ret xn
end

fn lk_rfc s long to void
xc = get lkcn 0
xo = lk_fmt s true
lk_r xo get lklast 0
put lkcn 0 xc
end

fn lk_fwr to void
xs = lk_written
if eq get lkok 0 0
xs = lk_now
end
lk_rfc xs
end

fn lk_fentry i ulong to void
sr_raw lfe0
lk_xf i 0
sr_raw lfe1
lk_xf i 4
sr_raw lfe2
lk_xf i 3
sr_raw lfe3
lk_xf i 0
sr_raw lfe4
lk_xf i 0
sr_raw lfe5
if ne get lkopv i 0
lk_rfc get lkopd i
else
lk_fupd i
end
sr_raw lfe6
lk_fupd i
sr_raw lfe7
lk_fbody i
sr_raw lfe8
lk_xf i 3
sr_raw lfe9
end

fn lk_fupd i ulong to void
if ne get lkupv i 0
lk_rfc get lkupd i
ret
end
lk_fwr
end

fn lk_fbody i ulong to void
sr_raw lfb0
lk_xf i 3
sr_raw lfb1
lk_xf i 2
sr_raw lfb2
lk_sname get lkstrm i
sr_raw lfb3
if gt lk_fl i 5 0
sr_raw lfb4
lk_xf i 5
end
xc = get lknc i
if gt xc 0
sr_raw lfb5
xf = get lknf i
for xj ulong xc
sr_raw lfb6
lk_x get lkno add xf xj get lknl add xf xj
end
end
end

fn sp_now_feed to void
lk_load_all
xn = lk_fsort
sr_raw lfhead0
lk_fwr
sr_raw lfhead1
for xj ulong xn
lk_fentry get lkperm xj
end
sr_raw lfend
end
