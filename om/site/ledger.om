text lkkdd "--"
text lkksk "sk-"
text lkkghp "ghp_"
text lkkgho "gho_"
text lkkgpat "github_pat_"
text lkkxox "xox"
text lkkakia "akia"
text lkkbeg "-----begin"
text lkkbear "bearer"
text lkkcss "://"
text lkklh "localhost"
text lkkloc "local"
