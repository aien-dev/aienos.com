fn lk_e o ulong l ulong to void
for xj ulong l
sr_escape get lkcl add o xj
end
end

fn lk_r o ulong l ulong to void
for xj ulong l
sr_byte get lkcl add o xj
end
end

fn lk_un v ulong to void
sr_num v
end

fn lk_ln v long to void
if lt v 0
sr_byte 45
sr_num ulong neg v
ret
end
sr_num ulong v
end

fn lk_ef i ulong k ulong to void
lk_e lk_fo i k lk_fl i k
end

note keeper_name(): Renda to Keeper in prose, identifiers untouched; output HTML-escaped.
fn lk_k o ulong l ulong to void
xi = ulong 0
while lt xi l bound 999999
xw = lk_khit o l xi
if eq xw 0
sr_escape get lkcl add o xi
xi = add xi 1
else
lk_kout xw
xi = add xi 5
end
end
end

text lkkw0 "KEEPER"
text lkkw1 "Keeper"
text lkkw2 "keeper"
text lkkrn "renda"
text lkkRN "RENDA"

fn lk_kout w uchar to void
if eq w 1
sr_raw lkkw0
ret
end
if eq w 2
sr_raw lkkw1
ret
end
sr_raw lkkw2
end

fn lk_up c uchar to bool
ret and ge c 65 le c 90
end

fn lk_lo c uchar to bool
ret and ge c 97 le c 122
end

fn lk_dg c uchar to bool
ret and ge c 48 le c 57
end

note 0 no rename at i; 1 KEEPER, 2 Keeper, 3 keeper.
fn lk_khit o ulong l ulong i ulong to uchar
if gt add i 5 l
ret 0
end
if not lk_lat o l i lkkrn
ret 0
end
xcap = eq get lkcl add o i 82
if gt i 0
if not lk_kbef get lkcl sub add o i 1 xcap
ret 0
end
end
if lt add i 5 l
if not lk_kaft o l add i 5 xcap
ret 0
end
end
if lk_eqat o i lkkRN
ret 1
end
if xcap
ret 2
end
ret 3
end

fn lk_eqat o ulong i ulong s view uchar * to bool
for xj ulong len s
if ne get lkcl add add o i xj get s xj
ret false
end
end
ret true
end

fn lk_kbef p uchar cap bool to bool
if or or lk_up p lk_dg p or or eq p 47 eq p 46 or or eq p 95 eq p 126 eq p 45
ret false
end
ret or not lk_lo p cap
end

fn lk_kaft o ulong l ulong j ulong cap bool to bool
xn = get lkcl add o j
if or eq xn 47 eq xn 95
ret false
end
if eq xn 46
if lt add j 1 l
xt = get lkcl add add o j 1
ret not or or lk_up xt lk_lo xt lk_dg xt
end
ret true
end
if lk_lo xn
ret false
end
if lk_up xn
ret cap
end
ret true
end

