note short_utc over an lkcl string; escaped output.
fn lk_endz o ulong e ulong to bool
if le e o
ret false
end
ret eq get lkcl sub e 1 90
end

fn lk_short o ulong l ulong to void
xe = add o l
if lk_endz o xe
while gt xe o bound 999999
if ne get lkcl sub xe 1 90
break
end
xe = sub xe 1
end
end
xt = lk_find 1 o xe 84
if ge xt xe
lk_e o l
ret
end
xa = lk_find 1 o xt 45
if ge xa xt
lk_e o l
ret
end
xb = lk_find 1 add xa 1 xt 45
xm = lk_pint 1 add xa 1 xb
if or eq get lkok 0 0 or lt xm 1 gt xm 12
lk_e o l
ret
end
if ge xb xt
lk_e o l
ret
end
xc = lk_find 1 add xb 1 xt 45
lk_mon xm
sr_raw lhsp
xd = add xb 1
while lt xd xc bound 999999
if ne get lkcl xd 48
break
end
xd = add xd 1
end
lk_e xd sub xc xd
sr_raw lhsp
lk_e add xt 1 sub sub xe xt 1
end

fn lk_shbuilt to void
xc = get lkcn 0
xo = lk_fmt lk_now false
lk_short xo get lklast 0
put lkcn 0 xc
end

