note day_of: the first ten bytes of updated (else opened) when it parses, else "date unknown".
fn lk_dayo i ulong to ulong
xk = ulong 7
if eq lk_fl i 7 0
xk = 1
end
xo = lk_fo i xk
xv = lk_utc 1 xo add xo lk_fl i xk
if eq get lkok 0 0
ret 0
end
ret add mul xk 8 1
end

fn lk_dayout i ulong to void
xd = lk_dayo i
if eq xd 0
sr_raw lhdu
ret
end
xk = div sub xd 1 8
lk_e lk_fo i xk 10
end

fn lk_dayeq a ulong b ulong to bool
xa = lk_dayo a
xb = lk_dayo b
if or eq xa 0 eq xb 0
ret eq xa xb
end
xp = lk_fo a div sub xa 1 8
xq = lk_fo b div sub xb 1 8
for xj ulong 10
if ne get lkcl add xp xj get lkcl add xq xj
ret false
end
end
ret true
end

fn lk_old j ulong to bool
xi = get lkperm j
ret and lk_in xi 8 not lk_cur xi
end

fn lk_settled to void
if eq lk_count 8 0
ret
end
sr_raw lhst0
if eq lk_count 9 0
sr_raw lhst1
else
sr_raw lhst2
for xj ulong get lkn 0
if lk_in get lkperm xj 9
lk_tl get lkperm xj
end
end
sr_raw lhqs3
end
sr_raw lhqs4
lk_days1
sr_raw lh95
end

note One fold per run of equal days in the age-sorted old settled lines.
fn lk_days1 to void
xn = get lkn 0
xj = ulong 0
while lt xj xn bound 999999
if lk_old xj
xe = lk_dayend xj
lk_dayfold xj xe
xj = xe
else
xj = add xj 1
end
end
end

fn lk_dayend j ulong to ulong
xa = get lkperm j
xk = add j 1
while lt xk get lkn 0 bound 999999
if lk_old xk
if not lk_dayeq xa get lkperm xk
ret xk
end
end
xk = add xk 1
end
ret xk
end

fn lk_dayfold j ulong e ulong to void
xa = get lkperm j
xc = ulong 0
for xk ulong sub e j
if lk_old add j xk
xc = add xc 1
end
end
sr_raw lh40
sr_raw lhst3
lk_dayout xa
sr_raw lh41
sr_raw lhst4
lk_dayout xa
sr_raw lh42
lk_lines xc
sr_raw lhst5
for xm ulong sub e j
if lk_old add j xm
lk_tl get lkperm add j xm
end
end
sr_raw lh47
end

text lhhow "<section class=\"now-section now-how\" id=\"how\" aria-labelledby=\"now-how-h\"><div class=\"container\"><p class=\"kicker\">How this page is made</p><h2 id=\"now-how-h\" class=\"now-h2\">One file, no hands</h2><p class=\"now-sub\">The coordinator and every agent append to one tab separated file on the Spark. A publisher pushes that file to the <a class=\"prose-link\" href=\"https://github.com/aien-dev/aienos.com/tree/data/now\">data/now branch</a> whenever it changes. The site builder reads it at build time and writes this page and <a class=\"prose-link\" href=\"/now.json\">/now.json</a>. A line that is not in the file is not here. Every card, queue row and settled entry links to its own line of that file, and the commits, pull requests and evidence folders named in a note link to GitHub. Owners shown as &quot;agent&quot; are autonomous coding agents; the operator is one person. Keeper, the merge desk that lands finished changes, was called Renda until 24 October 2026: this page shows the new name, and the ledger on GitHub keeps each line as it was written. Keeper is the dachshund at the top of this page; a small one marks every line Keeper owns.</p></div></section>"

fn sp_now to void
lk_load_all
lk_sort
lk_hero
lk_usage1
lk_opsec
lk_streams
lk_models
lk_quiet
lk_next
lk_settled
sr_raw lhhow
end

