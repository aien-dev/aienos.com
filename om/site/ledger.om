note A fold over set (stream s, or 255 for all); id/title written by the caller's mode.
fn lk_fold set uchar s uchar to void
xn = ulong 0
xmin = long -1
for xi ulong get lkn 0
if lk_fin xi set s
xn = add xn 1
xa = get lkage xi
if ge xa 0
if or lt xmin 0 lt xa xmin
xmin = xa
end
end
end
end
sr_raw lh40
if eq s 255
sr_raw lhqo
else
sr_raw lhqt
lk_sslug s
end
sr_raw lh41
if eq s 255
sr_raw lhqn
else
lk_sname s
end
sr_raw lh42
lk_lines xn
sr_raw lkspc
if ge xmin 0
sr_raw lh45
lk_age xmin
sr_raw lkspc
end
sr_raw lh46
for xj ulong get lkn 0
if lk_fin xj set s
lk_row1 xj
end
end
sr_raw lh47
end

fn lk_fin i ulong set uchar s uchar to bool
if not lk_in i set
ret false
end
ret or eq s 255 eq get lkstrm i s
end

