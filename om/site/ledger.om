text lhst0 "<section class=\"now-section\" id=\"settled\" aria-labelledby=\"now-settled-h\"><div class=\"container\"><p class=\"kicker\">Settled</p><h2 id=\"now-settled-h\" class=\"now-h2\">Decisions made, with their evidence</h2><p class=\"now-sub\">A line closes on evidence (a commit, a receipt, a file) or is dropped for a stated reason. The last day is shown open, newest first; earlier days are folded by date (UTC).</p>"
