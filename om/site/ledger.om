text lh110 "<section class=\"now-section\" id=\"claude\" aria-labelledby=\"now-claude-h\"><div class=\"container\"><p class=\"kicker\">Paying for the work</p><h2 id=\"now-claude-h\" class=\"now-h2\">How much Claude is left</h2><p class=\"now-sub\">Many of the agents on this page are Claude models made by Anthropic (Opus, Fable, Sonnet and Haiku), running on Drake's own three Claude subscriptions. The plans allow a set amount of use in each five-hour session and in each week. The Spark reads the plan's own usage meter every five minutes and publishes the percentages, never the login.</p><p class=\"now-sub\">The same work also runs on subscriptions Drake pays for himself: OpenAI Codex, Google Gemini and xAI Grok. Those plans publish no usage meter here, so this page shows no percentage for them. The Claude meter is the only one the Spark can read.</p><div class=\"now-usage-wrap\"><article class=\"now-usage\">"
text lh111 "<header class=\"now-card-top\"><span class=\"now-usage-plan\">Claude "
text lh112 " plan</span><span class=\"now-age mono\">read "
text lh113 "</span></header>"
text lh114 "<p class=\"now-done\">This is the last reading the Spark published; it has not read a newer one since.</p>"
text lh115 "<div class=\"now-usage-menu\">"
text lh116 "<input type=\"radio\" name=\"now-usage\" id=\"now-usage-"
text lh117 "\" class=\"now-usage-radio\""
text lh118 " checked"
text lh119 ">"
text lh120 "<div class=\"now-usage-tabs\" role=\"tablist\" aria-label=\"Usage limits: choose one to read\">"
text lh121 "<label class=\"now-usage-tab\" for=\"now-usage-"
text lh122 "\"><span class=\"now-usage-tab-k\">"
text lh123 "</span><span class=\"now-usage-tab-v\">"
text lh124 "% left</span></label>"
text lh125 "</div><div class=\"now-usage-panels\">"
text lh126 "<div class=\"now-usage-panel now-usage-panel-"
text lh127 "</div></div>"
text lh128 "<p class=\"now-done\">The Spark has not published a reading of the plan yet.</p>"
text lh129 "Usage reading on GitHub"
text lh130 "</article><aside class=\"now-give\" aria-labelledby=\"now-give-h\"><h3 id=\"now-give-h\" class=\"now-give-h\">Give compute, not money</h3><p>The work runs on plans and on one Spark. Both can come from you, and Drake takes no payment for either.</p><ul class=\"now-give-steps\"><li><strong>Your agent, your plan. </strong>Pick any repository on <a class=\"prose-link\" href=\"/agents/\">Agents</a> and give your agent its instructions: the rules mine follow and that repository's own AGENTS.md. It claims an open issue and opens a pull request that leads with its evidence, like mine do. Its own subscription pays for it (Claude, Codex, Gemini or Grok); nothing of yours is sent to the Spark.</li><li><strong>Your Spark. </strong>A second GB10 can qualify the same gates and publish its own receipt. The GPU gates are written to run on any Spark, and a PASS from your machine is evidence, not a claim.</li></ul><p class=\"now-give-note\">No keys are collected. Your agent runs on your account, your Spark on your network, and only merged evidence reaches this page.</p><a class=\"now-give-btn\" href=\"https://github.com/aien-dev/open-humanity\" target=\"_blank\" rel=\"noopener noreferrer\">Join in Open Humanity <span aria-hidden=\"true\">↗</span></a></aside></div></div></section>"

fn lk_uplan to void
if eq get lkup 1 0
sr_raw lkuclau
ret
end
lk_e get lkup 0 get lkup 1
end

fn lk_ustale to bool
xc = lk_utc 1 get lkuc 0 add get lkuc 0 get lkuc 1
if eq get lkok 0 0
ret false
end
ret gt sub lk_now xc 7200
end

fn lk_usage1 to void
sr_raw lh110
if eq get lkuv 0 0
sr_raw lh128
else
sr_raw lh111
lk_uplan
sr_raw lh112
lk_e get lkuc 0 get lkuc 1
sr_raw lh113
if lk_ustale
sr_raw lh114
end
lk_umenu
end
lk_tfoot lkusgu lh129
sr_raw lh130
end

fn lk_umenu to void
xn = get lkun 0
if le xn 1
for xj ulong xn
lk_urow xj
end
ret
end
sr_raw lh115
for xi ulong xn
sr_raw lh116
lk_un xi
sr_raw lh117
if eq xi 0
sr_raw lh118
end
sr_raw lh119
end
sr_raw lh120
for xk ulong xn
sr_raw lh121
lk_un xk
sr_raw lh122
lk_ulabel xk
sr_raw lh123
lk_un sub 100 get lkupc xk
sr_raw lh124
end
sr_raw lh125
for xm ulong xn
sr_raw lh126
lk_un xm
sr_raw lhq
lk_urow xm
sr_raw lh54
end
sr_raw lh127
end

note ---------------------------------------------------------------- written stamp

note Latest parsable updated_utc in seconds; lkok 0 when none.
fn lk_written to long
xb = long 0
xh = false
for xi ulong get lkn 0
if ne get lkupv xi 0
if or not xh gt get lkupd xi xb
xb = get lkupd xi
xh = true
end
end
end
put lkok 0 0
if xh
put lkok 0 1
end
ret xb
end

fn lk_wfmt to void
xs = lk_written
if eq get lkok 0 0
sr_raw lhnev
ret
end
xc = get lkcn 0
xo = lk_fmt xs false
lk_r xo get lklast 0
put lkcn 0 xc
end

fn lk_bfmt full bool to void
xc = get lkcn 0
xo = lk_fmt lk_now full
lk_r xo get lklast 0
put lkcn 0 xc
end

note RFC 3339 ledger-written stamp (build time when none); cached for the build.
fn sp_ledger_stamp to void
if eq get lkwrv 0 0
lk_load_all
xs = lk_written
if eq get lkok 0 0
xs = lk_now
end
put lkwr 0 xs
put lkwrv 0 1
end
xc = get lkcn 0
xo = lk_fmt get lkwr 0 true
lk_r xo get lklast 0
put lkcn 0 xc
end

note ---------------------------------------------------------------- /now/

text lhn0 "<section class=\"now-hero\" aria-labelledby=\"now-title\"><div class=\"container\"><div class=\"now-hero-top\"><div class=\"now-hero-text\"><p class=\"kicker\">Now</p><h1 id=\"now-title\" class=\"now-title\">What is being done, right now.</h1><p class=\"now-lead\">This is the working ledger of AIEN, published as it is written. Every line is a promise with an owner and an observable finish. Agents write their progress here; the operator writes decisions here. Nothing on this page is composed by hand. Lines written in the last day are shown open; older lines are folded below, each one click away.</p><p class=\"now-lead\"><a href=\"/hive/\"><strong>Hive</strong></a> / Watch the agents work, see their exact models, and follow Drake's instructions and corrections live. <a href=\"/learn/\">Learn to structure your own work with AI.</a></p></div><figure class=\"now-keeper\"><img src=\"/assets/keeper.svg\" width=\"600\" height=\"200\" alt=\"Keeper, the merge desk that lands finished changes: a big cartoon dachshund, long and low, wearing a gold key on its red collar.\"><figcaption>Keeper, the merge desk</figcaption></figure></div>"
text lhn1 "<p class=\"now-empty\">No ledger has been published yet. The page will fill itself the moment one arrives.</p>"
text lhn2 "<div class=\"now-stats\">"
text lhs0 "agents writing in the last two hours"
text lhs1 "lines in motion, written in the last day"
text lhs2 "open lines quiet for over a day, quiet and queued"
text lhs3 "settled in the last day"
text lhs4 "waiting on the operator"
text lhc0 " now-stat-hot"
text lhc1 " "
text lhc2 " now-stat-done"
text lhc3 " now-stat-op"
text lhn3 "</div><nav class=\"now-jump\" aria-label=\"On this page\"><a href=\"#claude\">Paying for the work</a>"
text lhj0 "<a href=\"#operator\">Operator <span>"
text lhj1 "<a href=\"#streams\">In motion <span>"
text lhj2 "<a href=\"#models\">Models <span>"
text lhj3 "<a href=\"#quiet\">Quiet <span>"
