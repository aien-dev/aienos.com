fn lk_roster to ulong
xr = sj_load lkroster
if ne sj_kind xr 1
lk_fail lkemrj 0
end
if ne sj_kind sj_find xr lkmj1 2
lk_fail lkemrj 0
end
if ne sj_kind sj_find xr lkmj0 1
lk_fail lkemrj 0
end
ret xr
end

note Served id index for model m (first id whose ASCII lowercase contains served_match), or 9999.
fn lk_served m ulong to ulong
xp = sj_find m lkmj4
if ne sj_kind xp 3
ret 9999
end
for xj ulong get lkmidn 0
if lk_hasn get lkmid mul xj 2 get lkmid add mul xj 2 1 xp
ret xj
end
end
ret 9999
end

fn lk_hasn o ulong l ulong p ulong to bool
xn = sj_size p
if gt xn l
ret false
end
for xs ulong add sub l xn 1
if lk_hasat add o xs p xn
ret true
end
end
ret false
end

fn lk_hasat o ulong p ulong n ulong to bool
for xj ulong n
if ne lk_lb get lkcl add o xj sj_byte p xj
ret false
end
end
ret true
end

note 0 answering, 1 unknown, 2 absent string as written.
fn lk_mstate m ulong to uchar
if ne lk_served m 9999
ret 0
end
if and eq sj_kind sj_find m lkmj4 3 eq get lkmcv 0 0
if sj_eq sj_find m lkmj5 lkms2
ret 1
end
end
ret 2
end

fn lk_mstx m ulong st uchar to void
if eq st 0
sr_raw lkms0
ret
end
if eq st 1
sr_raw lkms1
ret
end
sj_emit sj_find m lkmj5
end

text lhw0 "Answering"
text lhw1 "Not answering"
text lhw2 "Planned"
text lhw3 "Not trained yet"
text lhw4 "Status unknown"

fn lk_mwords m ulong st uchar to void
if eq st 0
sr_raw lhw0
ret
end
if eq st 2
xa = sj_find m lkmj5
if sj_eq xa lkms2
sr_raw lhw1
ret
end
if sj_eq xa lkms3
sr_raw lhw2
ret
end
if sj_eq xa lkms4
sr_raw lhw3
ret
end
end
sr_raw lhw4
end

fn lk_itemid n ulong to ulong
if ne sj_kind n 3
ret 9999
end
for xi ulong get lkn 0
if lk_eqsj lk_fo xi 0 lk_fl xi 0 n
ret xi
end
end
ret 9999
end

fn lk_eqsj o ulong l ulong n ulong to bool
if ne sj_size n l
ret false
end
for xj ulong l
if ne get lkcl add o xj sj_byte n xj
ret false
end
end
ret true
end

text lkgh0 "https://github.com/"

fn lk_url n ulong to void
if not sj_prefix n lkgh0
lk_fail lkemrj 0
end
sj_href n
end


fn lk_mfoot root ulong m ulong to void
xi = lk_itemid sj_find m lkmj8
if ne xi 9999
sr_raw lkfa0
sr_raw lkledu
sr_raw lkhl
lk_un get lkline xi
sr_raw lkfa2
sr_raw lkfl2
lk_ef xi 0
sr_raw lkfl1
sr_raw lkfa3
ret
end
xs = sj_find m lkmj9
if ne sj_kind xs 1
xs = sj_find root lkmj0
end
sr_raw lkfa1
lk_url sj_find xs lkmj12
sr_raw lkfa2
sj_emit sj_find xs lkmj11
sr_raw lkfa3
end

text lh70 "<article class=\"now-card now-model now-model-"
