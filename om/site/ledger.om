if not first
sr_raw ljcm
end
sr_raw ljnl
for xj ulong d
sr_raw ljind
end
lk_jt k
sr_raw ljkc
end

fn lk_jnl d ulong first bool to void
if not first
sr_raw ljcm
end
sr_raw ljnl
for xj ulong d
sr_raw ljind
end
end

fn lk_jclose d ulong c view uchar * to void
sr_raw ljnl
for xj ulong d
sr_raw ljind
end
sr_raw c
end

