note Required data fields fail closed rather than turning malformed input into empty claims.
fn sp_field obj ulong key view uchar * to ulong
node = sj_find obj key
if eq node 0
sr_raw pp0339
exit 65
end
ret node
end

fn sp_value obj ulong key view uchar * to void
sj_emit sp_field obj key
end

fn sp_url node ulong to void
if not sj_prefix node pp0340
exit 65
end
sj_href node
end

fn sp_json_link node ulong to void
sr_raw pp0341
sp_url sp_field node pp0342
sr_raw pp0343
sp_value node pp0344
sr_raw pp0345
end

fn sp_owned_receipts to void
root = sj_load pp0346
if ne sj_kind root 2
exit 65
end
node = sj_first root
while ne node 0
sr_raw pp0347
sp_url sp_field node pp0348
sr_raw pp0349
sp_value node pp0350
sr_raw pp0351
sp_value node pp0352
sr_raw pp0100
if eq sj_kind sp_field node pp0353 5
sr_raw pp0354
end
sr_raw pp0355
sp_url sp_field node pp0348
sr_raw pp0356
node = sj_next node
end
end

fn sp_repo_url node ulong to void
urlnode = sp_field node pp0342
if not sj_prefix urlnode pp0357
exit 65
end
sj_href urlnode
end

note Percent encoding preserves real branch names including slashes and instruction filenames.
fn sp_url_part node ulong to void
note URL digits are the immutable text pp0358
one = new uchar 1 0
idx = ulong 0
while lt idx sj_size node
c = sj_byte node idx
safe = or and ge c 65 le c 90 and ge c 97 le c 122
safe = or safe and ge c 48 le c 57
safe = or safe or eq c 45 or eq c 46 or eq c 95 eq c 126
if safe
put one 0 c
sr_raw one
else
sr_raw pp0359
put one 0 get pp0358 ulong shr c 4
sr_raw one
put one 0 get pp0358 ulong and c 15
sr_raw one
end
idx = add idx 1
end
end

fn sp_agent_card node ulong to void
sr_raw pp0360
sp_value node pp0361
sr_raw pp0362
sp_repo_url node
sr_raw pp0349
name = sp_field node pp0361
if sj_eq name pp0363
sr_raw pp0364
else
if sj_eq name pp0365
sr_raw pp0366
else
if sj_eq name pp0367
sr_raw pp0368
else
sj_emit name
end
end
end
sr_raw pp0369
if eq sj_kind sj_find node pp0370 5
sr_raw pp0371
end
if eq sj_kind sp_field node pp0372 5
sr_raw pp0373
end
sr_raw pp0118
sp_value node pp0374
sr_raw pp0375
sp_value node pp0376
sr_raw pp0377
sp_value node pp0378
sr_raw pp0379
brief = sj_find node pp0380
if eq sj_kind brief 3
if not or sj_eq brief pp0381 sj_eq brief pp0382
exit 65
end
sr_raw pp0355
sp_repo_url node
sr_raw pp0383
sp_url_part sp_field node pp0376
sr_raw pp0384
sp_url_part brief
sr_raw pp0349
sj_emit brief
sr_raw pp0385
else
sr_raw pp0386
sp_repo_url node
sr_raw pp0387
end
sr_raw pp0031
end

fn sp_rules to void
sr_raw pp0388
sp_escaped_file pp0389
sr_raw pp0390
end

fn sp_escaped_file path view uchar * to void
buf = new uchar 4096 0
fd = open path 0 len path 0 0
if lt fd 0
exit 66
end
while true
n = read int fd buf 0 len buf
if lt n 0
exit 66
end
if eq n 0
break
end
sp_escape_slice buf ulong n
end
closed = close int fd
if ne closed 0
exit 66
end
end

fn sp_escape_slice buf view uchar * count ulong to void
one = new uchar 1 0
i = ulong 0
while lt i count
put one 0 get buf i
sr_esc one
i = add i 1
end
end

fn sp_agents to void
sr_raw pp0391
sp_rules
root = sj_load pp0392
repos = sp_field root pp0393
if ne sj_kind repos 2
exit 65
end
sr_raw pp0394
sr_num sj_len repos
sr_raw pp0395
count = ulong 0
node = sj_first repos
while ne node 0
if eq sj_kind sj_find node pp0380 3
count = add count 1
end
node = sj_next node
end
sr_num count
sr_raw pp0396
sp_value root pp0397
sr_raw pp0398
node = sj_first repos
while ne node 0
sp_agent_card node
node = sj_next node
end
sr_raw pp0399
end

fn sp_page route view uchar * to bool
if sr_equal route pp0400
sp_learn
ret true
end
if sr_equal route pp0401
sp_start
ret true
end
if sr_equal route pp0402
sp_contact
ret true
end
if sr_equal route pp0403
sp_now
ret true
end
if sr_equal route pp0404
sp_dash
ret true
end
if sr_equal route pp0405
sp_agents
ret true
end
if sr_equal route pp0406
sp_owned
ret true
end
if sr_equal route pp0407
sp_blog
ret true
end
if sr_equal route pp0408
sp_blog_post
ret true
end
if sr_equal route pp0409
sp_glossary
ret true
end
if sr_equal route pp0410
sp_privacy
ret true
end
ret false
end
