note Required data fields fail closed rather than turning malformed input into empty claims.
fn sp_field obj ulong key view uchar * to ulong
node = sj_find obj key
if eq node 0
sr_fail pp0339
end
ret node
end

fn sp_value obj ulong key view uchar * to void
sj_emit sp_field obj key
end

fn sp_url node ulong to void
if not sj_prefix node pp0340
exit 65
end
sj_href node
end

fn sp_json_link node ulong to void
sr_raw pp0341
sp_url sp_field node pp0342
sr_raw pp0343
sp_value node pp0344
sr_raw pp0345
end

fn sp_owned_receipts to void
root = sj_load pp0346
if ne sj_kind root 2
exit 65
end
node = sj_first root
while ne node 0
sr_raw pp0347
sp_url sp_field node pp0348
sr_raw pp0349
sp_value node pp0350
sr_raw pp0351
sp_value node pp0352
sr_raw pp0100
if eq sj_kind sp_field node pp0353 5
sr_raw pp0354
end
sr_raw pp0355
sp_url sp_field node pp0348
sr_raw pp0356
node = sj_next node
end
end

fn sp_repo_url node ulong to void
urlnode = sp_field node pp0342
if not sj_prefix urlnode pp0357
exit 65
end
sj_href urlnode
end

note Keep slash-separated GitHub refs intact; encode query, fragment and other non-unreserved bytes.
fn sp_url_part node ulong to void
note URL digits are the immutable text pp0358
idx = ulong 0
while lt idx sj_size node
c = sj_byte node idx
safe = or and ge c 65 le c 90 and ge c 97 le c 122
safe = or safe and ge c 48 le c 57
safe = or safe or eq c 45 or eq c 46 or eq c 95 eq c 126
safe = or safe eq c 47
if safe
sr_byte c
else
sr_raw pp0359
sr_byte get pp0358 ulong shr c 4
sr_byte get pp0358 ulong and c 15
end
idx = add idx 1
end
end

fn sp_agent_card node ulong to void
sr_raw pp0360
sp_value node pp0361
sr_raw pp0362
sp_repo_url node
sr_raw pp0349
name = sp_field node pp0361
if or sj_eq name pp0363 sj_eq name pposold
sr_raw pp0364
else
if sj_eq name pp0365
sr_raw pp0366
else
if sj_eq name pp0367
sr_raw pp0368
else
if sj_eq name ppold
sr_raw ppsys
else
sj_emit name
end
end
end
end
sr_raw pp0369
if eq sj_kind sj_find node pp0370 5
sr_raw pp0371
end
if eq sj_kind sp_field node pp0372 5
sr_raw pp0373
end
descr = sp_field node pp0374
if gt sj_size descr 0
sr_raw pp0118
sj_emit descr
sr_raw pp0100
end
sr_raw pp0375
sp_value node pp0376
sr_raw pp0377
sp_value node pp0378
sr_raw pp0379
brief = sj_find node pp0380
if eq sj_kind brief 3
if not or sj_eq brief pp0381 sj_eq brief pp0382
exit 65
end
sr_raw pp0355
sp_repo_url node
sr_raw pp0383
sp_url_part sp_field node pp0376
sr_raw pp0384
sp_url_part brief
sr_raw pp0349
sj_emit brief
sr_raw pp0385
else
sr_raw pp0386
sp_repo_url node
sr_raw pp0387
end
sr_raw pp0031
end

fn sp_rules to void
sr_raw pp0388
sp_rule_headings
sr_raw pp0390
end

note RULES headings are read from the same current file copied to /agents/RULES.md.
fn sp_rule_heading row view uchar * to void
if lt len row 4
ret
end
if not and eq get row 0 35 eq get row 1 35
ret
end
if ne get row 2 32
ret
end
if not and ge get row 3 48 le get row 3 57
ret
end
start = ulong 3
i = ulong 3
while lt add i 1 len row
if and eq get row i 46 eq get row add i 1 32
start = add i 2
break
end
i = add i 1
end
sr_raw ppli
sr_esc part row start sub len row start
sr_raw pp0031
end

fn sp_rule_headings to void
buf = new uchar 65536 0
fd = fopen pp0389 0 len pp0389 0 0
if lt fd 0
exit 66
end
count = ulong 0
while lt count len buf
n = read int fd buf count sub len buf count
if lt n 0
exit 66
end
if eq n 0
break
end
count = add count ulong n
end
if eq count len buf
n = read int fd buf 0 1
if ne n 0
exit 66
end
end
closed = fclose int fd
if ne closed 0
exit 66
end
start = ulong 0
i = ulong 0
while lt i count
if eq get buf i 10
sp_rule_heading part buf start sub i start
start = add i 1
end
i = add i 1
end
if lt start count
sp_rule_heading part buf start sub count start
end
end


fn sp_agents to void
sr_raw pp0391
sp_rules
root = sj_load pp0392
repos = sp_field root pp0393
if ne sj_kind repos 2
exit 65
end
sr_raw pp0394
sr_num sj_len repos
sr_raw pp0395
count = ulong 0
node = sj_first repos
while ne node 0
if eq sj_kind sj_find node pp0380 3
count = add count 1
end
node = sj_next node
end
sr_num count
sr_raw pp0396
sp_value root pp0397
sr_raw pp0398
node = sj_first repos
while ne node 0
sp_agent_card node
node = sj_next node
end
sr_raw pp0399
end

fn sp_page route view uchar * to bool
if sr_equal route pp0400
sp_learn
ret true
end
if sr_equal route pp0401
sp_start
ret true
end
if sr_equal route pp0402
sp_contact
ret true
end
if sr_equal route pp0403
sp_now
ret true
end
if sr_equal route pp0404
sp_dash
ret true
end
if sr_equal route pp0405
sp_agents
ret true
end
if sr_equal route pp0406
sp_owned
ret true
end
if sr_equal route pp0407
sp_blog
ret true
end
if sr_equal route pp0408
sp_blog_post
ret true
end
if sr_equal route pp0409
sp_glossary
ret true
end
if sr_equal route pp0410
sp_privacy
ret true
end
ret false
end
