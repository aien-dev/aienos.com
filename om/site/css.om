note Native door CSS budget <= 12288 raw bytes, including quiet controls; no external assets.
text ssdoor "/* Native Allen entry controls only; scene and panes belong to AllenPresence. */\nbody{margin:0;background:var(--bg-base);color:var(--text-primary);font-family:var(--font-sans)}[hidden]{display:none!important}.site-native{margin:0;padding:0}.site-utility{position:fixed;top:1rem;left:1rem;z-index:160;width:auto;max-width:calc(100% - 9rem);margin:0;font-size:.75rem;gap:.5rem 1rem}.site-utility a{background:var(--bg-base);padding:.25rem .4rem;border-radius:.3rem}.site> .site-index{position:fixed;right:1rem;top:1rem;z-index:170;max-width:min(35rem,calc(100% - 2rem));max-height:70vh;overflow:auto;margin:0}.site> .site-index:not([open]){padding:.35rem .6rem;background:var(--bg-base)}.site-index summary{min-height:1.8rem}.site-index-links{grid-template-columns:repeat(3,minmax(0,1fr))}.skip-link{position:fixed;left:1rem;top:1rem;z-index:200;transform:translateY(-200%);background:var(--accent-amber);color:var(--bg-base);padding:.6rem}.skip-link:focus{transform:none}.home-door{position:fixed;inset:4.5rem 0 0;z-index:130;pointer-events:none;color:var(--text-primary);font-family:var(--font-sans)}.home-door a,.home-door button{pointer-events:auto}.door-skip{position:absolute;right:1rem;top:0;padding:.5rem .8rem;background:var(--bg-base);border:1px solid var(--border-subtle);border-radius:2rem;color:var(--text-primary);font-size:.85rem;text-decoration:none}.door-invitation{position:absolute;bottom:6vh;left:50%;transform:translateX(-50%);width:min(36rem,calc(100% - 2rem));text-align:center;padding:1.25rem;border-radius:1.5rem;background:color-mix(in srgb,var(--bg-base) 90%,transparent)}.door-invitation h1{font-size:clamp(2rem,5vw,3.8rem);font-weight:450;line-height:1.1;margin:0 0 .8rem}.door-invitation p{line-height:1.5;font-size:.9rem;margin:.6rem 0;color:var(--text-secondary)}.door-invitation button,.site-choice-actions button,.site-choice-actions a{font:inherit;display:inline-flex;justify-content:center;align-items:center;border:1px solid var(--border-subtle);border-radius:2rem;padding:.7rem 1.2rem;background:var(--bg-card);color:var(--text-primary);text-decoration:none;cursor:pointer}.door-invitation button:disabled{opacity:.5;cursor:wait}.door-invitation .door-note{font-size:.75rem;color:var(--text-muted)}.home-door[data-playing=true] .door-invitation h1,.home-door[data-playing=true] .door-note{display:none}.home-door[data-playing=true] .door-invitation{bottom:2rem;padding:.65rem 1rem;width:auto;max-width:calc(100% - 2rem)}.site-mode-choice{position:fixed;z-index:135;bottom:8rem;left:50%;transform:translateX(-50%);width:min(43rem,calc(100% - 2rem));max-height:calc(100dvh - 13rem);overflow:auto;padding:1.5rem 1.7rem;background:color-mix(in srgb,var(--bg-surface) 96%,transparent);border:1px solid var(--border-subtle);border-radius:1.5rem;font-size:1rem;line-height:1.6}.site-mode-choice p{margin:0 0 1.2rem}.site-choice-actions{display:flex;flex-wrap:wrap;gap:.75rem}.site-choice-actions button{background:var(--accent-blue);color:var(--bg-base);border-color:var(--accent-blue)}.site-welcome-status{position:fixed;z-index:125;left:1rem;top:4rem;max-width:32ch;padding:.4rem .65rem;background:var(--bg-base);border-radius:.5rem;color:var(--text-secondary);font-size:.85rem;pointer-events:none}.home-door a:focus-visible,.home-door button:focus-visible,.site-mode-choice a:focus-visible,.site-mode-choice button:focus-visible{outline:3px solid var(--accent-amber);outline-offset:4px}@media(max-width:40rem){.site-utility{font-size:.7rem;max-width:calc(100% - 8rem);gap:.25rem .5rem}.site> .site-index{font-size:.75rem}.site-mode-choice{bottom:7.5rem;max-height:calc(100dvh - 12rem);padding:1.1rem;font-size:.9rem}.door-invitation{bottom:2rem}.site-welcome-status{font-size:.75rem;top:5rem}}@media(prefers-reduced-motion:reduce){.home-door *,.site-mode-choice *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}@media(forced-colors:active){.door-invitation,.site-mode-choice{background:Canvas;color:CanvasText;border:1px solid CanvasText}}\n"
fn door_css to void
sr_raw sstutils
sr_raw ssdoor
end
