note Generated stylesheet only: css_emit writes to the runtime's current output descriptor.
note Owner measurement budgets, not measured claims: site.css <= 24576 raw bytes; site.js <= 20480 raw bytes.
note Shared HTML chrome <= 24576 raw bytes excluding page data and supplied native/consent artifacts.
note Initial non-scene shell transfer budget <= 98304 raw bytes; native WASM/audio measured separately.
note Palette is shared with page assets. No external fonts, raster background, filter or shadow animation.
text sstyle0 "/* Generated from om/site/css.om. Shared galaxy palette and accessible document layout. */\n:root{color-scheme:dark;--bg-base:#0b1020;--bg-surface:#131c30;--bg-card:#19243b;--bg-card-hover:#22314e;--border-subtle:#3e506e;--text-primary:#f4f6ff;--text-secondary:#c1cee4;--text-muted:#a6b6d0;--accent-blue:#9ac8ff;--accent-green:#9de1bd;--accent-amber:#ffd49a;--accent-violet:#c4b1ff;--radius:1.25rem;--content-width:78rem;--font-sans:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;--font-mono:ui-monospace,SFMono-Regular,Consolas,monospace}\n*{box-sizing:border-box}html{scroll-padding-top:2rem}body{margin:0;background:var(--bg-base);color:var(--text-primary);font-family:var(--font-sans);font-size:1rem;line-height:1.7;overflow-wrap:anywhere}body.site{background-image:radial-gradient(ellipse at 12% 0%,#28305766,transparent 52rem),radial-gradient(ellipse at 95% 20%,#18354a55,transparent 46rem)}::selection{background:var(--accent-blue);color:var(--bg-base)}[hidden]{display:none!important}a{color:var(--accent-blue);text-decoration-thickness:.08em;text-underline-offset:.2em}a:hover{text-decoration-thickness:.14em}button,input,textarea,select{font:inherit}button,a,input,textarea,select,summary{-webkit-tap-highlight-color:transparent}button,summary,input[type=checkbox]{cursor:pointer}button:disabled,[aria-disabled=true]{cursor:not-allowed;opacity:.55}button{color:inherit}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--accent-amber);outline-offset:5px}img,video,canvas,svg{max-width:100%}img,video{height:auto}p,ul,ol,dl,pre,blockquote,table,figure{margin:0 0 1.4rem}h1,h2,h3,h4{line-height:1.15;letter-spacing:-.025em;text-wrap:balance}h1{font-size:clamp(2.5rem,6vw,5.25rem);font-weight:650;margin:.2em 0 .45em;max-width:20ch}h2{font-size:clamp(1.65rem,3vw,2.65rem);font-weight:620;margin:0 0 1.2rem}h3{font-size:1.25rem;margin:0 0 .8rem}h4{font-size:1.05rem}small{font-size:.85em}.container{width:min(var(--content-width),calc(100% - 4rem));margin-inline:auto}.site-main{padding-block:2rem 5rem;min-height:50vh}.site-main:focus,#site-content:focus{outline:none}.site-main>*+*{margin-top:3rem}.skip-link{position:fixed;top:.75rem;left:1rem;z-index:1000;background:var(--accent-amber);color:var(--bg-base);padding:.75rem 1rem;transform:translateY(-200%);border-radius:.5rem}.skip-link:focus{transform:none}\n"
text sstyle1 ".aien-header{position:relative;z-index:10;border-bottom:1px solid var(--border-subtle);background:var(--bg-base)}.site-header-inner{width:min(90rem,calc(100% - 4rem));margin:auto;display:grid;grid-template-columns:1fr auto;gap:1.2rem 2rem;padding:1.6rem 0 1rem}.site-brand{display:inline-flex;align-items:center;gap:.85rem;color:var(--text-primary);font-weight:650;line-height:1.2;text-decoration:none;justify-self:start}.site-brand small{display:block;font-weight:400;letter-spacing:.04em;color:var(--text-muted);padding-top:.4rem}.brand-mark{border:1px solid var(--accent-violet);border-radius:50%;width:2.8rem;height:2.8rem;display:grid;place-items:center;color:var(--accent-violet);font-family:var(--font-mono)}.aien-nav-reach{display:flex;align-items:center;justify-content:end;gap:1.4rem;font-size:.9rem}.x-link{display:inline-flex;align-items:center;gap:.65rem;color:var(--text-primary)}.x-link>span{font-weight:700;font-size:1.2rem}.aien-header nav{grid-column:1/-1}.master-nav{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.65rem;list-style:none;padding:0;margin:0}.master-nav a{display:flex;align-items:center;gap:.75rem;color:var(--text-secondary);text-decoration:none;border-radius:.8rem;padding:.7rem .8rem;border:1px solid transparent;min-height:3rem}.master-nav a:hover{background:var(--bg-surface);color:var(--text-primary)}.master-nav a[aria-current=page]{color:var(--text-primary);background:var(--bg-card);border-color:var(--border-subtle)}.nav-glyph{font-family:var(--font-mono);font-size:1.15rem;color:var(--accent-violet);width:1.4rem;text-align:center}.nav-toggle{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:.7rem;padding:.65rem 1rem}.breadcrumbs{padding-top:1.8rem;font-size:.85rem;color:var(--text-muted)}.breadcrumbs ol{display:flex;flex-wrap:wrap;gap:.4rem .85rem;list-style:none;padding:0;margin:0}.breadcrumbs li+li::before{content:'/';color:var(--text-muted);margin-right:.85rem}.breadcrumbs [aria-current]{max-width:55ch}.breadcrumbs a{color:var(--text-secondary)}\n"
text sstyle2 ".page-intro{padding-block:2rem 1.8rem;max-width:65rem}.eyebrow,.kicker{font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;font-weight:650;color:var(--accent-violet);margin-bottom:1.2rem}.lede,.lead,.subtitle{font-size:clamp(1.1rem,2vw,1.4rem);line-height:1.65;color:var(--text-secondary);max-width:58ch}.muted,.meta{color:var(--text-muted)}.prose{max-width:74ch}.prose p,.prose li{color:var(--text-secondary)}.prose h2{margin-top:2.8rem}.section{padding-block:1rem}.dashboard-grid,.card-grid,.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));gap:1.5rem;align-items:start}.panel,.hub-card,.research-status,.card,.evidence-card{background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:var(--radius);padding:clamp(1.3rem,3vw,2rem);min-width:0}.panel>:last-child,.hub-card>:last-child,.card>:last-child{margin-bottom:0}.hub-card h2,.panel h2,.research-status h2{font-size:1.5rem}.hub-card a,.panel a{position:relative}.hub-card:focus-within,.panel:focus-within{border-color:var(--accent-blue)}.full-width{grid-column:1/-1}.stack{display:flex;flex-direction:column;gap:1.5rem}.cluster,.actions,.cta-row{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem}.button,button.button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.8rem;padding:.65rem 1.1rem;background:var(--accent-blue);color:var(--bg-base);border:1px solid var(--accent-blue);border-radius:.65rem;text-decoration:none;font-weight:650;line-height:1.4}.button:hover{background:var(--text-primary);border-color:var(--text-primary);text-decoration:none}.button-secondary,button.button-secondary{background:var(--bg-card);color:var(--text-primary);border-color:var(--border-subtle)}.button-secondary:hover{background:var(--bg-card-hover);color:var(--text-primary)}.badge,.status,.status-pill{display:inline-flex;align-items:center;gap:.4rem;padding:.2rem .65rem;border:1px solid var(--border-subtle);border-radius:2rem;color:var(--text-secondary);font-family:var(--font-mono);font-size:.75rem;line-height:1.6}.evidence,.source-link,.box-source,.boxlink-foot{color:var(--text-muted);font-size:.85rem}.source-link,.box-source,.boxlink-foot{display:block;margin-top:1.3rem}.evidence-ladder,.status-list{padding-left:1.4rem}.evidence-ladder li,.status-list li{padding:.4rem 0}.stat{padding:1rem;border-left:2px solid var(--accent-violet)}.stat strong{display:block;font-size:1.8rem;line-height:1.2;color:var(--text-primary)}.stat-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr))}.stat span{color:var(--text-secondary)}blockquote{border-left:2px solid var(--accent-violet);padding:1rem 1.5rem;color:var(--text-secondary);background:var(--bg-surface);border-radius:0 .8rem .8rem 0}blockquote p:last-child{margin-bottom:0}hr{border:0;border-top:1px solid var(--border-subtle);margin:3rem 0}code,kbd,samp,pre{font-family:var(--font-mono);font-size:.9em}code{color:var(--accent-green)}pre{background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:.8rem;padding:1.2rem;max-width:100%;overflow:auto;white-space:pre}pre code{color:var(--text-primary)}.table-wrap{max-width:100%;overflow-x:auto;border:1px solid var(--border-subtle);border-radius:.8rem}.table-wrap table{margin:0}table{border-collapse:collapse;width:100%;font-size:.9rem;text-align:left}th,td{padding:.85rem 1rem;border-bottom:1px solid var(--border-subtle);vertical-align:top}th{color:var(--text-primary);font-weight:650;background:var(--bg-surface)}td{color:var(--text-secondary)}caption{text-align:left;padding:1rem;color:var(--text-muted)}details{border:1px solid var(--border-subtle);border-radius:.9rem;background:var(--bg-surface);padding:1rem 1.3rem}details+details{margin-top:.9rem}details[open]>summary{margin-bottom:1.2rem}summary{font-weight:600;color:var(--text-primary);padding:.3rem;min-height:2.5rem}summary::marker{color:var(--accent-violet)}details>:last-child{margin-bottom:0}label{display:block;color:var(--text-secondary)}input:not([type=checkbox]):not([type=radio]),textarea,select{width:100%;max-width:100%;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--border-subtle);border-radius:.6rem;padding:.75rem}textarea{resize:vertical;min-height:8rem}input[type=checkbox],input[type=radio]{accent-color:var(--accent-blue);width:1.2rem;height:1.2rem;vertical-align:middle;margin-right:.6rem}\n"
text sstyle3 ".home-door{isolation:isolate;position:relative;min-height:34rem;display:grid;align-items:center;border-radius:1.5rem;overflow:hidden;background:var(--bg-base);border:1px solid var(--border-subtle);margin-bottom:4rem}.door-scene{position:absolute;inset:0;z-index:-1}.door-scene canvas{width:100%;height:100%;display:block;opacity:.48}.door-content{position:relative;max-width:50rem;padding:clamp(1.4rem,5vw,4rem);background:linear-gradient(90deg,var(--bg-base),#0b1020d9 65%,transparent)}.door-content h2{font-size:clamp(2.3rem,5vw,4.8rem);max-width:15ch}.door-note{font-size:.8rem;max-width:50ch;margin-top:1.3rem}.home-door[data-playing=true] .door-content{background:#0b1020cc}.home-door[data-playing=true] .door-scene canvas{opacity:1}.home-door[data-playing=true] .door-content h2{font-size:clamp(1.5rem,3vw,2.4rem)}.home-door[data-playing=true] .door-content{align-self:end}.home-door[data-finished=true]{min-height:0}.home-door[data-finished=true] .door-scene{display:none}.home-door[data-finished=true] .door-content{max-width:none;width:100%;padding:1.5rem 2rem}.home-door[data-finished=true] h2{font-size:1.7rem}.home-door[data-finished=true] .door-note,.home-door[data-finished=true] .eyebrow{display:none}.next-stops{padding-block:2.5rem 3.5rem;border-top:1px solid var(--border-subtle)}.next-stops h2{font-size:1.7rem}.trail-panel{padding-bottom:3.5rem}.trail-panel>details{max-width:65rem}.trail-opt{margin-bottom:1rem}.star-map{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:.8rem 1.5rem}.star-map li{position:relative;padding-left:1rem}.star-map li::before{content:'';position:absolute;left:0;top:.65rem;width:.35rem;height:.35rem;border-radius:50%;background:var(--accent-violet)}#site-trail-draft{margin-top:1.5rem;border-top:1px solid var(--border-subtle);padding-top:1.5rem}#site-trail-draft textarea{margin-block:.7rem 1rem}.aien-footer{position:relative;border-top:1px solid var(--border-subtle);background:var(--bg-base);padding:3.5rem 0 6rem;color:var(--text-secondary);font-size:.9rem}.footer-intro{display:grid;gap:.8rem;margin-bottom:2rem}.footer-intro p{margin:0}.aien-reach-foot,.footer-quiet{display:flex;flex-wrap:wrap;gap:.7rem 1.4rem}.footer-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.7rem 1.2rem;margin-bottom:2.5rem}.footer-links a{color:var(--text-secondary)}.aien-footer-machines{font-size:.8rem}.footer-quiet{font-size:.8rem}.aien-footer .muted{font-size:.8rem;max-width:65ch}\n"
text sstyle4 "@media(min-width:52rem){.nav-toggle{display:none!important}.aien-header nav[hidden]{display:block!important}}@media(max-width:64rem){.master-nav a{gap:.4rem;padding:.65rem .35rem;font-size:.9rem}.site-header-inner{column-gap:1rem}}@media(max-width:52rem){.container,.site-header-inner{width:calc(100% - 2rem)}.site-header-inner{grid-template-columns:1fr;gap:1rem;padding-top:1.1rem}.aien-nav-reach{justify-content:start;flex-wrap:wrap;gap:1.25rem}.site-brand{font-size:.95rem}.nav-toggle{justify-self:start}.master-nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem}.master-nav a{font-size:.9rem;gap:.4rem;padding:.7rem .4rem}.nav-glyph{width:1rem}.site-main{padding-block:1rem 3rem}.site-main>*+*{margin-top:2rem}.page-intro{padding-top:1rem}.breadcrumbs{padding-top:1.2rem}.home-door{min-height:31rem;border-radius:1rem}.door-content{padding:1.5rem;background:#0b1020d9}.home-door[data-finished=true] .door-content{padding:1.3rem}.home-door .cluster{align-items:stretch}.home-door .cluster>*{flex:1 1 auto}.dashboard-grid,.card-grid{gap:1rem}.panel,.hub-card{padding:1.3rem}.next-stops{padding-block:2rem}.aien-footer{padding-top:2.5rem}.aien-footer .container{padding-right:0}.footer-links{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.door-scene{display:none}}@media(forced-colors:active){.panel,.hub-card,.home-door,.button,.master-nav a[aria-current=page]{border:1px solid CanvasText}.nav-glyph,.badge,.status{color:CanvasText}}@media print{body.site{background:white;color:black}.aien-header,.aien-footer,.home-door,.next-stops,.trail-panel,.allen-launcher,.breadcrumbs{display:none!important}.container{width:100%}.site-main{padding:0}a{color:inherit}.panel,.hub-card,details{background:transparent;border-color:#888;color:black;break-inside:avoid}p,td{color:black}pre{white-space:pre-wrap}}
"
