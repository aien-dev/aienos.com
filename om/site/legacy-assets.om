note Authored legacy browser asset units migrated without byte changes.
note These Omega text units are the source after cutover; public counterparts are generated artifacts.
note Native browser JavaScript is emitted by seeded Omega, matching the existing Hive #105 boundary.
text sap0 "js/project-progress.js"
text sab0 "/* AIEN project telemetry. Public data only; credentials stay in CI. */\n// A repository link the collector wrote (GitHub address of its current owner). Older snapshots carry none.\nconst REPO_URL=/^https:\\/\\/github\\.com\\/aien-(?:dev|spark)\\/(?!\\.\\.?$)[A-Za-z0-9_.-]+$/;\nfunction renderProgress(data,previousDate){\n    const root=document.getElementById('aien-growth-observatory');\n\n    const days=data.series.map(d=>({...d,x:new Date(d.date+'T12:00:00Z'),C:d.langs.C||0,Rust:d.langs.Rust||0,Other:d.loc-(d.langs.C||0)-(d.langs.Rust||0)}));\n    const fmt=new Intl.NumberFormat('en-US');\n    const short=d3.format('~s');\n    const dateFmt=d3.utcFormat('%b %-d');\n    const longDate=d3.utcFormat('%B %-d, %Y');\n    const esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n    const color=i=>'var(--viz-series-'+i+')';\n    const tooltip=root.querySelector('#ag-tooltip');\n    let selected=previousDate ? days.findIndex(d=>d.date===previousDate) : days.length-1; if(selected<0) selected=days.length-1;\n    const charts=[];\n    const definitions=[\n      {id:'ag-code',legend:'ag-code-legend',height:300,unit:'Physical source lines',series:[{key:'loc',label:'All measured source',color:1},{key:'test',label:'Test-path source (included)',color:2}],fill:true},\n      {id:'ag-revision',legend:'ag-revision-legend',height:240,unit:'Recorded revisions / PRs',series:[{key:'commits',label:'Commits',color:1},{key:'prs',label:'All PRs',color:3},{key:'merged',label:'Merged PRs',color:4}]},\n      {id:'ag-ci-plot',height:240,unit:'Available workflow runs',series:[{key:'ci',label:'CI runs',color:1}],fill:true},\n      {id:'ag-tests',height:240,unit:'Distinct named test files',series:[{key:'testfiles',label:'Test files',color:2}],fill:true},\n      {id:'ag-languages',legend:'ag-lang-legend',height:240,unit:'Physical source lines',series:[{key:'C',label:'C',color:3},{key:'Rust',label:'Rust',color:4},{key:'Other',label:'Other',color:5}],stack:true}\n    ];\n    const bisect=d3.bisector(d=>d.x).left;\n    function valueAt(key,time){\n      const i=Math.max(1,Math.min(days.length-1,bisect(days,time)));\n      const a=days[i-1],b=days[i];const t=Math.max(0,Math.min(1,(time-a.x)/(b.x-a.x)));\n      return a[key]+(b[key]-a[key])*t;\n    }\n    function updateSelection(){\n      const d=days[selected];\n      root.querySelector('#ag-selected-date').textContent='· '+longDate(d.x);\n      root.querySelector('#ag-lines').textContent=fmt.format(d.loc);\n      root.querySelector('#ag-revisions').textContent=fmt.format(d.commits);\n      root.querySelector('#ag-ci').textContent=fmt.format(d.ci);\n      root.querySelector('#ag-line-context').textContent=fmt.format(d.test)+' in named test files';\n      root.querySelector('#ag-rev-context').textContent=fmt.format(d.merged)+' merged PRs / '+fmt.format(d.prs)+' total';\n      root.querySelector('#ag-ci-context').textContent=d.repos+' repositories in retained history';\n      root.querySelector('#ag-test-summary').textContent=fmt.format(d.testfiles)+' files · '+fmt.format(d.test)+' physical lines';\n      charts.forEach(c=>{if(c.selection){const line=matchMedia('(prefers-reduced-motion: reduce)').matches?c.selection:c.selection.transition().duration(160);line.attr('x1',c.x(d.x)).attr('x2',c.x(d.x));}});\n    }\n    function moveTooltip(event,c,time){\n      const bounds=root.getBoundingClientRect();const px=event.clientX-bounds.left;const py=event.clientY-bounds.top;\n      const active=c.def.series.filter(s=>s.visible!==false);\n      tooltip.innerHTML='<div class=\"text-small\">'+longDate(time)+'</div>'+active.map(s=>'<div class=\"ag-tooltip-row text-small\"><span>'+esc(s.label)+'</span><span class=\"tabular-nums\">'+fmt.format(Math.round(valueAt(s.key,time)))+'</span></div>').join('')+'<div class=\"text-small text-muted\">Between daily snapshots</div>';\n      tooltip.style.display='block';\n      const tw=tooltip.getBoundingClientRect().width;\n      tooltip.style.left=Math.max(0,Math.min(bounds.width-tw,px+16))+'px';tooltip.style.top=Math.max(0,py-88)+'px';\n      c.hover.attr('x1',c.x(time)).attr('x2',c.x(time)).attr('visibility','visible');\n      c.markers.attr('visibility',s=>s.visible===false?'hidden':'visible').attr('cx',c.x(time)).attr('cy',s=>{\n        let v=valueAt(s.key,time);if(c.def.stack){v=0;for(const p of active){v+=valueAt(p.key,time);if(p.key===s.key)break;}}return c.y(v);\n      });\n    }\n    function draw(c){\n      const box=c.box;const W=box.clientWidth; if(!W)return;\n      const H=c.def.height;const m={l:70,r:22,t:24,b:48};const a=m.l,b=W-m.r,top=m.t,bottom=H-m.b;\n      const active=c.def.series.filter(s=>s.visible!==false);\n      const x=d3.scaleUtc().domain(d3.extent(days,d=>d.x)).range([a+4,b-4]);\n      const vals=c.def.stack?days.map(d=>active.reduce((s,p)=>s+d[p.key],0)):days.flatMap(d=>active.map(s=>d[s.key]));\n      const extent=d3.extent([0,...vals]);const y=d3.scaleLinear().domain([extent[0],Math.max(1,extent[1])*1.12]).nice().range([bottom-4,top+4]);\n      c.x=x;c.y=y;\n      const svg=d3.select(box).selectAll('svg').data([0]).join('svg').attr('class','ag-chart').attr('viewBox',`0 0 ${W} ${H}`).attr('role','img').attr('aria-label',c.def.unit+' over retained project history');\n      svg.selectAll('*').remove();svg.append('title').text(c.def.unit+' from '+longDate(days[0].x)+' to '+longDate(days.at(-1).x));\n      svg.append('desc').text('Daily pinned Git snapshots. The source import on September 19 and subsequent compiler and operating system work account for much of the visible growth.');\n      svg.append('rect').attr('data-chart-frame','').attr('x',a).attr('y',top).attr('width',Math.max(1,b-a)).attr('height',bottom-top).attr('fill','none').attr('stroke','var(--border)');\n      const ticks=W<420?3:W<650?4:6;\n      const yg=svg.append('g').attr('transform',`translate(${a},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(short).tickSize(-(b-a)));\n      yg.selectAll('.tick text').attr('dx',-4);yg.selectAll('.tick line').attr('opacity',.45);\n      const xg=svg.append('g').attr('transform',`translate(0,${bottom})`).call(d3.axisBottom(x).ticks(ticks).tickFormat(dateFmt).tickSize(0).tickPadding(10));\n      xg.selectAll('.tick').each(function(d){const tx=x(d);d3.select(this).select('text').attr('text-anchor',tx<a+25?'start':tx>b-25?'end':'middle');});\n      svg.append('text').attr('class','axis-title').attr('data-axis','y').attr('x',a).attr('y',13).text(c.def.unit);\n      svg.append('text').attr('class','axis-title').attr('data-axis','x').attr('x',b).attr('y',H-3).attr('text-anchor','end').text('Date · '+days[0].date.slice(0,4)+(days[0].date.slice(0,4)===days.at(-1).date.slice(0,4)?'':'–'+days.at(-1).date.slice(0,4)));\n      const clipId=c.def.id+'-clip';svg.append('defs').append('clipPath').attr('id',clipId).append('rect').attr('x',a).attr('y',top).attr('width',b-a).attr('height',bottom-top);\n      const marks=svg.append('g').attr('clip-path',`url(#${clipId})`);\n      const previous=c.pathPositions||{};const next={};\n      function paintPath(path,key,high,low){\n        const shape=lo=>lo?d3.area().x((d,i)=>x(days[i].x)).y0((d,i)=>lo[i]).y1(d=>d):d3.line().x((d,i)=>x(days[i].x)).y(d=>d);\n        const build=(hi,lo)=>shape(lo)(hi);const before=previous[key];next[key]={high,low};\n        if(before&&c.lastWidth===W&&!matchMedia('(prefers-reduced-motion: reduce)').matches){\n          const ih=d3.interpolateArray(before.high,high);const il=low?d3.interpolateArray(before.low||before.high,low):null;\n          path.attr('d',build(before.high,before.low)).transition().duration(180).attrTween('d',()=>t=>build(ih(t),il?il(t):null));\n        }else path.attr('d',build(high,low));\n      }\n      if(c.def.stack){\n        const stack=d3.stack().keys(active.map(s=>s.key))(days);\n        stack.forEach(s=>{const path=marks.append('path').attr('class','area').attr('fill',color(active.find(p=>p.key===s.key).color)).attr('opacity',.48);paintPath(path,s.key+'-stack',s.map(d=>y(d[1])),s.map(d=>y(d[0])));});\n      }else{\n        active.forEach(s=>{\n          if(c.def.fill)paintPath(marks.append('path').attr('fill',color(s.color)).attr('opacity',s.key==='test'?.12:.08),s.key+'-area',days.map(d=>y(d[s.key])),days.map(()=>y(0)));\n          paintPath(marks.append('path').attr('fill','none').attr('stroke',color(s.color)).attr('stroke-width',2),s.key+'-line',days.map(d=>y(d[s.key])),null);\n        });\n      }\n      c.pathPositions=next;c.lastWidth=W;\n      active.forEach(s=>{let v=days.at(-1)[s.key];if(c.def.stack){v=0;for(const p of active){v+=days.at(-1)[p.key];if(p.key===s.key)break;}}marks.append('circle').attr('cx',x(days.at(-1).x)).attr('cy',y(v)).attr('r',3).attr('fill',color(s.color));});\n      c.selection=marks.append('line').attr('x1',x(days[selected].x)).attr('x2',x(days[selected].x)).attr('y1',top).attr('y2',bottom).attr('stroke','var(--foreground)').attr('stroke-width',1).attr('opacity',.35);\n      c.hover=marks.append('line').attr('data-chart-hover-guide','').attr('y1',top).attr('y2',bottom).attr('stroke','var(--foreground)').attr('stroke-width',1).attr('opacity',.55).attr('visibility','hidden');\n      c.markers=marks.selectAll('circle.hover').data(c.def.series).join('circle').attr('class','hover').attr('data-chart-hover-marker','').attr('r',4).attr('fill',s=>color(s.color)).attr('visibility','hidden');\n      svg.append('rect').attr('data-chart-hit','').attr('data-chart-hover-overlay','cross-series').attr('class','cursor-interaction').attr('x',a).attr('y',top).attr('width',b-a).attr('height',bottom-top).attr('fill','transparent').on('pointermove',function(event){const [px]=d3.pointer(event,this);const t=x.invert(Math.max(x.range()[0],Math.min(x.range()[1],px)));moveTooltip(event,c,t);}).on('pointerleave',()=>{if(!c.pinned){tooltip.style.display='none';c.hover.attr('visibility','hidden');c.markers.attr('visibility','hidden');}}).on('click',function(event){c.pinned=!c.pinned;const [px]=d3.pointer(event,this);moveTooltip(event,c,x.invert(Math.max(x.range()[0],Math.min(x.range()[1],px))));});\n      // Tick labels are measured after every responsive redraw; optional crowded ticks are removed.\n      let lastRight=-Infinity; xg.selectAll('.tick text').each(function(){const r=this.getBoundingClientRect();if(r.left<lastRight+4)d3.select(this.parentNode).remove();else lastRight=r.right;});\n      const yboxes=[];yg.selectAll('.tick text').each(function(){yboxes.push(this.getBoundingClientRect());});\n      svg.selectAll('.axis-title').each(function(){const r=this.getBoundingClientRect();if(yboxes.some(t=>r.left<t.right+4&&r.right>t.left-4&&r.top<t.bottom+4&&r.bottom>t.top-4))d3.select(this).attr('y',9);});\n    }\n    definitions.forEach(def=>{\n      def.series.forEach(s=>s.visible=true);const c={def,box:root.querySelector('#'+def.id),pinned:false};charts.push(c);\n      if(def.legend){const legend=root.querySelector('#'+def.legend);def.series.forEach(s=>{const button=document.createElement('button');button.type='button';button.className='ag-legend cursor-interaction text-small';button.setAttribute('aria-pressed','true');button.innerHTML='<span class=\"ag-swatch\" style=\"background:'+color(s.color)+'\"></span>'+esc(s.label);button.addEventListener('click',()=>{if(s.visible&&def.series.filter(x=>x.visible).length===1)return;s.visible=!s.visible;button.setAttribute('aria-pressed',String(s.visible));tooltip.style.display='none';draw(c);});legend.append(button);});}\n      c.observer=new ResizeObserver(()=>draw(c));c.observer.observe(c.box);draw(c);\n    });\n    const slider=root.querySelector('#ag-date-slider');slider.max=days.length-1;slider.value=selected;slider.addEventListener('input',()=>{selected=+slider.value;updateSelection();});\n    root.querySelector('#ag-events').innerHTML=data.events.map(e=>'<details class=\"ag-event\"><summary class=\"cursor-interaction\"><div class=\"ag-event-meta\"><time class=\"text-small text-muted\" datetime=\"'+e.date+'\">'+longDate(new Date(e.date+'T12:00:00Z'))+'</time><span class=\"text-small text-muted\">'+esc(e.status)+'</span></div><div class=\"ag-event-title\"><span>'+esc(e.title)+'</span><span aria-hidden=\"true\">+</span></div></summary><p class=\"text-small\">'+esc(e.detail)+'</p><a class=\"text-small\" href=\"'+e.url+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+esc(e.repo)+(e.pr?' #'+e.pr:' · first retained commit')+'</a></details>').join('');\n    const maxRepo=d3.max(data.repos,r=>(r.size.source||0)+(r.size.test||0));\n    const repoUrl=r=>REPO_URL.test(r.url||'')?r.url:'https://github.com/aien-dev/'+encodeURIComponent(r.name);\n    root.querySelector('#ag-repos').innerHTML=data.repos.map(r=>{const total=(r.size.source||0)+(r.size.test||0);return '<tr><td><a href=\"'+esc(repoUrl(r))+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+esc(r.name)+'</a><div class=\"text-small text-muted\">'+esc(r.archived?'Archived precursor':r.group)+' · '+dateFmt(new Date(r.first+'T12:00:00Z'))+'</div></td><td class=\"ag-barcell text-end tabular-nums\">'+fmt.format(total)+'<div class=\"ag-bar\" aria-label=\"'+fmt.format(r.size.source||0)+' general source lines, '+fmt.format(r.size.test||0)+' test-path lines\"><span style=\"width:'+((r.size.source||0)/maxRepo*100)+'%;background:'+color(1)+'\"></span><span style=\"width:'+((r.size.test||0)/maxRepo*100)+'%;background:'+color(2)+'\"></span></div></td><td class=\"text-end tabular-nums\">'+fmt.format(r.revisions)+'</td><td class=\"text-end tabular-nums\">'+fmt.format(r.prCount)+'</td><td class=\"text-end tabular-nums\">'+fmt.format(r.ciCount)+'</td></tr>';}).join('');\n    root.querySelector('#ag-pins').innerHTML=data.repos.map(r=>'<div class=\"ag-pin\"><a href=\"'+esc(repoUrl(r)+'/tree/'+encodeURIComponent(r.head))+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+esc(r.name)+'</a><code>'+esc(String(r.head).slice(0,10))+'</code></div>').join('');\n    root.querySelector('#ag-scope').textContent=dateFmt(days[0].x)+' to '+longDate(days.at(-1).x)+' · '+data.repos.length+' public repositories';\n    root.querySelector('#ag-repo-counts').textContent=data.repos.filter(r=>r.archived).length+' archived · '+data.repos.filter(r=>!r.archived).length+' unarchived';\n    root.querySelector('#ag-activity').innerHTML=(data.activity||[]).map(p=>'<div class=\"ag-event\"><div class=\"ag-event-meta text-small text-muted\"><span>'+esc(p.repo)+'</span><span>'+esc(p.state)+'</span></div><a href=\"'+p.url+'\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ag-event-title\">'+esc(p.title)+'</a><time class=\"text-small text-muted\">'+longDate(new Date(p.date+'T12:00:00Z'))+'</time></div>').join('')||'<p>Recent activity will appear after the next collection.</p>';\n    root.querySelector('#ag-asof').textContent='Measurement cutoff: '+new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeStyle:'short',timeZone:'America/Chicago'}).format(new Date(data.asof))+' America/Chicago. Default branches were read and pinned during collection.';\n    root.querySelector('#ag-secondary-counts').textContent='Additional footprint: '+fmt.format(data.summary.files)+' distinct source blobs, '+fmt.format(data.summary.docfiles)+' distinct documentation blobs and '+fmt.format(data.summary.docs)+' documentation lines (excluded from source totals). Available CI conclusions at collection: '+fmt.format(data.ciConclusions.success||0)+' success, '+fmt.format(data.ciConclusions.failure||0)+' failure; remaining records were cancelled, skipped or unfinished. These are workflow outcomes, not unique correctness verdicts.';\n    updateSelection();\n\n\n    return {destroy(){charts.forEach(c=>c.observer.disconnect());},date(){return selected===days.length-1?null:days[selected].date;}};\n}\n\n(function startProgress(){\n  const root=document.getElementById('aien-growth-observatory');if(!root)return;\n  let data=null,view,busy=false,error=false;\n  const template=root.innerHTML;\n  function freshness(){\n    const age=Math.max(0,Date.now()-Date.parse(data.asof));\n    const stamp=new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short',timeZone:'America/Chicago'}).format(new Date(data.asof));\n    const node=root.querySelector('#ag-freshness');node.dataset.stale=String(age>3*3600000||error);\n    node.textContent=(error?'Update check unavailable · ':age>3*3600000?'Older snapshot · ':'Collected · ')+stamp;\n  }\n  function display(date){\n    view?.destroy();root.innerHTML=template;view=renderProgress(data,date);freshness();\n    root.querySelector('#ag-refresh').addEventListener('click',()=>refresh(true));\n  }\n  function valid(next){\n    if(!next||!Array.isArray(next.series)||!next.series.length||!Array.isArray(next.repos)||!next.repos.length||!Number.isFinite(Date.parse(next.asof)))throw Error('Invalid snapshot');\n    const last=next.series.at(-1);\n    for(const key of ['loc','commits','ci','testfiles'])if(!Number.isSafeInteger(last[key])||last[key]<0||next.summary[key]!==last[key])throw Error('Invalid metric');\n    const urls=[...(next.events||[]),...(next.activity||[])].map(p=>p.url);\n    for(const url of urls)if(!/^https:\\/\\/github\\.com\\/aien-(?:dev|spark)\\/[A-Za-z0-9_.\\/-]+$/.test(url))throw Error('Invalid source URL');\n    for(const repo of next.repos)if(!/^[.A-Za-z0-9_-]+$/.test(repo.name)||!/^[a-f0-9]{40}$/.test(repo.head)||(repo.url!==undefined&&!REPO_URL.test(repo.url)))throw Error('Invalid source pin');\n    return next;\n  }\n  async function refresh(manual=false){\n    if(busy)return;busy=true;const button=root.querySelector('#ag-refresh');button.disabled=true;button.textContent='Checking…';\n    try{\n      const response=await fetch('/data/project-progress.json?check='+Date.now(),{cache:'no-store',signal:AbortSignal.timeout(20000)});\n      if(!response.ok)throw Error('Unavailable');const next=valid(await response.json());\n      if(Date.parse(next.asof)>Date.parse(data.asof)){const date=view.date();data=next;display(date);}\n      error=false;freshness();if(manual)root.querySelector('#ag-refresh').textContent='Up to date';\n    }catch(e){error=true;freshness();}\n    finally{busy=false;root.querySelector('#ag-refresh').disabled=false;if(!manual||error)root.querySelector('#ag-refresh').textContent='Check for updates';}\n  }\n  async function loadInitial(){\n    try{\n      const response=await fetch('/data/project-progress.json',{cache:'default',signal:AbortSignal.timeout(20000)});\n      if(!response.ok)throw Error('Unavailable');\n      data=valid(await response.json());\n      display();\n      setInterval(()=>{freshness();if(!document.hidden)refresh();},5*60000);\n      document.addEventListener('visibilitychange',()=>{if(!document.hidden)refresh();});\n    }catch(e){\n      error=true;\n      const node=root.querySelector('#ag-freshness');\n      node.dataset.stale='true';\n      node.textContent='Dataset unavailable · Retry';\n      const button=root.querySelector('#ag-refresh');\n      button.addEventListener('click',()=>location.reload());\n    }\n  }\n  loadInitial();\n})();\n"
text sap1 "js/terminal.js"
text sab1 "// AIEN OS Interactive Neural Terminal Micro-Script\n// Pure Vanilla JavaScript (<2 KB) - Zero Virtual DOM overhead\n\n(function() {\n  const RESPONSES = {\n    sys_telemetry: {\n      device: \"NVIDIA Grace Blackwell GB10\",\n      compute_capability: \"sm_121a\",\n      unified_memory_total_gb: 128.0,\n      resident_kernel_model_gb: 64.3,\n      dynamic_kv_cache_allocated_gb: 4.8,\n      free_memory_gb: 58.9,\n      gpu_temp_celsius: 45.0,\n      power_draw_watts: 11.5,\n      performance_state: \"P0 (Maximum Performance)\"\n    },\n    sys_alloc_kv: {\n      syscall: \"sys_alloc_kv\",\n      status: \"SUCCESS\",\n      blocks_requested: 2048,\n      block_size_tokens: 16,\n      bytes_allocated: 33554432,\n      alloc_duration_us: 1420,\n      fragmentation_ratio: 0.000,\n      page_table_mapping: \"coherent_unified_sm_121a\"\n    },\n    sys_vault: {\n      subsystem: \"atlas-vault\",\n      hardware_key_substrate: \"/dev/tpmrm0\",\n      algorithm: \"ECDSA P-256 (NIST SP 800-90A)\",\n      disk_secrets_found: 0,\n      policy_status: \"SECURE_TPM_ONLY\",\n      memory_redaction_filter: \"ACTIVE ([REDACTED_BY_ATLAS_VAULT])\"\n    }\n  };\n\n  const HELP_TEXT = \"Supported Neural Syscalls:\\n  sys_telemetry - Inspect GB10 thermals, power, and unified VRAM\\n  sys_alloc_kv   - Allocate PagedAttention neural memory blocks\\n  sys_vault      - Validate hardware TPM 2.0 key vault security\\n  clear          - Clear terminal display\";\n\n  function initTerminal() {\n    const output = document.getElementById(\"terminal-output\");\n    const input = document.getElementById(\"terminal-input\");\n    const form = document.getElementById(\"terminal-form\");\n    if (!output || !input || !form) return;\n\n    function appendEntry(type, text) {\n      const line = document.createElement(\"div\");\n      line.className = \"terminal-log-line \" + type;\n      if (type === \"cmd\") {\n        line.innerHTML = '<span class=\"prompt-symbol\">$ </span>' + escapeHtml(text);\n      } else if (type === \"resp\") {\n        line.innerHTML = '<pre class=\"terminal-resp\">' + escapeHtml(text) + '</pre>';\n      } else {\n        line.innerHTML = '<span class=\"sys-msg\">' + escapeHtml(text) + '</span>';\n      }\n      output.appendChild(line);\n      output.scrollTop = output.scrollHeight;\n    }\n\n    function escapeHtml(str) {\n      return str.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    }\n\n    function runCommand(rawCmd) {\n      const cmd = rawCmd.trim();\n      if (!cmd) return;\n      appendEntry(\"cmd\", cmd);\n\n      const normalized = cmd.toLowerCase();\n      if (normalized === \"clear\") {\n        output.innerHTML = \"\";\n        return;\n      }\n      if (normalized === \"help\") {\n        appendEntry(\"resp\", HELP_TEXT);\n        return;\n      }\n\n      let respKey = null;\n      if (normalized === \"sys_telemetry\" || normalized === \"telemetry\" || normalized === \"status\") {\n        respKey = \"sys_telemetry\";\n      } else if (normalized === \"sys_alloc_kv\" || normalized === \"alloc_kv\") {\n        respKey = \"sys_alloc_kv\";\n      } else if (normalized === \"sys_vault\" || normalized === \"vault\") {\n        respKey = \"sys_vault\";\n      }\n\n      if (respKey) {\n        appendEntry(\"resp\", JSON.stringify(RESPONSES[respKey], null, 2));\n      } else {\n        appendEntry(\"resp\", \"Unrecognized neural syscall: '\" + cmd + \"'. Type 'help' for supported syscalls.\");\n      }\n    }\n\n    form.addEventListener(\"submit\", function(e) {\n      e.preventDefault();\n      const val = input.value;\n      input.value = \"\";\n      runCommand(val);\n    });\n\n    document.querySelectorAll(\"[data-cmd]\").forEach(function(btn) {\n      btn.addEventListener(\"click\", function() {\n        const cmd = btn.getAttribute(\"data-cmd\");\n        if (cmd) runCommand(cmd);\n      });\n    });\n\n    const clearBtn = document.getElementById(\"terminal-clear-btn\");\n    if (clearBtn) {\n      clearBtn.addEventListener(\"click\", function() {\n        output.innerHTML = \"\";\n      });\n    }\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initTerminal);\n  } else {\n    initTerminal();\n  }\n})();\n"
text sap2 "js/turing-game.js"
text sab2 "// The Turing, as a game you can play in thirty seconds.\n//\n// A hidden rule generates a stream of bits. You call each next bit before\n// it lands. A correct call earns 1 T, a miss costs 1 T, and a coin flip\n// averages zero: exactly the idea behind the measure. Memorizing is\n// useless here because every bit is new; only finding the rule pays.\n(function () {\n  \"use strict\";\n\n  var ROUNDS = 12;\n\n  // Each generator is a small hidden rule over the bit history.\n  // firstBits are shown for free so the pattern can be spotted.\n  var RULES = [\n    {\n      name: \"alternation\",\n      firstBits: [0, 1, 0, 1, 0, 1],\n      next: function (h) { return h[h.length - 1] ^ 1; }\n    },\n    {\n      name: \"growing runs\",\n      firstBits: [0, 1, 1, 0, 0, 0],\n      next: function (h) {\n        // Run lengths grow by one: 0, 11, 000, 1111, 00000, ...\n        var last = h[h.length - 1];\n        var s = h.length - 1;\n        while (s > 0 && h[s - 1] === last) s--;\n        var runsBefore = 0, i = 0;\n        while (i < s) {\n          var j = i;\n          while (j < s && h[j] === h[i]) j++;\n          runsBefore++;\n          i = j;\n        }\n        var trailing = h.length - s;\n        return trailing < runsBefore + 1 ? last : last ^ 1;\n      }\n    },\n    {\n      name: \"xor of the last two\",\n      firstBits: [0, 1, 1, 0, 1, 1],\n      next: function (h) { return h[h.length - 1] ^ h[h.length - 2]; }\n    },\n    {\n      name: \"pairs\",\n      firstBits: [1, 1, 0, 0, 1, 1],\n      next: function (h) {\n        var last = h[h.length - 1];\n        var prev = h[h.length - 2];\n        return last === prev ? last ^ 1 : last;\n      }\n    }\n  ];\n\n  var streamEl, scoreEl, roundEl, msgEl, btn0, btn1, btnReset;\n  var history, rule, score, round, finished;\n\n  function render() {\n    streamEl.textContent = history.join(\" \") + \"  ?\";\n    scoreEl.textContent = (score > 0 ? \"+\" : \"\") + score + \" T\";\n    roundEl.textContent = \"Round \" + round + \" / \" + ROUNDS;\n  }\n\n  function start() {\n    rule = RULES[Math.floor(Math.random() * RULES.length)];\n    history = rule.firstBits.slice();\n    score = 0;\n    round = 0;\n    finished = false;\n    btn0.disabled = false;\n    btn1.disabled = false;\n    btn0.style.opacity = \"1\";\n    btn1.style.opacity = \"1\";\n    msgEl.textContent =\n      \"Six bits are on the table for free. The rest are yours to predict. \" +\n      \"Right call: +1 T. Miss: -1 T. A coin flip averages zero.\";\n    render();\n  }\n\n  function verdict() {\n    if (score >= 8) {\n      return \"That is one part of understanding. A short rule in your head just compressed a stream you had never seen, and it paid out in Turings. The full measure, with sealed data and recomputable receipts, is in the paper.\";\n    }\n    if (score >= 3) {\n      return \"You are finding the pattern. That climb, from guessing to predicting, is exactly what the Turing measures. Memorizers cannot do it on new data.\";\n    }\n    if (score >= -2) {\n      return \"About coin-flip territory, which is the point: guessing earns nothing under this unit. The rule was there. Try a fresh stream and hunt for it.\";\n    }\n    return \"Below chance this time. The stream beat you, and the scoreboard said so honestly. That honesty is the whole idea: the Turing only pays for real prediction.\";\n  }\n\n  function guess(bit) {\n    if (finished) return;\n    var actual = rule.next(history);\n    history.push(actual);\n    round++;\n    if (bit === actual) {\n      score += 1;\n      msgEl.textContent = \"Called it. +1 T. The next bit is already hidden.\";\n    } else {\n      score -= 1;\n      msgEl.textContent = \"It landed \" + actual + \". -1 T. Adjust the rule in your head and call the next one.\";\n    }\n    if (round >= ROUNDS) {\n      finished = true;\n      btn0.disabled = true;\n      btn1.disabled = true;\n      btn0.style.opacity = \"0.5\";\n      btn1.style.opacity = \"0.5\";\n      streamEl.textContent = history.join(\" \");\n      scoreEl.textContent = (score > 0 ? \"+\" : \"\") + score + \" T\";\n      roundEl.textContent = \"Stream complete\";\n      msgEl.textContent = verdict();\n      return;\n    }\n    render();\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    streamEl = document.getElementById(\"tg-stream\");\n    if (!streamEl) return;\n    scoreEl = document.getElementById(\"tg-score\");\n    roundEl = document.getElementById(\"tg-round\");\n    msgEl = document.getElementById(\"tg-msg\");\n    btn0 = document.getElementById(\"tg-zero\");\n    btn1 = document.getElementById(\"tg-one\");\n    btnReset = document.getElementById(\"tg-reset\");\n    btn0.addEventListener(\"click\", function () { guess(0); });\n    btn1.addEventListener(\"click\", function () { guess(1); });\n    btnReset.addEventListener(\"click\", start);\n    start();\n  });\n})();\n"
text sap3 "assets/now.css"
text sab3 "/*\n * /now/: the live ledger. Sits inside the Turing look (turing-look.css):\n * near-black field, blue and green glow, mono kickers, heavy headings,\n * rounded cards. What is new here is warmth: every line is coloured by\n * how recently it was written, never by opinion. Hot is the last half\n * hour (green), warm the last two hours (blue), cool today (soft), cold\n * older (ink).\n */\n:root {\n  --now-hot: #00e599;\n  --now-warm: #7db4ff;\n  --now-cool: #5b6b85;\n  --now-cold: #2a3648;\n  --now-op: #f59e0b;\n  --now-drop: #f87171;\n}\n\n.now-hero {\n  padding: 120px 0 56px;\n  position: relative;\n}\n\n.now-hero .container,\n.now-section .container {\n  max-width: 1200px;\n}\n\n.now-title {\n  font-size: clamp(38px, 6vw, 68px);\n  font-weight: 800;\n  letter-spacing: -0.03em;\n  line-height: 1.04;\n  max-width: 18ch;\n}\n\n.now-lead,\n.now-sub {\n  margin-top: 18px;\n  max-width: 68ch;\n  color: var(--tl-ink-2);\n  font-size: 17px;\n  line-height: 1.6;\n}\n\n.now-sub {\n  font-size: 15.5px;\n  margin-top: 12px;\n}\n\n.now-empty {\n  margin-top: 28px;\n  color: var(--tl-ink-3);\n  font-style: italic;\n}\n\n/* ---------- the pulse row ---------- */\n.now-stats {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\n  gap: 14px;\n  margin-top: 40px;\n}\n\n.now-stat {\n  padding: 18px 20px 16px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: linear-gradient(180deg, rgba(19, 24, 34, 0.9), rgba(14, 18, 25, 0.9));\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  transition: border-color 0.3s ease, transform 0.3s ease;\n}\n\n.now-stat:hover {\n  transform: translateY(-2px);\n  border-color: var(--tl-line-2);\n}\n\n.now-stat-n {\n  font-family: var(--font-mono);\n  font-size: 34px;\n  font-weight: 600;\n  letter-spacing: -0.03em;\n  line-height: 1;\n  color: var(--tl-ink);\n}\n\n.now-stat-l {\n  font-size: 12.5px;\n  letter-spacing: 0.02em;\n  color: var(--tl-ink-3);\n  line-height: 1.35;\n}\n\n.now-stat-hot .now-stat-n { color: var(--now-hot); text-shadow: 0 0 24px rgba(0, 229, 153, 0.35); }\n.now-stat-done .now-stat-n { color: var(--now-warm); }\n.now-stat-op .now-stat-n { color: var(--now-op); }\n\n.now-stamp {\n  margin-top: 22px;\n  font-size: 13px;\n  color: var(--tl-ink-3);\n}\n\n.now-stamp .mono { color: var(--tl-ink-2); }\n\n.now-pulse {\n  list-style: none;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 22px;\n  margin-top: 14px;\n  padding: 0;\n}\n\n.now-pulse li {\n  display: inline-flex;\n  gap: 8px;\n  font-size: 12.5px;\n  color: var(--tl-ink-3);\n}\n\n.now-pulse-v { color: var(--tl-ink-2); }\n\n/* ---------- sections ---------- */\n.now-section {\n  padding: 72px 0;\n  border-top: 1px solid var(--tl-line);\n}\n\n.now-h2 {\n  font-size: clamp(26px, 3.4vw, 36px);\n  font-weight: 800;\n  letter-spacing: -0.025em;\n  line-height: 1.1;\n}\n\n.now-op-section {\n  background:\n    radial-gradient(ellipse 60% 24rem at 20% 0%, rgba(245, 158, 11, 0.07), transparent 70%);\n}\n\n/* ---------- streams and their rivers ---------- */\n.now-stream {\n  margin-top: 48px;\n}\n\n.now-stream-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.now-stream-name {\n  font-size: 21px;\n  font-weight: 700;\n  letter-spacing: -0.015em;\n}\n\n.now-stream-n {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--tl-ink-3);\n}\n\n.now-river {\n  display: flex;\n  gap: 3px;\n  height: 6px;\n  margin: 12px 0 20px;\n}\n\n.now-seg {\n  flex: 1 1 0;\n  min-width: 6px;\n  max-width: 72px;\n  border-radius: 3px;\n  background: var(--now-cold);\n  transition: transform 0.3s ease;\n}\n\n.now-seg:hover { transform: scaleY(1.6); }\n.now-seg.now-hot { background: var(--now-hot); box-shadow: 0 0 14px rgba(0, 229, 153, 0.55); }\n.now-seg.now-warm { background: var(--now-warm); box-shadow: 0 0 10px rgba(125, 180, 255, 0.35); }\n.now-seg.now-cool { background: var(--now-cool); }\n\n/* ---------- cards ---------- */\n.now-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));\n  gap: 16px;\n}\n\n.now-card {\n  position: relative;\n  padding: 20px 22px 18px 24px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: var(--tl-card);\n  overflow: hidden;\n  transition: transform 0.35s cubic-bezier(.22,.61,.36,1), border-color 0.35s ease, box-shadow 0.35s ease;\n}\n\n.now-card::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 14px;\n  bottom: 14px;\n  width: 3px;\n  border-radius: 3px;\n  background: var(--now-cold);\n}\n\n.now-card.now-hot::before { background: var(--now-hot); box-shadow: 0 0 16px rgba(0, 229, 153, 0.6); }\n.now-card.now-warm::before { background: var(--now-warm); }\n.now-card.now-cool::before { background: var(--now-cool); }\n.now-card.now-k-operator::before { background: var(--now-op); box-shadow: 0 0 16px rgba(245, 158, 11, 0.45); }\n\n.now-card:hover {\n  transform: translateY(-3px);\n  border-color: var(--tl-blue);\n  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);\n}\n\n.now-card.now-hot:hover { box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(0, 229, 153, 0.18); }\n\n.now-card-top {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  letter-spacing: 0.04em;\n}\n\n.now-id {\n  color: var(--tl-ink-3);\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  letter-spacing: 0.06em;\n}\n\n.now-owner {\n  padding: 2px 9px;\n  border-radius: 999px;\n  border: 1px solid var(--tl-line-2);\n  color: var(--tl-ink-2);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: 0.05em;\n  white-space: nowrap;\n}\n\n.now-owner-operator { color: var(--now-op); border-color: rgba(245, 158, 11, 0.45); }\n.now-owner-desk { color: var(--tl-violet); border-color: rgba(167, 139, 250, 0.4); }\n.now-owner-coordinator { color: var(--now-warm); border-color: rgba(125, 180, 255, 0.4); }\n.now-owner-unassigned { color: var(--tl-ink-3); border-style: dashed; }\n\n.now-age {\n  margin-left: auto;\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--tl-ink-3);\n  white-space: nowrap;\n}\n\n.now-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--now-cold);\n}\n\n.now-hot .now-dot {\n  background: var(--now-hot);\n  box-shadow: 0 0 0 0 rgba(0, 229, 153, 0.6);\n  animation: now-beat 2.4s cubic-bezier(.22,.61,.36,1) infinite;\n}\n\n.now-warm .now-dot { background: var(--now-warm); }\n.now-cool .now-dot { background: var(--now-cool); }\n\n@keyframes now-beat {\n  0% { box-shadow: 0 0 0 0 rgba(0, 229, 153, 0.55); }\n  70% { box-shadow: 0 0 0 9px rgba(0, 229, 153, 0); }\n  100% { box-shadow: 0 0 0 0 rgba(0, 229, 153, 0); }\n}\n\n.now-item {\n  margin-top: 12px;\n  font-size: 16.5px;\n  font-weight: 650;\n  letter-spacing: -0.01em;\n  line-height: 1.35;\n  color: var(--tl-ink);\n  overflow-wrap: anywhere;\n}\n\n.now-note {\n  margin-top: 10px;\n  font-size: 13.5px;\n  line-height: 1.55;\n  color: var(--tl-ink-2);\n  overflow-wrap: anywhere;\n  display: -webkit-box;\n  -webkit-line-clamp: 4;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.now-card:hover .now-note { -webkit-line-clamp: unset; }\n\n.now-done {\n  margin-top: 12px;\n  padding-top: 10px;\n  border-top: 1px dashed var(--tl-line);\n  font-size: 12.5px;\n  line-height: 1.5;\n  color: var(--tl-ink-3);\n  overflow-wrap: anywhere;\n}\n\n.now-done-k {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--tl-blue);\n  margin-right: 4px;\n}\n\n/* ---------- queue ---------- */\n.now-queue {\n  list-style: none;\n  padding: 0;\n  margin-top: 28px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  overflow: hidden;\n}\n\n.now-queue-row {\n  display: grid;\n  grid-template-columns: 56px 1fr auto;\n  gap: 8px 16px;\n  align-items: baseline;\n  padding: 14px 20px;\n  border-top: 1px solid var(--tl-line);\n  background: var(--tl-card);\n}\n\n.now-queue-row:first-child { border-top: 0; }\n.now-queue-row:nth-child(even) { background: rgba(14, 18, 25, 0.6); }\n\n.now-queue-item {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--tl-ink);\n  overflow-wrap: anywhere;\n}\n\n.now-queue-done {\n  grid-column: 2 / -1;\n  font-size: 12.5px;\n  color: var(--tl-ink-3);\n  overflow-wrap: anywhere;\n}\n\n@media (max-width: 640px) {\n  .now-queue-row { grid-template-columns: 1fr; }\n  .now-queue-row .now-owner { justify-self: start; }\n}\n\n/* ---------- settled timeline ---------- */\n.now-timeline {\n  list-style: none;\n  padding: 0;\n  margin-top: 36px;\n  position: relative;\n}\n\n.now-timeline::before {\n  content: \"\";\n  position: absolute;\n  left: 118px;\n  top: 6px;\n  bottom: 6px;\n  width: 1px;\n  background: linear-gradient(180deg, var(--tl-green), var(--tl-blue) 40%, var(--tl-line));\n}\n\n.now-tl {\n  display: grid;\n  grid-template-columns: 100px 1fr;\n  gap: 36px;\n  padding: 14px 0 22px;\n  position: relative;\n}\n\n.now-tl::after {\n  content: \"\";\n  position: absolute;\n  left: 114px;\n  top: 21px;\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--tl-bg);\n  border: 2px solid var(--now-warm);\n}\n\n.now-tl-done::after { border-color: var(--now-hot); }\n.now-tl-dropped::after { border-color: var(--now-drop); }\n\n.now-tl-when {\n  text-align: right;\n  font-size: 12px;\n  color: var(--tl-ink-3);\n  padding-top: 3px;\n}\n\n.now-verdict {\n  display: inline-block;\n  padding: 2px 9px;\n  border-radius: 999px;\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  margin-right: 10px;\n}\n\n.now-verdict-done { color: var(--now-hot); border: 1px solid rgba(0, 229, 153, 0.4); }\n.now-verdict-dropped { color: var(--now-drop); border: 1px solid rgba(248, 113, 113, 0.4); }\n\n.now-tl-item {\n  margin-top: 8px;\n  font-size: 15.5px;\n  font-weight: 600;\n  color: var(--tl-ink);\n  overflow-wrap: anywhere;\n}\n\n.now-tl-evidence {\n  margin-top: 6px;\n  font-size: 13px;\n  line-height: 1.55;\n  color: var(--tl-ink-2);\n  overflow-wrap: anywhere;\n}\n\n@media (max-width: 640px) {\n  .now-timeline::before { left: 4px; }\n  .now-tl { grid-template-columns: 1fr; gap: 6px; padding-left: 22px; }\n  .now-tl::after { left: 0; top: 20px; }\n  .now-tl-when { text-align: left; }\n}\n\n.now-how { padding-bottom: 110px; }\n\n@media (prefers-reduced-motion: reduce) {\n  .now-hot .now-dot { animation: none; }\n  .now-card, .now-stat, .now-seg { transition: none; }\n}\n\n/* References inside a note (a commit, a pull request, an evidence folder)\n   are links; they read as such and stay clickable above the card's own link. */\n.now-ref {\n  color: var(--tl-blue-soft);\n  text-decoration: underline;\n  text-decoration-color: rgba(125, 180, 255, 0.35);\n  text-decoration-thickness: 1px;\n  text-underline-offset: 3px;\n  transition: color 0.3s ease, text-decoration-color 0.3s ease;\n}\n\n.now-ref:hover {\n  color: var(--tl-green);\n  text-decoration-color: var(--tl-green);\n}\n\n/* ---------- jump bar, folds and compact rows ---------- */\n.now-jump {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 22px;\n}\n.now-jump a {\n  padding: 7px 13px;\n  border: 1px solid var(--tl-line);\n  border-radius: 999px;\n  color: var(--tl-ink-2);\n  font: 600 12.5px/1.2 var(--font-mono);\n  text-decoration: none;\n  background: var(--tl-card);\n}\n.now-jump a:hover,\n.now-jump a:focus-visible { color: var(--tl-ink); border-color: var(--now-warm); }\n.now-jump a span { color: var(--now-warm); margin-left: 4px; }\n\n.now-section { scroll-margin-top: 72px; }\n\n.now-folds {\n  display: grid;\n  gap: 10px;\n  margin-top: 26px;\n}\n.now-fold {\n  border: 1px solid var(--tl-line);\n  border-radius: 14px;\n  background: var(--tl-card);\n  overflow: hidden;\n}\n.now-fold-sum {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 6px 16px;\n  padding: 15px 20px;\n  cursor: pointer;\n  list-style: none;\n}\n.now-fold-sum::-webkit-details-marker { display: none; }\n.now-fold-sum::before {\n  content: \"+\";\n  width: 14px;\n  color: var(--now-warm);\n  font: 700 16px/1 var(--font-mono);\n}\n.now-fold[open] > .now-fold-sum::before { content: \"-\"; }\n.now-fold[open] > .now-fold-sum { border-bottom: 1px solid var(--tl-line); }\n.now-fold-sum:hover .now-fold-name,\n.now-fold-sum:focus-visible .now-fold-name { color: var(--now-warm); }\n.now-fold-name { font-weight: 700; color: var(--tl-ink); }\n.now-fold-n,\n.now-fold-age { color: var(--tl-ink-3); font: 12px/1.4 var(--font-mono); }\n.now-fold-age { margin-left: auto; }\n.now-fold-rows { margin-top: 0; border: 0; border-radius: 0; }\n.now-fold .now-timeline { padding: 4px 20px 16px; }\n\n.now-row { grid-template-columns: 64px 1fr auto; }\n.now-row > .box-link { grid-column: 2 / -1; justify-self: start; }\n.now-row-note {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  overflow: hidden;\n  margin-top: 4px;\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 1.5;\n  color: var(--tl-ink-2);\n}\n.now-row:hover .now-row-note,\n.now-row:target .now-row-note { -webkit-line-clamp: unset; }\n.now-row-meta {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 4px;\n}\n.now-row-age { color: var(--tl-ink-3); font: 11.5px/1.3 var(--font-mono); white-space: nowrap; }\n\n:target { scroll-margin-top: 80px; }\n.now-row:target,\n.now-tl:target,\n.now-card:target { outline: 2px solid var(--now-warm); outline-offset: 2px; }\n\n@media (max-width: 640px) {\n  .now-row { grid-template-columns: 1fr; }\n  .now-row > .box-link { grid-column: 1; }\n  .now-row-meta { flex-direction: row; align-items: center; gap: 10px; }\n  .now-fold-age { margin-left: 0; }\n  .now-fold .now-timeline { padding: 4px 12px 12px; }\n}\n.now-row-done { display: block; margin-top: 3px; font-size: 12px; font-weight: 400; color: var(--tl-ink-3); overflow-wrap: anywhere; }\n\n/* ---------- models on the Spark ---------- */\n.now-model-track { color: var(--tl-ink-3); font: 600 11px/1.3 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }\n.now-model-state {\n  margin-left: auto;\n  padding: 3px 9px;\n  border: 1px solid var(--tl-line);\n  border-radius: 999px;\n  font: 600 11px/1.3 var(--font-mono);\n  color: var(--tl-ink-3);\n  white-space: nowrap;\n}\n.now-model-state-answering { color: var(--now-hot); border-color: rgba(0, 229, 153, 0.45); }\n.now-model-state-not-answering { color: var(--now-drop); border-color: rgba(248, 113, 113, 0.45); }\n.now-model-state-planned { color: var(--now-warm); border-color: rgba(125, 180, 255, 0.4); }\n.now-model-answering::before { background: var(--now-hot); }\n.now-model-not-answering::before { background: var(--now-drop); }\n.now-model .now-model-role { -webkit-line-clamp: unset; }\n.now-model-figs { margin: 12px 0 0; display: grid; gap: 4px; }\n.now-model-figs dt { color: var(--tl-ink-3); font: 600 11px/1.3 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; margin-top: 6px; }\n.now-model-figs dd { margin: 0; color: var(--tl-ink); font-size: 14px; line-height: 1.5; }\n#models .now-grid { margin-top: 26px; }\n\n/* Keeper, the merge desk: one big dachshund standing on the page (public/assets/keeper.svg). */\n.now-owner-dog {\n  width: 42px;\n  height: 14px;\n  margin-right: 5px;\n  vertical-align: -2px;\n}\n\n.now-hero-top {\n  display: grid;\n  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);\n  gap: 24px;\n  align-items: end;\n}\n\n.now-keeper {\n  margin: 0;\n  text-align: center;\n}\n\n.now-keeper img {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.now-keeper figcaption {\n  margin-top: 6px;\n  color: var(--tl-ink-3);\n  font-family: var(--font-mono);\n  font-size: 12px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n@media (max-width: 900px) {\n  .now-hero-top { grid-template-columns: 1fr; }\n  .now-keeper { order: -1; }\n}\n\n/* Drake's Claude plan: what is left, and how to help pay for it. */\n.now-usage-wrap {\n  display: grid;\n  margin-top: 24px;\n  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);\n  gap: 18px;\n  align-items: start;\n}\n\n.now-usage {\n  position: relative;\n  padding: 20px 22px 18px 24px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: var(--tl-card);\n}\n\n.now-usage-plan {\n  font-weight: 700;\n  color: var(--tl-ink);\n}\n\n.now-usage-row {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: 6px 12px;\n  margin-top: 16px;\n}\n\n.now-usage-k { color: var(--tl-ink); font-size: 15px; }\n.now-usage-v { justify-self: end; color: var(--tl-ink); font-size: 15px; }\n.now-usage-used { color: var(--tl-ink-2); font-size: 13px; }\n.now-usage-reset { grid-column: 1 / -1; color: var(--tl-ink-3); font-size: 12px; }\n\n.now-usage-meter {\n  grid-column: 1 / -1;\n  grid-row: 2;\n  width: 100%;\n  height: 12px;\n}\n\n/* The limits as one menu: a chip per window flips the card between the\n   five-hour session and the weekly limits, with no script and no page jump. */\n.now-usage-menu { margin-top: 4px; }\n\n.now-usage-radio {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.now-usage-tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin: 4px 0 2px;\n}\n\n.now-usage-tab {\n  display: inline-flex;\n  align-items: baseline;\n  gap: 8px;\n  padding: 7px 12px;\n  border: 1px solid var(--tl-line);\n  border-radius: 999px;\n  color: var(--tl-ink-2);\n  font-size: 13px;\n  line-height: 1.2;\n  cursor: pointer;\n  transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;\n}\n\n.now-usage-tab:hover { color: var(--tl-ink); border-color: var(--tl-line-2); }\n.now-usage-tab-k { font-weight: 600; }\n.now-usage-tab-v { color: var(--tl-ink-3); font-variant-numeric: tabular-nums; }\n\n.now-usage-panels .now-usage-panel { display: none; }\n.now-usage-panel .now-usage-row { margin-top: 14px; }\n\n#now-usage-0:checked ~ .now-usage-tabs label[for=\"now-usage-0\"],\n#now-usage-1:checked ~ .now-usage-tabs label[for=\"now-usage-1\"],\n#now-usage-2:checked ~ .now-usage-tabs label[for=\"now-usage-2\"] {\n  border-color: var(--now-op);\n  color: var(--tl-ink);\n  box-shadow: inset 0 -2px 0 var(--now-op);\n}\n\n#now-usage-0:checked ~ .now-usage-tabs label[for=\"now-usage-0\"] .now-usage-tab-v,\n#now-usage-1:checked ~ .now-usage-tabs label[for=\"now-usage-1\"] .now-usage-tab-v,\n#now-usage-2:checked ~ .now-usage-tabs label[for=\"now-usage-2\"] .now-usage-tab-v { color: var(--tl-ink); }\n\n#now-usage-0:focus-visible ~ .now-usage-tabs label[for=\"now-usage-0\"],\n#now-usage-1:focus-visible ~ .now-usage-tabs label[for=\"now-usage-1\"],\n#now-usage-2:focus-visible ~ .now-usage-tabs label[for=\"now-usage-2\"] {\n  outline: 2px solid var(--now-op);\n  outline-offset: 2px;\n}\n\n#now-usage-0:checked ~ .now-usage-panels .now-usage-panel-0,\n#now-usage-1:checked ~ .now-usage-panels .now-usage-panel-1,\n#now-usage-2:checked ~ .now-usage-panels .now-usage-panel-2 { display: block; }\n\n@media (max-width: 520px) {\n  .now-usage-tab { flex: 1 1 100%; }\n}\n\n.now-give {\n  padding: 20px 22px;\n  border: 1px solid rgba(245, 158, 11, 0.45);\n  border-radius: var(--tl-radius);\n  background: rgba(245, 158, 11, 0.06);\n  color: var(--tl-ink-2);\n  font-size: 15px;\n  line-height: 1.55;\n}\n\n.now-give-h {\n  margin: 0 0 8px;\n  color: var(--now-op);\n  font-size: 18px;\n}\n\n.now-give-steps { margin: 10px 0; padding-left: 20px; }\n.now-give-note { color: var(--tl-ink-3); font-size: 13px; }\n\n.now-give-btn {\n  display: inline-block;\n  margin-top: 8px;\n  padding: 10px 16px;\n  border-radius: 999px;\n  background: var(--now-op);\n  color: #1a1206;\n  font-weight: 700;\n  text-decoration: none;\n}\n\n.now-give-btn:hover,\n.now-give-btn:focus-visible { background: #fbbf24; }\n\n@media (max-width: 760px) {\n  .now-usage-wrap { grid-template-columns: 1fr; }\n}\n"
text sap4 "assets/learn.css"
text sab4 "/* The learning guide is a long-form reading surface, not a card dashboard. */\n.learn-page {\n  --learn-ink: #0d1117;\n  --learn-paper: #eee5d4;\n  --learn-copper: #d6aa7a;\n  --learn-muted: #b4b8bf;\n  --learn-rule: #39404a;\n  max-width: 1160px;\n  margin: 0 auto;\n  padding: 0 36px 88px;\n  color: var(--learn-paper);\n  font-family: ui-sans-serif, system-ui, sans-serif;\n  font-size: 17px;\n  line-height: 1.75;\n}\n.learn-page * { box-sizing: border-box; }\n.learn-page a {\n  color: var(--learn-copper);\n  text-decoration: underline;\n  text-decoration-thickness: 1px;\n  text-underline-offset: .22em;\n}\n.learn-page a:hover { color: #fff5e3; }\n.learn-page :focus-visible { outline: 2px solid var(--learn-copper); outline-offset: 5px; }\n.learn-page p { margin: 0 0 1.2em; }\n.learn-page h1,\n.learn-page h2,\n.learn-page h3 { color: var(--learn-paper); text-wrap: balance; }\n.learn-page .learn-eyebrow {\n  color: var(--learn-copper);\n  font: 500 11px/1.7 ui-monospace, SFMono-Regular, Consolas, monospace;\n  letter-spacing: .15em;\n  text-transform: uppercase;\n  margin-bottom: 22px;\n}\n.learn-intro {\n  position: relative;\n  isolation: isolate;\n  padding: 84px 0 76px;\n  border-bottom: 1px solid var(--learn-rule);\n}\n.learn-intro h1 {\n  position: relative;\n  z-index: 1;\n  font-family: Georgia, 'Times New Roman', serif;\n  font-weight: 400;\n  font-size: clamp(70px, 11vw, 144px);\n  line-height: .94;\n  letter-spacing: -.065em;\n  margin: 0 0 38px;\n}\n.learn-page .learn-lede {\n  position: relative;\n  z-index: 1;\n  max-width: 680px;\n  font-size: clamp(20px, 2.4vw, 25px);\n  line-height: 1.6;\n}\n.learn-invitation { max-width: 640px; color: var(--learn-muted); }\n.learn-jump { display: flex; flex-wrap: wrap; gap: 12px 30px; margin-top: 32px; font-size: 14px; }\n.learn-orbit {\n  position: absolute;\n  z-index: -1;\n  top: 80px;\n  right: 6px;\n  width: 290px;\n  height: 290px;\n  pointer-events: none;\n  border: 1px solid #4a4036;\n  border-radius: 50%;\n  background: radial-gradient(circle at 37% 35%, #282825, #111821 56%, #0d1117 72%);\n  opacity: .65;\n}\n.learn-orbit-ring {\n  position: absolute;\n  inset: 32% -20%;\n  border: 1px solid #806749;\n  border-radius: 50%;\n  transform: rotate(-32deg);\n}\n.learn-orbit-dot {\n  position: absolute;\n  top: 17%;\n  right: 13%;\n  width: 6px;\n  height: 6px;\n  background: var(--learn-copper);\n  border-radius: 50%;\n  box-shadow: 0 0 20px #d6aa7a66;\n}\n.learn-section {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);\n  gap: 60px;\n  padding: 64px 0;\n  border-bottom: 1px solid var(--learn-rule);\n  scroll-margin-top: 96px;\n}\n.learn-margin h2 {\n  font-family: Georgia, 'Times New Roman', serif;\n  font-weight: 400;\n  font-size: 36px;\n  line-height: 1.15;\n  letter-spacing: -.03em;\n  margin: 0 0 24px;\n}\n.learn-margin > p:not(.learn-eyebrow) { color: var(--learn-muted); font-size: 15px; }\n.learn-page h3 { font-size: 20px; line-height: 1.45; font-weight: 550; margin: 0 0 12px; }\n.learn-steps { list-style: none; counter-reset: learn-step; margin: 0; padding: 0 0 0 36px; }\n.learn-steps li { position: relative; counter-increment: learn-step; margin-bottom: 34px; }\n.learn-steps li:last-child { margin-bottom: 0; }\n.learn-steps li::before {\n  content: counter(learn-step, decimal-leading-zero);\n  position: absolute;\n  left: -36px;\n  top: 4px;\n  font: 12px/1.7 ui-monospace, SFMono-Regular, Consolas, monospace;\n  color: var(--learn-copper);\n}\n.learn-steps p,\n.learn-example > p,\n.learn-watch > p { color: #c4c5c8; }\n.learn-brief { min-width: 0; }\n.learn-page .learn-caption { color: var(--learn-copper); font-size: 13px; margin-bottom: 16px; }\n.learn-brief pre {\n  margin: 0;\n  padding: 12px 0 12px 24px;\n  border: 0;\n  border-left: 2px solid var(--learn-copper);\n  border-radius: 0;\n  background: transparent;\n  color: var(--learn-paper);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  tab-size: 2;\n  user-select: text;\n}\n.learn-brief code {\n  padding: 0;\n  background: transparent;\n  color: inherit;\n  font: 13px/1.85 ui-monospace, SFMono-Regular, Consolas, monospace;\n}\n.learn-page .learn-example-label { border-left: 2px solid var(--learn-copper); padding-left: 16px; }\n.learn-page dl { margin: 26px 0; }\n.learn-page dt { color: var(--learn-copper); font-size: 14px; font-weight: 600; margin-top: 25px; }\n.learn-page dd { margin: 8px 0 0; }\n.learn-example blockquote {\n  margin: 0;\n  padding: 0;\n  border: 0;\n  font-family: Georgia, 'Times New Roman', serif;\n  font-size: 22px;\n  font-style: normal;\n  line-height: 1.6;\n  color: var(--learn-paper);\n}\n.learn-terms { border-top: 1px solid var(--learn-rule); border-bottom: 1px solid var(--learn-rule); padding-bottom: 24px; }\n.learn-terms dd { color: #c4c5c8; }\n.learn-text-link { display: inline-block; margin-bottom: 12px; }\n.learn-outro { max-width: 760px; padding-top: 64px; }\n.learn-outro h2 { font: 400 clamp(32px, 5vw, 48px)/1.2 Georgia, 'Times New Roman', serif; letter-spacing: -.035em; margin: 0 0 26px; }\n.learn-outro > p:not(.learn-eyebrow) { color: var(--learn-muted); }\n.learn-source-links { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; font-size: 14px; padding-top: 16px; }\n@media (max-width: 760px) {\n  .learn-page { padding: 0 24px 64px; font-size: 16px; }\n  .learn-intro { padding: 55px 0 44px; }\n  .learn-orbit { width: 180px; height: 180px; right: 15px; top: 65px; opacity: .3; }\n  .learn-section { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 44px 0; }\n  .learn-margin { max-width: 580px; }\n  .learn-margin h2 { font-size: 32px; }\n  .learn-margin > p:not(.learn-eyebrow) { font-size: 16px; }\n  .learn-brief pre { padding-left: 16px; }\n  .learn-steps { padding-left: 30px; }\n  .learn-steps li::before { left: -30px; }\n  .learn-outro { padding-top: 44px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .learn-page { scroll-behavior: auto; }\n}\n@media (forced-colors: active) {\n  .learn-orbit { display: none; }\n  .learn-page { --learn-paper: CanvasText; --learn-copper: LinkText; --learn-muted: CanvasText; --learn-rule: CanvasText; }\n  .learn-page p, .learn-page dd { color: CanvasText; }\n}\n"
text sap5 "assets/machines.css"
text sab5 "/*\n * The machines and the speeds (components/machines.rs). Sits inside the\n * Turing look (turing-look.css): near-black field, blue and green glow,\n * mono kickers, heavy headings, rounded cards that lift. Green marks a\n * number that is on main; blue marks a branch. Nothing here is compared\n * with anything but the machine's ceiling and our own previous run.\n */\n.mx-section {\n  padding: 96px 0;\n  border-bottom: 1px solid var(--tl-line);\n}\n\n.mx-section .container {\n  max-width: 1200px;\n}\n\n.mx-head {\n  max-width: 820px;\n  margin-bottom: 40px;\n}\n\n.mx-h2 {\n  font-size: clamp(30px, 4.4vw, 46px);\n  font-weight: 800;\n  letter-spacing: -0.025em;\n  line-height: 1.1;\n  color: var(--tl-ink);\n}\n\n.mx-lead {\n  margin-top: 16px;\n  font-size: 17px;\n  line-height: 1.65;\n  color: var(--tl-ink-2);\n}\n\n.mx-stamp,\n.mx-judging {\n  margin-top: 24px;\n  font-size: 13.5px;\n  line-height: 1.6;\n  color: var(--tl-ink-3);\n  max-width: 920px;\n}\n\n.mx-judging {\n  margin-top: 28px;\n  font-size: 15.5px;\n  color: var(--tl-ink-2);\n  padding-left: 16px;\n  border-left: 2px solid var(--tl-green);\n}\n\n.mx-stamp .mono,\n.mx-judging .mono {\n  color: var(--tl-ink-2);\n}\n\n.mx-stamp a,\n.mx-judging a,\n.mx-td-ceiling a,\n.mx-hero-l a {\n  color: var(--tl-blue-soft);\n  text-decoration: none;\n  border-bottom: 1px solid rgba(125, 180, 255, 0.35);\n}\n\n/* ---------- machine cards ---------- */\n.mx-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));\n  gap: 18px;\n}\n\n.mx-card {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 26px 26px 22px;\n  background: var(--tl-card);\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.mx-card:hover {\n  border-color: var(--tl-blue);\n  transform: translateY(-4px);\n  box-shadow: 0 18px 50px rgba(45, 127, 249, 0.14);\n}\n\n.mx-name {\n  font-size: 21px;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  line-height: 1.15;\n  color: var(--tl-ink);\n}\n\n.mx-detail {\n  margin-top: 6px;\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  letter-spacing: 0.04em;\n  color: var(--tl-ink-3);\n  line-height: 1.5;\n}\n\n.mx-role {\n  font-size: 15px;\n  line-height: 1.6;\n  color: var(--tl-ink);\n}\n\n.mx-facts {\n  margin: 0;\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 8px 14px;\n  font-size: 13.5px;\n  line-height: 1.55;\n  color: var(--tl-ink-2);\n}\n\n.mx-facts dt {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--tl-blue);\n  padding-top: 3px;\n  white-space: nowrap;\n}\n\n.mx-facts dd {\n  margin: 0;\n}\n\n.mx-date {\n  color: var(--tl-ink);\n  font-weight: 600;\n}\n\n.mx-card-foot {\n  margin-top: auto;\n  padding-top: 16px;\n  border-top: 1px solid var(--tl-line);\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px 14px;\n  font-size: 12.5px;\n}\n\n/* The receipt's name (folder, file or PR). The link is the box itself. */\n.mx-receipt {\n  display: inline;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: var(--tl-ink);\n  overflow-wrap: anywhere;\n}\n\n.mx-card .box-link {\n  margin-top: 14px;\n}\n\n.mx-td-receipt .box-link {\n  display: inline-flex;\n  margin-top: 8px;\n}\n\n.mx-where {\n  display: inline-block;\n  padding: 2px 9px;\n  border-radius: 999px;\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.mx-where-main {\n  color: var(--tl-green);\n  border: 1px solid rgba(0, 229, 153, 0.4);\n}\n\n.mx-where-branch {\n  color: var(--tl-blue-soft);\n  border: 1px solid rgba(125, 180, 255, 0.4);\n  text-transform: none;\n  letter-spacing: 0.03em;\n}\n\n.mx-more {\n  flex-basis: 100%;\n  font-size: 12.5px;\n  line-height: 1.7;\n  color: var(--tl-ink-3);\n}\n\n.mx-more a {\n  color: var(--tl-ink-2);\n  text-decoration: none;\n  border-bottom: 1px solid var(--tl-line-2);\n}\n\n.mx-more a:hover {\n  color: var(--tl-ink);\n  border-color: var(--tl-blue);\n}\n\n/* The same cards at the top of /machine/, inside the narrow column. */\n.mx-on-narr .mx-grid {\n  grid-template-columns: 1fr;\n  margin-top: 28px;\n}\n\n.mx-on-narr .mx-card {\n  padding: 22px 24px 20px;\n}\n\n/* ---------- speed hero ---------- */\n.mx-speed {\n  background:\n    radial-gradient(ellipse 50% 28rem at 15% 20%, rgba(0, 229, 153, 0.06), transparent 70%);\n}\n\n.mx-hero {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 18px;\n  padding: 30px 32px;\n  margin-bottom: 28px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: linear-gradient(135deg, rgba(45, 127, 249, 0.1), rgba(0, 229, 153, 0.06)), var(--tl-card);\n}\n\n.mx-hero-n,\n.mx-hero-c,\n.mx-hero-p {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.mx-hero-value {\n  display: block;\n  white-space: nowrap;\n  font-size: clamp(34px, 4.2vw, 52px);\n  font-weight: 600;\n  letter-spacing: -0.03em;\n  line-height: 1;\n  color: var(--tl-green);\n  text-shadow: 0 0 28px rgba(0, 229, 153, 0.35);\n}\n\n.mx-hero-frac {\n  color: var(--tl-blue-soft);\n  text-shadow: 0 0 28px rgba(45, 127, 249, 0.35);\n}\n\n.mx-hero-prev .mx-hero-value {\n  color: var(--tl-ink-2);\n  text-shadow: none;\n}\n\n.mx-unit {\n  font-size: 0.42em;\n  font-weight: 500;\n  letter-spacing: 0;\n  color: var(--tl-ink-3);\n  text-shadow: none;\n}\n\n.mx-hero-l {\n  font-size: 13px;\n  line-height: 1.5;\n  color: var(--tl-ink-3);\n}\n\n.mx-hero-r {\n  grid-column: 1 / -1;\n  display: inline-flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px;\n  padding-top: 16px;\n  border-top: 1px solid var(--tl-line);\n  font-family: var(--font-mono);\n  font-size: 12.5px;\n  font-weight: 700;\n  color: var(--tl-green);\n  text-decoration: none;\n}\n\n.mx-hero-r:hover {\n  text-decoration: underline;\n}\n\n/* ---------- speed table ---------- */\n.mx-table-wrap {\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: var(--tl-card);\n  overflow-x: auto;\n}\n\n.mx-table {\n  width: 100%;\n  table-layout: fixed;\n  border-collapse: collapse;\n  font-size: 13px;\n  line-height: 1.5;\n  color: var(--tl-ink-2);\n}\n\n.mx-table th {\n  text-align: left;\n  padding: 14px 14px;\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  font-weight: 500;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--tl-ink-3);\n  border-bottom: 1px solid var(--tl-line);\n  background: rgba(8, 9, 12, 0.5);\n}\n\n.mx-table td {\n  padding: 16px 14px;\n  vertical-align: top;\n  border-bottom: 1px solid var(--tl-line);\n}\n\n.mx-table tr:last-child td {\n  border-bottom: 0;\n}\n\n.mx-table tbody tr:hover td {\n  background: rgba(45, 127, 249, 0.05);\n}\n\n.mx-row:first-child td {\n  background: rgba(0, 229, 153, 0.04);\n}\n\n.mx-what {\n  display: block;\n  font-weight: 700;\n  color: var(--tl-ink);\n}\n\n.mx-model {\n  display: block;\n  margin-top: 3px;\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  color: var(--tl-ink-3);\n}\n\n.mx-value {\n  display: block;\n  font-size: 17px;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n  color: var(--tl-ink);\n}\n\n.mx-row:first-child .mx-value {\n  color: var(--tl-green);\n}\n\n.mx-sub {\n  display: block;\n  margin-top: 4px;\n  font-size: 12px;\n  line-height: 1.5;\n  color: var(--tl-ink-3);\n}\n\n.mx-none {\n  font-style: italic;\n}\n\n.mx-verdict {\n  display: block;\n  margin-top: 6px;\n  font-size: 12px;\n  line-height: 1.5;\n  color: var(--tl-amber);\n}\n\n.mx-td-ceiling .mono {\n  font-size: 16px;\n  color: var(--tl-blue-soft);\n}\n\n.mx-td-date {\n  white-space: nowrap;\n  color: var(--tl-ink-2);\n}\n\n.mx-td-receipt .mx-receipt {\n  display: inline;\n  overflow-wrap: anywhere;\n}\n\n.mx-td-receipt .mx-where {\n  display: inline-block;\n  margin-top: 8px;\n  white-space: normal;\n  overflow-wrap: anywhere;\n}\n\n.mx-table th:nth-child(1) { width: 17%; }\n.mx-table th:nth-child(2) { width: 16%; }\n.mx-table th:nth-child(3) { width: 21%; }\n.mx-table th:nth-child(4) { width: 10%; }\n.mx-table th:nth-child(5) { width: 13%; }\n.mx-table th:nth-child(6) { width: 8%; }\n.mx-table th:nth-child(7) { width: 15%; }\n\n/* On a phone the table becomes a stack of cards, one per row, each cell\n   labelled by its column name. */\n@media (max-width: 900px) {\n  .mx-table thead {\n    display: none;\n  }\n\n  .mx-table,\n  .mx-table tbody,\n  .mx-table tr,\n  .mx-table td {\n    display: block;\n    width: 100%;\n    min-width: 0;\n  }\n\n  .mx-table tr {\n    padding: 8px 0;\n    border-bottom: 1px solid var(--tl-line);\n  }\n\n  .mx-table tr:last-child {\n    border-bottom: 0;\n  }\n\n  .mx-table td {\n    padding: 8px 18px;\n    border-bottom: 0;\n  }\n\n  .mx-table td::before {\n    content: attr(data-label);\n    display: block;\n    margin-bottom: 3px;\n    font-family: var(--font-mono);\n    font-size: 10px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--tl-blue);\n  }\n\n  .mx-td-what::before {\n    display: none;\n  }\n\n  .mx-td-what {\n    padding-top: 14px;\n  }\n\n  .mx-td-receipt {\n    padding-bottom: 14px;\n  }\n\n  .mx-table tbody tr:hover td,\n  .mx-row:first-child td {\n    background: transparent;\n  }\n\n  .mx-hero {\n    padding: 24px 20px;\n  }\n\n  .mx-section {\n    padding: 56px 0;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .mx-card {\n    transition: none;\n  }\n}\n"
text sap6 "assets/hive.css"
text sab6 "/* Hive layout and look. Structure comes from om/hive-page/hive.om; this file\n   places it. Two layers live here and they are read in that order: layout and\n   state first (the bounded panels, the branch disclosure, the row grid, the\n   status pill and model chip, tabular numbers, the clamped activity line, the\n   focus rings), then the presentation layer at the end of the file (the\n   masthead scene, its scrim, the display type scale and the softer radii).\n   Palette tokens from assets/style.css only: no local hex, no bespoke near\n   black. Motion is compositor only, one transform transition, removed for\n   prefers-reduced-motion and whenever the page's own motion control is off.\n   The masthead scene is Allen's two black holes: its markup, its samples and\n   every keyframe of it are emitted by the Omega program into\n   om/hive-page/main.html, and this file only places the stage and paints the\n   discs. It animates nothing of its own. */\n.hive {\n  --hive-h1: clamp(2.4rem, 5.4vw, 4rem);\n  --hive-h2: clamp(1.2rem, 1.4vw, 1.45rem);\n  --hive-row: 0.95rem;\n  --hive-body: 0.85rem;\n  --hive-label: 0.7rem;\n  --hive-micro: 0.66rem;\n  /* Height of the sticky site header, consumed by the sticky side panel. */\n  --hive-nav: 0px;\n  --hive-scroll: clamp(360px, 74vh, 880px);\n  max-width: 1320px;\n  margin: 0 auto;\n  padding: 32px 5vw 72px;\n  color: var(--text-primary);\n  font-family: var(--font-sans);\n}\n\n/* The site header is sticky from this width up, so the sticky side panel\n   starts below it instead of sliding under it. */\n@media (min-width: 1100px) {\n  .hive { --hive-nav: 133px; }\n}\n\n.hive [hidden] { display: none !important; }\n\n/* The masthead is one block of prose beside nothing: no scene, no stage. */\n.hive-masthead { max-width: 68ch; margin-bottom: 32px; }\n.hive h1 { font-size: var(--hive-h1); font-weight: 600; line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 16px; }\n.hive h2 { font-size: var(--hive-h2); font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; margin: 0; }\n.hive h3 { font-family: var(--font-mono); font-size: var(--hive-label); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin: 18px 0 6px; }\n.hive p { margin: 0; line-height: 1.6; }\n.hive a { color: var(--accent-blue); text-underline-offset: 4px; }\n.hive-period { color: var(--text-muted); }\n\n/* Labels: mono, quiet, and never wider than the value they introduce. */\n.hive-eyebrow { font-family: var(--font-mono); font-size: var(--hive-label); letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 6px; }\n.hive-small, .hive-source-note, .hive-state { font-family: var(--font-mono); font-size: var(--hive-micro); line-height: 1.55; color: var(--text-muted); font-variant-numeric: tabular-nums; }\n.hive-intro { font-size: 1.15rem; max-width: 46ch; margin-bottom: 12px; }\n.hive-welcome { max-width: 62ch; color: var(--text-secondary); }\n.hive-learn { display: inline-block; margin-top: 16px; }\n\n.hive-jumps { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 12px 0; margin-bottom: 24px; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }\n.hive-jumps a { color: var(--text-secondary); font-size: var(--hive-body); text-decoration: none; }\n.hive-jumps a:hover { color: var(--accent-blue); }\n\n/* Sections are placed by the grid, not by their markup order, so the section\n   list, its order and its width class stay a hive.om decision. One panel per\n   region, one 1px separator inside it, and no card nested in a card. */\n.hive-sections { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 380px); gap: 20px; align-items: start; }\n.hive-section { min-width: 0; padding: 18px 20px; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-surface); }\n.hive-section-full { grid-column: 1 / -1; }\n.hive-section-main { grid-column: 1; }\n.hive-section-narrow { grid-column: 2; }\n.hive-note { color: var(--text-secondary); font-size: var(--hive-body); line-height: 1.55; margin: 8px 0 0; max-width: 74ch; }\n.hive-section > .hive-eyebrow + h2 + .hive-note { margin-bottom: 14px; }\n\n/* A bounded panel: the head stays, the body is the only scroll box, so a fleet\n   of hundreds of agents is one viewport tall instead of thousands of pixels. */\n.hive-section.hive-panel { display: flex; flex-direction: column; max-height: var(--hive-scroll); padding: 0; overflow: hidden; }\n.hive-panel-head { position: sticky; top: 0; flex: 0 0 auto; z-index: 2; padding: 16px 18px 0; background: var(--bg-surface); }\n.hive-panel-head .hive-note { margin-bottom: 0; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle); }\n.hive-panel-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 18px 16px; scroll-padding-top: 76px; }\n.hive-panel-body > * + * { margin-top: 12px; }\n.hive-section-narrow { position: sticky; top: calc(var(--hive-nav) + 12px); } /* While the manifest is\n   shorter than the missions panel it pins at that offset and stays readable as the reader moves\n   through the row; the bounded panels are what keep both on screen. */\n\n/* The missions tools ride at the top of the scroll box, so search is reachable\n   while the tree scrolls under it. */\n.hive-tools { position: sticky; top: 0; z-index: 1; padding: 10px 0 8px; background: var(--bg-surface); border-bottom: 1px solid var(--border-subtle); }\n.hive-search { display: grid; gap: 5px; max-width: 44ch; }\n.hive-search label { font-family: var(--font-mono); font-size: var(--hive-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }\n.hive-tools .hive-small { margin-top: 6px; }\n\n/* Status and freshness strip: two quiet columns of label and value. */\n.hive-times, .hive-fields { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 3px 16px; margin: 0; }\n.hive-times dt, .hive-fields dt { font-family: var(--font-mono); font-size: var(--hive-micro); color: var(--text-muted); }\n.hive-times dd, .hive-fields dd { margin: 0; font-family: var(--font-mono); font-size: var(--hive-micro); color: var(--text-secondary); overflow-wrap: anywhere; }\n.hive-times dd time, .hive-fields dd time, .hive-message-who time { font-variant-numeric: tabular-nums; }\n.hive-strip-status { display: grid; gap: 4px; }\n.hive-connection { font-size: var(--hive-body); color: var(--text-secondary); }\n.hive-counts { font-family: var(--font-mono); font-size: var(--hive-micro); color: var(--text-secondary); }\n.hive-coverage { font-family: var(--font-mono); font-size: var(--hive-micro); line-height: 1.55; color: var(--text-secondary); border-left: 2px solid var(--border-subtle); padding-left: 10px; }\n.hive-coverage[data-complete=\"false\"] { border-left-color: var(--accent-amber); }\n/* Rewritten every second: clamped so the strip cannot reflow under the pointer. */\n.hive-connection, .hive-counts, .hive-coverage, .hive-strip-status .hive-small {\n  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;\n}\n\n.hive button, .hive input { font: inherit; }\n.hive button { color: var(--text-primary); background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 3px; padding: 6px 10px; min-height: 34px; font-size: var(--hive-body); cursor: pointer; }\n.hive button:hover { border-color: var(--text-muted); }\n.hive button[aria-pressed=\"true\"] { border-color: var(--accent-blue); color: var(--accent-blue); }\n.hive button:disabled { color: var(--text-muted); cursor: default; }\n.hive button:disabled:hover { border-color: var(--border-subtle); }\n.hive :is(a, button, input, [tabindex]):focus-visible { outline: 2px solid var(--accent-green); outline-offset: 2px; border-radius: 2px; }\n.hive input { color: var(--text-primary); background: var(--bg-base); border: 1px solid var(--border-subtle); border-radius: 3px; padding: 6px 9px; width: 100%; font-size: var(--hive-body); }\n.hive input::placeholder { color: var(--text-muted); }\n\n/* The mission tree. One 1px separator per row and one indentation rail per\n   level carry the hierarchy; nothing else decorates a row. */\n.hive-tree, .hive-children { list-style: none; margin: 0; padding: 0; }\n.hive-children { margin-left: 10px; padding-left: 10px; border-left: 1px solid var(--border-subtle); }\n.hive-node[hidden] { display: none !important; }\n.hive-record {\n  position: relative;\n  display: grid;\n  grid-template-columns: 2.2rem minmax(0, 1fr) max-content max-content max-content;\n  gap: 3px 10px;\n  align-items: baseline;\n  padding: 6px 10px;\n  margin: 0 -10px;\n  border-bottom: 1px solid var(--border-subtle);\n  border-radius: 3px 3px 0 0;\n}\n.hive-record:hover { background: var(--bg-card-hover); }\nsummary.hive-record { list-style: none; cursor: pointer; }\nsummary.hive-record::-webkit-details-marker { display: none; }\nsummary.hive-record::before { content: \"\"; grid-area: 1 / 1; width: 5px; height: 5px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(-45deg); transition: transform 140ms ease-out; }\ndetails[open] > summary.hive-record::before { transform: rotate(45deg); }\n.hive .hive-select { grid-area: 1 / 2; text-align: left; font-size: var(--hive-row); font-weight: 600; line-height: 1.35; color: var(--text-primary); background: transparent; border: 0; padding: 0; min-height: 0; overflow-wrap: anywhere; }\n.hive-select:hover { border-color: transparent; color: var(--accent-blue); }\n.hive-pill { grid-area: 1 / 3; font-family: var(--font-mono); font-size: var(--hive-micro); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; color: var(--text-muted); border: 1px solid var(--border-subtle); border-radius: 999px; padding: 1px 8px; }\n.hive-chip { grid-area: 1 / 4; font-family: var(--font-mono); font-size: var(--hive-micro); color: var(--text-secondary); background: var(--bg-base); border-radius: 3px; padding: 1px 6px; min-width: 0; max-width: 28ch; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.hive-elapsed { grid-area: 1 / 5; font-family: var(--font-mono); font-size: var(--hive-micro); color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 5ch; text-align: right; }\n/* Rewritten as the source advances: two fixed lines, so the row never resizes\n   and the pointer never falls off the row it is over. */\n.hive-activity { grid-area: 2 / 2 / 3 / -1; font-size: var(--hive-body); line-height: 1.4; color: var(--text-secondary); overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; min-height: calc(1.4em * 2); }\n.hive-node[data-selected=\"true\"] > details > .hive-record { background: var(--bg-card); }\n.hive-node[data-selected=\"true\"] > details > .hive-record .hive-select { color: var(--accent-blue); }\n.hive-empty { color: var(--text-muted); font-size: var(--hive-body); line-height: 1.55; }\n\n/* Selected-agent manifest: label and value pairs, no cards inside it. */\n.hive-manifest-name { font-size: 1rem; font-weight: 600; line-height: 1.35; margin: 12px 0 14px; overflow-wrap: anywhere; }\n.hive-work { color: var(--text-secondary); font-size: var(--hive-body); overflow-wrap: anywhere; }\n.hive-family { display: flex; flex-wrap: wrap; gap: 5px 14px; }\n.hive-family-link { font-family: var(--font-mono); font-size: var(--hive-micro); }\n.hive-panel-body #hive-show-selected { margin-top: 14px; }\n\n/* The message feed. Only the list scrolls, and the page never jumps with it. */\n.hive-conversation-controls { display: flex; flex-wrap: wrap; gap: 8px; }\n.hive-chat { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-height: min(60vh, 520px); overflow-y: auto; overscroll-behavior: contain; }\n.hive-chat:focus-visible { outline: 2px solid var(--accent-green); outline-offset: 4px; }\n.hive-message { display: grid; gap: 3px; padding: 8px 10px 8px 12px; border-left: 2px solid var(--border-subtle); }\n.hive-message[data-role=\"drake\"] { border-left-color: var(--accent-blue); }\n.hive-message-who { display: flex; flex-wrap: wrap; gap: 3px 12px; font-family: var(--font-mono); font-size: var(--hive-micro); color: var(--text-muted); }\n.hive-message-who strong { color: var(--text-primary); font-weight: 600; }\n.hive-message-text { color: var(--text-secondary); font-size: var(--hive-body); overflow-wrap: anywhere; white-space: pre-wrap; }\n\n.hive-closing { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border-subtle); }\n.hive-closing p { color: var(--text-muted); }\n\n@media (max-width: 900px) {\n  .hive { padding: 24px 4vw 56px; --hive-scroll: clamp(320px, 68vh, 640px); }\n  .hive-sections { grid-template-columns: minmax(0, 1fr); gap: 16px; }\n  .hive-section-full, .hive-section-main, .hive-section-narrow { grid-column: 1; }\n  .hive-section-narrow { position: static; }\n  .hive-section { padding: 16px; }\n  .hive-section.hive-panel { padding: 0; }\n  .hive-panel-head { padding: 14px 14px 0; }\n  .hive-panel-body { padding: 0 14px 14px; }\n  .hive-record { grid-template-columns: 2rem minmax(0, 1fr) max-content; column-gap: 8px; padding: 6px 8px; margin: 0 -8px; }\n  .hive .hive-select { grid-area: 1 / 2; }\n  .hive-pill { grid-area: 1 / 3; }\n  .hive-chip { grid-area: 2 / 2 / 3 / 3; max-width: 100%; justify-self: start; }\n  .hive-elapsed { grid-area: 2 / 3 / 3 / 4; }\n  .hive-activity { grid-area: 3 / 2 / 4 / -1; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hive *, .hive *::before, .hive *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }\n}\n\n.hive:not(:has(#hive-motion:checked)) *, .hive:not(:has(#hive-motion:checked)) *::before, .hive:not(:has(#hive-motion:checked)) *::after {\n  transition: none !important;\n  animation: none !important;\n  scroll-behavior: auto !important;\n}\n\n/* Presentation layer, from #91. The sky is decorative: it never encodes agent\n   position, progress, topology or live activity, and it is inert (no script,\n   no animation, no external reference). Where a rule here collided with the\n   bounded panels or the row grid, the structure won: the record grid, the\n   panel scroll boxes and the manifest offset are set once, in the sections\n   above. */\n.hive { max-width:1600px; padding:22px 4vw 80px; }\n.hive *, .hive *::before, .hive *::after { box-sizing:border-box; }\n/* The sky sits behind the whole page, not inside a band: one fixed layer the\n   size of the viewport, so it has no edge to show and never scrolls. A fixed,\n   composited layer is rasterised once and only moved by the compositor;\n   the old band was a cover-sized layer at half opacity under a gradient scrim\n   that was repainted with the holes, which read as faded and flickering.\n   No negative z-index: under isolation Chromium rebuilt that layer on\n   scroll. The layer is at 0 and every child of .hive is lifted to 1. */\n.hive::before {\n  content:\"\"; position:fixed; inset:0; z-index:0; pointer-events:none;\n  background:url('/assets/hive-universe.svg') 60% 45% / cover no-repeat;\n  transform:translateZ(0); will-change:transform;\n}\n.hive > * { position:relative; z-index:1; }\n/* The site footer and, below 1100px, the site header (sticky only above it)\n   follow the static flow, so the fixed sky would paint over them; this sheet\n   only loads on /hive/, so lifting them here is local. */\n.aien-footer { position:relative; z-index:1; }\n@media (max-width:1099px) { .aien-header { position:relative; z-index:50; } }\n/* The jumps and the closing line are the only prose outside a section, scrim\n   or opaque card, so they get the sections' 86% --bg-surface glass rather\n   than sitting straight on the sky's bright core. */\n.hive-jumps { margin-bottom:0; border-top:0; padding:14px 18px; gap:12px 30px; border-radius:12px; background:color-mix(in srgb, var(--bg-surface) 86%, transparent); }\n.hive-closing { padding:16px 18px; border-radius:12px; background:color-mix(in srgb, var(--bg-surface) 86%, transparent); }\n.hive-jumps a { font-size:.73rem; letter-spacing:.04em; }\n.hive-masthead {\n  position:relative; overflow:hidden;\n  max-width:none; min-height:520px; margin:0 -4vw 36px;\n  padding:80px 8vw 72px; display:flex; flex-direction:column; justify-content:center;\n}\n\n/* The scene: Allen's two black holes (native/kernel/ui/night.c and chirp.c,\n   ported by om/hive-page/hive.om). The markup, the samples and every keyframe\n   come from that program; this block only places the stage and paints the\n   discs, and it animates nothing. The emitted <style> in the artifact\n   attaches the animations, inside a prefers-reduced-motion:no-preference\n   query and behind the native motion checkbox, so with motion off the\n   base values below are what the reader sees: one frame of the sequence, the\n   two holes at a visible separation (t = 7000 ms of the 19000 ms cycle), no\n   merged hole and no ripple.\n   Units: 1em is one unit of Allen's picture (a0 is 270 of them), and the\n   scene's font-size is that unit, so the whole scene scales on one number. */\n.hive-masthead > .hive-scene {\n  position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none;\n  font-size:var(--hive-u,1px); contain:paint;\n}\n.hive-stage { position:absolute; left:74%; top:44%; width:0; height:0; }\n.hive-hole, .hive-merge {\n  position:absolute; left:0; top:0; width:0; height:0;\n  transform:translateZ(0); will-change:transform;\n}\n/* The bend: the region whose light a hole bends (night.c's Einstein radius,\n   60 units). A page cannot warp starlight with a transform, so the timing of\n   this halo is Allen's, the 2600 to 5200 ms ramp, and the shape is the\n   page's: it is the one place the scene simplifies. */\n.hive-bend, .hive-mglow {\n  position:absolute; left:0; top:0; border-radius:50%;\n  background:radial-gradient(circle closest-side,\n    color-mix(in srgb, var(--accent-blue) 20%, transparent) 0%,\n    color-mix(in srgb, var(--accent-blue) 8%, transparent) 46%,\n    transparent 74%);\n}\n.hive-bend { width:180em; height:180em; margin:-90em 0 0 -90em; }\n.hive-mglow { width:254em; height:254em; margin:-127em 0 0 -127em; }\n/* The shadow: night.c draws an opaque disc of radius rs (20 units), a thin\n   ring at 1.04 rs, and a glow that dies out by 1.5 rs. The box is 60em\n   across, 3 rs, so each stop below is one of those radii as a share of the\n   box, and scaling the box scales all three together. */\n.hive-plate, .hive-mplate {\n  position:absolute; left:0; top:0; width:60em; height:60em; margin:-30em 0 0 -30em;\n  border-radius:50%;\n  background:radial-gradient(circle closest-side,\n    var(--bg-base) 0 65.8%,\n    color-mix(in srgb, var(--accent-amber) 62%, var(--text-primary)) 68.9% 69.7%,\n    color-mix(in srgb, var(--accent-amber) 30%, transparent) 70.6%,\n    transparent 100%);\n}\n/* The ring that wobbles after the merger, inside the merged shadow's own\n   scale so it always sits just outside the shadow it belongs to. */\n.hive-ring {\n  position:absolute; inset:0; border-radius:50%;\n  background:radial-gradient(circle closest-side, transparent 0 66.4%,\n    color-mix(in srgb, var(--text-primary) 56%, transparent) 68.6% 70%,\n    transparent 72%);\n}\n/* The ripple: one circle from the merge point, out to 1000 units, drawn in\n   night.c's shape (a band a tenth of the radius wide) and its envelope. */\n.hive-ripple {\n  position:absolute; left:0; top:0; width:2em; height:2em; margin:-1em 0 0 -1em;\n  border-radius:50%;\n  background:radial-gradient(circle closest-side, transparent 0 64%,\n    color-mix(in srgb, var(--accent-blue) 34%, transparent) 82% 94%,\n    transparent 100%);\n}\n/* The two parts that exist only after the merger. With motion off the frame is\n   the pair, so both stay hidden; the emitted keyframes are what turn them on,\n   and they win over these declarations while they run. */\n.hive-merge, .hive-ripple { opacity:0; }\n@media (max-width:600px) {\n  /* The prose is bottom aligned on a phone, so the pair rides in the upper\n     fifth: at 0.86 of the unit the discs bottom out at about 457 CSS px, above\n     the first line at 464, and the scrim over the prose is untouched. */\n  .hive-masthead > .hive-scene { --hive-u:.86px; }\n  .hive-stage { left:50%; top:15%; }\n}\n.hive-masthead > * { position:relative; z-index:2; }\n/* Scrim. The prose always sits over --bg-base at a token-derived alpha, never\n   straight over the sky. It is an ellipse that dies out to transparent on\n   every side, so the band has no top, bottom or right edge: the sky runs\n   straight through. Inside the inner 68% of the ellipse (where the prose is)\n   it stays at 0.90 or more of --bg-base, and against the brightest pixel the\n   sky could produce (white) 0.90 leaves --text-primary at 14.7:1,\n   --text-secondary at 6.2:1 and --text-muted at 6.0:1.\n   scripts/test-hive-cosmic.py checks the stop contract. */\n.hive-masthead::after {\n  content:\"\"; position:absolute; inset:0; z-index:1; pointer-events:none;\n  background:radial-gradient(ellipse 72% 95% at 24% 52%, color-mix(in srgb, var(--bg-base) 92%, transparent) 0%, color-mix(in srgb, var(--bg-base) 90%, transparent) 68%, color-mix(in srgb, var(--bg-base) 55%, transparent) 86%, transparent 100%);\n}\n.hive-masthead .hive-eyebrow { color:var(--text-secondary); font-size:.65rem; letter-spacing:.24em; margin-bottom:22px; }\n.hive h1 { font-size:clamp(4rem,9vw,8.5rem); font-weight:400; letter-spacing:-.065em; margin:0 0 24px; }\n.hive-period { color:var(--accent-blue); }\n.hive-intro { max-width:34ch; font-size:clamp(1.1rem,1.8vw,1.4rem); line-height:1.5; }\n.hive-welcome { max-width:43ch; font-size:.85rem; margin-top:16px; }\n.hive-learn { align-self:flex-start; margin-top:25px; padding:12px 19px; border:1px solid var(--border-subtle); border-radius:30px; text-decoration:none; font-size:.76rem; background:var(--bg-surface); }\n.hive-learn:hover { border-color:var(--border-active); background:var(--bg-card); }\n\n/* Provenance: this page is generated by Omega, and that is the point of the\n   page, so it says so above the fleet rather than in a footnote. */\n.hive-omega {\n  display:grid; gap:6px; margin:0 0 22px; padding:18px 20px 18px 22px;\n  border:1px solid var(--border-subtle); border-left:3px solid var(--accent-blue);\n  border-radius:10px; background:var(--bg-surface);\n}\n.hive-omega-kicker { font-family:var(--font-mono); font-size:.7rem; letter-spacing:.2em; text-transform:uppercase; color:var(--accent-green); }\n.hive-omega-line { font-size:1rem; line-height:1.5; color:var(--text-primary); }\n.hive-omega-note { font-size:.85rem; line-height:1.55; color:var(--text-secondary); }\n.hive-omega-source { justify-self:start; margin-top:4px; font-family:var(--font-mono); font-size:.72rem; }\n.hive-sections { gap:28px; }\n/* Sections are glass over the sky, not opaque slabs: 86% of --bg-surface\n   keeps the text contrast (0.86 over white) and lets the galaxy run on. */\n.hive-section { border-radius:16px; padding:26px; background:color-mix(in srgb, var(--bg-surface) 86%, transparent); }\n.hive-section .hive-eyebrow { font-size:.61rem; letter-spacing:.18em; }\n.hive h2 { font-size:1.5rem; font-weight:450; letter-spacing:-.025em; }\n.hive-note { font-size:.78rem; }\n/* The Signal band is three short rows, not a column of stacked headings: the\n   eyebrow, heading and note share one head row (hive.om opens that row in field\n   1 and closes it in field 7), the two timestamps sit beside the connection\n   state, counts sit beside coverage, and the motion control takes the top\n   right. The band stays near 180px, so the Missions head is on screen at 1280\n   by 900 without a scroll. */\n#hive-strip { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px 24px; padding:14px 22px 16px; }\n#hive-strip > * { margin-top:0; }\n.hive-head-row { grid-column:1; grid-row:1; display:flex; flex-wrap:wrap; align-items:baseline; column-gap:16px; row-gap:2px; }\n.hive-head-row .hive-eyebrow { margin:0; }\n.hive-head-row h2 { margin:0; }\n.hive-head-row .hive-note { flex:1 1 100%; margin:2px 0 0; }\n.hive-strip-facts { grid-column:1 / -1; grid-row:2; display:grid; grid-template-columns:minmax(0,max-content) minmax(0,1fr); gap:2px 28px; align-items:start; }\n.hive-strip-facts .hive-times { gap:1px 14px; }\n.hive-strip-facts .hive-strip-status { gap:1px; }\n.hive-strip-foot { grid-column:1 / -1; grid-row:3; display:flex; flex-wrap:wrap; align-items:baseline; gap:2px 22px; }\n.hive-strip-foot .hive-counts, .hive-strip-foot .hive-coverage { min-width:0; }\n.hive-strip-foot .hive-coverage { flex:1 1 auto; }\n.hive input.hive-motion-check { width: 1.1rem; min-height: 1.1rem; padding: 0; margin: 0 8px 14px 0; accent-color: var(--accent-blue); }\n.hive-motion-label { color: var(--text-muted); font-size: var(--hive-micro); cursor: pointer; }\n@media (min-width:901px) {\n  /* One line of context above the facts; the text is short enough to fit. */\n  .hive-head-row .hive-note { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:1; overflow:hidden; }\n}\n.hive button { min-height:44px; border-radius:22px; font-size:.78rem; padding:9px 14px; }\n.hive input { min-height:44px; border-radius:22px; padding:10px 15px; }\n.hive-search { max-width:none; }\n.hive-search label { font-size:.71rem; }\n.hive-chip { font-size:.66rem; }\n.hive-pill,.hive-elapsed { font-size:.63rem; }\n.hive-activity { font-size:.76rem; }\n.hive-node[data-selected=\"true\"] > details > .hive-record { background:var(--bg-card); border-radius:8px; }\n.hive-children { margin-left:10px; padding-left:15px; }\n.hive-message { border-radius:10px; padding:16px 18px; }\n.hive-message-text { font-size:.88rem; line-height:1.75; }\n.hive-closing { font-size:.78rem; }\n/* Fold budget. The Signal band is 172px and the presentation masthead was 538,\n   which put the Missions head at 977 on a 900px viewport. The band below trims\n   the hero (smaller display size, tighter padding and rhythm) and the gaps\n   around the strip, without touching the scene or any section head, so the\n   Missions head lands above the fold at 1280 by 900. */\n@media (min-width:901px) {\n  .hive { padding-top:14px; }\n  .hive-masthead { min-height:380px; margin:0 -4vw 22px; padding:40px 8vw 32px; }\n  .hive h1 { font-size:clamp(3rem,5.6vw,5.2rem); margin:0 0 12px; }\n  .hive-masthead .hive-eyebrow { margin-bottom:14px; }\n  .hive-welcome { margin-top:10px; }\n  .hive-learn { margin-top:14px; }\n  .hive-jumps { padding:8px 0; }\n  .hive-sections { gap:18px; }\n  #hive-strip { padding:10px 22px 12px; gap:6px 24px; }\n}\n\n@media (max-width:900px) {\n  .hive-masthead { min-height:460px; padding:58px 7vw; }\n  .hive-section { padding:22px; }\n}\n@media (max-width:600px) {\n  .hive { padding:14px 20px 50px; }\n  .hive-jumps { gap:10px 20px; }\n  .hive-jumps a { font-size:.65rem; }\n  .hive-masthead { margin:0 -20px 22px; padding:54px 28px 48px; min-height:520px; justify-content:flex-end; }\n  /* The prose is bottom-aligned here, so the scrim ellipse sits low. */\n  .hive-masthead::after {\n    background:radial-gradient(ellipse 110% 70% at 50% 82%, color-mix(in srgb, var(--bg-base) 94%, transparent) 0%, color-mix(in srgb, var(--bg-base) 90%, transparent) 55%, color-mix(in srgb, var(--bg-base) 60%, transparent) 80%, transparent 100%);\n  }\n  .hive h1 { font-size:clamp(3.7rem,17vw,5rem); margin-bottom:18px; }\n  .hive-intro { font-size:1rem; }\n  .hive-welcome { font-size:.78rem; }\n  .hive-sections { gap:18px; }\n  .hive-section { padding:20px 16px; border-radius:12px; }\n  #hive-strip { display:block; padding:16px; }\n  #hive-strip > * + * { margin-top:12px; }\n  .hive-times { grid-template-columns:1fr; font-size:.67rem; gap:2px; }\n  .hive-times dd { margin-bottom:8px; }\n  .hive-chip { max-width:100%; }\n  .hive-conversation-controls button { flex:1; }\n}\n@media (prefers-reduced-motion:reduce) { .hive *, .hive *::before, .hive *::after { animation:none !important; transition:none !important; } }\n"
text sap7 "assets/style.css"
text sab7 ":root {\n  --bg-base: #08090c;\n  --bg-surface: #0e1219;\n  --bg-card: #131822;\n  --bg-card-hover: #18202d;\n  --border-subtle: #1c2536;\n  --border-active: #2d7ff9;\n  --accent-blue: #2d7ff9;\n  --accent-blue-glow: rgba(45, 127, 249, 0.15);\n  --accent-green: #00e599;\n  --accent-green-glow: rgba(0, 229, 153, 0.15);\n  --accent-amber: #f59e0b;\n  --text-primary: #f1f5f9;\n  --text-secondary: #94a3b8;\n  --text-muted: #8ea0b5;\n  --font-sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n  /* Research status (generated /research/status/ page) */\n  --rs-pass: #00e599;\n  --rs-pass-bg: rgba(0, 229, 153, 0.12);\n  --rs-fail: #f87171;\n  --rs-fail-bg: rgba(248, 113, 113, 0.08);\n  --rs-warn: #f5a623;\n  --rs-warn-bg: rgba(245, 166, 35, 0.1);\n  --rs-blocked: #fca5a5;\n  --rs-open: #94a3b8;\n  --rs-stair: clamp(4px, 2vw, 28px);\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml, body {\n  background-color: var(--bg-base);\n  color: var(--text-primary);\n  font-family: var(--font-sans);\n  line-height: 1.5;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  overflow-x: hidden;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  scroll-padding-top: 88px;\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\nbutton:focus-visible,\na:focus-visible,\ninput:focus-visible {\n  outline: 2px solid var(--accent-green);\n  outline-offset: 3px;\n}\n\n.skip-link {\n  position: fixed;\n  left: 16px;\n  top: 12px;\n  z-index: 100;\n  padding: 10px 14px;\n  border-radius: 6px;\n  background: var(--text-primary);\n  color: var(--bg-base);\n  font-weight: 700;\n  transform: translateY(-150%);\n  transition: transform 0.15s ease;\n}\n\n.skip-link:focus {\n  transform: translateY(0);\n}\n\n.nav-section-link {\n  color: var(--text-secondary);\n  transition: color 0.15s ease;\n}\n\n.nav-section-link:hover {\n  color: var(--text-primary);\n}\n\ncode, pre, .mono {\n  font-family: var(--font-mono);\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\nh1, h2, h3 {\n  text-wrap: balance;\n}\n\np {\n  text-wrap: pretty;\n}\n\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n/* Technical grid background */\n.bg-grid {\n  background-size: 40px 40px;\n  background-image: \n    linear-gradient(to right, rgba(28, 37, 54, 0.35) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(28, 37, 54, 0.35) 1px, transparent 1px);\n}\n\n/* Glow highlights */\n.glow-box {\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-card);\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\n}\n\n.glow-box:hover {\n  border-color: var(--border-active);\n  box-shadow: 0 0 24px var(--accent-blue-glow);\n}\n\n/* Badges */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 10px;\n  border-radius: 4px;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.badge-blue {\n  background: rgba(45, 127, 249, 0.12);\n  /* lighter than the accent so 10px badge text clears 4.5:1 on the card ground */\n  color: #6aa7ff;\n  border: 1px solid rgba(45, 127, 249, 0.3);\n}\n\n.badge-green {\n  background: rgba(0, 229, 153, 0.12);\n  color: var(--accent-green);\n  border: 1px solid rgba(0, 229, 153, 0.3);\n}\n\n.badge-amber {\n  background: rgba(245, 158, 11, 0.12);\n  color: var(--accent-amber);\n  border: 1px solid rgba(245, 158, 11, 0.3);\n}\n\n.badge-muted {\n  background: rgba(148, 163, 184, 0.08);\n  color: var(--text-secondary);\n  border: 1px solid var(--border-subtle);\n}\n\n/* Section headings */\n.section {\n  padding: 80px 0;\n  border-bottom: 1px solid var(--border-subtle);\n}\n\n.section-alt {\n  background: var(--bg-surface);\n}\n\n.section-head {\n  margin-bottom: 40px;\n  max-width: 720px;\n}\n\n.section-head .badge {\n  margin-bottom: 12px;\n}\n\n.section-head h2 {\n  font-size: clamp(26px, 3.4vw, 32px);\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  line-height: 1.2;\n  color: var(--text-primary);\n}\n\n.section-head p {\n  color: var(--text-secondary);\n  margin-top: 10px;\n}\n\n.section-head a,\n.prose-link {\n  color: var(--accent-blue);\n  border-bottom: 1px solid rgba(45, 127, 249, 0.35);\n}\n\n.section-head a:hover,\n.prose-link:hover {\n  border-bottom-color: var(--accent-blue);\n}\n\n/* Card grids never force horizontal scroll on narrow phones */\n.card-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));\n  gap: 20px;\n}\n\n/* Data table: real table on wide screens, stacked cards on phones */\n.data-table-wrap {\n  border: 1px solid var(--border-subtle);\n  border-radius: 8px;\n  background: var(--bg-base);\n  overflow: hidden;\n}\n\n.data-table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n  font-size: 14px;\n}\n\n.data-table th {\n  padding: 12px 20px;\n  background: rgba(14, 18, 25, 0.9);\n  border-bottom: 1px solid var(--border-subtle);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-muted);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.data-table td {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-subtle);\n  vertical-align: top;\n  color: var(--text-secondary);\n}\n\n.data-table tr:last-child td {\n  border-bottom: none;\n}\n\n.data-table td:first-child {\n  color: var(--text-primary);\n  font-weight: 600;\n}\n\n.data-table code {\n  display: inline-block;\n  font-size: 12px;\n  color: var(--text-primary);\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: 4px;\n  padding: 3px 8px;\n  overflow-wrap: anywhere;\n}\n\n@media (max-width: 720px) {\n  .data-table thead {\n    display: none;\n  }\n\n  .data-table,\n  .data-table tbody,\n  .data-table tr,\n  .data-table td {\n    display: block;\n    width: 100%;\n  }\n\n  .data-table tr {\n    padding: 16px;\n    border-bottom: 1px solid var(--border-subtle);\n  }\n\n  .data-table tr:last-child {\n    border-bottom: none;\n  }\n\n  .data-table td {\n    padding: 4px 0;\n    border: none;\n  }\n\n  .data-table td[data-label]::before {\n    content: attr(data-label);\n    display: block;\n    margin-top: 8px;\n    font-family: var(--font-mono);\n    font-size: 10px;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n  }\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: var(--bg-base);\n}\n::-webkit-scrollbar-thumb {\n  background: var(--border-subtle);\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--text-muted);\n}\n\n@media (max-width: 820px) {\n  .site-nav {\n    gap: 14px !important;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    max-width: 62vw;\n  }\n\n  .site-nav::-webkit-scrollbar {\n    display: none;\n  }\n\n  .nav-section-link {\n    white-space: nowrap;\n    font-size: 13px;\n  }\n\n  .install-method-heading {\n    align-items: flex-start !important;\n    flex-direction: column;\n    gap: 6px;\n  }\n\n  .install-command,\n  .install-method-command {\n    align-items: stretch !important;\n    flex-direction: column !important;\n    gap: 12px;\n  }\n\n  .install-command > div,\n  .install-method-command > span {\n    white-space: normal !important;\n    overflow-wrap: anywhere;\n  }\n\n  .install-command button,\n  .install-method-command button {\n    justify-content: center;\n  }\n}\n\n@media (max-width: 600px) {\n  .container {\n    padding: 0 16px;\n  }\n\n  .responsive-card-grid {\n    grid-template-columns: minmax(0, 1fr) !important;\n  }\n\n  section {\n    scroll-margin-top: 74px;\n  }\n\n  .brand-copy span:last-child {\n    display: none;\n  }\n\n  .terminal-status {\n    display: none;\n  }\n\n  .terminal-title {\n    display: inline-block;\n    max-width: 210px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n\n/* Blog */\n.blog-wrap {\n  max-width: 760px;\n  padding-top: 56px;\n  padding-bottom: 80px;\n}\n\n.blog-kicker {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--accent-green);\n  margin: 0 0 12px;\n}\n\n.blog-title {\n  font-family: var(--font-sans);\n  font-size: 40px;\n  line-height: 1.15;\n  letter-spacing: -0.02em;\n  color: var(--text-primary);\n  margin: 0 0 16px;\n}\n\n.blog-standfirst {\n  font-size: 18px;\n  line-height: 1.6;\n  color: var(--text-secondary);\n  margin: 0 0 40px;\n}\n\n.blog-date {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--text-muted);\n  margin: 0 0 8px;\n}\n\n.blog-byline {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--text-muted);\n  margin: 0 0 28px;\n}\n\n.blog-byline a {\n  color: var(--accent-blue);\n  text-decoration: none;\n}\n\n.blog-byline a:hover {\n  text-decoration: underline;\n}\n\n.blog-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-subtle);\n  border-radius: 12px;\n  padding: 28px;\n  transition: border-color 0.2s ease, transform 0.2s ease;\n}\n\n.blog-card:hover {\n  border-color: var(--border-active);\n}\n\n.blog-card-title {\n  font-size: 24px;\n  margin: 0 0 12px;\n}\n\n.blog-card-title a {\n  color: var(--text-primary);\n  text-decoration: none;\n}\n\n.blog-card-title a:hover {\n  color: var(--accent-blue);\n}\n\n.blog-excerpt {\n  color: var(--text-secondary);\n  line-height: 1.65;\n  margin: 0 0 20px;\n}\n\n.blog-read-more {\n  font-family: var(--font-mono);\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--accent-green);\n  text-decoration: none;\n}\n\n.blog-read-more:hover {\n  text-decoration: underline;\n}\n\n.blog-crumb {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--text-muted);\n  margin-bottom: 24px;\n}\n\n.blog-crumb a {\n  color: var(--accent-blue);\n  text-decoration: none;\n}\n\n.blog-wrap article p {\n  color: var(--text-secondary);\n  line-height: 1.75;\n  margin: 0 0 20px;\n}\n\n.blog-wrap article p.lead {\n  font-size: 19px;\n  color: var(--text-primary);\n  line-height: 1.65;\n}\n\n.blog-wrap article h2 {\n  font-size: 26px;\n  color: var(--text-primary);\n  margin: 40px 0 16px;\n  letter-spacing: -0.01em;\n}\n\n.blog-wrap article strong {\n  color: var(--text-primary);\n}\n\n.blog-wrap article blockquote {\n  border-left: 3px solid var(--accent-green);\n  margin: 24px 0;\n  padding: 4px 0 4px 20px;\n  font-size: 19px;\n  font-style: italic;\n  color: var(--text-primary);\n}\n\n.pdf-callout {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  flex-wrap: wrap;\n  background: linear-gradient(135deg, rgba(45, 127, 249, 0.08) 0%, rgba(0, 229, 153, 0.06) 100%);\n  border: 1px solid var(--border-subtle);\n  border-radius: 12px;\n  padding: 24px;\n  margin: 28px 0;\n}\n\n.pdf-callout-title {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--text-primary);\n  margin-bottom: 4px;\n}\n\n.pdf-callout-sub {\n  font-size: 14px;\n  color: var(--text-muted);\n}\n\n.pdf-button {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: 14px;\n  font-weight: 700;\n  color: #04120c;\n  background: var(--accent-green);\n  border-radius: 8px;\n  padding: 12px 20px;\n  text-decoration: none;\n  white-space: nowrap;\n  box-shadow: 0 0 16px var(--accent-green-glow);\n}\n\n.pdf-button:hover {\n  filter: brightness(1.1);\n}\n\n@media (max-width: 640px) {\n  .blog-title {\n    font-size: 30px;\n  }\n\n  .pdf-callout {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n\n/* Theory illustrations: one visual system for all hand-built SVG figures */\n.theory-fig {\n  margin: 36px 0;\n  background: linear-gradient(160deg, rgba(45, 127, 249, 0.05), rgba(0, 229, 153, 0.03)), var(--bg-card);\n  border: 1px solid var(--border-subtle);\n  border-radius: 16px;\n  padding: 26px 26px 22px;\n}\n\n.theory-fig .fig-kicker {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  flex-wrap: wrap;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--accent-blue);\n  margin-bottom: 18px;\n}\n\n.theory-fig .fig-kicker .fig-kind {\n  color: var(--text-muted);\n}\n\n.theory-fig svg {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.theory-fig figcaption {\n  margin-top: 18px;\n  font-size: 14.5px;\n  line-height: 1.65;\n  color: var(--text-secondary);\n}\n\n.theory-fig figcaption strong {\n  color: var(--text-primary);\n}\n\n@media (max-width: 640px) {\n  .theory-fig {\n    padding: 18px 14px 16px;\n  }\n}\n\n/* ------------------------------------------------------------------\n   Research status: ladder, experiment cards, implementation list.\n   Rendered from crates/site-builder/data/research_status.json.\n   Status is always written as text; colour and line style only repeat it.\n   ------------------------------------------------------------------ */\n.rs-page {\n  padding-top: 56px;\n  padding-bottom: 88px;\n  max-width: 1100px;\n  line-height: 1.65;\n}\n\n.rs-kicker {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent-green);\n  margin-bottom: 10px;\n}\n\n.rs-page-title {\n  font-size: clamp(30px, 6vw, 44px);\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  line-height: 1.15;\n  margin-bottom: 16px;\n}\n\n.rs-standfirst {\n  max-width: 720px;\n  color: var(--text-secondary);\n  font-size: 17px;\n  margin-bottom: 10px;\n}\n\n.rs-toc {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 18px;\n  margin-top: 18px;\n  font-family: var(--font-mono);\n  font-size: 13px;\n}\n\n.rs-toc a,\n.rs-embed-link a {\n  color: var(--accent-green);\n  font-weight: 600;\n}\n\n.rs-section {\n  margin-top: 64px;\n}\n\n.rs-h2 {\n  font-size: 26px;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n  margin-bottom: 12px;\n}\n\n.rs-h3 {\n  font-size: 17px;\n  font-weight: 700;\n  margin: 24px 0 8px;\n}\n\n.rs-section-lede {\n  max-width: 720px;\n  color: var(--text-secondary);\n  margin-bottom: 24px;\n}\n\n.rs-mono {\n  font-family: var(--font-mono);\n  font-size: 12.5px;\n  overflow-wrap: anywhere;\n}\n\n/* Badges */\n.rs-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 3px 9px;\n  border-radius: 4px;\n  border: 1px solid transparent;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.rs-badge--pass { color: var(--rs-pass); background: var(--rs-pass-bg); border-color: rgba(0, 229, 153, 0.4); }\n.rs-badge--fail { color: var(--bg-base); background: var(--rs-fail); border-color: var(--rs-fail); }\n.rs-badge--incomplete { color: var(--rs-warn); background: var(--rs-warn-bg); border-color: var(--rs-warn); }\n.rs-badge--partial { color: var(--rs-warn); background: var(--rs-warn-bg); border: 1px dashed var(--rs-warn); }\n.rs-badge--blocked { color: var(--rs-blocked); background: var(--rs-fail-bg); border: 1px dashed var(--rs-fail); }\n.rs-badge--not-established,\n.rs-badge--not-started,\n.rs-badge--unknown { color: var(--rs-open); background: transparent; border: 1px dashed var(--rs-open); }\n\n/* Ladder */\n.rs-current {\n  font-size: 18px;\n  color: var(--text-primary);\n  max-width: 760px;\n}\n\n.rs-current strong {\n  color: var(--accent-green);\n}\n\n.rs-current-meaning,\n.rs-ladder-hint {\n  color: var(--text-secondary);\n  max-width: 760px;\n  margin-top: 6px;\n}\n\n.rs-ladder-hint {\n  font-size: 14px;\n  color: var(--text-muted);\n}\n\n.rs-stairs {\n  list-style: none;\n  display: flex;\n  flex-direction: column-reverse;\n  gap: 10px;\n  margin: 24px 0 0;\n  padding: 0;\n}\n\n.rs-step {\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr);\n  gap: 12px;\n  margin-left: calc(var(--i) * var(--rs-stair));\n}\n\n.rs-step-mark {\n  width: 18px;\n  height: 18px;\n  margin-top: 17px;\n  border-radius: 50%;\n  border: 2px solid var(--rs-open);\n}\n\n.rs-step--achieved .rs-step-mark { background: var(--rs-pass); border-color: var(--rs-pass); }\n.rs-step--partial .rs-step-mark { background: linear-gradient(to top, var(--rs-warn) 50%, transparent 50%); border-color: var(--rs-warn); }\n.rs-step--not-achieved .rs-step-mark { background: transparent; border-style: dashed; }\n.rs-step--not-attempted .rs-step-mark { background: transparent; border-style: dotted; }\n\n.rs-step-body {\n  min-width: 0;\n  padding: 14px 18px;\n  border-radius: 8px;\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-card);\n}\n\n.rs-step--achieved .rs-step-body { border-left: 4px solid var(--rs-pass); }\n.rs-step--partial .rs-step-body { border-left: 4px dashed var(--rs-warn); }\n.rs-step--not-achieved .rs-step-body,\n.rs-step--not-attempted .rs-step-body {\n  background: transparent;\n  border-style: dashed;\n}\n\n.rs-step-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 4px 10px;\n}\n\n.rs-step-level {\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--text-primary);\n}\n\n.rs-step-name {\n  font-weight: 600;\n  color: var(--text-primary);\n}\n\n.rs-step--not-achieved .rs-step-name,\n.rs-step--not-attempted .rs-step-name {\n  color: var(--text-secondary);\n}\n\n.rs-here {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--bg-base);\n  background: var(--accent-green);\n  border-radius: 4px;\n  padding: 2px 8px;\n}\n\n.rs-step-state {\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  margin-top: 4px;\n  color: var(--rs-open);\n}\n\n.rs-step--achieved .rs-step-state { color: var(--rs-pass); }\n.rs-step--partial .rs-step-state { color: var(--rs-warn); }\n\n.rs-step-detail {\n  color: var(--text-secondary);\n  font-size: 15px;\n  margin-top: 4px;\n}\n\n.rs-step-basis {\n  color: var(--text-muted);\n  font-family: var(--font-mono);\n  font-size: 12px;\n  margin-top: 4px;\n  overflow-wrap: anywhere;\n}\n\n.rs-attempt {\n  margin-top: 12px;\n  padding: 12px 14px;\n  border-radius: 6px;\n  border: 1px solid var(--rs-fail);\n  background: var(--rs-fail-bg);\n  color: var(--text-secondary);\n  font-size: 14.5px;\n}\n\n.rs-attempt-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px 10px;\n  margin-bottom: 4px;\n  color: var(--text-primary);\n}\n\n.rs-attempt-head span:last-child {\n  color: var(--text-secondary);\n  font-size: 13px;\n}\n\n.rs-embed-link {\n  margin-top: 16px;\n  font-family: var(--font-mono);\n  font-size: 13px;\n}\n\n/* Experiment cards */\n.rs-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));\n  gap: 20px;\n}\n\n.rs-card {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 22px;\n  border-radius: 10px;\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-card);\n}\n\n.rs-card--fail { border-color: var(--rs-fail); }\n.rs-card--blocked,\n.rs-card--not-started,\n.rs-card--not-established { border-style: dashed; }\n\n.rs-card-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.rs-card-id {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  color: var(--text-muted);\n  overflow-wrap: anywhere;\n  text-align: right;\n}\n\n.rs-card-title {\n  font-size: 18px;\n  font-weight: 700;\n  line-height: 1.3;\n}\n\n.rs-card-headline {\n  font-family: var(--font-mono);\n  font-size: 20px;\n  font-weight: 700;\n  color: var(--text-primary);\n  overflow-wrap: anywhere;\n}\n\n.rs-card-callout {\n  padding: 10px 12px;\n  border-left: 3px solid var(--rs-warn);\n  background: var(--rs-warn-bg);\n  color: var(--text-primary);\n  font-size: 14.5px;\n}\n\n.rs-card-plain {\n  color: var(--text-secondary);\n  font-size: 15px;\n}\n\n.rs-facts {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding-top: 12px;\n  border-top: 1px solid var(--border-subtle);\n  font-size: 13.5px;\n}\n\n.rs-facts > div {\n  display: grid;\n  grid-template-columns: 8.5em minmax(0, 1fr);\n  gap: 10px;\n}\n\n.rs-facts dt {\n  color: var(--text-muted);\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  padding-top: 2px;\n}\n\n.rs-facts dd {\n  color: var(--text-secondary);\n  overflow-wrap: anywhere;\n  min-width: 0;\n}\n\n/* Implementation list */\n.rs-impl {\n  display: flex;\n  flex-direction: column;\n  gap: 28px;\n}\n\n.rs-group {\n  padding: 20px 22px;\n  border-radius: 10px;\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-surface);\n}\n\n.rs-group--research-hypothesis {\n  border: 1px dashed var(--rs-open);\n  background: repeating-linear-gradient(135deg, transparent 0 12px, rgba(148, 163, 184, 0.04) 12px 24px);\n}\n\n.rs-group--planned {\n  border-style: dashed;\n}\n\n.rs-group-title {\n  font-size: 18px;\n  font-weight: 700;\n}\n\n.rs-group-count {\n  color: var(--text-muted);\n  font-weight: 500;\n}\n\n.rs-group-blurb {\n  color: var(--text-secondary);\n  font-size: 14.5px;\n  margin: 2px 0 14px;\n}\n\n.rs-impl-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.rs-impl-item {\n  padding: 14px 0;\n  border-top: 1px solid var(--border-subtle);\n  min-width: 0;\n}\n\n.rs-impl-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 4px 12px;\n}\n\n.rs-impl-name {\n  font-weight: 700;\n  color: var(--text-primary);\n  overflow-wrap: anywhere;\n}\n\n.rs-impl-status {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.rs-impl-scope {\n  color: var(--text-secondary);\n  font-size: 14.5px;\n  margin-top: 4px;\n}\n\n.rs-impl-more {\n  margin-top: 8px;\n}\n\n.rs-impl-more summary {\n  cursor: pointer;\n  font-family: var(--font-mono);\n  font-size: 12.5px;\n  color: var(--accent-green);\n}\n\n.rs-impl-more .rs-facts {\n  margin-top: 10px;\n}\n\n.rs-sources p,\n.rs-sources li {\n  color: var(--text-secondary);\n  font-size: 14.5px;\n  max-width: 820px;\n  margin-bottom: 8px;\n  overflow-wrap: anywhere;\n}\n\n.rs-sources ul {\n  padding-left: 20px;\n}\n\n@media (max-width: 600px) {\n  .rs-page {\n    padding-top: 36px;\n  }\n\n  .rs-facts > div {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 2px;\n  }\n\n  .rs-card,\n  .rs-group {\n    padding: 18px 16px;\n  }\n\n  .rs-step-body {\n    padding: 12px 14px;\n  }\n}\n\n/* Homepage top (NARR-HOME): central statement, slogan, canonical loop,\n   three questions. Pure CSS, no images, no JS. */\n:root {\n  --loop-perimeter: var(--accent-amber);\n  --accent-amber-glow: rgba(245, 158, 11, 0.12);\n  --loop-feedback: var(--accent-green);\n  --loop-gen: var(--accent-blue);\n}\n\n.home-top {\n  padding: 96px 0 80px;\n  border-bottom: 1px solid var(--border-subtle);\n}\n\n.home-column {\n  max-width: 68ch;\n  margin: 0 auto;\n}\n\n.home-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: 28px;\n}\n\n.home-lead {\n  font-size: clamp(30px, 4.4vw, 52px);\n  font-weight: 800;\n  line-height: 1.12;\n  letter-spacing: -0.025em;\n  color: var(--text-primary);\n}\n\n.home-lead-rest {\n  margin-top: 24px;\n  font-size: clamp(17px, 1.8vw, 20px);\n  line-height: 1.65;\n  color: var(--text-primary);\n}\n\n.home-thesis {\n  margin-top: 36px;\n  padding-top: 28px;\n  border-top: 1px solid var(--border-subtle);\n}\n\n.home-thesis p {\n  font-size: 17px;\n  line-height: 1.75;\n  color: var(--text-secondary);\n}\n\n.home-thesis p + p {\n  margin-top: 18px;\n}\n\n.home-slogan {\n  max-width: 22ch;\n  margin: 88px auto 96px;\n  text-align: center;\n  font-size: clamp(34px, 6vw, 76px);\n  font-weight: 800;\n  line-height: 1.12;\n  letter-spacing: -0.03em;\n  color: var(--text-primary);\n  text-wrap: balance;\n}\n\n/* The loop diagram */\n.loop {\n  margin: 0 auto;\n  max-width: 1080px;\n}\n\n.loop-title {\n  font-size: clamp(26px, 3vw, 34px);\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  text-align: center;\n  color: var(--text-primary);\n}\n\n.loop-intro {\n  max-width: 68ch;\n  margin: 14px auto 0;\n  text-align: center;\n  font-size: 16px;\n  line-height: 1.7;\n  color: var(--text-secondary);\n}\n\n.loop-legend {\n  list-style: none;\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 10px 24px;\n  margin: 24px 0 20px;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.loop-key::before {\n  content: \"\";\n  display: inline-block;\n  width: 22px;\n  height: 12px;\n  margin-right: 8px;\n  vertical-align: -1px;\n  border-radius: 3px;\n}\n\n.loop-key-gen::before {\n  border: 2px solid var(--loop-gen);\n}\n\n.loop-key-feedback::before {\n  border: 2px solid var(--loop-feedback);\n  background: var(--accent-green-glow);\n}\n\n.loop-key-perimeter::before {\n  border: 2px dashed var(--loop-perimeter);\n}\n\n.loop-perimeter {\n  border: 2px dashed var(--loop-perimeter);\n  border-radius: 18px;\n  padding: 20px 22px 22px;\n  background: var(--bg-surface);\n}\n\n.loop-perimeter-label {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--loop-perimeter);\n  text-align: center;\n  margin-bottom: 14px;\n}\n\n.loop-perimeter-band {\n  list-style: none;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.loop-guard {\n  border: 1px dashed var(--loop-perimeter);\n  border-radius: 8px;\n  padding: 10px 14px;\n  text-align: center;\n  background: var(--accent-amber-glow);\n}\n\n.loop-guard-name {\n  display: block;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  color: var(--loop-perimeter);\n}\n\n.loop-guard-role {\n  display: block;\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n.loop-stages {\n  list-style: none;\n  counter-reset: loop-stage;\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 34px 28px;\n  margin: 20px 0 0;\n}\n\n.loop-stage {\n  position: relative;\n  counter-increment: loop-stage;\n  background: var(--bg-card);\n  border: 2px solid var(--loop-gen);\n  border-radius: 10px;\n  padding: 14px 12px;\n  text-align: center;\n  overflow-wrap: anywhere;\n}\n\n.loop-stage::before {\n  content: counter(loop-stage);\n  display: block;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n/* Arrow to the next stage (decorative; order is carried by the <ol>). */\n.loop-stage:not(:last-child)::after {\n  content: \"\\2192\";\n  content: \"\\2192\" / \"\";\n  position: absolute;\n  right: -22px;\n  top: 50%;\n  transform: translateY(-50%);\n  font-family: var(--font-mono);\n  font-size: 16px;\n  color: var(--text-muted);\n}\n\n/* Row end: no sideways arrow off the edge; a turn cue below points to the\n   first box of the next row. Order is still carried by the <ol>. */\n.loop-stage:nth-child(4n):not(:last-child)::after {\n  content: \"\\2199\";\n  content: \"\\2199\" / \"\";\n  right: auto;\n  left: 50%;\n  top: auto;\n  bottom: -30px;\n  transform: translateX(-50%);\n}\n\n.loop-stage-reality {\n  border-style: double;\n  border-width: 4px;\n  border-color: var(--text-secondary);\n}\n\n.loop-stage-feedback {\n  border-color: var(--loop-feedback);\n  background: var(--accent-green-glow);\n}\n\n.loop-stage-name {\n  display: block;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  color: var(--text-primary);\n}\n\n.loop-stage-role {\n  display: block;\n  margin-top: 4px;\n  font-size: 13px;\n  line-height: 1.45;\n  color: var(--text-secondary);\n}\n\n.loop-stage-band {\n  display: block;\n  margin-top: 8px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n\n.loop-stage-feedback .loop-stage-band {\n  color: var(--loop-feedback);\n}\n\n.loop-return {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  margin: 16px 0 20px;\n  padding: 12px 16px;\n  border: 2px solid var(--loop-feedback);\n  border-radius: 999px;\n  background: var(--accent-green-glow);\n  font-size: 15px;\n  color: var(--text-primary);\n  text-align: left;\n}\n\n.loop-return-arrow {\n  font-size: 30px;\n  line-height: 1;\n  color: var(--loop-feedback);\n}\n\n.loop-caption {\n  max-width: 68ch;\n  margin: 16px auto 0;\n  text-align: center;\n  font-size: 13px;\n  line-height: 1.6;\n  color: var(--text-muted);\n}\n\n/* The three questions */\n.home-questions {\n  max-width: 1080px;\n  margin: 56px auto 0;\n}\n\n.home-questions-title {\n  font-size: clamp(22px, 2.6vw, 28px);\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  text-align: center;\n  color: var(--text-primary);\n  margin-bottom: 24px;\n}\n\n.home-q-list {\n  list-style: none;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.home-q {\n  background: var(--bg-card);\n  border: 1px solid var(--border-subtle);\n  border-radius: 12px;\n  padding: 22px 20px;\n}\n\n.home-q-question {\n  font-size: 20px;\n  font-weight: 700;\n  line-height: 1.3;\n  color: var(--text-primary);\n}\n\n.home-q-measure {\n  margin-top: 12px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n}\n\n.home-q-measure-name {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--text-primary);\n}\n\n.home-q-badge {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.home-q-badge.status-experimental {\n  color: var(--accent-blue);\n  border: 1px solid var(--accent-blue);\n  background: var(--accent-blue-glow);\n}\n\n.home-q-badge.status-planned {\n  color: var(--accent-amber);\n  border: 1px dashed var(--accent-amber);\n  background: transparent;\n}\n\n.home-q-badge.status-hypothesis {\n  color: var(--text-secondary);\n  border: 1px dotted var(--text-secondary);\n  background: transparent;\n  font-style: italic;\n}\n\n.home-q-meaning {\n  margin-top: 10px;\n  font-size: 15px;\n  line-height: 1.6;\n  color: var(--text-secondary);\n}\n\n/* ==========================================================================\n   NARR-NAV: six-section footer and section hub pages\n   (/experiments/, /evidence/, /philosophy/). Self-contained block; the\n   header nav itself lives in /assets/site-nav.css so hand-written pages\n   that do not load this file can share it.\n   ========================================================================== */\n\n.aien-footer {\n  border-top: 1px solid var(--border-subtle);\n  background: var(--bg-base);\n  padding: 48px 0 32px;\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n.aien-footer-top {\n  display: grid;\n  grid-template-columns: minmax(0, 300px) minmax(0, 1fr);\n  gap: 40px;\n  margin-bottom: 40px;\n}\n\n.aien-footer-brand {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 12px;\n  font-weight: 700;\n  font-size: 16px;\n  color: var(--text-primary);\n}\n\n.aien-footer-about p {\n  line-height: 1.6;\n  color: var(--text-secondary);\n  margin: 0;\n}\n\n/* For machines: the data index, llms.txt and the feeds, one line under the blurb. */\n.aien-footer-machines {\n  margin-top: 12px !important;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.aien-footer-machines a {\n  color: var(--text-secondary);\n}\n\n.aien-footer-machines a:hover {\n  color: var(--text-primary);\n}\n\n.aien-footer-sections {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n  gap: 28px 24px;\n}\n\n.aien-footer-heading {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--text-primary);\n  margin: 0 0 12px;\n}\n\n.aien-footer-group ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.aien-footer-group a {\n  color: var(--text-secondary);\n  transition: color 0.15s ease;\n}\n\n.aien-footer-group a:hover {\n  color: var(--text-primary);\n}\n\n.aien-footer-more .aien-footer-heading {\n  color: var(--text-muted);\n}\n\n.aien-footer-legal {\n  border-top: 1px solid var(--border-subtle);\n  padding-top: 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n  font-family: var(--font-mono);\n  font-size: 11px;\n}\n\n.aien-footer-legal a {\n  color: var(--text-secondary);\n  text-decoration: underline;\n}\n\n.aien-footer-mottos {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n\n/* Hub pages: one centered reading column, generous whitespace. */\n.hub-wrap {\n  max-width: 760px;\n  padding-top: 64px;\n  padding-bottom: 96px;\n}\n\n.hub-kicker {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent-green);\n  margin: 0 0 12px;\n}\n\n.hub-label {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  border-radius: 999px;\n  padding: 5px 12px;\n  margin: 0 0 16px;\n}\n\n/* Philosophy pages argue a stance: amber outline plus the text label,\n   never color alone. */\n.hub-label-position {\n  color: var(--accent-amber);\n  border: 1px dashed var(--accent-amber);\n  background: rgba(245, 158, 11, 0.08);\n}\n\n.hub-title {\n  font-size: 40px;\n  line-height: 1.15;\n  letter-spacing: -0.02em;\n  color: var(--text-primary);\n  margin: 0 0 16px;\n}\n\n.hub-standfirst {\n  max-width: 68ch;\n  font-size: 18px;\n  line-height: 1.65;\n  color: var(--text-secondary);\n  margin: 0 0 48px;\n}\n\n.hub-standfirst a,\n.hub-section p a {\n  color: var(--accent-blue);\n}\n\n.hub-section {\n  margin: 0 0 48px;\n}\n\n.hub-section p {\n  max-width: 68ch;\n  font-size: 16px;\n  line-height: 1.7;\n  color: var(--text-secondary);\n  margin: 0 0 16px;\n}\n\n.hub-h2 {\n  font-size: 22px;\n  letter-spacing: -0.01em;\n  color: var(--text-primary);\n  margin: 0 0 16px;\n}\n\n/* Experiments hub: ladder and cards rendered from research_status data.\n   The wrap widens for the card grid; prose stays in a 68ch column. */\n.hub-wrap-wide {\n  max-width: 1100px;\n}\n\n.hub-data {\n  margin: 0 0 64px;\n}\n\n.hub-data .hub-lede {\n  max-width: 68ch;\n  font-size: 16px;\n  line-height: 1.7;\n  color: var(--text-secondary);\n  margin: 0 0 24px;\n}\n\n.hub-data-foot {\n  margin: 32px 0 0;\n}\n\n.hub-button {\n  display: inline-flex;\n  align-items: center;\n  padding: 11px 20px;\n  border-radius: 8px;\n  border: 1px solid var(--accent-blue);\n  background: rgba(45, 127, 249, 0.12);\n  color: var(--accent-blue);\n  font-weight: 700;\n  font-size: 14px;\n}\n\n.hub-button:hover {\n  background: rgba(45, 127, 249, 0.2);\n}\n\n.hub-ladder {\n  counter-reset: hub-ladder;\n  list-style: none;\n  margin: 0 0 20px;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.hub-ladder li {\n  counter-increment: hub-ladder;\n  display: grid;\n  grid-template-columns: 2.25em minmax(0, 1fr);\n  column-gap: 12px;\n  align-items: baseline;\n  padding: 12px 16px;\n  border: 1px solid var(--border-subtle);\n  border-radius: 10px;\n  background: var(--bg-card);\n}\n\n.hub-ladder li::before {\n  content: counter(hub-ladder);\n  grid-row: span 2;\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--accent-green);\n}\n\n.hub-ladder strong {\n  color: var(--text-primary);\n  font-size: 15px;\n}\n\n.hub-ladder span {\n  color: var(--text-secondary);\n  font-size: 14.5px;\n  line-height: 1.55;\n}\n\n.hub-section .hub-note {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n.hub-cards {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 14px;\n}\n\n.hub-card {\n  border: 1px solid var(--border-subtle);\n  border-radius: 12px;\n  background: var(--bg-card);\n  padding: 20px;\n  transition: border-color 0.2s ease;\n}\n\n.hub-card:hover {\n  border-color: var(--border-active);\n}\n\n.hub-card a {\n  display: block;\n  font-weight: 700;\n  font-size: 16px;\n  color: var(--text-primary);\n  margin: 0 0 8px;\n}\n\n.hub-card a:hover {\n  color: var(--accent-blue);\n}\n\n.hub-card p {\n  margin: 0;\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--text-secondary);\n}\n\n/* /agents/ (components/agents.rs): the prompt block, the steps and the\n   per-repository tags reuse the hub layout. */\n.agents-steps {\n  color: var(--text-secondary);\n  line-height: 1.7;\n  padding-left: 22px;\n}\n\n.agents-prompt {\n  background: var(--bg-card);\n  border: 1px solid var(--border-subtle);\n  border-radius: 10px;\n  padding: 16px 18px;\n  white-space: pre-wrap;\n  word-break: break-word;\n  font-family: var(--font-mono);\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--text-primary);\n}\n\n.hub-card p.agents-tag {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--text-muted);\n  border: 1px solid var(--border-subtle);\n  border-radius: 999px;\n  padding: 1px 8px;\n  margin: 0 0 8px;\n}\n\n.hub-card p.agents-none {\n  margin-top: 8px;\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n.agents-rule-list {\n  margin: 0 0 8px;\n  padding-left: 20px;\n  font-size: 14px;\n  line-height: 1.7;\n  color: var(--text-secondary);\n}\n\n.home-q-note {\n  margin-top: 8px;\n  font-size: 13px;\n  line-height: 1.55;\n  color: var(--text-muted);\n}\n\n.home-actions {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 56px;\n}\n\n.home-cta {\n  background: var(--bg-card);\n  color: var(--text-primary);\n  border: 1px solid var(--border-subtle);\n  border-radius: 4px;\n  padding: 12px 22px;\n  font-family: var(--font-mono);\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.home-cta-primary {\n  background: var(--accent-green);\n  color: var(--bg-base);\n  border-color: var(--accent-green);\n  font-weight: 700;\n}\n\n.home-cta-ghost {\n  background: transparent;\n  color: var(--text-secondary);\n}\n\n.home-checks {\n  list-style: none;\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 10px 28px;\n  margin-top: 28px;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n\n@media (max-width: 900px) {\n  .loop-stages {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .loop-stage:nth-child(2n):not(:last-child)::after {\n    content: \"\\2199\";\n    content: \"\\2199\" / \"\";\n    right: auto;\n    left: 50%;\n    top: auto;\n    bottom: -30px;\n    transform: translateX(-50%);\n  }\n  .home-q-list {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* Phone: one vertical stack, arrows point down, return arrow stays. */\n@media (max-width: 600px) {\n  .home-top .container {\n    padding: 0 16px;\n  }\n  .home-top {\n    padding: 64px 0 56px;\n  }\n  .home-slogan {\n    margin: 56px auto 64px;\n  }\n  .loop-perimeter {\n    padding: 14px 12px 16px;\n  }\n  .loop-perimeter-band,\n  .loop-stages {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .loop-stages {\n    gap: 26px;\n  }\n  .loop-stage:nth-child(n):not(:last-child)::after {\n    content: \"\\2193\";\n    content: \"\\2193\" / \"\";\n    right: auto;\n    left: 50%;\n    top: auto;\n    bottom: -24px;\n    transform: translateX(-50%);\n  }\n  .loop-return {\n    border-radius: 12px;\n  }\n}\n.hub-callout {\n  border-left: 3px solid var(--accent-green);\n  padding: 4px 0 4px 20px;\n}\n\n@media (max-width: 720px) {\n  .aien-footer-top {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .hub-wrap {\n    padding-top: 40px;\n    padding-bottom: 64px;\n  }\n\n  .hub-title {\n    font-size: 32px;\n  }\n\n  .hub-data {\n    margin-bottom: 48px;\n  }\n}\n\n@media (max-width: 600px) {\n  .aien-footer .container,\n  .hub-wrap {\n    padding-left: 16px;\n    padding-right: 16px;\n  }\n}\n/* ========================= end NARR-NAV block ========================= */\n\n/* ==========================================================================\n   NARR-RESEARCH: research narrative pages (/machine/, /discovery/)\n   Reading column and narrative layout. Status badges reuse the shared rs-*\n   badge styles; the badge TEXT comes from the research status data and each\n   class adds a distinct border style. Dark only, like the rest of the site.\n   ========================================================================== */\n.narr-page {\n  --narr-bg: var(--bg-base);\n  --narr-card: var(--bg-card);\n  --narr-border: var(--border-subtle);\n  --narr-text: var(--text-primary);\n  --narr-text-2: #b6c2d1;\n  --narr-muted: var(--text-muted);\n  --narr-link: #6aa7ff;\n  --narr-green: var(--accent-green);\n  background: var(--narr-bg);\n  color: var(--narr-text);\n  padding: 56px 16px 96px;\n}\n\n.narr-column {\n  max-width: 68ch;\n  margin: 0 auto;\n}\n\n.narr-page .visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.narr-header {\n  margin-bottom: 56px;\n}\n\n.narr-kicker {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: var(--narr-green);\n  margin: 0 0 12px;\n}\n\n.narr-title {\n  font-size: 42px;\n  line-height: 1.12;\n  letter-spacing: -0.02em;\n  margin: 0 0 28px;\n}\n\n.narr-standfirst,\n.narr-mission p {\n  font-size: 19px;\n  line-height: 1.65;\n  color: var(--narr-text);\n}\n\n.narr-mission {\n  border-left: 3px solid var(--narr-green);\n  padding: 4px 0 4px 20px;\n  margin: 0 0 32px;\n}\n\n.narr-slogan {\n  font-size: 26px;\n  font-weight: 700;\n  line-height: 1.35;\n  letter-spacing: -0.01em;\n  color: var(--narr-text);\n  margin: 0 0 28px;\n}\n\n.narr-page p {\n  color: var(--narr-text-2);\n  line-height: 1.75;\n  margin: 0 0 18px;\n}\n\n.narr-page a {\n  color: var(--narr-link);\n  text-underline-offset: 3px;\n}\n\n.narr-page strong {\n  color: var(--narr-text);\n}\n\n.narr-section {\n  margin: 0 0 64px;\n}\n\n.narr-section h2 {\n  font-size: 28px;\n  line-height: 1.25;\n  letter-spacing: -0.01em;\n  color: var(--narr-text);\n  margin: 0 0 18px;\n}\n\n.narr-section h3 {\n  font-size: 19px;\n  color: var(--narr-text);\n  margin: 0 0 10px;\n}\n\n.narr-page ul,\n.narr-page ol,\n.narr-page dl {\n  color: var(--narr-text-2);\n  line-height: 1.7;\n  margin: 0 0 20px;\n}\n\n.narr-loop {\n  list-style: none;\n  counter-reset: narr-step;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  padding: 0;\n}\n\n.narr-loop li {\n  counter-increment: narr-step;\n  background: var(--narr-card);\n  border: 1px solid var(--narr-border);\n  border-radius: 999px;\n  padding: 6px 14px;\n  font-size: 15px;\n  color: var(--narr-text);\n}\n\n.narr-loop li::before {\n  content: counter(narr-step) \". \";\n  font-family: var(--font-mono);\n  color: var(--narr-muted);\n}\n\n.narr-formula {\n  margin: 8px 0 24px;\n}\n\n.narr-formula pre {\n  background: var(--narr-card);\n  border: 1px solid var(--narr-border);\n  border-radius: 10px;\n  padding: 18px 20px;\n  overflow-x: auto;\n  white-space: pre-wrap;\n  word-break: break-word;\n  font-size: 15px;\n}\n\n.narr-ledger,\n.narr-questions,\n.narr-caps {\n  padding-left: 22px;\n}\n\n.narr-cards {\n  list-style: none;\n  padding: 0;\n  display: grid;\n  gap: 16px;\n}\n\n.narr-card {\n  background: var(--narr-card);\n  border: 1px solid var(--narr-border);\n  border-radius: 12px;\n  padding: 22px 22px 6px;\n}\n\n.narr-keystone {\n  font-size: 20px;\n  font-weight: 600;\n  line-height: 1.5;\n}\n\n.narr-page .narr-keystone {\n  color: var(--narr-text);\n}\n\n.narr-connections dt {\n  font-weight: 700;\n  color: var(--narr-text);\n  margin-top: 18px;\n}\n\n.narr-connections dd {\n  margin: 6px 0 0;\n}\n\n.narr-rule {\n  border-left: 3px solid var(--rs-warn);\n  padding: 4px 0 4px 20px;\n  margin: 0 0 24px;\n}\n\n.narr-page .narr-rule p {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--narr-text);\n}\n\n/* Implementation-class badges. Base look is the shared .rs-badge; text comes\n   from the research status data. Each class adds its own border style so the\n   class never depends on colour alone. */\n.rs-class--implemented { color: var(--rs-pass); background: var(--rs-pass-bg); border: 1px solid var(--rs-pass); }\n.rs-class--partially-implemented { color: var(--rs-warn); background: var(--rs-warn-bg); border: 1px solid var(--rs-warn); border-right-style: dashed; border-bottom-style: dashed; }\n.rs-class--experimental { color: var(--rs-warn); background: transparent; border: 3px double var(--rs-warn); }\n.rs-class--planned { color: var(--rs-open); background: transparent; border: 1px dashed var(--rs-open); }\n.rs-class--research-hypothesis { color: var(--rs-open); background: transparent; border: 1px dotted var(--rs-open); border-radius: 999px; font-style: italic; }\n\n.narr-page .rs-badge {\n  vertical-align: middle;\n}\n\n.narr-exam h2 .rs-badge,\n.narr-connections dt .rs-badge,\n.narr-card h3 .rs-badge {\n  margin-left: 6px;\n}\n\n.narr-figure .rs-badge,\n.narr-card p .rs-badge {\n  margin-right: 4px;\n}\n\n.narr-norecord {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--narr-muted);\n}\n\n.narr-page .rs-ladder,\n.narr-page .rs-impl {\n  margin-top: 24px;\n}\n\n@media (max-width: 640px) {\n  .narr-page {\n    padding: 36px 16px 72px;\n  }\n\n  .narr-title {\n    font-size: 31px;\n  }\n\n  .narr-slogan {\n    font-size: 21px;\n  }\n\n  .narr-loop {\n    flex-direction: column;\n  }\n}\n/* ======================= end NARR-RESEARCH block ========================= */\n\n/* Live block in the status section: read from the public record at build time. */\n.live { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border-subtle); }\n.live-head { max-width: 760px; margin-bottom: 24px; }\n.live-head h3 { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: var(--text-primary); margin: 12px 0 8px; }\n.live-head p { color: var(--text-secondary); line-height: 1.6; font-size: 15px; }\n.live-head .mono { font-family: var(--font-mono); font-size: 13px; }\n.live-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr); gap: 40px; align-items: start; }\n.status-table { border-collapse: collapse; width: 100%; }\n.status-table th, .status-table td { text-align: left; vertical-align: top; padding: 12px 12px 12px 0; border-bottom: 1px solid var(--border-subtle); font-size: 14.5px; }\n.status-table th { color: var(--text-muted); font-weight: 500; font-size: 12px; font-family: var(--font-mono); letter-spacing: 0.04em; }\n.status-table td { color: var(--text-secondary); line-height: 1.5; }\n.status-table td.name { white-space: nowrap; font-weight: 700; }\n.status-table td.name a { color: var(--text-primary); }\n.status-table td.name small { display: block; font-weight: 400; color: var(--text-muted); font-family: var(--font-mono); font-size: 12px; }\n.status-table td .merge { color: var(--text-secondary); }\n.status-table td .when { color: var(--text-muted); font-size: 13px; display: block; margin-top: 2px; }\n.status-table th.num, .status-table td.num { font-family: var(--font-mono); text-align: right; white-space: nowrap; }\n.decisions { margin-top: 32px; max-width: 760px; }\n.decisions h4 { font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 10px; }\n.decisions ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }\n.decisions li a { color: var(--text-secondary); font-size: 14.5px; }\n.decisions li a:hover { color: var(--text-primary); }\n.decisions li .mono { font-family: var(--font-mono); color: var(--text-muted); font-size: 12.5px; margin-right: 6px; }\n.decisions .small { margin-top: 14px; font-size: 13px; color: var(--text-muted); }\n.decisions .small a { color: var(--text-secondary); }\n\n/* The receipt: a real verification receipt, set like a till print. */\n.receipt { background: #f4efe4; color: #1a1a1a; font-family: var(--font-mono); font-size: 13px; line-height: 1.5; padding: 24px 22px 28px; border-radius: 2px; box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5); position: relative; transform: rotate(-0.6deg); }\n.receipt::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: -8px; height: 8px; background: linear-gradient(135deg, transparent 50%, #f4efe4 50%) 0 0 / 12px 8px, linear-gradient(225deg, transparent 50%, #f4efe4 50%) 6px 0 / 12px 8px; }\n.receipt h3 { font-family: var(--font-mono); font-size: 13px; font-weight: 700; color: #1a1a1a; letter-spacing: 0.04em; text-align: center; margin: 0 0 12px; }\n.receipt p { margin: 0; color: #1a1a1a; }\n.receipt .rule { border-top: 1px dashed #8a8276; margin: 12px 0; }\n.receipt .row { display: flex; justify-content: space-between; gap: 12px; }\n.receipt .row span:last-child { text-align: right; word-break: break-all; }\n.receipt .verdict { font-weight: 700; font-size: 15px; margin-top: 6px; }\n.receipt .verdict.pass { color: #1d7a3f; }\n.receipt .verdict.fail { color: #a8231b; }\n.receipt .verdict.pending { color: #5a5a5a; }\n.receipt .receipt-note { color: #5a5a5a; font-size: 12.5px; margin-top: 4px; }\n.receipt .foot { margin-top: 14px; font-size: 12px; color: #5a5a5a; text-align: center; }\n.receipt a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }\n\n@media (max-width: 900px) {\n  .live-grid { grid-template-columns: 1fr; }\n  .receipt { transform: none; max-width: 420px; }\n}\n@media (max-width: 640px) {\n  .status-table thead { display: none; }\n  .status-table, .status-table tbody, .status-table tr, .status-table td { display: block; width: 100%; }\n  .status-table tr { padding: 12px 0; border-bottom: 1px solid var(--border-subtle); }\n  .status-table td { border: 0; padding: 2px 0; }\n  .status-table td.name { white-space: normal; }\n  .status-table td.num { text-align: left; }\n  .status-table td.num::before { content: \"Open changes: \"; color: var(--text-muted); font-family: var(--font-sans); }\n}\n\n.narr-byline {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  color: var(--narr-text);\n  margin: 20px 0 0;\n}\n\n/* ==========================================================================\n   /contact/: where I am and how to reach me (components/contact.rs).\n   ========================================================================== */\n\n.contact-page {\n  padding: 80px 0;\n  border-bottom: 1px solid var(--border-subtle);\n}\n\n.contact-page h1 {\n  font-size: clamp(32px, 5vw, 48px);\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  color: var(--text-primary);\n  margin: 0 0 16px;\n}\n\n.contact-lede {\n  color: var(--text-secondary);\n  font-size: 17px;\n  line-height: 1.7;\n  margin: 0 0 32px;\n}\n\n.contact-routes {\n  display: grid;\n  gap: 14px;\n  margin: 0;\n}\n\n.contact-route {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: 8px;\n  padding: 18px 22px;\n}\n\n.contact-route dt {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n\n.contact-route dd {\n  margin: 4px 0 0;\n}\n\n.contact-route-link a {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 20px;\n  font-weight: 700;\n  color: var(--text-primary);\n}\n\n.contact-route-text {\n  color: var(--text-secondary);\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n.contact-note {\n  color: var(--text-secondary);\n  font-size: 15px;\n  line-height: 1.7;\n  margin: 28px 0 0;\n}\n"
text sap8 "assets/turing-look.css"
text sab8 "/*\n * The Turing look: one shared layer that gives every page the feel of\n * /turing/ (cinematic near-black page, soft blue and green glow, small\n * blue capital kickers, large heavy headings, roomy sections, rounded\n * cards that lift on hover, pill badges, a blue-to-green reading bar).\n * Loaded last on every page so it wins over older page styles.\n * Motion (reading bar, glide-in) comes from /js/turing-look.js, the same\n * effects the Turing page runs; without it every element simply shows.\n * The /turing/ page itself does not load this file.\n */\n:root {\n  --tl-bg: #08090c;\n  --tl-card: #0e1219;\n  --tl-card-2: #131822;\n  --tl-line: #1c2536;\n  --tl-line-2: #2a3648;\n  --tl-ink: #f1f5f9;\n  --tl-ink-2: #94a3b8;\n  --tl-ink-3: #8ea0b5;\n  --tl-blue: #2d7ff9;\n  --tl-blue-soft: #7db4ff;\n  --tl-green: #00e599;\n  --tl-amber: #f59e0b;\n  --tl-violet: #a78bfa;\n  --tl-radius: 18px;\n}\n\n/* ---------- page ---------- */\nhtml, body {\n  background-color: var(--tl-bg);\n  color: var(--tl-ink);\n  /* clip, not hidden: hidden turns the page into its own scroll box and\n     the pinned header stops sticking. */\n  overflow-x: clip;\n}\n\nbody {\n  background-image:\n    radial-gradient(ellipse 70% 42rem at 50% -8rem, rgba(45, 127, 249, 0.13), transparent 70%),\n    radial-gradient(ellipse 40% 30rem at 88% 10rem, rgba(0, 229, 153, 0.05), transparent 70%);\n  background-repeat: no-repeat;\n}\n\n/* The old technical grid gives way to the Turing page's clean field. */\n.bg-grid {\n  background-image: none !important;\n}\n\n/* Reading bar across the top, blue to green, as on /turing/.\n   The bar element is added by /js/turing-look.js. */\n.tl-progress {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 0;\n  height: 3px;\n  z-index: 200;\n  background: linear-gradient(90deg, var(--tl-blue), var(--tl-green));\n  pointer-events: none;\n}\n\n/* A soft cross-fade when moving from one page to the next. */\n@view-transition {\n  navigation: auto;\n}\n\n::view-transition-old(root),\n::view-transition-new(root) {\n  animation-duration: 0.35s;\n}\n\n/* ---------- header ---------- */\n.aien-header {\n  background: rgba(8, 9, 12, 0.72);\n  -webkit-backdrop-filter: blur(14px);\n  backdrop-filter: blur(14px);\n}\n\n/* ---------- sections ---------- */\n.hub-section,\n.narr-section,\n.rs-section {\n  padding-top: 96px;\n  padding-bottom: 96px;\n}\n\n@media (max-width: 640px) {\n  .hub-section,\n  .narr-section,\n  .rs-section {\n    padding-top: 56px;\n    padding-bottom: 56px;\n  }\n}\n\n.section-alt {\n  background: transparent;\n  border-color: var(--tl-line);\n}\n\n/* ---------- kickers: small blue capitals above a heading ---------- */\n.kicker,\n.blog-kicker,\n.rs-kicker,\n.hub-kicker,\n.narr-kicker,\n.section-head .badge,\n.theory-fig .fig-kicker {\n  display: inline-block;\n  font-family: var(--font-mono, ui-monospace, monospace);\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--tl-blue);\n  background: none;\n  border: 0;\n  padding: 0;\n  margin-bottom: 18px;\n}\n\n/* ---------- headings ---------- */\nh1,\n.blog-title,\n.rs-page-title,\n.hub-title,\n.narr-title {\n  font-weight: 800;\n  letter-spacing: -0.03em;\n  line-height: 1.04;\n  color: var(--tl-ink);\n}\n\n.blog-title,\n.rs-page-title,\n.hub-title,\n.narr-title,\n.wrap > header h1,\n.page-head h1 {\n  font-size: clamp(38px, 6vw, 68px);\n}\n\nh2,\n.section-head h2,\n.hub-h2,\n.rs-h2,\n.narr-section h2,\n.blog-wrap article h2,\n.loop-title,\n.home-questions-title {\n  font-weight: 800;\n  letter-spacing: -0.025em;\n  line-height: 1.1;\n  color: var(--tl-ink);\n}\n\n.section-head h2,\n.hub-h2,\n.rs-h2,\n.narr-section h2,\n.loop-title,\n.home-questions-title {\n  font-size: clamp(30px, 4.4vw, 46px);\n  margin-bottom: 18px;\n}\n\nh3 {\n  letter-spacing: -0.01em;\n}\n\n/* Lead paragraphs: larger, calm grey, white for emphasis. */\n.section-head p,\n.blog-standfirst,\n.rs-standfirst,\n.hub-standfirst,\n.narr-mission p,\n.loop-intro,\n.rs-section-lede,\np.lead,\n.lead {\n  font-size: 18px;\n  line-height: 1.65;\n  color: var(--tl-ink-2);\n}\n\n.section-head p strong,\n.lead strong,\n.hub-standfirst strong {\n  color: var(--tl-ink);\n}\n\n/* ---------- cards: dark, rounded, lift on hover ---------- */\n.glow-box,\n.blog-card,\n.hub-card,\n.narr-card,\n.rs-card,\n.rs-attempt,\n.rs-impl-item,\n.home-q,\n.receipt,\n.pdf-callout,\n.hub-callout,\n.hub-data,\n.theory-fig,\n.entry,\n.card,\n.step-card,\n.doc {\n  background: var(--tl-card);\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.glow-box:hover,\n.blog-card:hover,\n.hub-card:hover,\n.narr-card:hover,\n.rs-card:hover,\n.home-q:hover,\n.entry:hover,\n.card:hover {\n  border-color: var(--tl-blue);\n  transform: translateY(-4px);\n  box-shadow: 0 18px 50px rgba(45, 127, 249, 0.14);\n}\n\n/* Status cards keep their verdict colour on the border. */\n.rs-card--fail:hover { border-color: var(--rs-fail, #f87171); }\n\n/* Feature panels: the Turing \"big stat\" gradient. */\n.pdf-callout,\n.hub-callout,\n.receipt {\n  background: linear-gradient(135deg, rgba(45, 127, 249, 0.1), rgba(0, 229, 153, 0.06)), var(--tl-card);\n}\n\n/* Code and formula blocks sit on the page colour, as on /turing/. */\npre,\n.narr-formula,\n.narr-formula pre,\n.data-table-wrap {\n  border-radius: 14px;\n}\n\npre,\n.narr-formula pre {\n  background: var(--tl-bg);\n  border: 1px solid var(--tl-line);\n}\n\n/* ---------- badges: pills ---------- */\n.badge,\n.rs-badge,\n.home-q-badge,\n.source-tag {\n  border-radius: 999px;\n  letter-spacing: 0.06em;\n}\n\n/* ---------- buttons: the Turing page's two button styles ---------- */\n.home-cta,\n.hub-button,\n.pdf-button,\n.btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 14px 28px;\n  border-radius: 12px;\n  font-weight: 700;\n  font-size: 15px;\n  text-decoration: none;\n  border: 1px solid var(--tl-line);\n  background: transparent;\n  color: var(--tl-ink-2);\n  transition: 0.25s;\n}\n\n.home-cta-primary,\n.hub-button,\n.pdf-button,\n.btn:not(.ghost):not(.secondary) {\n  border-color: var(--tl-blue);\n  background: rgba(45, 127, 249, 0.14);\n  color: var(--tl-blue-soft);\n}\n\n.home-cta:hover,\n.hub-button:hover,\n.pdf-button:hover,\n.btn:hover {\n  border-color: var(--tl-blue);\n  color: var(--tl-ink);\n  transform: translateY(-2px);\n}\n\n.home-cta-primary:hover,\n.hub-button:hover,\n.pdf-button:hover,\n.btn:not(.ghost):not(.secondary):hover {\n  background: rgba(45, 127, 249, 0.28);\n  color: var(--tl-blue-soft);\n  box-shadow: 0 12px 40px rgba(45, 127, 249, 0.25);\n}\n\n/* Inline \"read more\" links in the Turing blue. */\n.readmore,\n.blog-read-more,\n.prose-link {\n  color: var(--tl-blue-soft);\n}\n\n/* ---------- tables ---------- */\n.data-table th,\n.status-table th {\n  font-family: var(--font-mono, ui-monospace, monospace);\n  font-size: 11.5px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--tl-ink-3);\n}\n\n/* ---------- footer ---------- */\n.aien-footer {\n  border-top: 1px solid var(--tl-line);\n  background: transparent;\n}\n\n/* ---------- glide up and fade in once, as on /turing/ ----------\n   The script adds .tl-reveal only to things below the first screen and\n   .tl-in when they come into view. \"translate\" is used so the hover lift\n   (\"transform\") still works on revealed cards. */\n:root .tl-reveal {\n  opacity: 0;\n  translate: 0 34px;\n  transition: opacity 0.8s ease, translate 0.8s ease, border-color 0.3s ease,\n    transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n:root .tl-reveal.tl-in {\n  opacity: 1;\n  translate: none;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :root .tl-reveal {\n    opacity: 1;\n    translate: none;\n    transition: none;\n  }\n  @view-transition {\n    navigation: none;\n  }\n}\n\n/* ---------- research and paper pages ---------- */\n/* Their sections set their own margin; the site-wide .section padding\n   stacked on top of it and left large empty gaps. */\n.research-wrap .section {\n  padding: 0;\n  margin: 64px 0;\n}\n\n.research-wrap {\n  padding-top: 72px;\n}\n\n.research-wrap .section > h2 {\n  font-size: clamp(24px, 3vw, 30px);\n  margin-bottom: 16px;\n}\n\n.research-wrap .paper-sub {\n  font-size: 19px;\n  line-height: 1.6;\n  color: var(--tl-ink-2);\n}\n\n.research-wrap .artifact {\n  border-radius: 14px;\n  background: var(--tl-card);\n  border-color: var(--tl-line);\n  transition: border-color 0.3s ease;\n}\n\n.research-wrap .artifact:hover {\n  border-color: var(--tl-blue);\n}\n\n.research-wrap .btn.forthcoming:hover {\n  transform: none;\n  border-color: var(--tl-line);\n  color: var(--tl-ink-2);\n}\n\n/* ---------- every box is a link to its evidence on GitHub ----------\n   Each box carries one a.box-link in its footer. The anchor's ::after is\n   stretched over the whole box, so the box is the click target; links\n   inside the box sit above it (z-index 2) and keep working. */\n.mx-card,\n.mx-row,\n.glow-box,\n.lineage-card,\n.lineage-role,\n.status-row,\n.live-row,\n.receipt,\n.rs-card,\n.rs-step,\n.rs-impl-item,\n.hub-card,\n.narr-card,\n.blog-card,\n.now-card,\n.now-queue-row,\n.now-tl {\n  position: relative;\n}\n\na.box-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-top: auto;\n  font-family: var(--font-mono, ui-monospace, monospace);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--tl-blue-soft);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: color 0.3s ease;\n}\n\n.box-link::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  border-radius: inherit;\n}\n\n.box-link .box-arrow {\n  display: inline-block;\n  font-size: 13px;\n  line-height: 1;\n  transition: transform 0.3s cubic-bezier(.22,.61,.36,1);\n}\n\na.box-link-source {\n  color: var(--tl-ink-3);\n}\n\n/* Narrow cards let the words wrap rather than clip. */\n.hub-card a.box-link,\n.rs-card a.box-link,\n.lineage-card a.box-link,\n.lineage-role a.box-link {\n  white-space: normal;\n  line-height: 1.5;\n}\n\n/* Inline links and controls inside a box stay above the stretched link. */\n.mx-card a:not(.box-link),\n.mx-row a:not(.box-link),\n.glow-box a:not(.box-link),\n.glow-box button,\n.glow-box #turing-game,\n.status-row a:not(.box-link),\n.live-row a:not(.box-link),\n.receipt a:not(.box-link),\n.rs-card a:not(.box-link),\n.rs-step a:not(.box-link),\n.rs-impl-item a:not(.box-link),\n.rs-impl-item details,\n.hub-card a:not(.box-link),\n.narr-card a:not(.box-link),\n.blog-card a:not(.box-link),\n.now-card a:not(.box-link),\n.now-queue-row a:not(.box-link),\n.now-tl a:not(.box-link) {\n  position: relative;\n  z-index: 2;\n}\n\n/* Hover: the existing lift, and the border goes to the blue accent. */\n.mx-card:hover,\n.mx-row:hover,\n.lineage-card:hover,\n.lineage-role:hover,\n.status-row:hover,\n.live-row:hover,\n.receipt:hover,\n.rs-step:hover .rs-step-body,\n.rs-impl-item:hover,\n.now-card:hover,\n.now-queue-row:hover,\n.now-tl:hover {\n  border-color: var(--tl-blue);\n}\n\n.lineage-role,\n.status-row,\n.rs-impl-item,\n.now-queue-row,\n.now-tl {\n  transition: border-color 0.3s ease, background-color 0.3s ease;\n}\n\n.mx-row:hover td,\n.live-row:hover td {\n  background: rgba(45, 127, 249, 0.05);\n}\n\n.mx-card:hover .box-link,\n.mx-row:hover .box-link,\n.glow-box:hover .box-link,\n.lineage-card:hover .box-link,\n.lineage-role:hover .box-link,\n.status-row:hover .box-link,\n.live-row:hover .box-link,\n.receipt:hover .box-link,\n.rs-card:hover .box-link,\n.rs-step:hover .box-link,\n.rs-impl-item:hover .box-link,\n.hub-card:hover .box-link,\n.narr-card:hover .box-link,\n.blog-card:hover .box-link,\n.now-card:hover .box-link,\n.now-queue-row:hover .box-link,\n.now-tl:hover .box-link {\n  color: var(--tl-green);\n}\n\n.mx-card:hover .box-arrow,\n.glow-box:hover .box-arrow,\n.rs-card:hover .box-arrow,\n.hub-card:hover .box-arrow,\n.now-card:hover .box-arrow {\n  transform: translate(2px, -2px);\n}\n\n.box-link:focus-visible {\n  outline: none;\n}\n\n.box-link:focus-visible::after {\n  outline: 2px solid var(--tl-blue);\n  outline-offset: 2px;\n}\n\n/* Where the footer sits in each kind of box. */\n.mx-card .box-link,\n.rs-card .box-link,\n.hub-card .box-link,\n.narr-card .box-link,\n.blog-card .box-link,\n.now-card .box-link {\n  display: flex;\n  width: fit-content;\n  margin-top: 14px;\n}\n\n.narr-card .box-link {\n  margin-bottom: 16px;\n}\n\n.lineage-card .box-link,\n.lineage-role .box-link {\n  margin-top: 10px;\n}\n\n.status-row .box-link,\n.rs-impl-item .box-link,\n.rs-step .box-link {\n  margin-top: 8px;\n}\n\n/* Implementation items are cards in this look; give the words room. */\n.rs-impl-item {\n  padding: 16px 20px;\n}\n\n.rs-impl-list {\n  gap: 10px;\n}\n\n.rs-step .box-link {\n  display: inline-flex;\n}\n\n.mx-row .box-link,\n.live-row .box-link,\n.status-table td.name .box-link {\n  margin-top: 6px;\n  display: inline-flex;\n  color: var(--tl-blue-soft);\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.now-queue-row .box-link {\n  grid-column: 2 / -1;\n  margin-top: 2px;\n}\n\n.now-tl .box-link {\n  margin-top: 8px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .box-link,\n  .box-link .box-arrow {\n    transition: none;\n  }\n}\n\n/* Links to /omega/ wherever the site names Omega in running text. */\na.omega-link {\n  color: var(--tl-blue-soft);\n  text-decoration: underline;\n  text-decoration-color: rgba(125, 180, 255, 0.4);\n  text-underline-offset: 3px;\n}\na.omega-link:hover { text-decoration-color: var(--tl-blue-soft); }\n"
text sap9 "assets/dash.css"
text sab9 "/* /dash/: one compact screen. Palette tokens only; no motion. */\n\n.dash { padding-top: 10px; padding-bottom: 16px; }\n\n.dash-top {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 4px 16px;\n  margin-bottom: 10px;\n}\n.dash-title { font-size: 26px; line-height: 1.1; margin: 0; color: var(--text-primary); }\n.dash-meta { margin: 0; font-size: 12px; color: var(--text-muted); }\n.dash-warn {\n  margin: 0 0 12px;\n  padding: 6px 10px;\n  border-left: 3px solid var(--accent-amber);\n  background: var(--bg-surface);\n  color: var(--text-secondary);\n  font-size: 13px;\n}\n.dash-none { margin: 4px 0; font-size: 13px; color: var(--text-muted); }\n\n.dash-pairs + .dash-pairs { margin-top: 6px; }\n.dash-h {\n  margin: 0 0 6px;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--text-secondary);\n}\n.dash-h a { color: inherit; position: relative; z-index: 1; }\n.dash-h-note { font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--text-muted); }\n\n/* Quota cards, Spark and Work flow into balanced columns, so short cards\n   stack under each other instead of stretching to the tallest one. */\n.dash-flow { columns: 3 300px; column-gap: 10px; }\n.dash-flow > .dash-card { break-inside: avoid; margin-bottom: 8px; }\n\n.dash-card {\n  position: relative;\n  padding: 8px 12px 6px;\n  border: 1px solid var(--border-subtle);\n  border-radius: 8px;\n  background: var(--bg-card);\n}\n.dash-card:hover { background: var(--bg-card-hover); }\n.dash-card .box-link {\n  display: block;\n  margin-top: 3px;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.dash-acct + .dash-acct { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border-subtle); }\n.dash-acct-h { font-size: 12px; color: var(--text-secondary); margin-bottom: 2px; }\n.dash-plan {\n  margin-left: 6px;\n  padding: 0 5px;\n  border: 1px solid var(--border-subtle);\n  border-radius: 4px;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.dash-limit {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 64px 34px 84px;\n  align-items: center;\n  gap: 8px;\n  min-height: 20px;\n  font-size: 12.5px;\n  color: var(--text-primary);\n}\n.dash-limit-k { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.dash-meter { width: 100%; height: 8px; }\n.dash-limit-v { text-align: right; font-size: 12px; }\n.dash-limit-r { font-size: 11px; color: var(--text-muted); white-space: nowrap; }\n.dash-out .dash-limit-k,\n.dash-out .dash-limit-v { color: var(--text-muted); }\n.dash-out .dash-limit-r { color: var(--accent-amber); }\n\n.dash-kv {\n  display: grid;\n  grid-template-columns: max-content minmax(0, 1fr);\n  gap: 2px 14px;\n  margin: 0;\n  font-size: 13px;\n}\n.dash-kv dt { color: var(--text-muted); }\n.dash-kv dd { margin: 0; color: var(--text-primary); }\n\n.dash-pairs-h { margin: 0 0 2px; font-size: 12px; color: var(--text-secondary); }\n.dash-pairs dl {\n  display: grid;\n  grid-template-columns: max-content minmax(0, 1fr);\n  gap: 1px 10px;\n  margin: 0;\n  font-size: 12px;\n}\n.dash-pairs dt { color: var(--text-muted); }\n.dash-pairs dd { margin: 0; color: var(--text-primary); overflow-wrap: anywhere; }\n\n@media (max-width: 420px) {\n  .dash-limit { grid-template-columns: minmax(0, 1fr) 54px 32px; }\n  .dash-limit-r { grid-column: 1 / -1; margin-top: -2px; }\n}\n"
text sap10 "assets/progress.css"
text sab10 "\n    #aien-growth-observatory {color:var(--foreground);position:relative;}\n    #aien-growth-observatory .ag-mast {display:flex;justify-content:space-between;align-items:start;gap:24px;padding-top:8px;margin-bottom:24px;}\n    #aien-growth-observatory .ag-kicker {letter-spacing:.15em;text-transform:uppercase;color:var(--muted-foreground);font-weight:500;}\n    #aien-growth-observatory h1 {margin:8px 0 12px;}\n    #aien-growth-observatory h2 {margin:0;}\n    #aien-growth-observatory .ag-scope {color:var(--muted-foreground);margin:0;}\n    #aien-growth-observatory .ag-stats {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:28px 0 22px;}\n    #aien-growth-observatory .ag-stat h2 {margin:4px 0;}\n    #aien-growth-observatory .ag-stat span {display:block;}\n    #aien-growth-observatory .ag-nav {margin:18px 0 12px;}\n    #aien-growth-observatory .ag-date {display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap;margin-bottom:8px;}\n    #aien-growth-observatory .ag-legends {display:flex;flex-wrap:wrap;gap:10px 20px;margin:10px 0;}\n    #aien-growth-observatory .ag-legend {background:none;border:0;padding:0;color:var(--foreground);font:inherit;display:inline-flex;gap:8px;align-items:center;}\n    #aien-growth-observatory .ag-legend[aria-pressed=\"false\"] {opacity:.45;}\n    #aien-growth-observatory .ag-swatch {width:18px;height:3px;display:inline-block;}\n    #aien-growth-observatory .ag-plot {min-width:0;position:relative;}\n    #aien-growth-observatory .ag-plot svg {display:block;overflow:visible;width:100%;}\n    #aien-growth-observatory .ag-chart text {fill:var(--foreground);font-size:12px;font-weight:400;}\n    #aien-growth-observatory .ag-chart .domain {display:none;}\n    #aien-growth-observatory .ag-chart .tick line {stroke:var(--border);}\n    #aien-growth-observatory .ag-chart .axis-title {fill:var(--muted-foreground);}\n    #aien-growth-observatory .ag-section {margin-top:34px;}\n    #aien-growth-observatory .ag-section-head {display:flex;align-items:baseline;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:10px;}\n    #aien-growth-observatory .ag-pair {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px;margin-top:30px;}\n    #aien-growth-observatory .ag-pair h3 {margin:0 0 6px;}\n    #aien-growth-observatory .ag-caption {color:var(--muted-foreground);margin:8px 0 0;}\n    #aien-growth-observatory .ag-tooltip {position:absolute;display:none;z-index:10;pointer-events:none;max-width:280px;}\n    #aien-growth-observatory .ag-tooltip-row {display:flex;justify-content:space-between;gap:22px;}\n    #aien-growth-observatory .ag-evidence {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:20px 0 0;}\n    #aien-growth-observatory .ag-evidence h3 {margin:6px 0;}\n    #aien-growth-observatory .ag-evidence p {margin:4px 0;}\n    #aien-growth-observatory .ag-events {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28px;row-gap:0;}\n    #aien-growth-observatory .ag-event {padding:15px 0;border-bottom:1px solid var(--border);}\n    #aien-growth-observatory .ag-event summary {list-style:none;}\n    #aien-growth-observatory .ag-event summary::-webkit-details-marker {display:none;}\n    #aien-growth-observatory .ag-event-title {display:flex;align-items:start;justify-content:space-between;gap:12px;margin-top:7px;font-weight:500;}\n    #aien-growth-observatory .ag-event-meta {display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;}\n    #aien-growth-observatory .ag-event p {margin:10px 0;}\n    #aien-growth-observatory .ag-barcell {min-width:110px;}\n    #aien-growth-observatory .ag-bar {display:flex;height:5px;background:color-mix(in srgb,var(--foreground) 6%,transparent);margin-top:6px;}\n    #aien-growth-observatory .ag-bar > span {display:block;}\n    #aien-growth-observatory .ag-methods {margin-top:30px;}\n    #aien-growth-observatory .ag-methods p {margin:12px 0;}\n    #aien-growth-observatory .ag-pins {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px 22px;}\n    #aien-growth-observatory .ag-pin {display:flex;justify-content:space-between;gap:10px;min-width:0;}\n    #aien-growth-observatory .ag-pin a {overflow-wrap:anywhere;}\n    @media(max-width:740px) {#aien-growth-observatory .ag-pair {grid-template-columns:1fr;gap:28px;}#aien-growth-observatory .ag-evidence {grid-template-columns:1fr;gap:18px;}}\n    @media(max-width:540px) {#aien-growth-observatory .ag-stats {grid-template-columns:1fr;gap:14px;}#aien-growth-observatory .ag-stat {display:flex;justify-content:space-between;gap:14px;align-items:center;}#aien-growth-observatory .ag-stat h2 {margin:0;}#aien-growth-observatory .ag-stat .ag-stat-context {display:none;}#aien-growth-observatory .ag-events,#aien-growth-observatory .ag-pins {grid-template-columns:1fr;}#aien-growth-observatory .ag-mast {margin-bottom:14px;}}\n  /* Match the existing AIEN website while keeping analytical styles scoped. */\n#aien-growth-observatory {\n  --foreground: var(--text-primary); --muted-foreground: var(--text-secondary);\n  --border: var(--border-subtle); --viz-series-1: #63a9ff; --viz-series-2: #00e599;\n  --viz-series-3: #f5b75e; --viz-series-4: #bda0ff; --viz-series-5: #56cdd6;\n  width: min(1200px,100%); margin: 0 auto; padding: 52px 24px 72px; font-size:16px; font-weight:400;\n}\n#aien-growth-observatory h1 {font-size:clamp(30px,4vw,42px);font-weight:600;letter-spacing:-.035em;line-height:1.2;}\n#aien-growth-observatory h2 {font-size:22px;font-weight:500;letter-spacing:-.02em;}\n#aien-growth-observatory h3 {font-size:18px;font-weight:500;}\n#aien-growth-observatory .text-small {font-size:13px;line-height:1.6;}\n#aien-growth-observatory .text-muted {color:var(--muted-foreground);}\n#aien-growth-observatory .tabular-nums {font-variant-numeric:tabular-nums;font-family:var(--font-mono);}\n#aien-growth-observatory .text-end {text-align:right;}\n#aien-growth-observatory .cursor-interaction {cursor:pointer;}\n#aien-growth-observatory a {color:var(--viz-series-1);}\n#aien-growth-observatory a:hover {text-decoration:underline;text-underline-offset:4px;}\n#aien-growth-observatory .ag-mast {padding:0 0 24px;border-bottom:1px solid var(--border);}\n#aien-growth-observatory .ag-refresh {display:flex;align-items:flex-end;flex-direction:column;gap:8px;font-size:12px;color:var(--muted-foreground);white-space:nowrap;}\n#aien-growth-observatory #ag-freshness {color:var(--viz-series-2);}\n#aien-growth-observatory #ag-freshness[data-stale=\"true\"] {color:var(--viz-series-3);}\n#aien-growth-observatory #ag-refresh {background:var(--bg-surface);color:var(--foreground);border:1px solid var(--border);border-radius:6px;padding:8px 12px;font-size:12px;cursor:pointer;}\n#aien-growth-observatory #ag-refresh:hover {border-color:var(--viz-series-1);}\n#aien-growth-observatory .ag-stats {gap:32px;margin:32px 0;}\n#aien-growth-observatory .ag-stat {padding:0 0 22px;border-bottom:1px solid var(--border);}\n#aien-growth-observatory .ag-stat h2 {font-size:clamp(26px,3.2vw,36px);font-weight:500;line-height:1.35;margin:8px 0;letter-spacing:-.05em;}\n#aien-growth-observatory .ag-nav {margin:20px 0 32px;padding:16px 20px;background:var(--bg-surface);border:1px solid var(--border);border-radius:8px;}\n#aien-growth-observatory .form-label {font-size:14px;}\n#aien-growth-observatory .form-range {width:100%;height:24px;accent-color:var(--viz-series-1);cursor:ew-resize;}\n#aien-growth-observatory .ag-pair {gap:32px;margin-top:36px;}\n#aien-growth-observatory .ag-pair section {min-width:0;}\n#aien-growth-observatory .ag-section {margin-top:48px;}\n#aien-growth-observatory .ag-section-head {margin-bottom:16px;}\n#aien-growth-observatory .ag-chart text {font-family:var(--font-sans);fill:var(--muted-foreground);}\n#aien-growth-observatory .ag-tooltip {padding:12px 16px;border:1px solid #3d506b;border-radius:6px;background:#131c2b;box-shadow:0 12px 28px #0006;}\n#aien-growth-observatory .ag-evidence {padding:22px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}\n#aien-growth-observatory .ag-evidence h3 {font-size:19px;color:var(--foreground);}\n#aien-growth-observatory .ag-event-title {font-size:15px;line-height:1.5;}\n#aien-growth-observatory .ag-event-meta {font-family:var(--font-mono);font-size:12px;}\n#aien-growth-observatory .table-responsive {overflow-x:auto;margin-top:16px;}\n#aien-growth-observatory .table {width:100%;border-collapse:collapse;min-width:630px;font-size:14px;}\n#aien-growth-observatory .table th {text-transform:uppercase;letter-spacing:.05em;font-size:11px;font-weight:500;color:var(--muted-foreground);padding:12px 8px;border-bottom:1px solid #354156;white-space:nowrap;}\n#aien-growth-observatory .table td {padding:12px 8px;border-bottom:1px solid var(--border);}\n#aien-growth-observatory .table th:first-child,#aien-growth-observatory .table td:first-child {padding-left:0;}\n#aien-growth-observatory .table tbody tr:hover {background:var(--bg-surface);}\n#aien-growth-observatory .ag-methods {border-top:1px solid var(--border);padding-top:20px;}\n#aien-growth-observatory .ag-methods summary {color:var(--muted-foreground);font-size:14px;}\n#aien-growth-observatory .ag-pins {margin-top:20px;}\n#aien-growth-observatory .ag-pin code {color:var(--muted-foreground);font-size:11px;}\n@media(max-width:740px) {#aien-growth-observatory {padding:32px 20px 48px;}#aien-growth-observatory .ag-mast {flex-direction:column;gap:16px;}#aien-growth-observatory .ag-refresh {flex-direction:row;align-items:center;flex-wrap:wrap;white-space:normal;}#aien-growth-observatory .ag-refresh > .text-small {display:none;}}\n@media(max-width:540px) {#aien-growth-observatory .ag-stats {gap:14px;}#aien-growth-observatory .ag-stat {padding-bottom:14px;}#aien-growth-observatory .ag-stat h2 {font-size:25px;}#aien-growth-observatory .ag-nav {padding:12px;}#aien-growth-observatory .ag-date {gap:4px;}}\n"
text sap11 "assets/site-nav.css"
text sab11 "/*\n * Shared site header: the six-section navigation (NARR-NAV).\n * Self-contained on purpose: hand-written pages under public/ that do not\n * load style.css (post-llm-case, licensing) link this file too, so every\n * value has its own fallback and nothing depends on page tokens.\n * Phone width: the nav wraps onto rows. No horizontal scroll, no script.\n */\n.aien-header {\n  --an-bg: rgba(8, 9, 12, 0.92);\n  --an-border: #1c2536;\n  --an-text: #f1f5f9;\n  --an-text-2: #94a3b8;\n  --an-muted: #8ea0b5;\n  --an-blue: #2d7ff9;\n  --an-green: #00e599;\n  --an-sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  --an-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n  box-sizing: border-box;\n  border-bottom: 1px solid var(--an-border);\n  background: var(--an-bg);\n  -webkit-backdrop-filter: blur(12px);\n  backdrop-filter: blur(12px);\n  padding: 14px 0;\n  font-family: var(--an-sans);\n  line-height: 1.4;\n  color: var(--an-text);\n  z-index: 50;\n}\n\n.aien-header *,\n.aien-header *::before,\n.aien-header *::after {\n  box-sizing: border-box;\n}\n\n.aien-header-inner {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 24px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px 24px;\n}\n\n.aien-header .aien-brand,\n.aien-header .aien-brand:hover {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  color: var(--an-text);\n  text-decoration: none;\n}\n\n.aien-brand-mark {\n  width: 32px;\n  height: 32px;\n  border-radius: 6px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--an-blue);\n  background: linear-gradient(135deg, #131822 0%, #1e2638 100%);\n  border: 1px solid var(--an-blue);\n  box-shadow: 0 0 12px rgba(45, 127, 249, 0.15);\n  flex: none;\n}\n\n.aien-brand-copy {\n  display: flex;\n  flex-direction: column;\n}\n\n.aien-brand-name {\n  font-weight: 700;\n  font-size: 18px;\n  letter-spacing: -0.02em;\n  color: var(--an-text);\n}\n\n.aien-brand-tag {\n  font-family: var(--an-mono);\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  color: var(--an-muted);\n}\n\n.aien-nav {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px 20px;\n}\n\n.aien-nav ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.aien-nav-primary {\n  gap: 6px 20px;\n}\n\n.aien-nav .aien-nav-secondary {\n  gap: 6px 14px;\n  padding-left: 20px;\n  border-left: 1px solid var(--an-border);\n}\n\n.aien-nav a.aien-nav-link {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--an-text-2);\n  text-decoration: none;\n  padding: 4px 0;\n  border-bottom: 2px solid transparent;\n  transition: color 0.15s ease, border-color 0.15s ease;\n}\n\n.aien-nav a.aien-nav-minor {\n  font-family: var(--an-mono);\n  font-size: 12px;\n  color: var(--an-muted);\n  text-decoration: none;\n  padding: 4px 0;\n}\n\n.aien-nav a[href=\"/#waitlist\"] {\n  color: var(--an-green);\n}\n\n.aien-nav a.aien-nav-link:hover,\n.aien-nav a.aien-nav-minor:hover {\n  color: var(--an-text);\n  border-bottom-color: var(--an-blue);\n}\n\n.aien-nav a.aien-nav-link:focus-visible,\n.aien-nav a.aien-nav-minor:focus-visible,\n.aien-brand:focus-visible {\n  outline: 2px solid var(--an-green);\n  outline-offset: 3px;\n}\n\n/* Wide screens: the header stays pinned while reading. A page with its own\n   sticky bar opts out with data-sticky=\"off\" on the header. */\n@media (min-width: 1100px) {\n  .aien-header {\n    position: sticky;\n    top: 0;\n  }\n}\n\n/* Narrow screens: brand on its own row, sections wrap below it. */\n@media (max-width: 1099px) {\n  .aien-nav {\n    width: 100%;\n  }\n}\n\n@media (max-width: 600px) {\n  .aien-header-inner {\n    padding: 0 16px;\n  }\n\n  .aien-nav-primary {\n    gap: 4px 16px;\n  }\n\n  .aien-nav a.aien-nav-link {\n    font-size: 13.5px;\n  }\n\n  .aien-nav .aien-nav-secondary {\n    width: 100%;\n    padding-left: 0;\n    padding-top: 8px;\n    border-left: none;\n    border-top: 1px solid var(--an-border);\n  }\n}\n\n.aien-header[data-sticky=\"off\"] {\n  position: static;\n}\n\n/* Reach me: the contact page and Follow me on X, last in every header\n   (components/contact.rs). A plain link to x.com: no widget, no script. */\n.aien-nav a.aien-x-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  font-family: var(--an-mono);\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--an-text);\n  text-decoration: none;\n  padding: 4px 11px;\n  border: 1px solid var(--an-blue);\n  border-radius: 999px;\n  background: rgba(45, 127, 249, 0.1);\n  transition: background-color 0.15s ease;\n}\n\n.aien-nav a.aien-x-link:hover {\n  background: rgba(45, 127, 249, 0.22);\n}\n\n.aien-nav a.aien-x-link:focus-visible {\n  outline: 2px solid var(--an-green);\n  outline-offset: 3px;\n}\n\n.aien-nav .aien-x-handle {\n  color: var(--an-text-2);\n}\n\n.aien-x-mark {\n  flex: none;\n}\n\n/* The contact line in every footer. Hand-written pages that have no shared\n   footer get it in .aien-reach-strip, so every value has a fallback. */\n.aien-reach-strip {\n  box-sizing: border-box;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 20px 24px;\n  border-top: 1px solid var(--border-subtle, #1c2536);\n}\n\n.aien-reach-foot {\n  margin-top: 14px;\n  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace);\n  font-size: 12px;\n  line-height: 1.8;\n  color: var(--text-muted, #8ea0b5);\n}\n\n.aien-reach-strip .aien-reach-foot {\n  margin-top: 0;\n}\n\n.aien-reach-foot p {\n  margin: 0;\n}\n\n.aien-reach-foot a {\n  color: var(--text-secondary, #94a3b8);\n}\n\n.aien-reach-foot a:hover {\n  color: var(--text-primary, #f1f5f9);\n}\n\n.aien-reach-foot .aien-reach-title a {\n  color: var(--text-primary, #f1f5f9);\n  font-weight: 700;\n}\n\n.aien-reach-foot a.aien-x-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--text-primary, #f1f5f9);\n}\n"
text sap12 "assets/omega.css"
text sab12 "/*\n * /omega/: what Omega is. Built inside the Turing look (turing-look.css):\n * near-black field, blue and green glow, mono kickers, heavy headings,\n * 18px cards. The one idea of this page is the CUDA stack drawn as a\n * column of layers, top of the stack to the chip, each lit by its status:\n * green PASS, blue PARTIAL, a hollow amber MISSING, grey for the firmware\n * that stays. A meter above the map shows the whole stack at a glance.\n */\n:root {\n  --om-pass: #00e599;\n  --om-partial: #7db4ff;\n  --om-missing: #f59e0b;\n  --om-fixed: #5b6b85;\n}\n\n.om-page .container { max-width: 1120px; }\n\n/* ---------- hero ---------- */\n.om-hero { padding: 88px 0 40px; }\n.om-kicker {\n  font-family: var(--font-mono, ui-monospace, monospace);\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--tl-blue);\n  margin: 0 0 18px;\n}\n.om-title {\n  font-size: clamp(36px, 5.4vw, 64px);\n  font-weight: 800;\n  letter-spacing: -0.03em;\n  line-height: 1.05;\n  max-width: 940px;\n  margin: 0 0 24px;\n}\n.om-lead {\n  font-size: 19px;\n  line-height: 1.6;\n  color: var(--tl-ink-2);\n  max-width: 780px;\n  margin: 0 0 14px;\n}\n.om-verdicts {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n  margin: 34px 0 22px;\n}\n.om-verdict {\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  padding: 22px 24px;\n  background: var(--tl-card);\n}\n.om-verdict-true { border-color: rgba(0, 229, 153, 0.35); box-shadow: 0 0 40px rgba(0, 229, 153, 0.06); }\n.om-verdict-not { border-color: rgba(245, 158, 11, 0.35); }\n.om-verdict-k {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  margin: 0 0 10px;\n}\n.om-verdict-true .om-verdict-k { color: var(--om-pass); }\n.om-verdict-not .om-verdict-k { color: var(--om-missing); }\n.om-verdict-s { font-size: 18px; font-weight: 600; line-height: 1.45; color: var(--tl-ink); margin: 0 0 12px; }\n.om-verdict-a { font-family: var(--font-mono); font-size: 12.5px; color: var(--tl-blue-soft); }\n.om-verdict-not .om-verdict-a { color: var(--om-missing); }\n.om-source { font-size: 13.5px; line-height: 1.7; color: var(--tl-ink-3); max-width: 900px; }\n.om-source a, .om-sub a { color: var(--tl-blue-soft); }\n.om-toc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }\n.om-toc a {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  padding: 7px 13px;\n  border: 1px solid var(--tl-line-2);\n  border-radius: 999px;\n  color: var(--tl-ink-2);\n  text-decoration: none;\n}\n.om-toc a:hover { border-color: var(--tl-blue); color: var(--tl-ink); }\n\n/* ---------- sections ---------- */\n.om-section { padding: 72px 0; border-top: 1px solid var(--tl-line); }\n.om-h2 { font-size: clamp(28px, 3.6vw, 42px); font-weight: 800; letter-spacing: -0.025em; line-height: 1.1; margin: 0 0 14px; }\n.om-sub { color: var(--tl-ink-2); font-size: 16px; line-height: 1.65; max-width: 780px; margin: 0 0 26px; }\n\n/* ---------- boxes: one stretched GitHub link each ---------- */\n.om-part, .om-layer, .om-receipt, .om-gap, .om-bar-row, .om-beyond { position: relative; }\n.om-part a:not(.box-link), .om-layer a:not(.box-link), .om-receipt a:not(.box-link),\n.om-gap a:not(.box-link), .om-bar-row a:not(.box-link), .om-beyond a:not(.box-link) {\n  position: relative;\n  z-index: 2;\n}\n.om-links { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 0; margin: 6px 0 0; }\n.om-links a { color: var(--tl-blue-soft); font-family: var(--font-mono); font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }\n.om-page .mono, .om-links a { font-variant-ligatures: none; }\n.om-page a.box-link-source { color: var(--tl-ink-2); }\n\n/* ---------- the parts ---------- */\n.om-parts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 26px; }\n.om-part {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 24px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: var(--tl-card);\n  transition: transform 0.3s cubic-bezier(.22,.61,.36,1), border-color 0.3s;\n}\n.om-part:hover { transform: translateY(-3px); border-color: var(--tl-line-2); }\n.om-part-name { font-size: 19px; font-weight: 700; margin: 0; }\n.om-part-what { font-size: 14.5px; line-height: 1.6; color: var(--tl-ink-2); margin: 0; }\n.om-below { margin-top: 16px; border-style: dashed; border-color: var(--tl-line-2); background: transparent; }\n.om-below .om-part-what { max-width: 860px; }\n\n/* ---------- the CUDA map ---------- */\n.om-meter { display: flex; gap: 4px; height: 14px; margin: 6px 0 12px; }\n.om-seg { flex: 1; border-radius: 4px; background: var(--om-fixed); }\n.om-seg.om-pass { background: var(--om-pass); box-shadow: 0 0 14px rgba(0, 229, 153, 0.45); }\n.om-seg.om-partial { background: var(--om-partial); box-shadow: 0 0 10px rgba(125, 180, 255, 0.3); }\n.om-seg.om-missing { background: transparent; border: 1.5px solid var(--om-missing); }\n.om-seg.om-fixed { background: var(--om-fixed); }\n.om-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; padding: 0; margin: 0 0 26px; font-family: var(--font-mono); font-size: 12px; color: var(--tl-ink-2); }\n.om-legend li { display: inline-flex; align-items: center; gap: 8px; }\n.om-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; background: var(--om-fixed); }\n.om-legend .om-pass .om-dot { background: var(--om-pass); }\n.om-legend .om-partial .om-dot { background: var(--om-partial); }\n.om-legend .om-missing .om-dot { background: transparent; border: 1.5px solid var(--om-missing); }\n\n.om-map { display: flex; flex-direction: column; gap: 8px; }\n.om-map-head, .om-layer {\n  display: grid;\n  grid-template-columns: 1.05fr 1fr 1.7fr 1.15fr;\n  gap: 18px;\n  align-items: start;\n}\n.om-map-head {\n  padding: 0 20px 6px 24px;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--tl-ink-3);\n}\n.om-layer {\n  padding: 16px 20px 14px 24px;\n  border: 1px solid var(--tl-line);\n  border-left: 4px solid var(--om-fixed);\n  border-radius: 14px;\n  background: var(--tl-card);\n  transition: transform 0.3s cubic-bezier(.22,.61,.36,1), border-color 0.3s;\n}\n.om-layer:hover { transform: translateX(3px); border-color: var(--tl-line-2); }\n.om-layer.om-pass { border-left-color: var(--om-pass); }\n.om-layer.om-partial { border-left-color: var(--om-partial); }\n.om-layer.om-missing { border-left-color: var(--om-missing); background: rgba(245, 158, 11, 0.03); }\n.om-cuda { font-weight: 700; font-size: 15.5px; color: var(--tl-ink); }\n.om-job { font-size: 14px; color: var(--tl-ink-3); }\n.om-repl { font-size: 14.5px; line-height: 1.55; color: var(--tl-ink); }\n.om-status { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }\n.om-note { font-size: 12.5px; line-height: 1.5; color: var(--tl-ink-3); }\n.om-pill {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  font-weight: 600;\n  letter-spacing: 0.14em;\n  padding: 4px 9px;\n  border-radius: 999px;\n  border: 1px solid var(--om-fixed);\n  color: var(--tl-ink-2);\n  white-space: nowrap;\n}\n.om-pass .om-pill, .om-pill.om-pass { color: var(--om-pass); border-color: rgba(0, 229, 153, 0.5); }\n.om-partial .om-pill, .om-pill.om-partial { color: var(--om-partial); border-color: rgba(125, 180, 255, 0.5); }\n.om-missing .om-pill, .om-pill.om-missing { color: var(--om-missing); border-color: rgba(245, 158, 11, 0.55); }\n.om-layer a.box-link { grid-column: 1 / -1; font-size: 10px; opacity: 0.7; }\n.om-layer:hover a.box-link { opacity: 1; }\n\n/* ---------- the receipt ---------- */\n.om-receipt {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 28px;\n  border: 1px solid rgba(0, 229, 153, 0.35);\n  border-radius: var(--tl-radius);\n  background: linear-gradient(180deg, rgba(0, 229, 153, 0.05), var(--tl-card) 60%);\n}\n.om-receipt-what { font-size: 16px; line-height: 1.65; color: var(--tl-ink-2); margin: 0; max-width: 860px; }\n.om-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 10px; margin: 6px 0; }\n.om-fact { border: 1px solid var(--tl-line); border-radius: 12px; padding: 12px 14px; background: rgba(8, 9, 12, 0.5); }\n.om-fact dt { font-size: 12px; color: var(--tl-ink-3); margin-bottom: 4px; }\n.om-fact dd { margin: 0; font-size: 13px; color: var(--tl-ink); overflow-wrap: anywhere; }\n.om-fact-zero { border-color: rgba(0, 229, 153, 0.45); }\n.om-fact-zero dd { font-size: 34px; font-weight: 700; line-height: 1; color: var(--om-pass); text-shadow: 0 0 24px rgba(0, 229, 153, 0.35); }\n.om-taken { font-size: 13px; color: var(--tl-ink-3); margin: 0; }\n.om-true { font-size: 17px; margin: 0; color: var(--tl-ink-2); }\n.om-true strong { color: var(--om-pass); font-weight: 700; }\n\n/* ---------- not yet, and beyond ---------- */\n.om-gaps { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }\n.om-gap, .om-beyond {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 24px;\n  border: 1px solid var(--tl-line);\n  border-top: 3px solid var(--om-missing);\n  border-radius: var(--tl-radius);\n  background: var(--tl-card);\n}\n.om-beyond { border-top-color: var(--tl-violet); }\n.om-perf { border-top-color: var(--tl-blue); margin: 26px 0 22px; }\n.om-perf-rule { margin-top: 0; }\n.om-gap p, .om-beyond p { font-size: 14.5px; line-height: 1.6; color: var(--tl-ink-2); margin: 0; }\n.om-gap-title { font-size: 18px; font-weight: 700; margin: 0; line-height: 1.3; }\n\n/* ---------- the bar, a checklist ---------- */\n.om-bar { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }\n.om-bar-row {\n  display: grid;\n  grid-template-columns: 34px 1fr;\n  gap: 18px;\n  padding: 22px 24px;\n  border: 1px solid var(--tl-line);\n  border-radius: var(--tl-radius);\n  background: var(--tl-card);\n}\n.om-check {\n  width: 28px;\n  height: 28px;\n  border-radius: 8px;\n  border: 2px solid var(--tl-ink-3);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 18px;\n  color: #08090c;\n  margin-top: 2px;\n}\n.om-done .om-check { background: var(--om-pass); border-color: var(--om-pass); box-shadow: 0 0 18px rgba(0, 229, 153, 0.45); }\n.om-bar-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; max-width: 860px; }\n.om-bar-title { font-size: 19px; font-weight: 700; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }\n.om-bar-id { color: var(--tl-blue-soft); font-size: 15px; }\n.om-bar-when, .om-bar-now { font-size: 14.5px; line-height: 1.6; color: var(--tl-ink-2); margin: 0; }\n.om-bar-when strong, .om-bar-now strong { color: var(--tl-ink); font-weight: 600; }\n\n\n/* ---------- phone ---------- */\n@media (max-width: 820px) {\n  .om-hero { padding-top: 56px; }\n  .om-verdicts { grid-template-columns: 1fr; }\n  .om-map-head { display: none; }\n  .om-layer { grid-template-columns: 1fr; gap: 6px; }\n  .om-job::before { content: \"Its job: \"; color: var(--tl-ink-3); }\n  .om-status { flex-direction: row; flex-wrap: wrap; align-items: center; }\n  .om-section { padding: 52px 0; }\n  .om-bar-row { grid-template-columns: 28px 1fr; gap: 12px; padding: 18px 16px; }\n  .om-check { width: 24px; height: 24px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .om-part, .om-layer { transition: none; }\n  .om-part:hover, .om-layer:hover { transform: none; }\n}\n"
text sap13 "assets/cudaplusplus.css"
text sab13 "/*\n * /cudaplusplus/: CUDA++. Loaded after omega.css and built inside the\n * Turing look (turing-look.css). The one idea of this page is the path a\n * GPU program takes from the program to the chip, drawn as a wire down the\n * left: each step's node and segment is lit by whose code runs there.\n * Green: ours, with a receipt. Blue: ours in part. Amber, dashed: ours,\n * being built. Grey: NVIDIA's, for a physical reason.\n */\n:root {\n  --cp-pass: #00e599;\n  --cp-partial: #7db4ff;\n  --cp-building: #f59e0b;\n  --cp-nvidia: #5b6b85;\n}\n\n.cp-purpose {\n  font-size: 14.5px;\n  line-height: 1.6;\n  color: var(--tl-ink-2);\n  margin: 8px 0 12px;\n}\n\n/* ---------- the path ---------- */\n.cp-path {\n  list-style: none;\n  margin: 28px 0 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n.cp-hop {\n  --c: var(--cp-nvidia);\n  position: relative;\n  display: grid;\n  grid-template-columns: 44px 1fr 220px;\n  gap: 0 18px;\n  padding: 18px 20px 18px 0;\n  border-radius: var(--tl-radius, 18px);\n  transition: background 0.35s cubic-bezier(.22,.61,.36,1);\n}\n.cp-hop:hover { background: var(--tl-card, #0e1219); }\n.cp-hop.cp-pass { --c: var(--cp-pass); }\n.cp-hop.cp-partial { --c: var(--cp-partial); }\n.cp-hop.cp-building { --c: var(--cp-building); }\n/* the wire: one segment per step, joined into a line */\n.cp-hop::before {\n  content: \"\";\n  position: absolute;\n  left: 21px;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  background: var(--c);\n  opacity: 0.55;\n}\n.cp-hop:first-child::before { top: 30px; }\n.cp-hop:last-child::before { bottom: calc(100% - 30px); }\n.cp-hop.cp-building::before {\n  background: repeating-linear-gradient(to bottom, var(--c) 0 6px, transparent 6px 12px);\n  opacity: 0.8;\n}\n.cp-node {\n  position: relative;\n  z-index: 1;\n  grid-column: 1;\n  justify-self: center;\n  margin-top: 6px;\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  background: var(--c);\n  box-shadow: 0 0 0 4px var(--tl-bg, #08090c), 0 0 18px var(--c);\n}\n.cp-hop.cp-building .cp-node { background: var(--tl-bg, #08090c); border: 2px solid var(--c); }\n.cp-hop.cp-nvidia .cp-node { box-shadow: 0 0 0 4px var(--tl-bg, #08090c); }\n.cp-hop-body { grid-column: 2; min-width: 0; }\n.cp-step {\n  font-size: 18px;\n  font-weight: 700;\n  margin: 0 0 6px;\n  line-height: 1.3;\n}\n.cp-cuda, .cp-ours { margin: 0 0 4px; font-size: 14.5px; line-height: 1.55; }\n.cp-cuda { color: var(--tl-ink-3, #8ea0b5); }\n.cp-ours { color: var(--tl-ink, #f1f5f9); }\n.cp-lane {\n  display: inline-block;\n  min-width: 58px;\n  font-family: var(--font-mono, ui-monospace, monospace);\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  color: var(--tl-ink-3, #8ea0b5);\n}\n.cp-lane-ours { color: var(--c); }\n.cp-hop-status {\n  grid-column: 3;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 6px;\n  padding-top: 2px;\n}\n.cp-note { font-size: 13px; line-height: 1.45; color: var(--tl-ink-2); }\n.cp-pill {\n  display: inline-block;\n  font-family: var(--font-mono, ui-monospace, monospace);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  padding: 4px 10px;\n  border-radius: 999px;\n  border: 1px solid var(--c, var(--cp-nvidia));\n  color: var(--c, var(--cp-nvidia));\n  white-space: nowrap;\n}\n.cp-hop .box-link {\n  grid-column: 2 / 4;\n  justify-self: start;\n  margin-top: 8px;\n  opacity: 0.7;\n}\n.cp-hop:hover .box-link { opacity: 1; }\n\n/* ---------- cards and rows ---------- */\n.cp-steps {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 24px;\n}\n.cp-card, .cp-row {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 24px;\n  background: var(--tl-card, #0e1219);\n  border: 1px solid var(--tl-line, #1c2536);\n  border-radius: var(--tl-radius, 18px);\n  transition: border-color 0.35s cubic-bezier(.22,.61,.36,1), transform 0.35s cubic-bezier(.22,.61,.36,1);\n}\n.cp-card:hover, .cp-row:hover { border-color: var(--tl-blue, #2d7ff9); transform: translateY(-2px); }\n.cp-card p, .cp-row p { font-size: 14.5px; line-height: 1.6; color: var(--tl-ink-2); margin: 0; }\n.cp-didnot { margin-top: 16px; }\n.cp-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }\n.cp-list li { font-size: 14.5px; line-height: 1.6; color: var(--tl-ink-2); }\n\n.cp-rows { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-top: 24px; }\n.cp-row { --c: var(--cp-nvidia); padding-left: 30px; }\n.cp-row.cp-pass { --c: var(--cp-pass); }\n.cp-row.cp-building { --c: var(--cp-building); }\n/* the same wire as the path, one short segment per row */\n.cp-row::before {\n  content: \"\";\n  position: absolute;\n  left: 14px;\n  top: 26px;\n  bottom: 26px;\n  width: 2px;\n  background: var(--c);\n  opacity: 0.7;\n}\n.cp-row.cp-building::before { background: repeating-linear-gradient(to bottom, var(--c) 0 6px, transparent 6px 12px); }\n.cp-row .box-link { margin-top: auto; }\n.cp-card .box-link { margin-top: auto; }\n.cp-row-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }\n.cp-row-title { font-size: 18px; font-weight: 700; margin: 0; line-height: 1.3; }\n.cp-cmd {\n  margin: 0;\n  padding: 10px 14px;\n  border-radius: 10px;\n  background: var(--tl-bg, #08090c);\n  border: 1px solid var(--tl-line, #1c2536);\n  font-size: 13px;\n  overflow-x: auto;\n}\n.cp-page .om-links li + li::before { content: \"\\00B7\"; color: var(--tl-ink-3, #8ea0b5); margin-right: 14px; }\n.cp-page .om-links { gap: 4px 14px; }\n.cp-card a:not(.box-link), .cp-row a:not(.box-link), .cp-hop a:not(.box-link) { position: relative; z-index: 2; }\n\n@media (max-width: 760px) {\n  .cp-steps { grid-template-columns: 1fr; }\n  .cp-hop { grid-template-columns: 32px 1fr; padding-right: 12px; }\n  .cp-hop::before { left: 15px; }\n  .cp-hop-status { grid-column: 2; flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px; }\n  .cp-hop .box-link { grid-column: 2; }\n  .cp-lane { min-width: 0; margin-right: 4px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .cp-hop, .cp-card, .cp-row { transition: none; }\n  .cp-card:hover, .cp-row:hover { transform: none; }\n}\n"
