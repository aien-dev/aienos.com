note Progressive enhancement only. No content gating, tracking request, remote font or automatic relay.
note Native scene completion/ready promises are owned by AllenPresence, never estimated by a duplicate clock.
note Draft interface agreed with AllenChat: /allen/#draft=<encoded text>, max 2000 characters, never auto-send.
text sjsite0 "/* Generated by om/site/client.om. Do not edit the generated asset. */\n(() => {\n'use strict';\nconst byId = id => document.getElementById(id);\nconst reduced = matchMedia('(prefers-reduced-motion: reduce)');\nfunction loadLocal(key) {\n  for (const kind of ['localStorage', 'sessionStorage']) {\n    try { const value = window[kind].getItem(key); if (value !== null) return value; } catch (_) {}\n  }\n  return null;\n}\nfunction saveLocal(key, value) {\n  let saved = false;\n  for (const kind of ['localStorage', 'sessionStorage']) {\n    try { window[kind].setItem(key, value); saved = true; } catch (_) {}\n  }\n  return saved;\n}\nfunction eraseLocal(key) {\n  for (const kind of ['localStorage', 'sessionStorage']) { try { window[kind].removeItem(key); } catch (_) {} }\n}\nfunction greeting() {\n  if (window.aienAllenIntro) window.aienAllenIntro.greet();\n}\nfunction navigation() {\n  const toggle = document.querySelector('.nav-toggle');\n  const nav = byId('site-navigation');\n  if (!toggle || !nav) return;\n  const narrow = matchMedia('(max-width: 52rem)');\n  let open = false;\n  function paint() {\n    nav.hidden = narrow.matches && !open;\n    toggle.setAttribute('aria-expanded', String(!nav.hidden));\n  }\n  toggle.hidden = false;\n  toggle.addEventListener('click', () => { open = !open; paint(); });\n  nav.addEventListener('keydown', event => {\n    if (event.key === 'Escape' && narrow.matches && open) { event.preventDefault(); open = false; paint(); toggle.focus(); }\n  });\n  nav.addEventListener('click', event => {\n    if (event.target.closest('a') && narrow.matches) { open = false; paint(); }\n  });\n  narrow.addEventListener('change', paint);\n  paint();\n}\n"
text sjsite1 "function homeDoor() {\n  const door = byId('site-door');\n  if (!door) return;\n  const canvas = byId('site-door-canvas'), enter = byId('site-door-enter');\n  const skip = byId('site-door-skip'), title = byId('site-door-title'), status = byId('site-door-status');\n  const content = byId('site-content');\n  const key = 'aienos-intro-seen';\n  let scene = null, ready = false, finished = false, playing = false, generation = 0;\n  let returnFocus = null;\n  function stop() {\n    generation++; ready = false;\n    if (scene) { scene.destroy(); scene = null; }\n    if (window.AllenAudio) window.AllenAudio.stop();\n  }\n  function finish(message, focus = false) {\n    const ownedFocus = door.contains(document.activeElement);\n    finished = true; playing = false;\n    stop(); saveLocal(key, '1');\n    door.dataset.playing = 'false'; door.dataset.finished = 'true';\n    title.textContent = 'Make yourself at home.';\n    status.textContent = message;\n    enter.hidden = true; skip.textContent = 'Explore the site';\n    if (focus || ownedFocus) {\n      const target = returnFocus && returnFocus.isConnected ? returnFocus : content;\n      target.focus({preventScroll:true});\n    }\n    returnFocus = null;\n    greeting();\n  }\n  function unavailable() {\n    if (finished) return;\n    finish('The introduction is unavailable in this browser. The complete site is still here.');\n  }\n  function mount() {\n    if (finished || reduced.matches || scene || !window.AllenScene) return;\n    const current = ++generation;\n    try {\n      scene = window.AllenScene.mount(canvas, {compact:false, interactive:false});\n      Promise.resolve(scene.ready).then(() => {\n        if (current !== generation || finished || !scene) return;\n        ready = true; enter.disabled = false; enter.hidden = false;\n        status.textContent = 'A short native introduction, or go straight to the complete site below.';\n      }, () => { if (current === generation) unavailable(); });\n    } catch (_) { unavailable(); }\n  }\n  function reset(focus = false) {\n    stop(); finished = false; playing = false;\n    door.dataset.finished = 'false'; door.dataset.playing = 'false';\n    title.textContent = 'Come in. Take a look around.';\n    status.textContent = 'The site is ready below. The optional native scene is loading.';\n    skip.textContent = 'Skip introduction'; enter.hidden = true; enter.disabled = true;\n    if (reduced.matches) { finish('Reduced motion is on. The introduction is skipped; every destination is open.', focus); return; }\n    mount();\n    if (focus) { door.scrollIntoView({block:'start',behavior:'auto'}); skip.focus({preventScroll:true}); }\n  }\n  enter.addEventListener('click', () => {\n    if (!ready || finished || playing || reduced.matches) return;\n    // This native button handles both a tap and keyboard Enter. No await, timer\n    // or Promise callback may move audio creation out of this gesture stack.\n    try { if (window.AllenAudio) void window.AllenAudio.enter('home'); } catch (_) {}\n    try { scene.enter('birth'); } catch (_) { unavailable(); return; }\n    playing = true; door.dataset.playing = 'true';\n    enter.hidden = true; skip.focus({preventScroll:true});\n    title.textContent = 'Welcome to Sovereign Intelligence.';\n    status.textContent = 'Allen\u2019s native introduction is playing. Skip or press Escape at any time.';\n  });\n  skip.addEventListener('click', () => { if (!finished) finish('Welcome. Choose any destination, in any order.', true); });\n  canvas.addEventListener('allen-scene-complete', () => {\n    if (playing) finish('Welcome. Choose any destination, in any order.');\n  });\n  canvas.addEventListener('allen-scene-error', unavailable);\n  document.addEventListener('allen-scene-ready', mount);\n  document.addEventListener('keydown', event => {\n    if (event.key === 'Escape' && !finished) {\n      event.preventDefault(); event.stopImmediatePropagation();\n      finish('Introduction skipped. Every destination is open.', true);\n    }\n  }, true);\n  document.querySelectorAll('[data-site-replay]').forEach(link => {\n    link.addEventListener('click', event => {\n      if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;\n      event.preventDefault(); returnFocus = link; reset(true);\n    });\n  });\n  reduced.addEventListener('change', () => {\n    if (reduced.matches && !finished) finish('Reduced motion is on. The introduction is skipped; every destination is open.');\n  });\n  window.addEventListener('pagehide', stop);\n  if (location.hash === '#replay-intro') reset();\n  else if (loadLocal(key) === '1') {\n    finish('Welcome back. Pick up a trail, or explore somewhere new.');\n    title.textContent = 'Welcome back.';\n  } else if (reduced.matches) finish('Reduced motion is on. The introduction is skipped; every destination is open.');\n  else reset();\n}\n"
text sjsite2 "function localTrail() {\n  const panel = byId('site-trail');\n  if (!panel) return;\n  const enable = byId('site-trail-enable'), list = byId('site-trail-list');\n  const status = byId('site-trail-status'), clear = byId('site-trail-clear');\n  const report = byId('site-trail-report'), draft = byId('site-trail-draft');\n  const message = byId('site-trail-message'), take = byId('site-trail-send');\n  const key = 'aienos-local-trail';\n  let pages = [], on = false, persistent = false;\n  function validPage(row) {\n    if (!row || typeof row.path !== 'string' || typeof row.title !== 'string') return false;\n    try {\n      const url = new URL(row.path, location.origin);\n      return url.origin === location.origin && url.pathname === row.path && !url.search && !url.hash && row.path.length <= 256 && row.title.length <= 160;\n    } catch (_) { return false; }\n  }\n  try {\n    const state = JSON.parse(loadLocal(key) || 'null');\n    if (state && state.on === true && Array.isArray(state.pages)) {\n      on = true; pages = state.pages.filter(validPage).slice(-20); persistent = true;\n    }\n  } catch (_) {}\n  function remember() {\n    if (!on) return;\n    const row = {path:location.pathname, title:(document.querySelector('main h1')?.textContent || document.title).trim().slice(0,160)};\n    if (validPage(row)) { pages = pages.filter(item => item.path !== row.path); pages.push(row); pages = pages.slice(-20); }\n    persistent = saveLocal(key, JSON.stringify({on:true,pages}));\n  }\n  function paint() {\n    enable.checked = on; list.replaceChildren();\n    for (const row of pages) {\n      const li = document.createElement('li'), anchor = document.createElement('a');\n      anchor.href = row.path; anchor.textContent = row.title;\n      if (row.path === location.pathname) anchor.setAttribute('aria-current','page');\n      li.append(anchor); list.append(li);\n    }\n    status.textContent = !on ? 'Trail is off. No visits are being saved.' : persistent ? 'Your trail is saved only in this browser. No trail data is sent to a server.' : 'Browser storage is unavailable. This trail lasts only while this page is open.';\n    clear.disabled = pages.length === 0 && !on;\n  }\n  function dismiss() { draft.hidden = true; message.value = ''; take.href = '/allen/'; report.focus(); }\n  enable.addEventListener('change', () => {\n    on = enable.checked;\n    if (on) remember(); else { pages = []; eraseLocal(key); }\n    draft.hidden = true; message.value = ''; take.href = '/allen/'; paint();\n  });\n  clear.addEventListener('click', () => {\n    on = false; pages = []; eraseLocal(key); draft.hidden = true; message.value = ''; take.href = '/allen/'; paint(); enable.focus();\n  });\n  report.addEventListener('click', () => {\n    const entries = pages.length ? pages : [{path:location.pathname,title:document.title}];\n    message.value = ('I explored these pages and would like to talk about them:\\n' + entries.map(row => '- ' + row.title + ': ' + row.path).join('\\n')).slice(0,2000);\n    draft.hidden = false; message.focus();\n  });\n  take.addEventListener('click', () => {\n    // The fragment is local navigation data, not an HTTP query. The Allen page\n    // clears it after prefilling its editable input. Only its Send button sends.\n    take.href = '/allen/#draft=' + encodeURIComponent(message.value.slice(0,2000));\n  });\n  byId('site-trail-cancel').addEventListener('click', dismiss);\n  draft.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); dismiss(); } });\n  window.addEventListener('storage', event => {\n    if (event.key !== key && event.key !== null) return;\n    let state = null; try { state = JSON.parse(event.newValue); } catch (_) {}\n    on = Boolean(state && state.on === true && Array.isArray(state.pages));\n    pages = on ? state.pages.filter(validPage).slice(-20) : [];\n    if (!on) eraseLocal(key);\n    draft.hidden = true; message.value = ''; take.href = '/allen/'; paint();\n  });\n  remember(); paint(); panel.hidden = false;\n}\nnavigation(); homeDoor(); localTrail();\n})();\n"
