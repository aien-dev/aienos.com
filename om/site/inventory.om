text sicss "assets/site.css"
text sijs "js/site.js"
text sitokens "assets/site-tokens.css"
text sidoor "assets/site-door.css"

fn si_line path view uchar * to void
sr_raw path
sr_raw ssnl
end

fn si_generated path view uchar * to bool
if sr_equal path sap0
ret true
end
if sr_equal path sap1
ret true
end
if sr_equal path sap2
ret true
