fn si_page row ulong to void
buf = new uchar 1024 0
aliasbuf = new uchar 1024 0
n = st_html_path row buf
si_line part buf 1 sub n 1
n = ss_mdpath row buf
si_line part buf 1 sub n 1
an = st_field row 0 aliasbuf
an = st_append aliasbuf ssmdidx an
if not sr_equal part buf 0 n part aliasbuf 0 an
si_line part aliasbuf 1 sub an 1
end
end

fn si_expected to void
st_open siexpect
si_fixed
for i ulong get stcount 0
si_page i
end
put sxmode 0 2
sx_tree stpub 0
put sxmode 0 0
sr_close
end

fn si_required_data to void
pathbuf = new uchar 4096 0
fullbuf = new uchar 8192 0
root = sj_load ssfields
node = sj_first root
while ne node 0 bound 1024
n = sj_string sj_find node stk0 pathbuf
sn = st_path part pathbuf 0 n fullbuf
r = faccess fullbuf 0 sn 4
if ne r 0
sr_diag part pathbuf 0 n
sr_diag ssnl
trap 10
end
node = sj_next node
end
end
