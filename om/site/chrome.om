fn sc_begin title view uchar * desc view uchar * to void
if gt len title len sctitle
trap 3
end
if gt len desc len scdesc
trap 3
end
put sclens 0 len title
put sclens 1 len desc
for i ulong len title
put sctitle i get title i
end
for i ulong len desc
put scdesc i get desc i
end
end
fn sc_title to void
buf = new uchar 2048 0
for i ulong get sclens 0
put buf i get sctitle i
end
sr_esc part buf 0 get sclens 0
end
fn sc_desc to void
buf = new uchar 8192 0
for i ulong get sclens 1
put buf i get scdesc i
end
sr_esc part buf 0 get sclens 1
end
fn sc_iszh route view uchar * to bool
if lt len route len sczh
ret false
end
for i ulong len sczh
if ne get route i get sczh i
ret false
end
end
ret true
end
fn sc_mdpath route view uchar * to void
if or sr_equal route scroot sr_equal route sczh
sr_esc route
sr_raw scindex
else
n = len route
if gt n 0
if eq get route sub n 1 47
n = sub n 1
end
end
sr_esc part route 0 n
sr_raw scmd
end
end
fn sc_meta route view uchar * to void
sr_raw scdoc
if sc_iszh route
sr_raw sclang
else
sr_raw scen
end
sr_raw schead
sc_title
sr_raw sctend
sc_desc
sr_raw scogt
sc_title
sr_raw scogd
sc_desc
sr_raw sctwt
sc_title
sr_raw sctwd
sc_desc
if not sr_equal route scerr
sr_raw sccan
sr_esc route
end
sr_raw scogurl
sr_esc route
sr_raw scogtype
ss_ogtype route
sr_raw scogimg
ss_image route
sr_raw sctwimg
ss_image route
sr_raw scalt
sc_mdpath route
sr_raw scmdend
pwa_head
if sr_equal route scerr
sr_raw scnoidx
else
sr_raw scrobots
end
end
fn sc_areaurl to void
if eq get scarea 0 2
sr_raw scuomega
else
if eq get scarea 0 3
sr_raw scumach
else
if eq get scarea 0 4
sr_raw scudisc
else
if eq get scarea 0 5
sr_raw sculearn
else
sr_raw sclass
end
end
end
end
end
fn sc_route route view uchar * area view uchar * to void
put scstate 0 0
put scstate 1 0
if sr_equal route scroot
put scstate 0 1
end
if or sr_equal route scroot sr_equal route scallen
put scstate 1 1
end
put scarea 0 1
if sr_equal area scomega
put scarea 0 2
end
if sr_equal area scmach
put scarea 0 3
end
if sr_equal area scdisco
put scarea 0 4
end
if sr_equal area sclearn
put scarea 0 5
end
sc_meta route
if eq get scstate 1 1
sr_raw sctokens
else
sr_raw scstyles
end
sr_raw scconsjs
sc_extrahead route
if ne get scstate 1 1
sr_raw scnative
end
sr_raw scclient
sr_raw scbody
sr_esc area
sr_raw scendat
sr_raw scskip
sr_raw scutil0
if eq get scstate 1 1
sr_raw scutnat
else
sr_raw scutcls
end
sr_raw scutile
if eq get scstate 1 1
sr_raw scind0
if eq get scstate 0 1
sr_raw schmain
else
sr_raw scnmain
end
else
sr_raw sccrumb
sc_areaurl
sr_raw sccruma
sr_esc area
sr_raw sccrumbb
sc_title
sr_raw sccrumbe
sr_raw scmain
end
end
fn sc_next to void
sr_raw scnext0
if eq get scarea 0 1
sr_raw scnext1
end
if eq get scarea 0 2
sr_raw scnext2
end
if eq get scarea 0 3
sr_raw scnext3
end
if eq get scarea 0 4
sr_raw scnext4
end
if eq get scarea 0 5
sr_raw scnext5
end
sr_raw scnexte
end
fn sc_end to void
sr_raw scclose
if ne get scstate 1 1
sc_next
door_trail
sr_raw scfoot0
sr_raw scind0
sr_raw scfoot1
sr_file sclaunch
end
sr_file sccons
sr_raw scdone
end
