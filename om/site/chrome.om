text scnexte "</div></aside>"

fn sc_begin title view uchar * desc view uchar * to void
if gt len title len sctitle
trap 3
end
if gt len desc len scdesc
trap 3
end
put sclens 0 len title
put sclens 1 len desc
for i ulong len title
put sctitle i get title i
end
for i ulong len desc
put scdesc i get desc i
end
end

fn sc_title to void
buf = new uchar 2048 0
for i ulong get sclens 0
put buf i get sctitle i
end
sr_esc part buf 0 get sclens 0
end

fn sc_desc to void
buf = new uchar 8192 0
for i ulong get sclens 1
put buf i get scdesc i
end
sr_esc part buf 0 get sclens 1
end

fn sc_iszh route view uchar * to bool
if lt len route len sczh
ret false
end
for i ulong len sczh
if ne get route i get sczh i
ret false
end
end
ret true
end

fn sc_img to void
if eq get scarea 0 2
sr_raw scimac
else
if eq get scarea 0 3
sr_raw scimac
else
if eq get scarea 0 4
sr_raw scidisc
else
if eq get scarea 0 5
sr_raw scilearn
else
sr_raw scimg
end
end
end
end
end

fn sc_meta route view uchar * to void
sr_raw scdoc
if sc_iszh route
sr_raw sclang
else
sr_raw scen
end
sr_raw schead
sc_title
sr_raw sctend
sc_desc
sr_raw scogt
sc_title
sr_raw scogd
sc_desc
sr_raw sctwt
sc_title
sr_raw sctwd
sc_desc
sr_raw sccan
sr_esc route
sr_raw scogurl
sr_esc route
sr_raw scogimg
sc_img
sr_raw sctwimg
sc_img
sr_raw scalt
if sr_equal route scroot
sr_raw scindex
else
sr_esc route
sr_raw scmd
end
sr_raw scmdend
end

fn sc_navlink url view uchar * label view uchar * glyph view uchar * to void
sr_raw scnava
sr_esc url
sr_raw scnavb
if sr_equal label scsi
if eq get scarea 0 1
sr_raw scactive
end
end
if sr_equal label scomega
if eq get scarea 0 2
sr_raw scactive
end
end
if sr_equal label scmach
if eq get scarea 0 3
sr_raw scactive
end
end
if sr_equal label scdisco
if eq get scarea 0 4
sr_raw scactive
end
end
if sr_equal label sclearn
if eq get scarea 0 5
sr_raw scactive
end
end
sr_raw scnavc
sr_raw glyph
sr_raw scnavd
sr_esc label
sr_raw scnave
end

fn sc_nav to void
sr_raw scnav0
sc_navlink scroot scsi scgsi
sc_navlink scuomega scomega scgom
sc_navlink scumach scmach scgmac
sc_navlink scudisc scdisco scgdisc
sc_navlink sculearn sclearn scglearn
sc_navlink scallen scall scgall
sr_raw scnavend
end

fn sc_areaurl to void
if eq get scarea 0 2
sr_raw scuomega
else
if eq get scarea 0 3
sr_raw scumach
else
if eq get scarea 0 4
sr_raw scudisc
else
if eq get scarea 0 5
sr_raw sculearn
else
sr_raw scroot
end
end
end
end
end

fn sc_route route view uchar * area view uchar * to void
put scstate 0 or sr_equal route scnow sr_equal route scznow
put scstate 1 sr_equal route scallen
put scstate 2 sr_equal route scroot
put scarea 0 1
if sr_equal area scomega
put scarea 0 2
end
if sr_equal area scmach
put scarea 0 3
end
if sr_equal area scdisco
put scarea 0 4
end
if sr_equal area sclearn
put scarea 0 5
end
sc_meta route
if not get scstate 0
sr_raw scjson
if not get scstate 1
sr_raw scassets
end
end
if get scstate 1
sr_raw scalcss
end
sr_raw scbody
sr_esc area
sr_raw scendat
sr_raw scskip
if not get scstate 1
sc_nav
if not get scstate 2
sr_raw sccrumb
sc_areaurl
sr_raw sccruma
sr_esc area
sr_raw sccrumbb
sc_title
sr_raw sccrumbe
end
end
sr_raw scmain
end

fn sc_next to void
sr_raw scnext0
if eq get scarea 0 1
sr_raw scnext1
end
if eq get scarea 0 2
sr_raw scnext2
end
if eq get scarea 0 3
sr_raw scnext3
end
if eq get scarea 0 4
sr_raw scnext4
end
if eq get scarea 0 5
sr_raw scnext5
end
sr_raw scnexte
end

fn sc_end to void
sr_raw scclose
if not get scstate 1
sc_next
if not get scstate 0
door_trail
end
sr_raw scfoot0
if not get scstate 0
sr_file sccons
sr_file sclaunch
end
end
sr_raw scdone
end
