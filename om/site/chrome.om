text scnav0 "<header class=\"aien-header\"><div class=\"site-header-inner\"><a class=\"site-brand\" href=\"/\" aria-label=\"Sovereign Intelligence home\"><span class=\"brand-mark\" aria-hidden=\"true\">SI</span><span>Sovereign Intelligence<small>built on AienOS</small></span></a><div class=\"aien-nav-reach\"><a class=\"x-link\" href=\"https://x.com/mdrakestapleton\" rel=\"noopener noreferrer\"><span aria-hidden=\"true\">X</span> Follow me on X</a><a href=\"/contact/\">Contact</a></div><button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-navigation\" hidden>Explore destinations</button><nav id=\"site-navigation\" aria-label=\"Master destinations\"><ul class=\"master-nav\">"
