global vego ulong 512
global vegc ulong 1

note ---------------------------------------------------------------- registry
note sv_rgall: entry k of the registry as (slot, offset, length) in vax[0..2]: the PAGES table
note first (offsets into vpages are reported with slot 0), then the engineer paths.
fn sv_regn to ulong
ret add sv_tcount vpages get vegc 0
end
note sv_rgeq: registry entry k equals bytes [a, a+n) of slot s.
fn sv_rgeq k ulong s ulong a ulong n ulong to bool
wp = sv_tcount vpages
if lt k wp
wo = sv_tat vpages k
if ne sv_tlen vpages wo n
ret false
end
ret sv_eqm add sv_off s a part vpages wo n
end
we = get vego sub k wp
if ne sv_n we n
ret false
end
for wj ulong n
if ne sv_b we wj sv_b s add a wj
ret false
end
end
ret true
end
fn sv_inreg s ulong a ulong n ulong to bool
for wk ulong sv_regn
if sv_rgeq wk s a n
ret true
end
end
ret false
end
note sv_rgpush: push registry entry k onto the newest slot.
fn sv_rgpush k ulong to void
wp = sv_tcount vpages
if lt k wp
wo = sv_tat vpages k
sv_pusht part vpages wo sv_tlen vpages wo
ret
end
we = get vego sub k wp
sv_pusha sv_off we sv_n we
end

note ---------------------------------------------------------------- engineer record (O7)
note oracle.rs engineer_paths over the committed public/data/engineer.json (a repository input, like
note data/quotes.json, never the generator's output). Valid paths are kept as persistent slots.
fn sv_engpath ws ulong to bool
wn = sv_n ws
if not sv_starts ws veng
ret false
end
if ne sv_b ws sub wn 1 47
ret false
end
wi = len veng
wseg = ulong 0
while lt wi wn bound 999999
c = sv_b ws wi
if eq c 47
if eq wseg 0
ret false
end
wseg = 0
else
if not or or sv_isdig c and ge c 97 le c 122 eq c 45
ret false
end
wseg = add wseg 1
end
wi = add wi 1
end
ret true
end
fn sv_engone wc ulong wk ulong to ulong
wp = sj_find wc vkpath
ws = sv_jsl wp
if eq ws 0
sv_fail vro7 vtengp
ret 0
end
if not sv_engpath ws
sv_failx vro7 vtengp sv_off ws sv_n ws
end
if sv_inreg ws 0 sv_n ws
sv_failx vro7 vtengd sv_off ws sv_n ws
end
if or or sv_blank sj_find wc vkname sv_blank sj_find wc vktitle sv_blank sj_find wc vkdesc
sv_failx vro7 vtengf sv_off ws sv_n ws
end
wkd = sj_find wc vkkind
if not sv_tin wkd vekinds
sv_failx vro7 vtengk sv_off ws sv_n ws
end
if sj_eq wkd vkhome
if not sj_eq wp veng
sv_fail vro7 vtengh
end
end
wo = sj_find wc vkold
if ne sj_kind wo 2
sv_failx vro7 vtengo sv_off ws sv_n ws
else
wx = sj_first wo
while ne wx 0 bound 65536
wok = sj_prefix wx vshome
if wok
if gt sj_size wx 1
wok = ne sj_byte wx 1 47
end
end
if not wok
sv_failx vro7 vtengo sv_off ws sv_n ws
end
wx = sj_next wx
end
end
put vego wk ws
put vegc 0 add wk 1
ret ws
end
fn sv_vengine to bool
wf = get vfail 0
sv_ctxp
wr = sv_jload
if ne sj_kind wr 1
sv_fail vro7 vtengn
ret false
end
wpg = sj_find wr vkpages2
if or ne sj_kind wpg 2 eq sj_len wpg 0
sv_fail vro7 vtengn
ret false
end
put vegc 0 0
wh = ulong 0
wc = sj_first wpg
wk = ulong 0
while ne wc 0 bound 512
if sj_eq sj_find wc vkkind vkhome
wh = add wh 1
end
wk = sv_engk wc wk
wc = sj_next wc
end
if ne wh 1
sv_fail vro7 vtengh
end
ret eq get vfail 0 wf
end
fn sv_engk wc ulong wk ulong to ulong
note duplicates within the record: compared against the paths already kept
ws = sv_engone wc wk
if eq ws 0
ret wk
end
for wj ulong wk
we = get vego wj
if eq sv_n we sv_n ws
wsm = true
for wi ulong sv_n ws
if ne sv_b we wi sv_b ws wi
wsm = false
end
end
if wsm
sv_failx vro7 vtengd sv_off ws sv_n ws
end
end
end
ret add wk 1
end

note ---------------------------------------------------------------- paths
note sv_ppath: the site path of index file q ("index.html" -> "/", "a/b/index.html" -> "/a/b/") as
note a new slot; 0 when q is not an index.html.
fn sv_ppath q ulong to ulong
wo = get vfo q
wl = get vfl q
if lt wl len vixh
ret 0
end
wb = sub wl len vixh
for wj ulong len vixh
if ne get vfp add add wo wb wj get vixh wj
ret 0
end
end
if gt wb 0
if ne get vfp add wo sub wb 1 47
ret 0
end
end
ws = sv_snew
sv_push 47
for wj ulong wb
sv_push get vfp add wo wj
end
ret ws
end
fn sv_iszh s ulong to bool
ret sv_starts s vzh
end
note sv_enof: oracle en_of as a new slot.
fn sv_enof s ulong to ulong
ws = sv_snew
if and eq sv_n s len vzh sv_starts s vzh
sv_pusht vclas
ret ws
end
if sv_starts s vzh
sv_pusha add sv_off s sub len vzh 1 sub sv_n s sub len vzh 1
ret ws
end
sv_pusha sv_off s sv_n s
ret ws
end
note sv_zhof: oracle zh_of as a new slot, 0 for the root (no translation of its own).
fn sv_zhof s ulong to ulong
if and eq sv_n s len vclas sv_starts s vclas
ws = sv_snew
sv_pusht vzh
ret ws
end
if eq sv_n s 1
ret 0
end
ws = sv_snew
sv_pusht part vzh 0 sub len vzh 1
sv_pusha sv_off s sv_n s
ret ws
end
note sv_pagefile: vpath = root + the site path (without its leading '/') + index.html.
fn sv_pagefile s ulong to void
sv_proot
sv_pva add sv_off s 1 sub sv_n s 1
sv_padd vixh
sv_ctxp
end
fn sv_written s ulong to bool
sv_pagefile s
ret sv_isreg
end
note sv_twin: the written translation partner of page p (a new slot) or 0.
fn sv_twin p ulong to ulong
wt = ulong 0
if sv_iszh p
wt = sv_enof p
else
wt = sv_zhof p
if eq wt 0
ret 0
end
end
if sv_written wt
ret wt
end
sv_drop wt
ret 0
end

note ---------------------------------------------------------------- O2 head
note The head is [vax2 start, end) found as oracle read_head does: the first "<head" (any case) must
note be followed by '>' or whitespace; the head ends at the next "</head>".
global vhd ulong 4
fn sv_hbounds h ulong to bool
wo = sv_findc h vxhead 0
if eq wo VNONE
ret false
end
if not sv_awsr sv_lc sv_bat h add wo 5
ret false
end
wg = sv_tagend h wo
if eq wg VNONE
ret false
end
we = sv_findx h vxheadc add wg 1 sv_n h true
if eq we VNONE
ret false
end
put vhd 0 add wg 1
put vhd 1 we
ret true
end
text vtgt ">"
note sv_hnext: the next head tag at or after i (oracle read_head's tag list), its '<'; vax[0] its '>',
note vax[1] where the scan resumes. Title, script and style bodies are skipped to "</name".
note VNONE at the end, or when the head is malformed (vhd[2] = 1).
fn sv_hnext h ulong i ulong to ulong
we = get vhd 1
while true bound 999999
wl = sv_findx h vxlt i we false
if eq wl VNONE
ret VNONE
end
wg = sv_findx h vtgt wl we false
if eq wg VNONE
put vhd 2 1
ret VNONE
end
wc = sv_bat h add wl 1
wtn = sv_tname h wl
wsk = and ne wc 47 or or sv_tnis vxtitle sv_tnis vxscr sv_tnis vxsty
if wsk
wz = sv_hclose h add wg 1
if eq wz VNONE
put vhd 2 1
ret VNONE
end
put vax 0 wg
put vax 1 add add wz 2 get vtnn 0
ret wl
end
if not or eq wc 47 eq wc 33
put vax 0 wg
put vax 1 add wg 1
ret wl
end
i = add wg 1
end
ret VNONE
end
fn sv_hclose h ulong from ulong to ulong
we = get vhd 1
wi = from
while true bound 999999
wl = sv_findx h vxclo wi we false
if eq wl VNONE
ret VNONE
end
if sv_vtnat h add wl 2
ret wl
end
wi = add wl 1
end
ret VNONE
end
note sv_hrange_blank: [a, b) of h is empty or only Unicode whitespace (str::trim().is_empty()).
fn sv_rblank h ulong a ulong b ulong to bool
wi = a
while lt wi b bound 999999
if not sv_ins sv_cp h wi
ret false
end
wi = add wi sv_cpl h wi
end
ret true
end
note sv_htitle: exactly one title tag in the head (else a failure) and its text is not blank.
fn sv_htitle h ulong to bool
wn = ulong 0
wb = false
wi = get vhd 0
while true bound 999999
wl = sv_hnext h wi
if eq wl VNONE
break
end
wtn = sv_tname h wl
if and ne sv_bat h add wl 1 47 sv_tnis vxtitle
wn = add wn 1
wz = sv_hclose h add get vax 0 1
wb = sv_rblank h add get vax 0 1 wz
end
wi = get vax 1
end
if ne get vhd 2 0
sv_fail vro2 vthtag
ret false
end
if gt wn 1
sv_fail vro2 vtht2
ret false
end
if or eq wn 0 wb
sv_fail vro2 vttitle
ret false
end
ret true
end
note sv_hmeta: oracle check_head meta(key): the first meta tag whose name (else property) equals key
note and whose content is not blank; its content offset (vav[0] its length) or VNONE.
fn sv_hmeta h ulong key view uchar * to ulong
wi = get vhd 0
while true bound 999999
wl = sv_hnext h wi
if eq wl VNONE
ret VNONE
end
wg = get vax 0
wi = get vax 1
wtn = sv_tname h wl
if sv_tnis vxmeta
wk = sv_attr h wl wg vxname
if eq wk VNONE
wk = sv_attr h wl wg vxprop
end
if ne wk VNONE
if and eq get vav 0 len key sv_eqat h wk key
wc = sv_attr h wl wg vxcont
if ne wc VNONE
wcl = get vav 0
if not sv_rblank h wc add wc wcl
put vav 0 wcl
ret wc
end
end
end
end
end
put vax 1 wi
end
ret VNONE
end
fn sv_heq h ulong off ulong n ulong u ulong to bool
if or eq off VNONE ne n sv_n u
ret false
end
for wj ulong n
if ne sv_b h add off wj sv_b u wj
ret false
end
end
ret true
end
note sv_hlinks: walk the link tags with rel == relv. mode 0: count the hrefs and whether every one
note equals u (canonical); mode 1: the href of the first one whose hreflang equals code (vav len).
fn sv_hcanon h ulong u ulong to bool
wn = ulong 0
wok = true
wi = get vhd 0
while true bound 999999
wl = sv_hnext h wi
if eq wl VNONE
break
end
wg = get vax 0
wi = get vax 1
wtn = sv_tname h wl
if and sv_tnis vxlink sv_aeq h sv_attr h wl wg vxrel vxcanon
wv = sv_attr h wl wg vxhref
if ne wv VNONE
wn = add wn 1
if not sv_heq h wv get vav 0 u
wok = false
end
end
end
end
ret and wok eq wn 1
end
fn sv_hlang h ulong code view uchar * to ulong
wi = get vhd 0
while true bound 999999
wl = sv_hnext h wi
if eq wl VNONE
ret VNONE
end
wg = get vax 0
wi = get vax 1
wtn = sv_tname h wl
if and sv_tnis vxlink sv_aeq h sv_attr h wl wg vxrel vxalt
if sv_aeq h sv_attr h wl wg vxhl code
ret sv_attr h wl wg vxhref
end
end
end
ret VNONE
end
note sv_url: "https://www.aienos.com" followed by site path slot p, as a new slot.
fn sv_url p ulong to ulong
ws = sv_snew
sv_pusht vhost
sv_pusha sv_off p sv_n p
ret ws
end
fn sv_hlangok h ulong p ulong to bool
wh = sv_find h vxhtml 0
if eq wh VNONE
ret false
end
wg = sv_tagend h wh
if eq wg VNONE
ret false
end
wv = sv_attr h wh wg vxlng
if eq wv VNONE
ret false
end
wn = get vav 0
if sv_iszh p
ret and eq wn len vxzhl sv_eqat h wv vxzhl
end
if and eq wn 2 sv_eqat h wv vxen
ret true
end
ret sv_eqat h wv vxenx
end
fn sv_hpair h ulong p ulong tw ulong u ulong to void
if ne tw 0
we = p
wz = tw
if sv_iszh p
we = tw
wz = p
end
wue = sv_url we
wuz = sv_url wz
wa = sv_hlang h vxen
wan = get vav 0
wb = sv_hlang h vxzhl
wbn = get vav 0
whok = sv_heq h wa wan wue
whok = and whok sv_heq h wb wbn wuz
if not whok
sv_fail vro2 vthrp
end
sv_drop wue
ret
end
wa = sv_hlang h vxzhl
wan = get vav 0
wb = sv_hlang h vxen
wbn = get vav 0
wx = and ne wa VNONE not sv_heq h wa wan u
wy = and ne wb VNONE not sv_heq h wb wbn u
if or wx wy
sv_fail vro2 vthrx
end
end
fn sv_chead h ulong p ulong tw ulong to void
put vhd 2 0
if not sv_hbounds h
sv_fail vro2 vthead
ret
end
if not sv_htitle h
ret
end
wd = sv_hmeta h vxdesc
if and eq wd VNONE eq sv_hmeta h vxogd VNONE
sv_fail vro2 vtdesc
end
if eq sv_hmeta h vxogt VNONE
sv_fail vro2 vtogt
end
if eq sv_hmeta h vxogd VNONE
sv_fail vro2 vtogd
end
wu = sv_url p
if not sv_hcanon h wu
sv_fail vro2 vtcan
end
wo = sv_hmeta h vxogu
if not sv_heq h wo get vav 0 wu
sv_fail vro2 vtogu
end
if not sv_hlangok h p
sv_fail vro2 vtlang
end
sv_hpair h p tw wu
sv_drop wu
end

note ---------------------------------------------------------------- O3 destinations, O4 root
fn sv_dests h ulong to void
wr = sv_strip h 31
wi = ulong 0
for wk ulong sv_tcount vdlab
wa = sv_tat vdhref wk
wb = sv_tat vdlab wk
sv_setlab part vdlab wb sv_tlen vdlab wb
wi = sv_alink wr wi sv_n wr part vdhref wa sv_tlen vdhref wa 2
if eq wi VNONE
sv_failt vro3 vtdest part vdlab wb sv_tlen vdlab wb
sv_drop wr
ret
end
end
sv_drop wr
end
fn sv_root h ulong to void
wm = sv_strip h 7
if not and sv_hasid wm vsallen sv_hasid wm vsdoor
sv_fail vro4 vtrid
end
sv_drop wm
wr = sv_strip h 31
if eq sv_alink wr 0 sv_n wr vclas 0 VNONE
sv_fail vro4 vtrcl
end
sv_drop wr
if not sv_nosc h
sv_fail vro4 vtrns
end
end
note sv_nosc: some <noscript> outside hidden elements (oracle noscript) links /classic/ with text.
fn sv_nosc h ulong to bool
wm = sv_strip h 23
wi = ulong 0
while true bound 999999
wa = sv_findc wm vxnoso wi
if eq wa VNONE
sv_drop wm
ret false
end
wi = add wa 1
if sv_awsr sv_lc sv_bat wm add wa 9
wg = sv_tagend wm wa
if ne wg VNONE
if sv_nosc1 wm add wg 1
sv_drop wm
ret true
end
end
end
end
ret false
end
fn sv_nosc1 wm ulong body ulong to bool
wtn = sv_tname wm sub body 1
note vtn must hold "noscript" for sv_eend: set it from the opening tag
put vtnn 0 8
for wj ulong 8
put vtn wj get vxnos wj
end
we = sv_eend wm body
if eq we VNONE
we = sv_n wm
else
we = sub we len vxnosc
end
wf = sv_slot1 body we wm
wg = sv_strip wf 16
wr = sv_alink wg 0 sv_n wg vclas 0
sv_drop wf
ret ne wr VNONE
end

note ---------------------------------------------------------------- O5 assets
fn sv_lmode to ulong
wk = lstat vpath 0 get vpn 0 vst 0 128
if lt wk 0
ret 0
end
wm = or ulong get vst 16 shl ulong get vst 17 8
ret or wm or shl ulong get vst 18 16 shl ulong get vst 19 24
end
note sv_resolve: oracle resolve_asset for the URL [a, a+n) of slot s.
fn sv_resolve s ulong a ulong n ulong to bool
wl = ulong 0
while lt wl n bound 999999
c = sv_b s add a wl
if or eq c 63 eq c 35
break
end
wl = add wl 1
end
if or eq wl 0 eq sv_b s add a sub wl 1 47
ret false
end
wi = ulong 0
while and lt wi wl eq sv_b s add a wi 47 bound 999999
wi = add wi 1
end
if eq wi wl
ret false
end
wseg = ulong 0
wdot = ulong 0
for wj ulong sub wl wi
c = sv_b s add add a wi wj
if eq c 47
if or eq wseg 0 and le wseg 2 eq wdot wseg
ret false
end
wseg = 0
wdot = 0
else
if eq c 92
ret false
end
if eq c 46
wdot = add wdot 1
end
wseg = add wseg 1
end
end
if and le wseg 2 eq wdot wseg
ret false
end
sv_proot
sv_pva add add sv_off s a wi sub wl wi
ret eq and sv_lmode 61440 32768
end
fn sv_assets h ulong to void
wm = sv_strip h 0
wi = ulong 0
while true bound 999999
wl = sv_findb2 wm 60 wi
if eq wl VNONE
break
end
wg = sv_tagend wm wl
if eq wg VNONE
break
end
wi = add wg 1
if ne sv_bat wm add wl 1 47
wi = sv_asset1 wm wl wg
end
end
sv_drop wm
end
fn sv_asset1 wm ulong wl ulong wg ulong to ulong
wtn = sv_tname wm wl
wv = VNONE
wscr = sv_tnis vxscr
if wscr
wv = sv_attr wm wl wg vxsrc
end
if sv_tnis vxlink
wr = sv_attr wm wl wg vxrel
if ne wr VNONE
if sv_hastokc wm wr get vav 0 vxsheet
wv = sv_attr wm wl wg vxhref
end
end
end
if ne wv VNONE
wn = get vav 0
if and ge wn 1 eq sv_b wm wv 47
if not and ge wn 2 eq sv_b wm add wv 1 47
if not sv_resolve wm wv wn
sv_failx vro5 vtasset add sv_off wm wv wn
end
end
end
end
wtn = sv_tname wm wl
if or wscr sv_tnis vxsty
wz = sv_eend wm add wg 1
if eq wz VNONE
ret sv_n wm
end
ret wz
end
ret add wg 1
end
note sv_hastokc: ASCII-whitespace-separated token equal to tok ignoring ASCII case.
fn sv_hastokc s ulong v ulong n ulong tok view uchar * to bool
wi = v
we = add v n
while lt wi we bound 999999
while and lt wi we sv_aws sv_b s wi bound 999999
wi = add wi 1
end
wst = wi
while and lt wi we not sv_aws sv_b s wi bound 999999
wi = add wi 1
end
if and gt wi wst eq sub wi wst len tok
if sv_eqatc s wst tok
ret true
end
end
end
ret false
end

note ---------------------------------------------------------------- C1 consent boundary (per .html)
fn sv_lower s ulong to ulong
ws = sv_snew
for wj ulong sv_n s
sv_push sv_lc sv_b s wj
end
ret ws
end
fn sv_c1 h ulong to void
wl = sv_lower h
if or sv_has wl vxuwt sv_has wl vxtwq
sv_fail vrc1 vtxpx
end
if or sv_has wl vxfg sv_has wl vxfs
sv_fail vrc1 vtfont
end
wi = ulong 0
while true bound 999999
wa = sv_find wl vxscro wi
if eq wa VNONE
break
end
wg = sv_tagend wl wa
if eq wg VNONE
sv_fail vrc1 vtunt
break
end
wv = sv_attr wl wa wg vxsrc
if ne wv VNONE
if not sv_srcok wl wv get vav 0
sv_failx vrc1 vtscr add sv_off wl wa sub add wg 1 wa
end
else
if sv_hasn wl vxsrc wa add wg 1
sv_failx vrc1 vtscr add sv_off wl wa sub add wg 1 wa
end
end
wi = add wg 1
end
sv_drop wl
if ne sv_count h vxload 1
sv_fail vrc1 vtload
end
if ne sv_count h vxdlg 1
sv_fail vrc1 vtdlg
end
if not sv_has h vxprv
sv_fail vrc1 vtpriv
end
end
fn sv_srcok s ulong v ulong n ulong to bool
if or eq n 0 ne sv_b s v 47
ret false
end
if and ge n 2 eq sv_b s add v 1 47
ret false
end
wi = v
while lt wi add v n bound 999999
if or eq sv_b s wi 92 sv_ins sv_cp s wi
ret false
end
wi = add wi sv_cpl s wi
end
ret true
end
fn sv_c1js q ulong h ulong to void
if or sv_has h vxuwt sv_has h vxtwq
wok = sv_fis q vxaij
if not wok
wok = sv_fext q vxaijs
end
if not wok
sv_fail vrc2 vtjsx
end
end
end
fn sv_c2 to void
wj = sv_loadrel vxaij
if eq wj 0
sv_fail vrc2 vtrfr
ret
end
if or ne sv_count wj vxuwtu 1 ne sv_count wj vxrfr 1
sv_fail vrc2 vtrfr
end
sv_drop wj
end

note ---------------------------------------------------------------- G contact (per .html)
fn sv_contact q ulong h ulong to void
wr = sv_strip h 31
if eq sv_alink wr 0 sv_n wr vsx 1 VNONE
sv_fail vrg vtnox
sv_drop wr
ret
end
if ne sv_mains wr 1
sv_fail vrg vtmain
else
if eq sv_alink wr 0 get vax 0 vsx 1 VNONE
sv_fail vrg vtxbm
end
end
if eq sv_alink wr 0 sv_n wr vscon 0 VNONE
sv_fail vrg vtnoc
end
if eq sv_alink wr 0 sv_n wr vsmail 0 VNONE
sv_fail vrg vtnom
end
wroot = or sv_fis q vixh sv_fis q v404
if not wroot
wh = ne sv_alink wr 0 sv_n wr vshome 0 VNONE
if and not wh sv_frelzh q
wh = ne sv_alink wr 0 sv_n wr vzh 0 VNONE
end
if not wh
sv_fail vrg vtnoh
end
end
sv_cfoot wr
sv_drop wr
end
fn sv_frelzh q ulong to bool
if lt get vfl q len vzhr
ret false
end
for wj ulong len vzhr
if ne get vfp add get vfo q wj get vzhr wj
ret false
end
end
ret true
end
fn sv_cfoot wr ulong to void
wlast = VNONE
wi = ulong 0
while true bound 999999
wa = sv_fclass wr wi vsfoot
if eq wa VNONE
break
end
wlast = wa
wi = add get vax 0 1
end
if eq wlast VNONE
sv_fail vrg vtnof
ret
end
wx = ne sv_alink wr wlast sv_n wr vsx 1 VNONE
wm = ne sv_alink wr wlast sv_n wr vsmail 0 VNONE
if not and wx wm
sv_fail vrg vtnof
end
end

note ---------------------------------------------------------------- F singular voice
note voice.rs verify_singular_voice with the sourced-quote exemption (RustOracle lane): every .html,
note .md and .txt in dist. HTML: each element whose opening tag carries data-quote-id="qNN" (the
note attribute preceded by ASCII whitespace inside the tag) must show exactly the squashed text of qNN
note from data/quotes.json, and only that element is removed before the check; an unknown id, an
note element that never closes or a changed text fails. Markdown and text: only the exact raw quote
note strings are removed. data-speaker="allen" is NOT an exemption here until PR #119 lands in the
note Rust oracle (RustOracle decision); the generator must not rely on it.
text vallowf "post-llm-case/index.html"
text vallowp "We’re never going to get to human-level intelligence by training LLMs or by training on text only. We need the real world."
text vxscr2 "<script"
text vxscc "</script>"
text vxsty2 "<style"
text vxstc "</style>"
text vxlk1 "]("
text vxhttps "https://"
text vxhttp "http://"
text vpw "we\nus\nour\nours\nourselves\n"
text vxus "US"
text vxus2 "us"
text vjoin "-_/.#"
global vrec ulong 1
note sv_cut: in the newest slot s replace [a, b) by one space.
fn sv_cut s ulong a ulong b ulong to void
wo = sv_off s
wn = sv_n s
put va add wo a 32
wd = add a 1
sv_amove add wo wd add wo b sub wn b
sv_trunc s add wd sub wn b
end
note sv_sleq: slots a and b hold the same bytes (split out of sv_quote1 for registers).
fn sv_sleq a ulong b ulong to bool
if ne sv_n a sv_n b
ret false
end
for wj ulong sv_n a
if ne sv_b a wj sv_b b wj
ret false
end
end
ret true
end
fn sv_rlt s ulong wpos ulong to ulong
wi = wpos
while gt wi 0 bound 999999
wi = sub wi 1
if eq sv_b s wi 60
ret wi
end
end
ret VNONE
end
note sv_quotes: without_sourced_quotes on the newest slot s, in place. False on a quote failure.
fn sv_quotes s ulong to bool
wfrom = ulong 0
while true bound 999999
wat = sv_find s vxqattr wfrom
if eq wat VNONE
ret true
end
wop = sv_rlt s wat
wg = VNONE
if ne wop VNONE
wg = sv_tagend s wop
end
wskip = or eq wop VNONE eq wg VNONE
if not wskip
wskip = or lt wg wat not sv_aws sv_b s sub wat 1
end
if wskip
wfrom = add wat len vxqattr
else
if not sv_quote1 s wop wg wat
ret false
end
wfrom = wop
end
end
ret true
end
fn sv_quote1 s ulong wop ulong wg ulong wat ulong to bool
wid = add wat len vxqattr
wq = sv_findb2 s 34 wid
if eq wq VNONE
sv_fail vrf vtquo
ret false
end
wk = sv_qfind s wid sub wq wid
if eq wk VNONE
sv_failx vrf vtquo add sv_off s wid sub wq wid
ret false
end
wtn = sv_tname s wop
wnl = get vtnn 0
we = sv_eend s add wg 1
if eq we VNONE
sv_failx vrf vtquo add sv_off s wid sub wq wid
ret false
end
wt = sv_rtext s add wg 1 sub we add wnl 3
wqs = get vqo wk
wok = sv_sleq wt wqs
sv_drop wt
if not wok
sv_failx vrf vtquo add sv_off s wid sub wq wid
ret false
end
sv_cut s wop we
ret true
end
fn sv_qfind s ulong a ulong n ulong to ulong
for wk ulong get vqc 0
wi = get vqio wk
if eq sv_n wi n
wm = true
for wj ulong n
if ne sv_b wi wj sv_b s add a wj
wm = false
end
end
if wm
ret wk
end
end
end
ret VNONE
end
note sv_qstr: without_quote_strings on the newest slot s: every raw quote string becomes one space.
fn sv_qstr s ulong to void
for wk ulong get vqc 0
wq = get vqin wk
wn = sv_n wq
while true bound 999999
wf = sv_finda s 0 sv_n s sv_off wq wn
if eq wf VNONE
break
end
sv_cut s wf add wf wn
end
end
end
note sv_vis: voice.rs visible_text on the newest slot s, in place: script and style blocks
note (`<script\b.*?</script>` / `<style\b.*?</style>`, any case), then `<[^>]*>`, each to one space;
note then the seven entities in voice.rs order.
fn sv_vis s ulong to void
sv_vblocks s
sv_vtags s
sv_ents s vxent2
end
fn sv_vblk s ulong i ulong to ulong
note end of a script or style block starting at i, or VNONE
we = VNONE
if sv_eqatc s i vxscr2
if not sv_wat s add i 7
we = sv_findc s vxscc add i 7
if ne we VNONE
we = add we 9
end
end
ret we
end
if sv_eqatc s i vxsty2
if not sv_wat s add i 6
we = sv_findc s vxstc add i 6
if ne we VNONE
we = add we 8
end
end
end
ret we
end
fn sv_vblocks s ulong to void
wi = ulong 0
while true bound 999999
wl = sv_findb2 s 60 wi
if eq wl VNONE
ret
end
we = sv_vblk s wl
if eq we VNONE
wi = add wl 1
else
sv_cut s wl we
wi = add wl 1
end
end
end
fn sv_vtags s ulong to void
wi = ulong 0
while true bound 999999
wl = sv_findb2 s 60 wi
if eq wl VNONE
ret
end
wg = sv_findb2 s 62 add wl 1
if eq wg VNONE
ret
end
sv_cut s wl add wg 1
wi = add wl 1
end
end
note sv_links: `\]\([^)\s]*\)|https?://\S+` each to one space, in place.
fn sv_links s ulong to void
wi = ulong 0
while lt wi sv_n s bound 999999
we = VNONE
if sv_eqat s wi vxlk1
wj = add wi 2
while and lt wj sv_n s not or eq sv_b s wj 41 sv_ins sv_cp s wj bound 999999
wj = add wj sv_cpl s wj
end
if and lt wj sv_n s eq sv_bat s wj 41
we = add wj 1
end
else
wj = VNONE
if sv_eqat s wi vxhttps
wj = add wi 8
end
if and eq wj VNONE sv_eqat s wi vxhttp
wj = add wi 7
end
if ne wj VNONE
if and lt wj sv_n s not sv_sat s wj
while and lt wj sv_n s not sv_sat s wj bound 999999
wj = add wj sv_cpl s wj
end
we = wj
end
end
end
if eq we VNONE
wi = add wi sv_cpl s wi
else
sv_cut s wi we
wi = add wi 1
end
end
end
note sv_pmatch: a plural word starts at i (\b on both sides); its end or VNONE.
fn sv_pmatch t ulong i ulong to ulong
if not sv_wb t i
ret VNONE
end
for wk ulong sv_tcount vpw
wa = sv_tat vpw wk
put vlx 0 0
put vlx 1 sv_n t
put vlx 2 t
we = sv_lmc i part vpw wa sv_tlen vpw wa
if ne we VNONE
if sv_wb t we
ret we
end
end
end
ret VNONE
end
fn sv_joined t ulong i ulong to bool
if ge i sv_n t
ret false
end
c = sv_b t i
for wj ulong len vjoin
if eq c get vjoin wj
ret true
end
end
ret false
end
note sv_pskip: voice.rs filters for the match [i, e) of t.
fn sv_pskip t ulong i ulong e ulong rec ulong to bool
if and eq sub e i 2 sv_eqat t i vxus
ret true
end
if gt i 0
if sv_joined t sv_pv t i
ret true
end
end
if sv_joined t e
ret true
end
if and eq sub e i 2 sv_eqatc t i vxus2
wj = i
while gt wj 0 bound 999999
wp = sv_pv t wj
if not sv_ins sv_cp t wp
if sv_isdig sv_b t wp
ret true
end
break
end
wj = wp
end
end
if ne rec 0
ret sv_inrec t i e rec
end
ret false
end
fn sv_inrec t ulong i ulong e ulong rec ulong to bool
ws = i
for wk ulong 12
if eq ws 0
break
end
ws = sv_pv t ws
end
we = e
for wk ulong 12
if ge we sv_n t
break
end
we = add we sv_cpl t we
end
if ne sv_finda rec 0 sv_n rec add sv_off t ws sub e ws VNONE
ret true
end
ret ne sv_finda rec 0 sv_n rec add sv_off t i sub we i VNONE
end
fn sv_plural t ulong rec ulong to void
wi = ulong 0
while lt wi sv_n t bound 999999
we = sv_pmatch t wi
if eq we VNONE
wi = add wi sv_cpl t wi
else
if not sv_pskip t wi we rec
ws = wi
for wk ulong 50
if eq ws 0
break
end
ws = sv_pv t ws
end
sv_failx vrf vtvoice add sv_off t ws sub we ws
end
wi = we
end
end
end
note sv_voice1: one file q whose bytes are slot h.
fn sv_voice1 q ulong h ulong to void
wt = sv_slot1 0 sv_n h h
if sv_fext q vxhtm
if not sv_quotes wt
sv_drop wt
ret
end
sv_vis wt
else
sv_qstr wt
end
if sv_fis q vallowf
sv_qrep wt
end
sv_links wt
sv_squash wt
wrec = ulong 0
if sv_ledpage q
wrec = get vrec 0
end
sv_plural wt wrec
sv_drop wt
end
fn sv_qrep s ulong to void
while true bound 999999
wf = sv_find s vallowp 0
if eq wf VNONE
ret
end
sv_cut s wf add wf len vallowp
end
end
fn sv_ledpage q ulong to bool
for wk ulong sv_tcount vledp
wa = sv_tat vledp wk
if sv_fis q part vledp wa sv_tlen vledp wa
ret true
end
end
ret false
end
note sv_vrec: the squashed ledger record (tabs as spaces) as a persistent slot; empty when absent.
fn sv_vrec to void
sv_prel vfnow
ws = sv_load
if eq ws 0
ws = sv_snew
end
for wj ulong sv_n ws
if eq sv_b ws wj 9
put va add sv_off ws wj 32
end
end
sv_squash ws
put vrec 0 ws
if eq sv_n ws 0
put vrec 0 0
end
end

note ---------------------------------------------------------------- O1 registry, O2 heads, O3
fn sv_regw to void
note every written index.html is registered (or translates a written registered page)
for wq ulong get vfc 0
wp = sv_ppath wq
if ne wp 0
wen = sv_enof wp
if not sv_inreg wen 0 sv_n wen
sv_pfile wq
if sv_iszh wp
sv_failx vro1 vtregz sv_off wp sv_n wp
else
sv_failx vro1 vtregx sv_off wp sv_n wp
end
else
if and sv_iszh wp not sv_written wen
sv_failx vro1 vtregz sv_off wp sv_n wp
end
end
sv_drop wp
end
end
note every registry entry was written
for wk ulong sv_regn
ws = sv_snew
sv_rgpush wk
if not sv_written ws
sv_ctxt vtregm
sv_failx vro1 vtregm sv_off ws sv_n ws
end
sv_drop ws
end
end
fn sv_pages to void
for wq ulong get vfc 0
wp = sv_ppath wq
if ne wp 0
sv_pfile wq
wh = sv_load
if eq wh 0
sv_fail vro2 vtnf
else
wtw = sv_twin wp
sv_pfile wq
sv_chead wh wp wtw
sv_dests wh
end
sv_drop wp
end
end
end
fn sv_sitemap to void
sv_prel vfsmap
wsm = sv_load
if eq wsm 0
sv_fail vro6 vtnf
ret
end
for wk ulong sv_regn
wn = sv_snew
sv_pusht vxloc
sv_pusht vhost
sv_rgpush wk
sv_pusht vxlocc
if eq sv_finda wsm 0 sv_n wsm sv_off wn sv_n wn VNONE
sv_failx vro6 vtsmap sv_off wn sv_n wn
end
sv_drop wn
end
sv_drop wsm
end

note ---------------------------------------------------------------- C3-C8 machine surface
fn sv_c3 to void
wr = sv_loadrel vfrob
if eq wr 0
sv_fail vrc3 vtrob
ret
end
for wk ulong sv_tcount vxbots
wn = sv_snew
sv_pusht vxua
wa = sv_tat vxbots wk
sv_pusht part vxbots wa sv_tlen vxbots wa
sv_pusht vxallow
if eq sv_finda wr 0 sv_n wr sv_off wn sv_n wn VNONE
sv_failx vrc3 vtrob sv_off wn sv_n wn
end
sv_drop wn
end
if not sv_has wr vxsmap
sv_fail vrc3 vtrob
end
sv_drop wr
ws = sv_loadrel vfsmap
if eq ws 0
sv_fail vrc3 vtnf
ret
end
if sv_has ws vxapex
sv_fail vrc3 vtapex
end
sv_drop ws
end
fn sv_c4 to void
wm = sv_loadrel vfsmd
if eq wm 0
sv_fail vrc4 vtsmd
else
if not and sv_starts wm vxsmh and sv_has wm vxh2 sv_has wm vxglmd
sv_fail vrc4 vtsmd
end
sv_drop wm
end
wa = sv_loadrel vfagm
if eq wa 0
sv_fail vrc4 vtagm
else
for wk ulong sv_tcount vxagm
wo = sv_tat vxagm wk
if not sv_has wa part vxagm wo sv_tlen vxagm wo
sv_failt vrc4 vtagm part vxagm wo sv_tlen vxagm wo
end
end
sv_drop wa
end
wi = sv_loadrel vixh
if eq wi 0
sv_fail vrc4 vtnf
ret
end
if not sv_has wi vxgl
sv_fail vrc4 vtgl
end
if not sv_has wi vxbcl
sv_fail vrc4 vtbc
end
sv_drop wi
end
fn sv_c5 to void
wl = sv_loadrel vfllms
if eq wl 0
sv_fail vrc5 vtnf
ret
end
for wk ulong sv_tcount vdfiles
wa = sv_tat vdfiles wk
wn = sv_tlen vdfiles wa
sv_proot
sv_pva 0 0
sv_padd part vdfiles add wa 1 sub wn 1
sv_ctxp
wok = sv_exists
wok = and wok sv_has wl part vdfiles wa wn
if not wok
sv_failt vrc5 vtdf part vdfiles wa wn
end
end
sv_drop wl
sv_prel vfidx
if not sv_exists
sv_fail vrc5 vtdfn
ret
end
wr = sv_jload
if ne sj_len sj_find wr vkfiles2 sv_tcount vdfiles
sv_fail vrc5 vtdfn
end
end
text vxtmd "index.md"
note sv_mdpath: seo.rs md_path of site path slot p, as a new slot ("/" -> "/index.md", "/a/" -> "/a.md").
fn sv_mdpath p ulong to ulong
ws = sv_snew
if eq sv_n p 1
sv_push 47
sv_pusht vxtmd
ret ws
end
wn = sv_n p
while and gt wn 0 eq sv_b p sub wn 1 47 bound 4096
wn = sub wn 1
end
sv_pusha sv_off p wn
sv_pusht vxmd
ret ws
end
note sv_c6: one PAGES entry k (its path pushed into slot p).
fn sv_c6 p ulong wsm ulong wll ulong to void
wn = sv_snew
sv_pusht vxloc
sv_pusht vhost
sv_pusha sv_off p sv_n p
sv_pusht vxlocc
if eq sv_finda wsm 0 sv_n wsm sv_off wn sv_n wn VNONE
sv_failx vrc6 vtsml sv_off p sv_n p
end
sv_drop wn
wn = sv_snew
sv_pusht vxmdo
sv_pusht vhost
sv_pusha sv_off p sv_n p
sv_push 41
if eq sv_finda wll 0 sv_n wll sv_off wn sv_n wn VNONE
sv_failx vrc6 vtllm sv_off p sv_n p
end
sv_drop wn
sv_pagefile p
wh = sv_load
if eq wh 0
sv_failx vrc6 vtnf sv_off p sv_n p
ret
end
sv_c6page p wh
sv_c6ld wh
if sv_dash wh
sv_failx vrc6 vtdsh sv_off p sv_n p
end
sv_drop wh
sv_c6md p
end
fn sv_c6page p ulong wh ulong to void
wn = sv_snew
sv_pusht vxcano
sv_pusht vhost
sv_pusha sv_off p sv_n p
sv_pusht vxtagc
if eq sv_finda wh 0 sv_n wh sv_off wn sv_n wn VNONE
sv_fail vrc6 vtcanx
end
sv_drop wn
if not and sv_has wh vxldj sv_has wh vxtws
sv_fail vrc6 vtld
end
wm = sv_mdpath p
wn = sv_snew
sv_pusht vxmdl
sv_pusha sv_off wm sv_n wm
sv_pusht vxtagc
if eq sv_finda wh 0 sv_n wh sv_off wn sv_n wn VNONE
sv_fail vrc6 vtmdl
end
sv_drop wm
if not sv_has wh vxdby
sv_fail vrc6 vtdby
end
if not and sv_has wh vxsn1 sv_has wh vxsn2
sv_fail vrc6 vtsnip
end
if not sv_has wh vxgl
sv_fail vrc6 vtgl
end
end
fn sv_c6md p ulong to void
wm = sv_mdpath p
sv_proot
sv_pva add sv_off wm 1 sub sv_n wm 1
sv_ctxp
wd = sv_load
if eq wd 0
sv_fail vrc6 vtmdm
else
if not and sv_starts wd vxfm and sv_has wd vxcu sv_has wd vxsms
sv_fail vrc6 vtmdm
end
end
sv_drop wm
if gt sv_n p 1
sv_proot
sv_pva add sv_off p 1 sub sv_n p 1
sv_padd vxtmd
sv_ctxp
if not sv_exists
sv_fail vrc6 vtmdd
end
end
end
note sv_c6ld: the first `<script type="application/ld+json">` block parses as JSON whose @graph is an
note array of at least four nodes (json.om sj_loadat reads exactly that slice of the page file).
fn sv_c6ld wh ulong to void
wa = sv_find wh vxldo 0
if eq wa VNONE
sv_fail vrc6 vtld
ret
end
wa = add wa len vxldo
wb = sv_find wh vxsce wa
if eq wb VNONE
sv_fail vrc6 vtld
ret
end
wp = new uchar 4352 0
for wj ulong get vpn 0
put wp wj get vpath wj
end
wr = sj_loadat view part wp 0 get vpn 0 wa sub wb wa
wg = ulong 0
if eq sj_kind wr 1
wg = sj_find wr vxgraph
end
if or ne sj_kind wg 2 lt sj_len wg 4
sv_fail vrc6 vtldg
end
end
fn sv_c78 to void
for wk ulong sv_tcount vxmach7
wa = sv_tat vxmach7 wk
sv_prel part vxmach7 wa sv_tlen vxmach7 wa
if not sv_exists
sv_failt vrc7 vtmach part vxmach7 wa sv_tlen vxmach7 wa
end
end
for wk ulong sv_tcount vxdash8
wa = sv_tat vxdash8 wk
sv_prel part vxdash8 wa sv_tlen vxdash8 wa
ws = sv_load
if eq ws 0
sv_failt vrc8 vtnf part vxdash8 wa sv_tlen vxdash8 wa
else
if sv_dash ws
sv_failt vrc8 vtdsh part vxdash8 wa sv_tlen vxdash8 wa
end
sv_drop ws
end
end
end
fn sv_cseo to void
sv_c3
sv_c4
sv_c5
wsm = sv_loadrel vfsmap
if eq wsm 0
ret
end
wll = sv_loadrel vfllms
if eq wll 0
sv_drop wsm
ret
end
for wk ulong sv_tcount vpages
wp = sv_snew
wa = sv_tat vpages wk
sv_pusht part vpages wa sv_tlen vpages wa
sv_c6 wp wsm wll
sv_drop wp
end
sv_drop wsm
sv_c78
end

note ---------------------------------------------------------------- D4 data/pages.json against the registry
fn sv_nodeis node ulong s ulong to bool
if ne sj_size node sv_n s
ret false
end
for wj ulong sv_n s
if ne sj_byte node wj sv_b s wj
ret false
end
end
ret true
end
fn sv_regset n ulong to void
for wi ulong n
for wj ulong wi
if sj_same get vseen wj get vseen wi
sv_failt vrd4 vtixd vtpgm
end
end
ws = sv_jsl get vseen wi
if not sv_inreg ws 0 sv_n ws
sv_failx vrd4 vtpgm sv_off ws sv_n ws
end
sv_drop ws
end
for wk ulong sv_regn
ws = sv_snew
sv_rgpush wk
wf = false
for wi ulong n
if sv_nodeis get vseen wi ws
wf = true
end
end
if not wf
sv_failx vrd4 vtpgm sv_off ws sv_n ws
end
sv_drop ws
end
end
