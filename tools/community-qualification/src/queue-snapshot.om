note Queue projection: metadata M and reviewed public J records, not a parallel queue.
note J fields: tag repository number head base title Spark-check Hosted-check.
note All rows remain blocked; a reported GitHub status is not a gate receipt.
global inp uchar 1048576
global ilen ulong 1
global out uchar 2097152
global olen ulong 1
global bad ulong 1
global fs ulong 8192
global fl ulong 8192
global rs ulong 1024
global rc ulong 1024
global nf ulong 1
global nr ulong 1
text pieces "{\"schema_version\":1,\"generated_utc\":~ ,\"source_url\":~ ,\"jobs\":[~]}\n~{\"repository\":~ ,\"number\":~ ,\"head_sha\":~ ,\"base_sha\":~ ,\"title\":~ ,\"summary\":\"Observed in the local PR queue. Reported checks are not accepted gate receipts. Portable instructions still need review.\",\"hardware\":\"Not mapped for this job; do not assume a Spark is the only requirement\",\"requirements\":[],\"commands\":[],\"instructions_reviewed\":false,\"blockers\":[\"Gate contracts, hardware requirements and portable commands have not been reviewed for contributors\"],\"reports\":[],\"gates\":[{\"id\":\"Reported GitHub check: AIEN Verification (Spark)\",\"evidence_url\":null,\"contract_sha256\":null,\"status\":~},{\"id\":\"Reported GitHub check: AIEN Verification\",\"evidence_url\":null,\"contract_sha256\":null,\"status\":~}]}~,~\"pass_reported\"~\"fail_reported\"~\"unknown\"~"
text states "SUCCESS~FAILURE~ERROR~PENDING~UNKNOWN~"
text secrets "sk-ant-~sk-proj-~ghp_~gho_~Bearer ~/home/~/Users/~"
text prefix "https://github.com/"
fn appendb c ulong to int
if ge get olen 0 len out
put bad 0 1
ret 2
end
put out get olen 0 uchar c
put olen 0 add get olen 0 1
ret 0
end
fn literal which ulong to int
i = ulong 0
k = ulong 0
while and lt i len pieces lt k which
if eq get pieces i 126
k = add k 1
end
i = add i 1
end
while and lt i len pieces ne get pieces i 126
x = appendb ulong get pieces i
i = add i 1
end
ret 0
end
fn raw f ulong to int
i = ulong 0
while lt i get fl f
x = appendb ulong get inp add get fs f i
i = add i 1
end
ret 0
end
fn quoted f ulong to int
x = appendb 34
i = ulong 0
while lt i get fl f
c = ulong get inp add get fs f i
if or eq c 34 eq c 92
x = appendb 92
end
if ge c 128
if and eq c 226 le add i 3 get fl f
p = add get fs f i
c1 = ulong get inp add p 1
c2 = ulong get inp add p 2
if and eq c1 128 or eq c2 147 eq c2 148
x = appendb 45
i = add i 3
else
x = appendb c
i = add i 1
end
else
x = appendb c
i = add i 1
end
else
x = appendb c
i = add i 1
end
end
x = appendb 34
ret 0
end
fn equal a ulong b ulong to int
if ne get fl a get fl b
ret 0
end
i = ulong 0
while lt i get fl a
x = ulong get inp add get fs a i
y = ulong get inp add get fs b i
if and ge x 65 le x 90
x = add x 32
end
if and ge y 65 le y 90
y = add y 32
end
if ne x y
ret 0
end
i = add i 1
end
ret 1
end
fn sha f ulong to int
if ne get fl f 40
ret 0
end
i = ulong 0
while lt i 40
c = ulong get inp add get fs f i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret 0
end
i = add i 1
end
ret 1
end
fn number f ulong to int
if or eq get fl f 0 gt get fl f 9
ret 0
end
if eq get inp get fs f 48
ret 0
end
i = ulong 0
while lt i get fl f
c = ulong get inp add get fs f i
if or lt c 48 gt c 57
ret 0
end
i = add i 1
end
ret 1
end
fn charok c ulong to int
ok = or and ge c 48 le c 57 and ge c 65 le c 90
ok = or ok and ge c 97 le c 122
ok = or ok or eq c 45 or eq c 95 eq c 46
if ok
ret 1
end
ret 0
end
fn repoval f ulong to int
if or lt get fl f 3 gt get fl f 201
ret 0
end
i = ulong 0
slashes = ulong 0
while lt i get fl f
c = ulong get inp add get fs f i
if eq c 47
if or eq i 0 eq add i 1 get fl f
ret 0
end
slashes = add slashes 1
else
if eq charok c 0
ret 0
end
end
if eq c 46
if or eq i 0 eq add i 1 get fl f
ret 0
end
if eq get inp sub add get fs f i 1 47
ret 0
end
end
i = add i 1
end
if eq slashes 1
ret 1
end
ret 0
end
fn state f ulong to int
j = ulong 0
k = ulong 0
while lt j len states
start = j
while and lt j len states ne get states j 126
j = add j 1
end
if eq sub j start get fl f
i = ulong 0
same = ulong 1
while lt i get fl f
left = ulong get inp add get fs f i
right = ulong get states add start i
if ne left right
same = 0
end
i = add i 1
end
if eq same 1
ret int k
end
end
j = add j 1
k = add k 1
end
ret 9
end
fn clean f ulong to int
if or eq get fl f 0 gt get fl f 4096
ret 0
end
i = ulong 0
while lt i get fl f
c = ulong get inp add get fs f i
if or lt c 32 eq c 127
ret 0
end
i = add i 1
end
j = ulong 0
while lt j len secrets
start = j
while and lt j len secrets ne get secrets j 126
j = add j 1
end
n = sub j start
i = ulong 0
while le add i n get fl f
k = ulong 0
same = ulong 1
while lt k n
at = add get fs f i
left = ulong get inp add at k
right = ulong get secrets add start k
if ne left right
same = 0
end
k = add k 1
end
if eq same 1
ret 0
end
i = add i 1
end
j = add j 1
end
ret 1
end
fn digits f ulong start ulong count ulong to ulong
i = ulong 0
v = ulong 0
while lt i count
p = add get fs f start
p = add p i
c = ulong get inp p
d = sub c 48
v = add mul v 10 d
i = add i 1
end
ret v
end
fn utctime f ulong to int
if ne get fl f 20
ret 0
end
i = ulong 0
while lt i 20
c = ulong get inp add get fs f i
want = ulong 0
if or eq i 4 eq i 7
want = 45
end
if eq i 10
want = 84
end
if or eq i 13 eq i 16
want = 58
end
if eq i 19
want = 90
end
if ne want 0
if ne c want
ret 0
end
else
if or lt c 48 gt c 57
ret 0
end
end
i = add i 1
end
y = digits f 0 4
m = digits f 5 2
d = digits f 8 2
if or lt y 2020 or lt m 1 gt m 12
ret 0
end
maxday = ulong 31
if or or eq m 4 eq m 6 or eq m 9 eq m 11
maxday = 30
end
if eq m 2
maxday = 28
r4 = rem y 4
r100 = rem y 100
r400 = rem y 400
if eq r4 0
if or ne r100 0 eq r400 0
maxday = 29
end
end
end
if or lt d 1 gt d maxday
ret 0
end
if or gt digits f 11 2 23 or gt digits f 14 2 59 gt digits f 17 2 59
ret 0
end
ret 1
end
fn url f ulong to int
if or le get fl f len prefix gt get fl f 2048
ret 0
end
i = ulong 0
while lt i len prefix
if ne get inp add get fs f i get prefix i
ret 0
end
i = add i 1
end
while lt i get fl f
c = ulong get inp add get fs f i
if and eq charok c 0 ne c 47
ret 0
end
i = add i 1
end
ret 1
end
fn framing to int
if eq get ilen 0 0
ret 2
end
if ne get inp sub get ilen 0 1 10
ret 2
end
put nr 0 0
put nf 0 0
put rs 0 0
start = ulong 0
i = ulong 0
while lt i get ilen 0
c = ulong get inp i
if or eq c 9 eq c 10
if ge get nf 0 len fs
ret 2
end
put fs get nf 0 start
put fl get nf 0 sub i start
put nf 0 add get nf 0 1
start = add i 1
if eq c 10
row = get nr 0
first = get rs row
fields = sub get nf 0 first
put rc row fields
put nr 0 add get nr 0 1
if ge get nr 0 len rs
ret 2
end
put rs get nr 0 get nf 0
end
end
i = add i 1
end
ret 0
end
fn validall to int
if or ne get rc 0 4 gt get nr 0 1001
ret 2
end
if or ne get fl 0 1 ne get inp get fs 0 77
ret 2
end
if or ne get fl 1 1 ne get inp get fs 1 49
ret 2
end
if or eq utctime 2 0 eq url 3 0
ret 2
end
row = ulong 1
while lt row get nr 0
f = get rs row
if ne get rc row 8
ret 2
end
if or ne get fl f 1 ne get inp get fs f 74
ret 2
end
valid = repoval add f 1
valid = mul valid number add f 2
valid = mul valid sha add f 3
valid = mul valid sha add f 4
if eq valid 0
ret 2
end
if eq clean add f 5 0
ret 2
end
if eq state add f 6 9
ret 2
end
if eq state add f 7 9
ret 2
end
old = ulong 1
while lt old row
g = get rs old
same = equal add f 1 add g 1
same = mul same equal add f 2 add g 2
if eq same 1
ret 2
end
old = add old 1
end
row = add row 1
end
ret 0
end
fn render to int
put olen 0 0
x = literal 0
x = quoted 2
x = literal 1
x = quoted 3
x = literal 2
row = ulong 1
while lt row get nr 0
f = get rs row
if gt row 1
x = literal 12
end
x = literal 4
x = quoted add f 1
x = literal 5
x = raw add f 2
x = literal 6
x = quoted add f 3
x = literal 7
x = quoted add f 4
x = literal 8
x = quoted add f 5
x = literal 9
st = state add f 6
part = ulong 15
if eq st 0
part = 13
end
if or eq st 1 eq st 2
part = 14
end
x = literal part
x = literal 10
st = state add f 7
part = 15
if eq st 0
part = 13
end
if or eq st 1 eq st 2
part = 14
end
x = literal part
x = literal 11
row = add row 1
end
x = literal 3
if ne get bad 0 0
ret 2
end
sent = ulong 0
while lt sent get olen 0
w = write 1 out sent sub get olen 0 sent
if le w 0
ret 3
end
sent = add sent ulong w
end
ret 0
end
fn command to int
put ilen 0 0
while lt get ilen 0 len inp
n = read 0 inp get ilen 0 sub len inp get ilen 0
if lt n 0
ret 2
end
if eq n 0
if eq get ilen 0 0
ret 2
end
if ne get inp sub get ilen 0 1 10
ret 2
end
if ne framing 0
ret 2
end
if ne validall 0
ret 2
end
ret render
end
put ilen 0 add get ilen 0 ulong n
end
ret 2
end
