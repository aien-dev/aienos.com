f2e0137e878016a7afdb2314972e0cbbe2461a67b00eb1d691b4de8ea2665da8  layers-7.safetensors
1721b7bcd730891c224b70a7b6147e44a574a2d6c4d924760acf97728249c92c  layers-8.safetensors
0a21e07065b5bb04adc339300dea1872cc48ab8eab3b02df092f7cbc67c8d6f6  layers-9.safetensors
bbedc3fda3305820b977265f01b8619d87570a6739de3a5582c3464840f1e57a  LICENSE
f0838c766951bdfe76d6afbdb2771a8f67aaa2231dedb3d33cebd817729843a2  model.safetensors.index.json
e5e4464a3793cc261de536592830bca40e7f3af159ed038c358f5660917cf43b  mtp.safetensors
ddff1d6665a2b39f2612fce0ef955e2436724c565bfbcbc127c7ffd078b698ff  outside.safetensors
b11349aafa7cdc6a320767cf7ceb29ed82f7eda5d65e8e0819e76f0ce947bf27  tokenizer_config.json
0997f410c57a1f4e53b09e4be8f4a172d90edd9564368fb0847030937229b9f3  tokenizer.json
SUMS
todo=$(cd "$W" && sha256sum -c "$W.sha256" 2>&1 | grep -v -e ': OK$' -e '^sha256sum:' | sed 's/: .*//') || true
n=$(echo "$todo" | grep -c . || true)
echo "$n of $(wc -l < "$W.sha256") files to download (about 30 GB on a first run)"
echo "$todo" | grep . | xargs -r -P 8 -I{} sh -c \
  'curl -sSfL --retry 5 -C - -o "$1/$2" "https://huggingface.co/$3/resolve/$4/$2" || exit 255' _ "$W" {} "$HF_REPO" "$HF_REV"
(cd "$W" && sha256sum -c --quiet "$W.sha256") || die "a weight file does not match its published sha256 (run again to retry)"
echo "all $(wc -l < "$W.sha256") files match their published sha256"
mark weights "$t"

say "6/7 converting to the 4-bit store (once)"
t=$(now)
if ! "$BIN/qwen38_w4_store" check "$W" >/dev/null 2>&1; then
  $BUILD_WRAP "$BIN/qwen38_w4_store" write "$W"
fi
STORE_SHA256=2a45c5376547e8762417f7944c8c17f8a8ec4fca4411208ebd6671457c8f1a69
echo "$STORE_SHA256  $W.mxfp4/aien-w4.store" | sha256sum -c - >/dev/null \
  || die "the 4-bit store differs from the reference store (sha256 $STORE_SHA256)"
echo "the 4-bit store is byte-identical to the reference (sha256 $STORE_SHA256)"
mark convert "$t"

say "7/7 answering one prompt on the GPU"
t=$(now)
echo "linked libraries of the demo program (no libcuda):"
ldd "$BIN/qwen38_say" | sed 's/ (0x.*//; s/^/  /'
! ldd "$BIN/qwen38_say" | grep -qi cuda || die "the demo program links a CUDA library"
echo "prompt: $PROMPT"
$GPU_WRAP "$BIN/qwen38_say" "$W" "$PROMPT" --gen "$GEN" --receipt "$DIR/answer.json"
mark answer "$t"
mark total "$T0"

say "timings (seconds)"
cat "$DIR/timings.txt"
{
  printf '{\n  "demo": "aien one-command 27B", "utc": "%s",\n' "$(date -u +%FT%TZ)"
  printf '  "omega": "%s", "physics": "%s", "sovereign_core": "%s",\n' "$OMEGA_SHA" "$PHYSICS_SHA" "$SC_SHA"
  printf '  "weights": "%s@%s", "gpu": "%s", "driver": "%s", "kernel": "%s",\n' "$HF_REPO" "$HF_REV" "$GPU" "$DRV" "$(uname -r)"
  printf '  "store_sha256": "%s", "linked": "%s",\n' "$STORE_SHA256" "$(ldd "$BIN/qwen38_say" | awk '{print $1}' | paste -sd' ' -)"
  printf '  "loadavg_end": "%s", "run_sha256": "%s",\n' "$(cut -d' ' -f1-3 /proc/loadavg)" "$(sha256sum "$0" | cut -d' ' -f1)"
  printf '  "timings_s": {%s},\n' "$(awk '{printf "%s\"%s\": %s", (NR>1?", ":""), $1, $2}' "$DIR/timings.txt")"
  printf '  "answer": "answer.json"\n}\n'
} > "$DIR/demo-receipt.json"
echo "receipt: $DIR/demo-receipt.json (compare with github.com/aien-dev/aien-receipts)"
