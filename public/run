ebbc2c4bd2b98877caafa7073b6ed732a0284eb82269cf6d21710e245af5837a  layers-5.safetensors
9a19c30b190bf552eb424af16103f610bcd944fb276b3275eb7c73849799b7de  layers-60.safetensors
