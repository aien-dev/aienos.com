#!/bin/sh
# AIEN one-command demo: Qwen3.8-27B in 4 bits on an NVIDIA DGX Spark (GB10), through the Omega engine.
# No CUDA, no libcuda, no cubin: Omega talks to the open nvidia.ko kernel driver directly.
#
#   curl -sSLO https://aienos.com/run && less run && sh run
#   sh run [--dir DIR] [--prompt "TEXT"] [--gen N]
#
# Everything goes into one folder (default ./aien-demo, about 65 GB at the end). Nothing outside it is
# changed: no sudo, no system packages, the Rust toolchain (if missing) is installed inside the folder.
# Steps: check the machine, get Rust, fetch the three source repositories at pinned commits, build,
# download the official Qwen3.8-27B-FP8 weights (Apache 2.0) at a pinned revision and check every file's
# sha256, convert them once to the 4-bit store, answer one prompt, print the speed, write demo-receipt.json.
# Running it again reuses whatever is already finished and checked.
set -eu

DIR=./aien-demo
PROMPT="In three sentences: why does memory bandwidth decide how fast a language model writes?"
GEN=128
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) DIR=$2; shift 2 ;;
    --prompt) PROMPT=$2; shift 2 ;;
    --gen) GEN=$2; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option $1 (try --help)" >&2; exit 2 ;;
  esac
done

# Pins. Every source is public; every commit is reachable from a tag of the same name (demo-l182-v1).
OMEGA_SHA=d2d7404153164bfbe04b99e0fea5f688638096f7      # github.com/aien-dev/omega-mv (the engine)
PHYSICS_SHA=6d7cf0d4d8eb2cda7b512100ff6058e25dbb3ddf    # github.com/aien-dev/physics-mv (driver interface)
SC_SHA=d6942e21d0f507da10c9a111e389324d065dcf44                                       # github.com/aien-dev/aien-sovereign-core-mv (host side)
HF_REPO=Qwen/Qwen3.8-27B-FP8
HF_REV=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
RUST_VERSION=1.98.1
RUSTUP_VERSION=1.29.1
RUSTUP_SHA256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
DRIVER_TESTED=580.173.02
# Optional prefixes for shared machines (a lock or nice wrapper); empty on a normal Spark.
BUILD_WRAP=${AIEN_DEMO_BUILD_WRAP:-}
GPU_WRAP=${AIEN_DEMO_GPU_WRAP:-}

say() { printf '\n== %s\n' "$*"; }
die() { printf '\nSTOPPED: %s\n' "$*" >&2; exit 1; }
now() { date +%s.%N; }
T0=$(now)
mark() { awk -v a="$(now)" -v b="$2" -v k="$1" 'BEGIN { printf "%s %.1f\n", k, a - b }' >> "$DIR/timings.txt"; }

mkdir -p "$DIR"; DIR=$(cd "$DIR" && pwd); : > "$DIR/timings.txt"

say "1/7 checking this machine"
t=$(now)
[ "$(uname -m)" = aarch64 ] || die "needs an aarch64 machine (a DGX Spark); this is $(uname -m)"
[ -r /proc/driver/nvidia/version ] || die "no NVIDIA kernel driver loaded (/proc/driver/nvidia/version missing)"
DRV=$(sed -n 's/.*Kernel Module for [a-z0-9_]*  *\([0-9.]*\) .*/\1/p' /proc/driver/nvidia/version | head -1)
grep -q "Open Kernel Module" /proc/driver/nvidia/version || die "needs the open nvidia.ko kernel module"
# The GB10 GPU is PCI device 10de:2e12 (the driver's own name field can read "Unknown").
GPU=none
for d in /sys/bus/pci/devices/*; do
  [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] && [ "$(cat "$d/device" 2>/dev/null)" = 0x2e12 ] && GPU="NVIDIA GB10 (10de:2e12 at ${d##*/})"
done
[ "$GPU" != none ] || die "needs an NVIDIA GB10 GPU (PCI 10de:2e12); none found"
[ -e /dev/nvidiactl ] || die "/dev/nvidiactl is missing"
if [ "$DRV" != "$DRIVER_TESTED" ] && [ "${AIEN_DEMO_ANY_DRIVER:-0}" != 1 ]; then
  die "driver $DRV: this demo is tested only on $DRIVER_TESTED (the driver interface is pinned to it). AIEN_DEMO_ANY_DRIVER=1 tries anyway."
fi
for c in git curl make cc sha256sum awk; do command -v $c >/dev/null || die "missing tool: $c"; done
FREE_GB=$(df -P -BG "$DIR" | awk 'NR==2 {sub("G","",$4); print $4}')
[ "$FREE_GB" -ge 70 ] || die "needs about 70 GB free in $DIR (has ${FREE_GB} GB)"
MEM_GB=$(awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo)
[ "$MEM_GB" -ge 24 ] || die "needs about 24 GB of free memory (has ${MEM_GB} GB); stop other models first"
echo "GPU $GPU, driver $DRV, $FREE_GB GB disk free, $MEM_GB GB memory free"
mark check "$t"

say "2/7 Rust $RUST_VERSION"
t=$(now)
if command -v cargo >/dev/null && cargo +"$RUST_VERSION" --version >/dev/null 2>&1; then
  echo "using the installed toolchain: $(cargo +$RUST_VERSION --version)"
else
  export RUSTUP_HOME="$DIR/rust/rustup" CARGO_HOME="$DIR/rust/cargo"
  if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl -sSfL -o "$DIR/rustup-init" "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/aarch64-unknown-linux-gnu/rustup-init"
    echo "$RUSTUP_SHA256  $DIR/rustup-init" | sha256sum -c - >/dev/null || die "rustup-init checksum mismatch"
    chmod +x "$DIR/rustup-init"
    "$DIR/rustup-init" -y -q --no-modify-path --profile minimal --default-toolchain "$RUST_VERSION"
  fi
  PATH="$CARGO_HOME/bin:$PATH"; export PATH
  echo "installed inside the demo folder: $(cargo --version)"
fi
mark rust "$t"

say "3/7 sources at pinned commits"
t=$(now)
fetch() { # repo dir sha
  if [ "$(git -C "$DIR/src/$2" rev-parse HEAD 2>/dev/null)" != "$3" ]; then
    rm -rf "$DIR/src/$2"; mkdir -p "$DIR/src/$2"
    git -C "$DIR/src/$2" init -q
    git -C "$DIR/src/$2" fetch -q --depth 1 "https://github.com/aien-dev/$1" "$3"
    git -C "$DIR/src/$2" checkout -q FETCH_HEAD
  fi
  [ "$(git -C "$DIR/src/$2" rev-parse HEAD)" = "$3" ] || die "$1 is not at $3"
  echo "$1 $3"
}
fetch omega-mv omega "$OMEGA_SHA"
fetch physics-mv physics "$PHYSICS_SHA"
fetch aien-sovereign-core-mv sc "$SC_SHA"
mark sources "$t"

say "4/7 building Omega and the demo (C and Rust, no CUDA toolkit)"
t=$(now)
# The CUDA toolkit is kept out of reach so the build cannot pick it up by accident.
PATH=$(echo "$PATH" | tr ':' '\n' | grep -v cuda | paste -sd: -); export PATH
unset LD_LIBRARY_PATH CUDA_HOME CUDA_PATH 2>/dev/null || true
export AIEN_OMEGA_DIR="$DIR/src/omega" AIEN_PHYSICS_DIR="$DIR/src/physics" CARGO_TARGET_DIR="$DIR/target"
(cd "$DIR/src/sc" && $BUILD_WRAP cargo build -q --release --locked -p aien-inference-abi --bin qwen38_say --bin qwen38_w4_store)
BIN=$DIR/target/release
mark build "$t"

say "5/7 weights: $HF_REPO at revision $HF_REV (Apache 2.0)"
t=$(now)
W=$DIR/weights/qwen3.8-27b-fp8
mkdir -p "$W"
cat > "$W.sha256" <<'SUMS'
c3cf9e34abf4f9e36c2d72165aa9c132d3e2a725b6c2586aaa3a8af9d7a81041  chat_template.jinja
74227dd615bf1ea975aa676bdf355a0379858c12f394b5365cd9dfa5fc2c70bc  config.json
e70c136c1b78ddc1fb0905bac8e733a4dc448d4f852a5dd75143fffc70be550e  generation_config.json
07f700e293baeaf3cd4240c3df1a948c4403f16961ea7979e86c8d6a9f8fd466  layers-0.safetensors
